+#ifdef __PS4__
+// PS4: code only runs from flexible memory, of which there are a few hundred MiB for everything,
+// and a JIT per guest thread. Each code cache is a virtual range reservation that
+// EnsureMemoryCommitted backs as the code grows, and starts small.
+constexpr size_t CONSTANT_POOL_SIZE = 512 * 1024;
+constexpr size_t PRELUDE_COMMIT_SIZE = 256 * 1024;
+constexpr size_t PS4_PAGE_SIZE = 16 * 1024;  // the PS4 maps 16 KiB pages
+constexpr size_t PS4_COMMIT_STEP = 256 * 1024;
+
+extern "C" {
+// Declared by hand: several OpenOrbis prototypes are wrong.
+int32_t sceKernelReserveVirtualRange(void** address, size_t length, int32_t flags, size_t alignment);
+int32_t sceKernelMapNamedSystemFlexibleMemory(void** address, size_t length, int32_t protection, int32_t flags, const char* name);
+int32_t sceKernelMapNamedFlexibleMemory(void** address, size_t length, int32_t protection, int32_t flags, const char* name);
+int32_t sceKernelMunmap(void* address, size_t length);
+// the PS4 port's runtime (its port/ps4_crashlog.cpp): a line in the app's boot trace
+void ps4_boot_trace(const char* line);
+}
+constexpr int32_t PS4_MAP_FIXED = 0x10;  // SCE_KERNEL_MAP_FIXED
+constexpr int32_t PS4_PROT_CPU_RWX = 0x7;
+
+// Executable memory at a place in a reservation: from the system pool (where the heap also is), or
+// failing that the app's regular flexible memory; over the reservation, or failing that in its place.
+bool PS4CommitCode(uint8_t* at, size_t size) {
+    static std::atomic<int> logged{0};
+    const auto try_pools = [&](const char* how) {
+        void* addr = at;
+        int32_t r = sceKernelMapNamedSystemFlexibleMemory(&addr, size, PS4_PROT_CPU_RWX, PS4_MAP_FIXED, "dynarmic");
+        const char* pool = "system flexible";
+        if (r != 0 || addr != at) {
+            addr = at;
+            r = sceKernelMapNamedFlexibleMemory(&addr, size, PS4_PROT_CPU_RWX, PS4_MAP_FIXED, "dynarmic");
+            pool = "flexible";
+        }
+        if (r == 0 && addr == at) {
+            if (logged.fetch_add(1) == 0)
+                ps4_boot_trace(fmt::format("dynarmic: code memory from {} memory, mapped {}", pool, how).c_str());
+            return true;
+        }
+        ps4_boot_trace(fmt::format("dynarmic: {} KiB of code memory at {} {} failed: {:08X}", size >> 10, static_cast<void*>(at), how, static_cast<uint32_t>(r)).c_str());
+        return false;
+    };
+    if (try_pools("over the reservation"))
+        return true;
+    sceKernelMunmap(at, size);
+    return try_pools("after unmapping");
+}
