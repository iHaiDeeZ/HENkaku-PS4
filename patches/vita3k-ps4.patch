+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: background downloads. Each queued package has a folder in ux0/bgdl/t, as on the PS Vita:
+// download.txt (title, url, type, size once known), license.rif (PKGj's), and the package itself,
+// a ".part" file until it's whole.
+
+#include "ps4_bgdl.h"
+
+#include <util/log.h>
+
+#include <fmt/format.h>
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <thread>
+
+namespace ps4bgdl {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr const char *JOB_FILE = "download.txt";
+constexpr const char *LICENSE_FILE = "license.rif";
+
+// queue's ids, and the thread's state below
+std::mutex g_mutex;
+bool g_running = false;
+bool g_more = false; // something was queued while the thread looked: it looks again
+std::string g_title; // the download going on
+uint64_t g_done = 0;
+uint64_t g_size = 0;
+int g_waiting = 0; // queued after it
+std::string g_last; // what happened last, said for a while
+Clock::time_point g_last_at{};
+
+fs::path root_of(const fs::path &vita_fs) {
+    return vita_fs / "ux0" / "bgdl" / "t";
+}
+
+fs::path stop_mark(const fs::path &vita_fs) {
+    return vita_fs / "ux0" / "bgdl" / "stopped";
+}
+
+bool is_id(const std::string &name) {
+    return name.size() == 8 && std::all_of(name.begin(), name.end(), [](unsigned char c) { return std::isxdigit(c); });
+}
+
+// the package's name: the URL's last part (PKGj's: EP0000-PCSB00000_00-....pkg on Sony's servers)
+std::string file_name(const std::string &url) {
+    std::string name = url.substr(0, url.find_first_of("?#"));
+    name = name.substr(name.find_last_of('/') + 1);
+    name.erase(std::remove_if(name.begin(), name.end(), [](unsigned char c) { return c < 0x20 || std::strchr("\\:*\"<>|", c); }), name.end());
+    if (name.empty() || name == "." || name == ".." || name == JOB_FILE || name == LICENSE_FILE)
+        return "package.pkg";
+    return name;
+}
+
+uint64_t size_of(const fs::path &path) {
+    boost::system::error_code ec;
+    const auto size = fs::file_size(path, ec);
+    return ec ? 0 : static_cast<uint64_t>(size);
+}
+
+bool save_job(const Download &d) {
+    const fs::path temp = d.dir / (std::string(JOB_FILE) + ".new");
+    {
+        std::string title = d.title;
+        std::replace_if(title.begin(), title.end(), [](char c) { return c == '\n' || c == '\r'; }, ' ');
+        fs::ofstream out(temp, std::ios::trunc);
+        out << "title=" << title << "\nurl=" << d.url << "\ntype=" << d.type << "\nsize=" << d.size << "\n";
+        out.flush();
+        if (!out.good())
+            return false;
+    }
+    boost::system::error_code ec;
+    fs::rename(temp, d.dir / JOB_FILE, ec);
+    return !ec;
+}
+
+std::optional<Download> load_job(const fs::path &dir) {
+    const std::string name = dir.filename().string();
+    if (!is_id(name))
+        return std::nullopt;
+    fs::ifstream in(dir / JOB_FILE);
+    if (!in)
+        return std::nullopt;
+    Download d;
+    d.dir = dir;
+    d.id = static_cast<int>(std::strtoul(name.c_str(), nullptr, 16) & 0x7fffffff);
+    std::string line;
+    while (std::getline(in, line)) {
+        const auto eq = line.find('=');
+        if (eq == std::string::npos)
+            continue;
+        const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+        if (key == "title")
+            d.title = value;
+        else if (key == "url")
+            d.url = value;
+        else if (key == "type")
+            d.type = std::atoi(value.c_str());
+        else if (key == "size")
+            d.size = std::strtoull(value.c_str(), nullptr, 10);
+    }
+    if (d.url.empty())
+        return std::nullopt;
+    if (d.title.empty())
+        d.title = file_name(d.url);
+    return d;
+}
+
+std::string short_title(const std::string &title) {
+    return title.size() > 40 ? title.substr(0, 37) + "..." : title;
+}
+
+// The game's downloads, one after the other, until none is left that this thread hasn't tried
+void worker(fs::path vita_fs) {
+    std::set<int> failed; // tried once here: the launcher tries them again
+    while (true) {
+        {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_more = false;
+        }
+        std::optional<Download> next;
+        int waiting = 0;
+        for (Download &d : list(vita_fs)) {
+            if (d.downloaded() || failed.contains(d.id))
+                continue;
+            if (next)
+                waiting++;
+            else
+                next = d;
+        }
+        if (!next) {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            if (g_more)
+                continue;
+            g_running = false;
+            g_title.clear();
+            return;
+        }
+        {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_title = next->title;
+            g_done = 0;
+            g_size = next->size;
+            g_waiting = waiting;
+        }
+        LOG_INFO("PS4 downloads: downloading {} from {}", next->title, next->url);
+        int logged = -1;
+        const ps4download::Result result = fetch(*next, [&](uint64_t done, uint64_t size) {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_done = done;
+            g_size = size;
+            // in the log every 10%
+            const int tenth = size ? static_cast<int>(done * 10 / size) : 0;
+            if (tenth != logged) {
+                logged = tenth;
+                LOG_INFO("PS4 downloads: {} at {}% ({} of {} MB)", next->title, tenth * 10, done >> 20, size >> 20);
+            }
+            return true;
+        });
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (result.status == ps4download::Status::Done) {
+            LOG_INFO("PS4 downloads: {} downloaded", next->title);
+            g_last = short_title(next->title) + ": downloaded, it installs on the home screen";
+        } else {
+            LOG_ERROR("PS4 downloads: {} didn't download: {}", next->title, result.error);
+            failed.insert(next->id);
+            g_last = short_title(next->title) + " didn't download: " + result.error;
+        }
+        g_last_at = Clock::now();
+    }
+}
+
+} // namespace
+
+fs::path Download::package() const {
+    return dir / file_name(url);
+}
+
+fs::path Download::license() const {
+    return dir / LICENSE_FILE;
+}
+
+bool Download::downloaded() const {
+    // (the package gets its name only when it's whole)
+    const uint64_t have = size_of(package());
+    return have > 0 && (size == 0 || have == size);
+}
+
+int queue(const fs::path &vita_fs, int type, const std::string &url, const std::string &title, const std::vector<uint8_t> &license) {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    const fs::path root = root_of(vita_fs);
+    boost::system::error_code ec;
+    fs::create_directories(root, ec);
+    // one past the highest id there
+    int id = 1;
+    for (fs::directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec)) {
+        const std::string name = it->path().filename().string();
+        if (is_id(name))
+            id = std::max(id, static_cast<int>(std::strtoul(name.c_str(), nullptr, 16) & 0x7ffffffe) + 1);
+    }
+    Download d;
+    d.dir = root / fmt::format("{:08x}", id);
+    d.id = id;
+    d.type = type;
+    d.title = title;
+    d.url = url;
+    ec.clear();
+    fs::create_directories(d.dir, ec);
+    bool saved = !ec;
+    if (saved && !license.empty()) {
+        fs::ofstream out(d.license(), std::ios::binary | std::ios::trunc);
+        out.write(reinterpret_cast<const char *>(license.data()), static_cast<std::streamsize>(license.size()));
+        out.flush();
+        saved = out.good();
+    }
+    saved = saved && save_job(d);
+    if (!saved) {
+        LOG_ERROR("PS4 downloads: {} couldn't be queued in {}", title, d.dir);
+        fs::remove_all(d.dir, ec);
+        return -1;
+    }
+    fs::remove(stop_mark(vita_fs), ec);
+    LOG_INFO("PS4 downloads: queued {} as {:08x} ({}, type {:#x}, license of {} bytes)", title, id, url, type, license.size());
+    return id;
+}
+
+std::vector<Download> list(const fs::path &vita_fs) {
+    std::vector<Download> downloads;
+    boost::system::error_code ec;
+    for (fs::directory_iterator it(root_of(vita_fs), ec), end; !ec && it != end; it.increment(ec)) {
+        boost::system::error_code dir_ec;
+        if (!fs::is_directory(it->path(), dir_ec))
+            continue;
+        if (auto d = load_job(it->path()))
+            downloads.push_back(std::move(*d));
+    }
+    std::sort(downloads.begin(), downloads.end(), [](const Download &a, const Download &b) { return a.id < b.id; });
+    return downloads;
+}
+
+void remove(const Download &d) {
+    boost::system::error_code ec;
+    fs::remove_all(d.dir, ec);
+    if (ec)
+        LOG_WARN("PS4 downloads: {} couldn't be removed: {}", d.dir, ec.message());
+}
+
+bool stopped(const fs::path &vita_fs) {
+    boost::system::error_code ec;
+    return fs::exists(stop_mark(vita_fs), ec);
+}
+
+void set_stopped(const fs::path &vita_fs, bool stop) {
+    boost::system::error_code ec;
+    if (!stop) {
+        fs::remove(stop_mark(vita_fs), ec);
+        return;
+    }
+    fs::create_directories(stop_mark(vita_fs).parent_path(), ec);
+    fs::ofstream(stop_mark(vita_fs), std::ios::trunc);
+}
+
+ps4download::Result fetch(Download &d, const Progress &progress) {
+    if (d.downloaded())
+        return { ps4download::Status::Done, {} };
+    if (d.size == 0) {
+        std::string error;
+        d.size = ps4download::remote_size(d.url, error);
+        if (d.size == 0)
+            return { ps4download::Status::Failed, error };
+        save_job(d);
+    }
+    return ps4download::download(d.url, d.package(), d.size, [&](uint64_t done) { return progress(done, d.size); });
+}
+
+void start(const fs::path &vita_fs) {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_running) {
+        g_more = true;
+        return;
+    }
+    g_running = true;
+    std::thread(worker, vita_fs).detach();
+}
+
+std::string notice() {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_running && !g_title.empty()) {
+        std::string text = "Downloading " + short_title(g_title);
+        if (g_size)
+            text += fmt::format(": {}%", g_done * 100 / g_size);
+        if (g_waiting)
+            text += fmt::format(" (+{} more)", g_waiting);
+        return text;
+    }
+    if (!g_last.empty() && Clock::now() - g_last_at < std::chrono::seconds(15))
+        return g_last;
+    return {};
+}
+
+} // namespace ps4bgdl
+
+// For modules/SceIpmi: the shell's download service
+int ps4_bgdl_queue(const fs::path &vita_fs, int type, const std::string &url, const std::string &title, const std::vector<uint8_t> &license) {
+    return ps4bgdl::queue(vita_fs, type, url, title, license);
+}
+
+void ps4_bgdl_start(const fs::path &vita_fs) {
+    ps4bgdl::start(vita_fs);
+}
+
+// For the renderer: the game's overlay
+std::string ps4_bgdl_notice() {
+    return ps4bgdl::notice();
+}
diff --git a/vita3k/ps4/ps4_bgdl.h b/vita3k/ps4/ps4_bgdl.h
new file mode 100644
index 00000000..0574701a
--- /dev/null
+++ b/vita3k/ps4/ps4_bgdl.h
@@ -0,0 +1,69 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the PS Vita shell's background downloads (ux0:bgdl), which HENkaku does itself. PKGj queues a
+// package with the shell's download service (SceDownload, modules/SceIpmi): it comes down in a thread
+// of its own while the game goes on, carries on in the launcher (HENkaku restarts after every game),
+// and the launcher installs it with the license PKGj gave.
+
+#pragma once
+
+#include "ps4_download.h"
+
+#include <util/fs.h>
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ps4bgdl {
+
+struct Download {
+    fs::path dir; // ux0/bgdl/t/<its id, 8 hex digits>
+    int id = 0;
+    int type = 0; // the shell's: 0x16 game, 0x17 add-on, 0x0C theme
+    std::string title;
+    std::string url;
+    uint64_t size = 0; // once the server said
+
+    fs::path package() const; // where the package goes (a ".part" file until it's whole)
+    fs::path license() const; // the license PKGj gave (none for free content)
+    bool downloaded() const; // the package is there, whole
+};
+
+// Queues one: its id, or -1 if it couldn't be saved. A queued download also undoes a stop.
+int queue(const fs::path &vita_fs, int type, const std::string &url, const std::string &title, const std::vector<uint8_t> &license);
+// The queued downloads, oldest first
+std::vector<Download> list(const fs::path &vita_fs);
+// Forgets one, and what of it came down
+void remove(const Download &d);
+
+// Stopped (Circle in the launcher): the launcher doesn't carry on with them by itself
+bool stopped(const fs::path &vita_fs);
+void set_stopped(const fs::path &vita_fs, bool stop);
+
+// Downloads it, carrying on from what's there; progress(done, size) returning false stops it
+using Progress = std::function<bool(uint64_t done, uint64_t size)>;
+ps4download::Result fetch(Download &d, const Progress &progress);
+
+// In a game: downloads what's queued in a thread of its own, until it's all there
+void start(const fs::path &vita_fs);
+// What that thread is doing, for the game's overlay ("" when there's nothing to say)
+std::string notice();
+
+} // namespace ps4bgdl
diff --git a/vita3k/ps4/ps4_camera.cpp b/vita3k/ps4/ps4_camera.cpp
new file mode 100755
index 00000000..53d0a539
--- /dev/null
+++ b/vita3k/ps4/ps4_camera.cpp
@@ -0,0 +1,243 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the PlayStation Camera for a Vita game's cameras (camera/src/camera.cpp, the "web camera"
+// type). It gives 1280x800 YUV 4:2:2 pictures (Y0 U Y1 V, its left lens); a game asks for 640x480
+// or less, so the middle of the picture at the game's shape is scaled down to it as ARGB. The
+// structures are the PS4 SDK's (as shadPS4 has them): the OpenOrbis header declares the functions
+// without their arguments.
+
+#include <util/log.h>
+
+#include <orbis/Camera.h>
+#include <orbis/Sysmodule.h>
+#include <orbis/UserService.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace {
+
+constexpr int DEVICES = 2;
+constexpr int LEVELS = 4;
+constexpr int WIDTH = 1280;
+constexpr int HEIGHT = 800;
+
+struct OpenParameter {
+    uint32_t size_this;
+    uint32_t reserved[3];
+};
+
+struct Format {
+    uint32_t level[4]; // base: 0 YUV 4:2:2; scaled levels: 0 YUV 4:2:2, 0x10 not used
+};
+
+struct ConfigExtension {
+    Format format;
+    uint32_t resolution;
+    uint32_t framerate;
+    uint32_t width;
+    uint32_t height;
+    uint32_t reserved;
+    void *base_option;
+};
+
+struct Config {
+    uint32_t size_this;
+    uint32_t type; // 1: YUV 4:2:2 at 1280x800, 60 fps
+    ConfigExtension extension[DEVICES];
+};
+
+struct StartParameter {
+    uint32_t size_this;
+    uint32_t format_level[DEVICES]; // bit n: level n
+    void *start_option;
+};
+
+struct FramePosition {
+    uint32_t x, y, width, height;
+};
+
+struct ExposureGain {
+    uint32_t control, exposure, gain, mode;
+};
+
+struct WhiteBalance {
+    uint32_t control, red, blue, green;
+};
+
+struct Gamma {
+    uint32_t control, value;
+    uint8_t reserved[16];
+};
+
+struct Meta {
+    uint32_t mode;
+    uint32_t format[DEVICES][LEVELS];
+    uint64_t frame[DEVICES];
+    uint64_t timestamp[DEVICES];
+    uint32_t device_timestamp[DEVICES];
+    ExposureGain exposure_gain[DEVICES];
+    WhiteBalance white_balance[DEVICES];
+    Gamma gamma[DEVICES];
+    uint32_t luminance[DEVICES];
+    float acceleration[3];
+    uint64_t vcounter;
+    uint32_t reserved[14];
+};
+
+struct FrameData {
+    uint32_t size_this;
+    uint32_t read_mode;
+    FramePosition position[DEVICES][LEVELS];
+    void *frame[DEVICES][LEVELS];
+    uint32_t frame_size[DEVICES][LEVELS];
+    uint32_t status[DEVICES];
+    Meta meta;
+    void *frame_garlic[DEVICES][LEVELS];
+};
+static_assert(sizeof(FrameData) == 584);
+
+using IsAttachedFn = int32_t (*)(int32_t index);
+using OpenFn = int32_t (*)(int32_t user, int32_t type, int32_t index, OpenParameter *param);
+using CloseFn = int32_t (*)(int32_t handle);
+using SetConfigFn = int32_t (*)(int32_t handle, Config *config);
+using StartFn = int32_t (*)(int32_t handle, StartParameter *param);
+using StopFn = int32_t (*)(int32_t handle);
+using GetFrameDataFn = int32_t (*)(int32_t handle, FrameData *data);
+
+std::mutex g_lock;
+int g_users = 0; // the Vita cameras that have it open
+int32_t g_handle = -1;
+bool g_loaded = false;
+std::vector<uint8_t> g_frame; // the last picture, YUV 4:2:2
+uint64_t g_frame_number = 0;
+
+uint8_t clamp8(int v) {
+    return static_cast<uint8_t>(std::clamp(v, 0, 255));
+}
+
+void close_camera() {
+    if (g_handle < 0)
+        return;
+    reinterpret_cast<StopFn>(&sceCameraStop)(g_handle);
+    reinterpret_cast<CloseFn>(&sceCameraClose)(g_handle);
+    g_handle = -1;
+    g_frame.clear();
+}
+
+} // namespace
+
+// Opens the PlayStation Camera for a Vita camera: false if there is none (the caller shows a
+// picture instead)
+extern "C" bool ps4_camera_open() {
+    const std::lock_guard<std::mutex> guard(g_lock);
+    if (g_handle >= 0) {
+        g_users++;
+        return true;
+    }
+    if (!g_loaded) {
+        const int32_t r = sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_CAMERA);
+        if (r != 0)
+            LOG_WARN("PS4 camera: its module didn't load ({:08X})", static_cast<uint32_t>(r));
+        g_loaded = true;
+    }
+    const int32_t attached = reinterpret_cast<IsAttachedFn>(&sceCameraIsAttached)(0);
+    if (attached != 1) {
+        LOG_INFO("PS4 camera: no PlayStation Camera ({:08X})", static_cast<uint32_t>(attached));
+        return false;
+    }
+    int32_t user = -1;
+    sceUserServiceGetInitialUser(&user);
+    OpenParameter open{ sizeof(OpenParameter), {} };
+    const int32_t handle = reinterpret_cast<OpenFn>(&sceCameraOpen)(user, 0, 0, &open);
+    if (handle < 0) {
+        LOG_WARN("PS4 camera: sceCameraOpen failed: {:08X}", static_cast<uint32_t>(handle));
+        return false;
+    }
+    Config config{};
+    config.size_this = sizeof(Config);
+    config.type = 1;
+    int32_t r = reinterpret_cast<SetConfigFn>(&sceCameraSetConfig)(handle, &config);
+    if (r != 0)
+        LOG_WARN("PS4 camera: sceCameraSetConfig failed: {:08X}", static_cast<uint32_t>(r));
+    StartParameter start{ sizeof(StartParameter), { 1, 1 }, nullptr };
+    r = reinterpret_cast<StartFn>(&sceCameraStart)(handle, &start);
+    if (r != 0) {
+        LOG_WARN("PS4 camera: sceCameraStart failed: {:08X}", static_cast<uint32_t>(r));
+        reinterpret_cast<CloseFn>(&sceCameraClose)(handle);
+        return false;
+    }
+    g_handle = handle;
+    g_users = 1;
+    LOG_INFO("PS4 camera: the PlayStation Camera is open (handle {})", handle);
+    return true;
+}
+
+extern "C" void ps4_camera_close() {
+    const std::lock_guard<std::mutex> guard(g_lock);
+    if (g_users > 0 && --g_users == 0)
+        close_camera();
+}
+
+// The camera's newest picture at width x height, as ARGB8888 (pitch width * 4): false while it
+// has given none
+extern "C" bool ps4_camera_read(uint32_t *argb, int width, int height) {
+    const std::lock_guard<std::mutex> guard(g_lock);
+    if (g_handle < 0 || width <= 0 || height <= 0)
+        return false;
+    FrameData data{};
+    data.size_this = sizeof(FrameData);
+    const int32_t r = reinterpret_cast<GetFrameDataFn>(&sceCameraGetFrameData)(g_handle, &data);
+    if (r == 0 && data.frame[0][0] && data.meta.frame[0] != g_frame_number) {
+        g_frame_number = data.meta.frame[0];
+        g_frame.resize(WIDTH * HEIGHT * 2);
+        std::memcpy(g_frame.data(), data.frame[0][0], g_frame.size());
+    }
+    if (g_frame.empty())
+        return false;
+
+    // the middle of the picture at the game's shape
+    int crop_w = WIDTH, crop_h = HEIGHT;
+    if (WIDTH * height > HEIGHT * width)
+        crop_w = HEIGHT * width / height;
+    else
+        crop_h = WIDTH * height / width;
+    const int x0 = (WIDTH - crop_w) / 2;
+    const int y0 = (HEIGHT - crop_h) / 2;
+    for (int y = 0; y < height; y++) {
+        const uint8_t *row = g_frame.data() + static_cast<size_t>(y0 + y * crop_h / height) * WIDTH * 2;
+        uint32_t *out = argb + static_cast<size_t>(y) * width;
+        for (int x = 0; x < width; x++) {
+            const int sx = x0 + x * crop_w / width;
+            const uint8_t *pair = row + (sx & ~1) * 2; // Y0 U Y1 V
+            const int luma = pair[(sx & 1) * 2] - 16;
+            const int u = pair[1] - 128;
+            const int v = pair[3] - 128;
+            // BT.601, limited range
+            const int c = 298 * luma;
+            const uint8_t red = clamp8((c + 409 * v + 128) >> 8);
+            const uint8_t green = clamp8((c - 100 * u - 208 * v + 128) >> 8);
+            const uint8_t blue = clamp8((c + 516 * u + 128) >> 8);
+            out[x] = 0xFF000000u | (red << 16) | (green << 8) | blue;
+        }
+    }
+    return true;
+}
diff --git a/vita3k/ps4/ps4_canvas.cpp b/vita3k/ps4/ps4_canvas.cpp
new file mode 100644
index 00000000..8bee2f7f
--- /dev/null
+++ b/vita3k/ps4/ps4_canvas.cpp
@@ -0,0 +1,904 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the launcher's software canvas. Text comes from the PS Vita's fonts once Vita3K has the
+// font package (sa0/data/font/pvf: Latin, Japanese, Chinese, Korean), else from the PS4's own
+// (/preinst/common/font, where the app may read it: on the test console it couldn't, and v00.04
+// drew no text at all), else from the Roboto in the package (/app0/fonts). Rasterized with
+// stb_truetype (implemented in overlay/src/font.cpp); pictures are decoded with stb_image
+// (renderer/src/texture/replacement.cpp).
+
+#include "ps4_canvas.h"
+
+#include <util/log.h>
+
+#include <stb_image.h>
+#include <stb_truetype.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+
+extern "C" void ps4_boot_trace(const char *line); // port/ps4_crashlog.cpp
+
+namespace ps4ui {
+
+namespace {
+
+struct Font {
+    std::vector<uint8_t> data;
+    stbtt_fontinfo info{};
+};
+
+// A place fonts come from: its Latin fonts (the first it has of each list) and its fonts for other
+// scripts
+struct FontSource {
+    std::string dir;
+    std::vector<const char *> regular;
+    std::vector<const char *> bold;
+    std::vector<const char *> scripts;
+};
+
+struct Glyph {
+    int width = 0;
+    int height = 0;
+    int xoff = 0;
+    int yoff = 0;
+    float advance = 0;
+    std::vector<uint8_t> alpha;
+};
+
+struct FontSet {
+    std::vector<std::shared_ptr<Font>> fonts; // Latin first, then the other scripts
+    std::unordered_map<uint64_t, Glyph> glyphs;
+};
+
+std::mutex fonts_mutex;
+bool fonts_tried = false;
+std::string vita_font_dir; // set_vita_font_dir
+FontSet regular_set;
+FontSet bold_set;
+
+std::shared_ptr<Font> load_font(const std::string &dir, const char *name) {
+    const std::string path = dir + name;
+    FILE *f = std::fopen(path.c_str(), "rb");
+    if (!f)
+        return nullptr;
+    auto font = std::make_shared<Font>();
+    std::fseek(f, 0, SEEK_END);
+    const long size = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    font->data.resize(size > 0 ? static_cast<size_t>(size) : 0);
+    const size_t got = std::fread(font->data.data(), 1, font->data.size(), f);
+    std::fclose(f);
+    if (got != font->data.size() || !stbtt_InitFont(&font->info, font->data.data(), stbtt_GetFontOffsetForIndex(font->data.data(), 0))) {
+        LOG_WARN("PS4 launcher: font {} unreadable", path);
+        return nullptr;
+    }
+    return font;
+}
+
+// The fonts of the first place that has them
+void load_fonts() {
+    if (fonts_tried)
+        return;
+    fonts_tried = true;
+    std::vector<FontSource> sources;
+    if (!vita_font_dir.empty())
+        sources.push_back({ vita_font_dir, { "ltn0.pvf" }, { "ltn4.pvf" }, { "jpn0.pvf", "cn0.pvf", "kr0.pvf" } });
+    sources.push_back({ "/preinst/common/font/", { "SST-Roman.otf", "SST-Medium.otf" }, { "SST-Bold.otf", "SST-Medium.otf" },
+        { "SSTJpPro-Regular.otf", "DFHEI5-SONY.ttf", "SCEPS4Yoongd-Medium.otf" } });
+    sources.push_back({ "/app0/fonts/", { "Roboto-Regular.ttf" }, { "Roboto-Bold.ttf" }, {} });
+
+    const auto first = [](const FontSource &source, const std::vector<const char *> &names) -> std::shared_ptr<Font> {
+        for (const char *name : names) {
+            if (auto font = load_font(source.dir, name))
+                return font;
+        }
+        return nullptr;
+    };
+    std::string line = "launcher: no fonts, so no text";
+    for (const FontSource &source : sources) {
+        const std::shared_ptr<Font> regular = first(source, source.regular);
+        if (!regular)
+            continue;
+        const std::shared_ptr<Font> bold = first(source, source.bold);
+        regular_set.fonts.push_back(regular);
+        bold_set.fonts.push_back(bold ? bold : regular);
+        // (the sets share these: the Chinese font alone is 8 MiB)
+        for (const char *name : source.scripts) {
+            if (auto font = load_font(source.dir, name)) {
+                regular_set.fonts.push_back(font);
+                bold_set.fonts.push_back(font);
+            }
+        }
+        line = fmt::format("launcher: fonts from {} ({} with the other scripts)", source.dir, regular_set.fonts.size());
+        break;
+    }
+    LOG_INFO("PS4 {}", line);
+    ps4_boot_trace(line.c_str());
+}
+
+FontSet &font_set(Weight weight) {
+    load_fonts();
+    return weight == Weight::Bold && !bold_set.fonts.empty() ? bold_set : regular_set;
+}
+
+// Decodes the next code point of a UTF-8 string (U+FFFD for broken sequences)
+char32_t next_code_point(std::string_view s, size_t &i) {
+    const auto c = static_cast<uint8_t>(s[i++]);
+    if (c < 0x80)
+        return c;
+    int extra = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : -1;
+    if (extra < 0)
+        return 0xFFFD;
+    char32_t cp = c & (0x3F >> extra);
+    while (extra-- > 0) {
+        if (i >= s.size() || (static_cast<uint8_t>(s[i]) & 0xC0) != 0x80)
+            return 0xFFFD;
+        cp = (cp << 6) | (static_cast<uint8_t>(s[i++]) & 0x3F);
+    }
+    return cp;
+}
+
+const Glyph *glyph_for(FontSet &set, char32_t cp, int px) {
+    if (set.fonts.empty())
+        return nullptr;
+    size_t font_index = 0;
+    int glyph = 0;
+    for (size_t i = 0; i < set.fonts.size(); i++) {
+        glyph = stbtt_FindGlyphIndex(&set.fonts[i]->info, static_cast<int>(cp));
+        if (glyph) {
+            font_index = i;
+            break;
+        }
+    }
+    const uint64_t key = (static_cast<uint64_t>(font_index) << 48) | (static_cast<uint64_t>(px) << 32) | static_cast<uint32_t>(glyph);
+    auto it = set.glyphs.find(key);
+    if (it != set.glyphs.end())
+        return &it->second;
+    const stbtt_fontinfo &info = set.fonts[font_index]->info;
+    const float scale = stbtt_ScaleForPixelHeight(&info, static_cast<float>(px));
+    Glyph g;
+    int advance = 0, lsb = 0;
+    stbtt_GetGlyphHMetrics(&info, glyph, &advance, &lsb);
+    g.advance = advance * scale;
+    unsigned char *bitmap = stbtt_GetGlyphBitmap(&info, scale, scale, glyph, &g.width, &g.height, &g.xoff, &g.yoff);
+    if (bitmap) {
+        g.alpha.assign(bitmap, bitmap + g.width * g.height);
+        stbtt_FreeBitmap(bitmap, nullptr);
+    }
+    return &set.glyphs.emplace(key, std::move(g)).first->second;
+}
+
+uint32_t pack(Color c) {
+    return static_cast<uint32_t>(c.r) | (static_cast<uint32_t>(c.g) << 8) | (static_cast<uint32_t>(c.b) << 16) | (static_cast<uint32_t>(c.a) << 24);
+}
+
+uint8_t coverage(float v) {
+    return static_cast<uint8_t>(std::clamp(v, 0.f, 1.f) * 255.f + 0.5f);
+}
+
+// x * a / 255, rounded, without a division
+inline uint32_t mul255(uint32_t x, uint32_t a) {
+    const uint32_t t = x * a + 128;
+    return (t + (t >> 8)) >> 8;
+}
+
+// Three threads and the caller share a job's rows, in eight parts so they finish together. Waking
+// them costs some tens of microseconds, so small jobs don't. One job at a time: a second caller
+// meanwhile does its own alone.
+class RowPool {
+public:
+    static constexpr int THREADS = 3;
+    static constexpr int PARTS = 8;
+
+    RowPool() {
+        for (int i = 0; i < THREADS; i++)
+            std::thread([this] { work(); }).detach();
+    }
+
+    bool try_run(int y0, int y1, const std::function<void(int, int)> &fn) {
+        std::unique_lock<std::mutex> busy(run_mutex, std::try_to_lock);
+        if (!busy.owns_lock())
+            return false;
+        {
+            const std::lock_guard<std::mutex> lock(mutex);
+            job = &fn;
+            first = y0;
+            last = y1;
+            next.store(0);
+            done.store(0);
+            generation++;
+        }
+        wake.notify_all();
+        take_parts();
+        std::unique_lock<std::mutex> lock(mutex);
+        finished.wait(lock, [this] { return done.load() == PARTS; });
+        job = nullptr;
+        return true;
+    }
+
+private:
+    void take_parts() {
+        int ran = 0;
+        for (int part; (part = next.fetch_add(1)) < PARTS;) {
+            const int a = first + (last - first) * part / PARTS, b = first + (last - first) * (part + 1) / PARTS;
+            if (a < b)
+                (*job)(a, b);
+            ran++;
+        }
+        if (ran > 0 && done.fetch_add(ran) + ran == PARTS) {
+            const std::lock_guard<std::mutex> lock(mutex);
+            finished.notify_all();
+        }
+    }
+
+    void work() {
+        uint64_t seen = 0;
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                wake.wait(lock, [&] { return generation != seen; });
+                seen = generation;
+            }
+            take_parts();
+        }
+    }
+
+    std::mutex run_mutex;
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::condition_variable finished;
+    const std::function<void(int, int)> *job = nullptr;
+    int first = 0;
+    int last = 0;
+    std::atomic<int> next{ 0 };
+    std::atomic<int> done{ 0 };
+    uint64_t generation = 0;
+};
+
+thread_local bool t_serial = false;
+
+} // namespace
+
+void parallel_rows(int y0, int y1, size_t pixels, const std::function<void(int, int)> &fn) {
+    // (made once, and kept: its threads wait for work for as long as the app runs)
+    static RowPool *const pool = new RowPool;
+    if (y1 - y0 < 16 || pixels < 100000 || t_serial || !pool->try_run(y0, y1, fn))
+        fn(y0, y1);
+}
+
+void set_serial(bool serial) {
+    t_serial = serial;
+}
