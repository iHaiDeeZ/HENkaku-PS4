+// Counts the pages of [ptr, ptr + size) as free; a region none of whose pages is committed any
+// more is unmapped and its direct memory goes back to the free list. (A freed page in a region
+// still in use stays mapped: a stray access to it isn't caught, as it wouldn't be on a Vita.)
+void decommit(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    const size_t first = (ptr - base) / PAGE;
+    const size_t last = (ptr + size - base + PAGE - 1) / PAGE;
+    if (first >= last)
+        return;
+    for (size_t page = first; page < last; page++) {
+        if (page_committed[page]) {
+            page_committed[page] = 0;
+            region_used[page / PAGES_PER_REGION]--;
+            committed -= PAGE;
+        }
+    }
+    for (size_t region = first / PAGES_PER_REGION; region <= (last - 1) / PAGES_PER_REGION; region++) {
+        if (region_phys[region] && region_used[region] == 0) {
+            unmap_to_reserved(base + region * LARGE_PAGE, LARGE_PAGE);
+            free_regions.push_back(region_phys[region] - 1);
+            region_phys[region] = 0;
+        }
+    }
