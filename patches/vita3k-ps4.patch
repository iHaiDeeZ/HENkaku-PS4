+// The path as it is on the host, its names matched without case below base, as the Vita's file
+// system does (a game asks for app0:GOW1.self, which was copied as gow1.self). Empty if none matches.
+fs::path find_case_insensitive(const fs::path &base, const fs::path &relative) {
+    fs::path found = base;
+    for (const auto &part : relative) {
+        if (part.empty() || part == "/" || part == ".")
+            continue;
+        boost::system::error_code ec;
+        if (fs::exists(found / part, ec)) {
+            found /= part;
+            continue;
+        }
+        const std::string wanted = string_utils::tolower(fs_utils::path_to_utf8(part));
+        bool matched = false;
+        for (fs::directory_iterator it(found, ec), end; !ec && it != end; it.increment(ec)) {
+            if (string_utils::tolower(fs_utils::path_to_utf8(it->path().filename())) == wanted) {
+                found = it->path();
+                matched = true;
+                break;
+            }
+        }
+        if (!matched)
+            return {};
+    }
+    return found;
+}
