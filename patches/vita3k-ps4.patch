+// What a tile draws with, made the first time it's on screen
+struct TileArt {
+    ps4ui::Image bubble;
+    ps4ui::Image mini; // in the status bar, while its LiveArea is open
+    ps4ui::TextSprite label;
+};
+
+// An animated value pulled toward a target (underdamped: it overshoots a little and settles)
+struct Spring {
+    float pos = 0;
+    float vel = 0;
+    void step(float target, float dt, float stiffness, float damping) {
+        const float c = 2.f * damping * std::sqrt(stiffness);
+        const int n = std::max(1, static_cast<int>(std::ceil(dt / 0.004f)));
+        const float h = dt / n;
+        for (int i = 0; i < n; i++) {
+            vel += (stiffness * (target - pos) - c * vel) * h;
+            pos += vel * h;
+        }
+        if (std::fabs(target - pos) < 0.0005f && std::fabs(vel) < 0.002f) {
+            pos = target;
+            vel = 0;
+        }
+    }
+    bool moving(float target) const { return pos != target || vel != 0; }
+};
+
+float ms_since(Clock::time_point t, Clock::time_point now) {
+    return std::chrono::duration<float, std::milli>(now - t).count();
+}
+
+// A pressed bubble: it gives (to 0.88) and springs back past its size
+float press_scale(float ms) {
+    if (ms < 0)
+        return 1.f;
+    if (ms < 90.f)
+        return 1.f - 0.12f * ms / 90.f;
+    const float t = ms - 90.f;
+    return 1.f - 0.12f * std::exp(-t / 90.f) * std::cos(t / 52.f);
+}
+
+// The bubbles coming in, one after another, from nothing to a little more than their size
+float appear_scale(float ms) {
+    if (ms <= 0)
+        return 0.f;
+    return std::max(0.f, 1.f - std::exp(-ms / 75.f) * std::cos(ms / 60.f));
+}
+
+// The home screen's animated state
+struct HomeView {
+    int page = 0;
+    Spring rows[3]; // the page each row is at: they follow one another, the jelly of a page turn
+    Clock::time_point row_go[3]{};
+    float row_target[3] = {};
+    std::vector<float> focus; // per tile, 0..1
+    int pressed = -1;
+    Clock::time_point press_at{};
+    Clock::time_point appear_at{};
+    bool appearing = false;
+};
+
+void home_go_to_page(HomeView &v, int page, Clock::time_point now) {
+    if (page == v.page)
+        return;
+    const int dir = page > v.page ? 1 : -1;
+    v.page = page;
+    // the row on the side it moves to goes first
+    for (int r = 0; r < 3; r++) {
+        const int order = dir > 0 ? r : 2 - r;
+        v.row_go[r] = now + std::chrono::milliseconds(40 * order);
+        v.row_target[r] = static_cast<float>(page);
+    }
+}
+
+// Steps the home screen's animations; whether anything still moves
+bool home_animate(HomeView &v, int tile_count, int focused, float dt, Clock::time_point now) {
+    bool moving = false;
+    for (int r = 0; r < 3; r++) {
+        const float target = now >= v.row_go[r] ? v.row_target[r] : v.rows[r].pos;
+        v.rows[r].step(target, dt, 150.f, 0.62f);
+        moving |= v.rows[r].moving(v.row_target[r]);
+    }
+    v.focus.resize(static_cast<size_t>(tile_count), 0.f);
+    const float k = 1.f - std::exp(-dt * 16.f);
+    for (int i = 0; i < tile_count; i++) {
+        const float target = i == focused ? 1.f : 0.f;
+        float &f = v.focus[i];
+        f += (target - f) * k;
+        if (std::fabs(target - f) < 0.01f)
+            f = target;
+        else
+            moving = true;
+    }
+    if (v.pressed >= 0) {
+        if (ms_since(v.press_at, now) > 700.f)
+            v.pressed = -1;
+        else
+            moving = true;
+    }
+    if (v.appearing) {
+        if (ms_since(v.appear_at, now) > 30.f * PER_PAGE + 700.f)
+            v.appearing = false;
+        else
+            moving = true;
+    }
+    return moving;
+}
+
+// The home screen, its left edge at ox
+void draw_home(Canvas &c, HomeView &v, const std::vector<Tile> &tiles, const std::function<TileArt &(int)> &art, int ox, Clock::time_point now) {
+    c.copy_from(vita_wallpaper(), ox);
+    const int count = static_cast<int>(tiles.size());
+    const int pages = std::max(1, (count + PER_PAGE - 1) / PER_PAGE);
+    const ps4ui::Image &glow = focus_glow();
+    // the focused bubble last, over its neighbours
+    for (int pass = 0; pass < 2; pass++) {
+        for (int slot = 0; slot < PER_PAGE; slot++) {
+            const Slot &s = SLOTS[slot];
+            const float pos = v.rows[s.row].pos;
+            for (int page = static_cast<int>(std::floor(pos)); page <= static_cast<int>(std::floor(pos)) + 1; page++) {
+                const int index = page * PER_PAGE + slot;
+                if (page < 0 || index >= count)
+                    continue;
+                const float focus = index < static_cast<int>(v.focus.size()) ? v.focus[index] : 0.f;
+                if ((focus > 0.5f) != (pass == 1))
+                    continue;
+                const float y = s.y + (page - pos) * H;
+                if (y < -SPRITE || y > H + SPRITE)
+                    continue;
+                const float x = s.x + ox;
+                float scale = 1.f + 0.08f * focus;
+                if (v.pressed == index)
+                    scale *= press_scale(ms_since(v.press_at, now));
+                uint8_t alpha = 255;
+                if (v.appearing) {
+                    const float a = appear_scale(ms_since(v.appear_at, now) - 30.f * slot);
+                    scale *= a;
+                    alpha = static_cast<uint8_t>(std::clamp(a * 2.f, 0.f, 1.f) * 255);
+                }
+                if (scale < 0.02f)
+                    continue;
+                TileArt &t = art(index);
+                if (focus > 0.01f)
+                    c.blit_scaled(glow, x, y, scale, static_cast<uint8_t>(focus * alpha));
+                c.blit_scaled(t.bubble, x, y, scale, alpha);
+                const ps4ui::Image &label = t.label.image;
+                c.blit(label, static_cast<int>(x) - label.width / 2, static_cast<int>(y + BUBBLE_R * scale + 36) - t.label.baseline, alpha);
+            }
+        }
+    }
+    // the pages, as dots down the right edge
+    if (pages > 1) {
+        const float dots_x = ox + W - 40.f;
+        const float y0 = H / 2.f - (pages - 1) * 19.f;
+        const float at = v.rows[1].pos;
+        for (int p = 0; p < pages; p++) {
+            const float near = std::clamp(1.f - std::fabs(at - p), 0.f, 1.f);
+            c.fill_circle(dots_x, y0 + p * 38.f, 6.f + 4.f * near, rgb(0xffffff, static_cast<uint8_t>(110 + 140 * near)));
+        }
+    }
+}
