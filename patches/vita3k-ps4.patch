+#include <overlay/touch_indicator.h>
+
+#include <algorithm>
+
+namespace overlay {
+
+touch_indicator::touch_indicator() {
+    visible = true;
+    for (int i = 0; i < k_max_points; i++) {
+        m_outer[i].back_color = { 1.f, 1.f, 1.f, 0.45f };
+        m_outer[i].set_size(k_outer, k_outer);
+        m_inner[i].back_color = { 0.f, 0.f, 0.f, 0.25f };
+        m_inner[i].set_size(k_inner, k_inner);
+    }
+}
+
+void touch_indicator::set_points(const float *xy, const int count) {
+    m_count = std::clamp(count, 0, k_max_points);
+    for (int i = 0; i < m_count; i++) {
+        const float x = std::clamp(xy[i * 2], 0.f, 1.f) * virtual_width;
+        const float y = std::clamp(xy[i * 2 + 1], 0.f, 1.f) * virtual_height;
+        m_outer[i].set_pos(static_cast<int16_t>(x - k_outer / 2), static_cast<int16_t>(y - k_outer / 2));
+        m_inner[i].set_pos(static_cast<int16_t>(x - k_inner / 2), static_cast<int16_t>(y - k_inner / 2));
+    }
+}
+
+compiled_resource touch_indicator::get_compiled() {
+    compiled_resource result;
+    if (!visible)
+        return result;
+    for (int i = 0; i < m_count; i++) {
+        result.add(m_outer[i].get_compiled());
+        result.add(m_inner[i].get_compiled());
+    }
+    return result;
+}
+
+} // namespace overlay
