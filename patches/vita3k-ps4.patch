+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#pragma once
+
+// PS4: where HENkaku's render thread spends its time (HENkaku > Diagnostics > Renderer profiler):
+// the time of each kind of command, each kind of state set, and the parts of a draw, counted with
+// the TSC on the render thread and logged every 10 s by vita3k/ps4/ps4_main.cpp. Timing, not
+// sampling: a signal sampler on this thread broke a wait of the GPU driver and froze HENkaku.
+
+#include <atomic>
+#include <cstdint>
+
+namespace renderer::ps4stats {
+
+enum Phase {
+    PhasePipeline, // finding (or compiling) the pipeline
+    PhaseUniforms, // the shader info uniforms
+    PhaseDescriptors, // the uniform buffers and textures bound
+    PhaseIndices, // the index data copied
+    PhaseVertices, // the vertex streams copied (and repacked)
+    PhaseRecord, // the draw recorded
+    PhaseCount
+};
+
+constexpr int MAX_KINDS = 32;
+
+// Written by the render thread only, read by the perf line
+inline std::atomic<bool> enabled{ false };
+inline std::atomic<uint64_t> command_ticks[MAX_KINDS];
+inline std::atomic<uint64_t> command_count[MAX_KINDS];
+inline std::atomic<uint64_t> state_ticks[MAX_KINDS];
+inline std::atomic<uint64_t> state_count[MAX_KINDS];
+inline std::atomic<uint64_t> phase_ticks[PhaseCount];
+
+inline void add(std::atomic<uint64_t> &counter, uint64_t value) {
+    counter.store(counter.load(std::memory_order_relaxed) + value, std::memory_order_relaxed);
+}
+
+// Adds the time from its start to its end (or to next()) to a counter, when the profiler is on
+class Timer {
+public:
+    explicit Timer(std::atomic<uint64_t> &counter, std::atomic<uint64_t> *count = nullptr)
+        : counter(&counter)
+        , count(count)
+        , on(enabled.load(std::memory_order_relaxed))
+        , start(on ? __builtin_ia32_rdtsc() : 0) {}
+    ~Timer() { stop(); }
+    // ends this part and starts the next one
+    void next(std::atomic<uint64_t> &next_counter) {
+        stop();
+        counter = &next_counter;
+        count = nullptr;
+        start = on ? __builtin_ia32_rdtsc() : 0;
+    }
+    void stop() {
+        if (!on || !counter)
+            return;
+        add(*counter, __builtin_ia32_rdtsc() - start);
+        if (count)
+            add(*count, 1);
+        counter = nullptr;
+    }
+
+private:
+    std::atomic<uint64_t> *counter;
+    std::atomic<uint64_t> *count;
+    bool on;
+    uint64_t start;
+};
+
+} // namespace renderer::ps4stats
