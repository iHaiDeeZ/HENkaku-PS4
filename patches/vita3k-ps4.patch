+
+// A bubble as the Vita's: the icon in a circle (its edge a little shaded), a thin light rim and a
+// soft light around it, premultiplied
+ps4ui::Image make_bubble(const ps4ui::Image &icon, Color fill) {
+    ps4ui::Image out;
+    out.width = out.height = SPRITE;
+    out.pixels.resize(static_cast<size_t>(SPRITE) * SPRITE);
+    const float c = SPRITE / 2.f, R = BUBBLE_R;
+    const int ix0 = (ICON_SIZE - icon.width) / 2 + SPRITE_PAD, iy0 = (ICON_SIZE - icon.height) / 2 + SPRITE_PAD;
+    for (int y = 0; y < SPRITE; y++) {
+        for (int x = 0; x < SPRITE; x++) {
+            const float px = x + 0.5f - c, py = y + 0.5f - c;
+            const float d = std::sqrt(px * px + py * py);
+            // the light around it (white)
+            const float out_d = std::max(0.f, d - R);
+            const float halo = d > R - 1 ? 0.42f * std::exp(-out_d * out_d / 55.f) : 0.f;
+            const float cov = std::clamp(R - d + 0.5f, 0.f, 1.f);
+            float r = fill.r, g = fill.g, b = fill.b;
+            if (cov > 0) {
+                const int sx = x - ix0, sy = y - iy0;
+                if (!icon.empty() && sx >= 0 && sy >= 0 && sx < icon.width && sy < icon.height) {
+                    const uint32_t p = icon.pixels[static_cast<size_t>(sy) * icon.width + sx];
+                    const float a = (p >> 24) / 255.f;
+                    r = r * (1 - a) + (p & 0xFF) * a;
+                    g = g * (1 - a) + ((p >> 8) & 0xFF) * a;
+                    b = b * (1 - a) + ((p >> 16) & 0xFF) * a;
+                }
+                // its edge a little shaded, lit again just inside the rim (the glass), then the rim:
+                // a light line along it
+                const float shade = 0.14f * smoothstep(R * 0.74f, R * 0.94f, d);
+                r *= 1 - shade;
+                g *= 1 - shade;
+                b *= 1 - shade;
+                const float inner = 0.22f * smoothstep(R - 12.f, R - 2.f, d);
+                r += (255 - r) * inner;
+                g += (255 - g) * inner;
+                b += (255 - b) * inner;
+                const float rim = std::clamp(2.2f - std::fabs(d - (R - 2.0f)), 0.f, 1.f) * 0.78f;
+                r += (255 - r) * rim;
+                g += (255 - g) * rim;
+                b += (255 - b) * rim;
+            }
+            // (the halo is white: premultiplied, its colour is its alpha)
+            const float halo_a = halo * (1 - cov);
+            const float a = cov + halo_a;
+            out.pixels[static_cast<size_t>(y) * SPRITE + x] = static_cast<uint32_t>(r * cov + 255 * halo_a + 0.5f) | (static_cast<uint32_t>(g * cov + 255 * halo_a + 0.5f) << 8)
+                | (static_cast<uint32_t>(b * cov + 255 * halo_a + 0.5f) << 16) | (static_cast<uint32_t>(a * 255 + 0.5f) << 24);
+        }
+    }
+    return out;
+}
+
+// The focus: a soft light-blue glow around a bubble, premultiplied
+const ps4ui::Image &focus_glow() {
+    static ps4ui::Image out = [] {
+        ps4ui::Image img;
+        img.width = img.height = SPRITE;
+        img.pixels.resize(static_cast<size_t>(SPRITE) * SPRITE);
+        const float c = SPRITE / 2.f;
+        for (int y = 0; y < SPRITE; y++) {
+            for (int x = 0; x < SPRITE; x++) {
+                const float d = std::hypot(x + 0.5f - c, y + 0.5f - c);
+                const float k = (d - (BUBBLE_R + 5)) / 7.f;
+                const float a = d < BUBBLE_R - 1 ? 0.f : std::exp(-k * k) * 0.95f;
+                const uint32_t A = static_cast<uint32_t>(a * 255);
+                img.pixels[static_cast<size_t>(y) * SPRITE + x] = (0x9f * A / 255) | ((0xe0 * A / 255) << 8) | ((0xff * A / 255) << 16) | (A << 24);
+            }
+        }
+        return img;
+    }();
+    return out;
+}
+
+// What a tile draws with, made the first time it's on screen
+struct TileArt {
+    ps4ui::Image bubble;
+    ps4ui::Image mini; // in the status bar, while its LiveArea is open
+    ps4ui::TextSprite label;
+};
+
+// An animated value pulled toward a target (underdamped: it overshoots a little and settles)
+struct Spring {
+    float pos = 0;
+    float vel = 0;
+    void step(float target, float dt, float stiffness, float damping) {
+        const float c = 2.f * damping * std::sqrt(stiffness);
+        const int n = std::max(1, static_cast<int>(std::ceil(dt / 0.004f)));
+        const float h = dt / n;
+        for (int i = 0; i < n; i++) {
+            vel += (stiffness * (target - pos) - c * vel) * h;
+            pos += vel * h;
+        }
+        if (std::fabs(target - pos) < 0.0005f && std::fabs(vel) < 0.002f) {
+            pos = target;
+            vel = 0;
+        }
+    }
+    bool moving(float target) const { return pos != target || vel != 0; }
+};
+
+float ms_since(Clock::time_point t, Clock::time_point now) {
+    return std::chrono::duration<float, std::milli>(now - t).count();
+}
+
+// A pressed bubble: it gives (to 0.88) and springs back past its size
+float press_scale(float ms) {
+    if (ms < 0)
+        return 1.f;
+    if (ms < 90.f)
+        return 1.f - 0.12f * ms / 90.f;
+    const float t = ms - 90.f;
+    return 1.f - 0.12f * std::exp(-t / 90.f) * std::cos(t / 52.f);
+}
+
+// The bubbles coming in, one after another, from nothing to a little more than their size
+float appear_scale(float ms) {
+    if (ms <= 0)
+        return 0.f;
+    return std::max(0.f, 1.f - std::exp(-ms / 75.f) * std::cos(ms / 60.f));
+}
+
+// The home screen's animated state
+struct HomeView {
+    int page = 0;
+    Spring rows[3]; // the page each row is at: they follow one another, the jelly of a page turn
+    Clock::time_point row_go[3]{};
+    float row_target[3] = {};
+    std::vector<float> focus; // per tile, 0..1
+    int pressed = -1;
+    Clock::time_point press_at{};
+    Clock::time_point appear_at{};
+    bool appearing = false;
+};
+
+void home_go_to_page(HomeView &v, int page, Clock::time_point now) {
+    if (page == v.page)
+        return;
+    const int dir = page > v.page ? 1 : -1;
+    v.page = page;
+    // the row on the side it moves to goes first
+    for (int r = 0; r < 3; r++) {
+        const int order = dir > 0 ? r : 2 - r;
+        v.row_go[r] = now + std::chrono::milliseconds(40 * order);
+        v.row_target[r] = static_cast<float>(page);
+    }
+}
+
+// Steps the home screen's animations; whether anything still moves
+bool home_animate(HomeView &v, int tile_count, int focused, float dt, Clock::time_point now) {
+    bool moving = false;
+    for (int r = 0; r < 3; r++) {
+        const float target = now >= v.row_go[r] ? v.row_target[r] : v.rows[r].pos;
+        v.rows[r].step(target, dt, 150.f, 0.62f);
+        moving |= v.rows[r].moving(v.row_target[r]);
+    }
+    v.focus.resize(static_cast<size_t>(tile_count), 0.f);
+    const float k = 1.f - std::exp(-dt * 16.f);
+    for (int i = 0; i < tile_count; i++) {
+        const float target = i == focused ? 1.f : 0.f;
+        float &f = v.focus[i];
+        f += (target - f) * k;
+        if (std::fabs(target - f) < 0.01f)
+            f = target;
+        else
+            moving = true;
+    }
+    if (v.pressed >= 0) {
+        if (ms_since(v.press_at, now) > 700.f)
+            v.pressed = -1;
+        else
+            moving = true;
+    }
+    if (v.appearing) {
+        if (ms_since(v.appear_at, now) > 30.f * PER_PAGE + 700.f)
+            v.appearing = false;
+        else
+            moving = true;
+    }
+    return moving;
+}
+
+// The home screen, its left edge at ox
+void draw_home(Canvas &c, HomeView &v, const std::vector<Tile> &tiles, const std::function<TileArt &(int)> &art, int ox, Clock::time_point now) {
+    c.copy_from(vita_wallpaper(), ox);
+    const int count = static_cast<int>(tiles.size());
+    const int pages = std::max(1, (count + PER_PAGE - 1) / PER_PAGE);
+    const ps4ui::Image &glow = focus_glow();
+    // the focused bubble last, over its neighbours
+    for (int pass = 0; pass < 2; pass++) {
+        for (int slot = 0; slot < PER_PAGE; slot++) {
+            const Slot &s = SLOTS[slot];
+            const float pos = v.rows[s.row].pos;
+            for (int page = static_cast<int>(std::floor(pos)); page <= static_cast<int>(std::floor(pos)) + 1; page++) {
+                const int index = page * PER_PAGE + slot;
+                if (page < 0 || index >= count)
+                    continue;
+                const float focus = index < static_cast<int>(v.focus.size()) ? v.focus[index] : 0.f;
+                if ((focus > 0.5f) != (pass == 1))
+                    continue;
+                const float y = s.y + (page - pos) * H;
+                if (y < -SPRITE || y > H + SPRITE)
+                    continue;
+                const float x = s.x + ox;
+                float scale = 1.f + 0.08f * focus;
+                if (v.pressed == index)
+                    scale *= press_scale(ms_since(v.press_at, now));
+                uint8_t alpha = 255;
+                if (v.appearing) {
+                    const float a = appear_scale(ms_since(v.appear_at, now) - 30.f * slot);
+                    scale *= a;
+                    alpha = static_cast<uint8_t>(std::clamp(a * 2.f, 0.f, 1.f) * 255);
+                }
+                if (scale < 0.02f)
+                    continue;
+                TileArt &t = art(index);
+                if (focus > 0.01f) {
+                    // (the focus breathes)
+                    const float breath = 0.78f + 0.22f * std::sin(ms_since(Clock::time_point{}, now) / 260.f);
+                    c.blit_scaled(glow, x, y, scale, static_cast<uint8_t>(focus * breath * alpha));
+                }
+                c.blit_scaled(t.bubble, x, y, scale, alpha);
+            }
+        }
+    }
+    // the pages, as dots down the right edge (the firmware's, else drawn)
+    if (pages > 1) {
+        const float dots_x = ox + W - 40.f;
+        const float y0 = H / 2.f - (pages - 1) * 19.f;
+        const float at = v.rows[1].pos;
+        const ps4ui::Image *dot = ps4shell::picture(ps4shell::Picture::PageDot);
+        for (int p = 0; p < pages; p++) {
+            const float near = std::clamp(1.f - std::fabs(at - p), 0.f, 1.f);
+            if (dot)
+                c.blit_scaled(*dot, dots_x, y0 + p * 38.f, 1.3f + 0.4f * near, static_cast<uint8_t>(120 + 135 * near));
+            else
+                c.fill_circle(dots_x, y0 + p * 38.f, 6.f + 4.f * near, rgb(0xffffff, static_cast<uint8_t>(110 + 140 * near)));
+        }
+    }
+}
+
+// The status bar as the Vita's: black, the network at the left (the firmware's icon), in the middle
+// the home screen and the open LiveAreas (the one on screen bright), the time at the right (a PS TV's,
+// without a battery); what's missing of the firmware before the time
+void status_bar(Canvas &c, const app::FirmwareState &fw, const std::vector<const ps4ui::Image *> &cards, float card_pos) {
+    c.fill_rect(0, 0, W, STATUS_H, rgb(0x000000));
+    if (const ps4ui::Image *wifi = ps4shell::picture(ps4shell::Picture::Wifi))
+        c.blit_scaled(*wifi, 44.f, STATUS_H / 2.f, 1.9f);
+    // home, then the cards, 60 px apart
+    const ps4ui::Image *home = ps4shell::picture(ps4shell::Picture::Home);
+    const int n = static_cast<int>(cards.size()) + 1;
+    const float x0 = W / 2.f - (n - 1) * 30.f;
+    for (int i = 0; i < n; i++) {
+        const float near = std::clamp(1.f - std::fabs(card_pos - i), 0.f, 1.f);
+        const uint8_t a = static_cast<uint8_t>(110 + 145 * near);
+        const float cx = x0 + i * 60.f;
+        if (i == 0 && home)
+            c.blit_scaled(*home, cx, STATUS_H / 2.f, 0.5f, a);
+        else if (i == 0)
+            home_glyph(c, cx, STATUS_H / 2.f, rgb(0xffffff, a));
+        else if (!cards[i - 1]->empty())
+            c.blit(*cards[i - 1], static_cast<int>(cx) - cards[i - 1]->width / 2, STATUS_H / 2 - cards[i - 1]->height / 2, a);
+    }
+    int right = W - 34;
+    const std::string time = clock_text();
+    right -= c.text_width(time, 30, Weight::Bold);
+    c.text(right, 43, time, 30, TEXT, Weight::Bold);
+    if (!fw.main_firmware || !fw.font_package) {
+        const std::string missing = !fw.main_firmware ? "No PS Vita firmware" : "No font package";
+        right -= c.text_width(missing, 22, Weight::Bold) + 40;
+        c.fill_circle(right - 16.f, 35.f, 7.f, WARN);
+        c.text(right, 42, missing, 22, WARN, Weight::Bold);
+    }
+}
+
+// --- a game's LiveArea ---
+
+// The Vita's LiveArea styles (template.xml's style): where the gate and each frame are, as the
+// distances of their top left corner from the right and the bottom of the 960x544 screen, and their
+// sizes (as Vita3K has them)
+struct LiveLayout {
+    float x, y, w, h;
+};
+struct LiveStyle {
+    const char *name;
+    float gate_x, gate_y;
+    std::vector<std::pair<std::string, LiveLayout>> frames;
+};
+const std::vector<LiveStyle> &live_styles() {
+    static const std::vector<LiveStyle> styles = {
+        { "a1", 620, 361, { { "frame1", { 900, 414, 260, 260 } }, { "frame2", { 320, 414, 260, 260 } }, { "frame3", { 900, 154, 840, 150 } } } },
+        { "a2", 620, 395, { { "frame1", { 900, 404, 260, 400 } }, { "frame2", { 320, 404, 260, 400 } }, { "frame3", { 640, 204, 320, 200 } } } },
+        { "a3", 620, 395, { { "frame1", { 900, 414, 260, 200 } }, { "frame2", { 320, 414, 260, 200 } }, { "frame3", { 900, 214, 260, 210 } }, { "frame4", { 640, 214, 320, 210 } }, { "frame5", { 320, 214, 260, 210 } } } },
+        { "a4", 620, 395, { { "frame1", { 900, 414, 260, 200 } }, { "frame2", { 320, 414, 260, 200 } }, { "frame3", { 900, 214, 840, 70 } }, { "frame4", { 900, 144, 840, 70 } }, { "frame5", { 900, 74, 840, 70 } } } },
+        { "a5", 380, 395, { { "frame1", { 900, 412, 480, 68 } }, { "frame2", { 900, 344, 480, 68 } }, { "frame3", { 900, 276, 480, 68 } }, { "frame4", { 900, 208, 480, 68 } }, { "frame5", { 900, 140, 480, 68 } }, { "frame6", { 900, 72, 480, 68 } }, { "frame7", { 420, 214, 360, 210 } } } },
+        { "psmobile", 380, 345, { { "frame1", { 866, 414, 446, 154 } }, { "frame2", { 866, 249.5f, 446, 109 } }, { "frame3", { 866, 119, 196, 58 } }, { "frame4", { 866, 34, 772, 30 } } } },
+    };
+    return styles;
+}
+const LiveStyle &live_style(const std::string &name) {
+    for (const LiveStyle &style : live_styles())
+        if (name == style.name)
+            return style;
+    return live_styles().front();
+}
+
+// The Vita's screen on ours: 960x544 scaled to our height, centered
+constexpr float LIVE_SCALE = static_cast<float>(H) / 544.f;
+constexpr float LIVE_X = (W - 960.f * LIVE_SCALE) / 2.f;
+struct LiveRect {
+    int x, y, w, h;
+};
+LiveRect live_rect(float vx, float vy, float vw, float vh) {
+    return { static_cast<int>(LIVE_X + vx * LIVE_SCALE), static_cast<int>(vy * LIVE_SCALE), static_cast<int>(vw * LIVE_SCALE), static_cast<int>(vh * LIVE_SCALE) };
+}
+// The gate: 280x158 on the Vita
+LiveRect gate_rect(const Item &item) {
+    const LiveStyle &style = live_style(item.livearea_style);
+    return live_rect(960.f - style.gate_x, 544.f - style.gate_y, 280.f, 158.f);
+}
+
+std::string strip_spaces(std::string s) {
+    s.erase(std::remove_if(s.begin(), s.end(), [](unsigned char ch) { return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'; }), s.end());
+    return s;
+}
+
+// Whether a node is for English: a <lang>en</lang> child or a <cntry lang="en"> one
+bool is_english(const pugi::xml_node &node) {
+    for (const pugi::xml_node lang : node.children("lang")) {
+        const std::string value = lang.child_value();
+        if (value == "en" || value == "en-gb" || value == "en-us")
+            return true;
+    }
+    const std::string cntry = node.child("cntry").attribute("lang").as_string();
+    return cntry == "en" || cntry == "en-gb" || cntry == "en-us";
+}
+
+// The file a node names, with a version per language: English's, else the default one's
+// ("default" on), else the first
+std::string pick_language(const pugi::xml_node &parent, const char *name) {
+    std::string english, preferred, fallback;
+    for (const pugi::xml_node node : parent.children(name)) {
+        const std::string text = strip_spaces(node.child_value());
+        if (text.empty())
+            continue;
+        if (fallback.empty())
+            fallback = text;
+        if (english.empty() && is_english(node))
+            english = text;
+        if (preferred.empty() && std::string(node.attribute("default").as_string()) == "on")
+            preferred = text;
+    }
+    return !english.empty() ? english : !preferred.empty() ? preferred : fallback;
+}
+
+// -1, 0 or 1 for left / top, centre, right / bottom
+int align_of(const char *value) {
+    const std::string v = value;
+    if (v == "left" || v == "top")
+        return -1;
+    if (v == "right" || v == "bottom")
+        return 1;
+    return 0;
+}
+
+// A picture of the template, at most the size of a box (in our pixels), and no bigger than the
+// Vita would show it
+ps4ui::Image live_image(const fs::path &contents, std::string name, int max_w, int max_h) {
+    if (name.empty())
+        return {};
+    std::replace(name.begin(), name.end(), '\\', '/');
+    std::string path = fs_utils::path_to_utf8(contents / name);
+    boost::system::error_code ec;
+    if (!fs::exists(path, ec)) {
+        // (the Vita doesn't tell case apart: startup_spanish.PNG)
+        const fs::path found = vfs::find_case_insensitive(contents, name);
+        if (found.empty())
+            return {};
+        path = fs_utils::path_to_utf8(found);
+    }
+    int w = 0, h = 0;
+    if (!ps4ui::image_size(path, w, h))
+        return {};
+    const float scale = std::min({ LIVE_SCALE, static_cast<float>(max_w) / w, static_cast<float>(max_h) / h });
+    return ps4ui::load_image(path, std::max(1, static_cast<int>(w * scale)), std::max(1, static_cast<int>(h * scale)));
+}
+
+void ensure_livearea(Item &item, const fs::path &app_dir) {
+    if (item.livearea_loaded)
+        return;
+    item.livearea_loaded = true;
+    const fs::path contents = app_dir / "sce_sys" / "livearea" / "contents";
+    const LiveRect panel = live_rect(60, 44, 840, 500);
+    boost::system::error_code ec;
+    pugi::xml_document doc;
+    if (doc.load_file(fs_utils::path_to_utf8(contents / "template.xml").c_str())) {
+        const pugi::xml_node livearea = doc.child("livearea");
+        item.livearea_style = livearea.attribute("style").as_string("a1");
+        const LiveStyle &style = live_style(item.livearea_style);
+        item.livearea_bg = live_image(contents, pick_language(livearea.child("livearea-background"), "image"), panel.w, panel.h);
+        const LiveRect gate = gate_rect(item);
+        item.livearea_gate = live_image(contents, pick_language(livearea.child("gate"), "startup-image"), gate.w, gate.h);
+        // the frames the style has: each one's first live item (English's, if they differ by language)
+        for (const pugi::xml_node frame : livearea.children("frame")) {
+            const std::string id = frame.attribute("id").as_string();
+            const auto layout = std::find_if(style.frames.begin(), style.frames.end(), [&](const auto &f) { return f.first == id; });
+            if (layout == style.frames.end())
+                continue;
+            pugi::xml_node chosen;
+            for (const pugi::xml_node live : frame.children("liveitem")) {
+                if (is_english(live)) {
+                    chosen = live;
+                    break;
+                }
+                if (!chosen || std::string(live.attribute("default").as_string()) == "on")
+                    chosen = live;
+            }
+            if (!chosen)
+                continue;
+            const LiveRect r = live_rect(960.f - layout->second.x, 544.f - layout->second.y, layout->second.w, layout->second.h);
+            Item::LiveFrame f;
+            f.id = id;
+            f.background = live_image(contents, strip_spaces(chosen.child("background").child_value()), r.w, r.h);
+            f.image = live_image(contents, strip_spaces(chosen.child("image").child_value()), r.w, r.h);
+            const pugi::xml_node image = chosen.child("image");
+            f.image_align.x = align_of(image.attribute("align").as_string("center"));
+            f.image_align.y = align_of(image.attribute("valign").as_string("center"));
+            if (image.attribute("x") || image.attribute("y")) {
+                f.image_align.offset = true;
+                f.image_align.offset_x = image.attribute("x").as_float(0.f);
+                f.image_align.offset_y = image.attribute("y").as_float(0.f);
+            }
+            const pugi::xml_node text = chosen.child("text");
+            f.text_align.x = align_of(text.attribute("text-align").as_string(text.attribute("align").as_string("center")));
+            f.text_align.y = align_of(text.attribute("text-valign").as_string(text.attribute("valign").as_string("center")));
+            if (std::string(text.attribute("origin").as_string()) == "image") {
+                const std::string beside = text.attribute("align").as_string();
+                f.text_align.outside = beside == "outside-right" ? 1 : beside == "outside-left" ? -1 : 0;
+                if (f.text_align.outside != 0) {
+                    f.text_align.x = -f.text_align.outside;
+                    f.text_align.y = 0;
+                }
+            }
+            f.text_align.margin_left = text.attribute("margin-left").as_float(0.f);
+            f.text_align.margin_right = text.attribute("margin-right").as_float(0.f);
+            f.text_align.margin_top = text.attribute("margin-top").as_float(0.f);
+            f.text_align.margin_bottom = text.attribute("margin-bottom").as_float(0.f);
+            for (const pugi::xml_node str : text.children("str")) {
+                Item::LiveText t;
+                t.text = str.text().as_string();
+                std::string color = str.attribute("color").as_string();
+                if (!color.empty() && color[0] == '#')
+                    color.erase(0, 1);
+                t.color = color.empty() ? 0xFFFFFF : static_cast<uint32_t>(std::strtoul(color.c_str(), nullptr, 16));
+                t.size = str.attribute("size").as_float(0.f);
+                t.bold = std::string(str.attribute("bold").as_string()) == "on";
+                if (!t.text.empty())
+                    f.texts.push_back(std::move(t));
+            }
+            item.live_frames.push_back(std::move(f));
+        }
+    }
+    // without a template (or without its pictures): the usual names
+    if (item.livearea_bg.empty()) {
+        for (const char *name : { "bg0.png", "bg.png" }) {
+            if (fs::exists(contents / name, ec)) {
+                item.livearea_bg = live_image(contents, name, panel.w, panel.h);
+                break;
+            }
+        }
+    }
+    if (item.livearea_gate.empty() && fs::exists(contents / "startup.png", ec)) {
+        const LiveRect gate = gate_rect(item);
+        item.livearea_gate = live_image(contents, "startup.png", gate.w, gate.h);
+    }
+}
+
+// Lines of a text in a box, wrapped to its width, as many as fit, aligned as the template says
+void live_text(Canvas &c, const LiveRect &box, const std::string &text, int px, Color color, int align_x, int align_y, Weight weight) {
+    std::vector<std::string> lines;
+    std::string line, word;
+    const auto flush_word = [&] {
+        if (word.empty())
+            return;
+        const std::string tried = line.empty() ? word : line + " " + word;
+        if (!line.empty() && c.text_width(tried, px) > box.w - 8) {
+            lines.push_back(line);
+            line = word;
+        } else {
+            line = tried;
+        }
+        word.clear();
+    };
+    for (const char ch : text) {
+        if (ch == '\n') {
+            flush_word();
+            lines.push_back(line);
+            line.clear();
+        } else if (ch == ' ') {
+            flush_word();
+        } else {
+            word += ch;
+        }
+    }
+    flush_word();
+    if (!line.empty())
+        lines.push_back(line);
+    const int line_h = px * 5 / 4;
+    const int shown = std::max(1, std::min(static_cast<int>(lines.size()), box.h / line_h));
+    const int block = shown * line_h;
+    int y = (align_y < 0 ? box.y : align_y > 0 ? box.y + box.h - block : box.y + (box.h - block) / 2) + px;
+    for (int i = 0; i < shown; i++, y += line_h) {
+        const int width = c.text_width(lines[i], px, weight);
+        const int x = align_x < 0 ? box.x : align_x > 0 ? box.x + box.w - width : box.x + (box.w - width) / 2;
+        c.text(x + 2, y + 2, lines[i], px, rgb(0x000000, 140), weight);
+        c.text(x, y, lines[i], px, color, weight);
+    }
+}
+
+// A picture stretched to w x h with its corners (corner px of it) kept, scaled as the LiveArea is: a
+// button
+ps4ui::Image nine_slice(const ps4ui::Image &src, int w, int h, int corner) {
+    ps4ui::Image out;
+    out.width = w;
+    out.height = h;
+    out.pixels.resize(static_cast<size_t>(w) * h);
+    const int scaled = std::max(1, static_cast<int>(corner * LIVE_SCALE));
+    const auto map = [&](int d, int size, int src_size) {
+        if (d < scaled)
+            return d * corner / scaled;
+        if (d >= size - scaled)
+            return src_size - corner + (d - (size - scaled)) * corner / scaled;
+        return corner + (d - scaled) * (src_size - 2 * corner) / std::max(1, size - 2 * scaled);
+    };
+    for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++)
+            out.pixels[static_cast<size_t>(y) * w + x] = src.pixels[static_cast<size_t>(std::clamp(map(y, h, src.height), 0, src.height - 1)) * src.width + std::clamp(map(x, w, src.width), 0, src.width - 1)];
+    return out;
+}
+
+// A game's LiveArea as on the Vita: its background, its frames of pictures and text, and the gate
+// (the start picture with Start under it), over the wallpaper
+void draw_livearea(Canvas &c, Item &item) {
+    c.copy_from(vita_wallpaper());
+    c.fill_rect(0, 0, W, H, rgb(0x000000, 90));
+    const LiveRect panel = live_rect(60, 44, 840, 500);
+    c.fill_rect(panel.x, panel.y, panel.w, panel.h, rgb(0x94a4ad));
+    if (!item.livearea_bg.empty())
+        c.draw_image(item.livearea_bg, panel.x + (panel.w - item.livearea_bg.width) / 2, panel.y + (panel.h - item.livearea_bg.height) / 2);
+
+    const LiveStyle &style = live_style(item.livearea_style);
+    for (const Item::LiveFrame &frame : item.live_frames) {
+        const auto layout = std::find_if(style.frames.begin(), style.frames.end(), [&](const auto &f) { return f.first == frame.id; });
+        if (layout == style.frames.end())
+            continue;
+        const LiveRect r = live_rect(960.f - layout->second.x, 544.f - layout->second.y, layout->second.w, layout->second.h);
+        if (!frame.background.empty())
+            c.draw_image(frame.background, r.x + (r.w - frame.background.width) / 2, r.y + (r.h - frame.background.height) / 2);
+        // (where the picture went: a text may go beside it)
+        LiveRect picture{ 0, 0, 0, 0 };
+        if (!frame.image.empty()) {
+            const auto place = [](int align, int at, int room, int size) { return align < 0 ? at : align > 0 ? at + room - size : at + (room - size) / 2; };
+            int ix = place(frame.image_align.x, r.x, r.w, frame.image.width), iy = place(frame.image_align.y, r.y, r.h, frame.image.height);
+            if (frame.image_align.offset) {
+                ix = r.x + r.w / 2 + static_cast<int>(frame.image_align.offset_x * LIVE_SCALE) - frame.image.width / 2;
+                iy = r.y + r.h / 2 - static_cast<int>(frame.image_align.offset_y * LIVE_SCALE) - frame.image.height / 2;
+            }
+            c.draw_image(frame.image, ix, iy);
+            picture = { ix, iy, frame.image.width, frame.image.height };
+        }
+        if (!frame.texts.empty()) {
+            const Item::LiveText &t = frame.texts.front();
+            const int px = std::max(18, static_cast<int>((t.size > 0 ? t.size : 12.f) * LIVE_SCALE * 0.75f));
+            const Item::LiveAlign &a = frame.text_align;
+            LiveRect box = { r.x + static_cast<int>(a.margin_left * LIVE_SCALE), r.y + static_cast<int>(a.margin_top * LIVE_SCALE),
+                std::max(40, r.w - static_cast<int>((a.margin_left + a.margin_right) * LIVE_SCALE)),
+                std::max(px, r.h - static_cast<int>((a.margin_top + a.margin_bottom) * LIVE_SCALE)) };
+            if (a.outside != 0 && picture.w > 0) {
+                const int gap = static_cast<int>(12 * LIVE_SCALE);
+                box = a.outside > 0 ? LiveRect{ picture.x + picture.w + gap, picture.y, std::max(40, r.x + r.w - (picture.x + picture.w + gap)), picture.h }
+                                    : LiveRect{ r.x, picture.y, std::max(40, picture.x - gap - r.x), picture.h };
+            }
+            live_text(c, box, t.text, px, rgb(t.color), a.x, a.y, t.bold ? Weight::Bold : Weight::Regular);
+        }
+    }
+
+    // the gate: the start picture (or the game's icon), its frame, and Start
+    const LiveRect gate = gate_rect(item);
+    c.fill_round_rect(gate.x - 4, gate.y - 4, gate.w + 8, gate.h + 8, 22, rgb(0xc0c0c0));
+    c.fill_round_rect(gate.x, gate.y, gate.w, gate.h, 18, rgb(0x2f3332));
+    ensure_icons(item);
+    const ps4ui::Image &picture = !item.livearea_gate.empty() ? item.livearea_gate : item.large;
+    if (!picture.empty())
+        c.draw_image(picture, gate.x + (gate.w - picture.width) / 2, gate.y + (gate.h - picture.height) / 2);
+    const int bw = static_cast<int>(120 * LIVE_SCALE), bh = static_cast<int>(32 * LIVE_SCALE);
+    const int bx = gate.x + (gate.w - bw) / 2, by = gate.y + gate.h - bh - static_cast<int>(8 * LIVE_SCALE);
+    if (const ps4ui::Image *button = ps4shell::picture(ps4shell::Picture::StartButton))
+        c.blit(nine_slice(*button, bw, bh, 14), bx, by);
+    else
+        c.fill_round_rect(bx, by, bw, bh, 18, rgb(0x14a8de));
+    c.text_centered(bx + bw / 2, by + bh / 2 + 15, "Start", 40, rgb(0xffffff), Weight::Bold);
+
+    // the top right corner, folded down along its diagonal: the LiveArea peels from there (Triangle).
+    // u, v: from the panel's right edge and its top; the corner (u + v < fold) shows what's behind the
+    // card, the flap (its mirror across the fold) the card's light back, darker toward the fold
+    const int fold = static_cast<int>(34 * LIVE_SCALE), right = panel.x + panel.w, top = panel.y;
+    const uint32_t *behind = vita_wallpaper().data();
+    uint32_t *px = c.data();
+    for (int v = 0; v < fold; v++) {
+        for (int u = 0; u < fold; u++) {
+            const int x = right - 1 - u, y = top + v;
+            if (x < 0 || y < 0 || x >= W || y >= H)
+                continue;
+            const size_t at = static_cast<size_t>(y) * W + x;
+            if (u + v < fold) {
+                px[at] = behind[at];
+            } else {
+                const float t = static_cast<float>(u + v - fold) / fold; // 0 at the fold
+                const uint32_t g = static_cast<uint32_t>(198 + 50 * t);
+                px[at] = g | (g << 8) | (std::min(255u, g + 6) << 16) | 0xFF000000u;
+            }
+        }
+    }
+}
+
+// A card peeled away from its top right corner, `d` px along the diagonal (0 to W + H): over
+// what `frame` already has under it. The fold runs at 45 degrees; the peeled corner lies folded
+// back over the card, its white back shaded toward the fold.
+void peel(Canvas &frame, const Canvas &card, float d) {
+    uint32_t *dst = frame.data();
+    const uint32_t *src = card.data();
+    const auto darken = [](uint32_t p, uint32_t keep) {
+        const uint32_t rb = (((p & 0x00FF00FFu) * keep) >> 8) & 0x00FF00FFu;
+        const uint32_t g = (((p & 0x0000FF00u) * keep) >> 8) & 0x0000FF00u;
+        return rb | g | 0xFF000000u;
+    };
+    for (int y = 0; y < H; y++) {
+        uint32_t *row = dst + static_cast<size_t>(y) * W;
+        const uint32_t *from = src + static_cast<size_t>(y) * W;
+        // right of the fold: what's under the card
+        const int fold = std::clamp(static_cast<int>(W + y - d), 0, W);
+        const int flap = y <= d ? std::clamp(static_cast<int>(std::max(W + y - 2 * d, W - d)), 0, fold) : fold;
+        std::memcpy(row, from, static_cast<size_t>(flap) * 4);
+        // the flap's shadow on the card
+        for (int x = std::max(0, flap - 22); x < flap; x++)
+            row[x] = darken(row[x], 150 + (flap - x) * 105 / 22);
+        for (int x = flap; x < fold; x++) {
+            const float t = std::clamp((fold - x) / std::max(1.f, d), 0.f, 1.f);
+            const uint32_t v = static_cast<uint32_t>(246 - 70 * t);
+            row[x] = v | (v << 8) | (std::min(255u, v + 8) << 16) | 0xFF000000u;
+        }
+        // the fold's shadow on what's under
+        for (int x = fold; x < std::min(W, fold + 26); x++)
+            row[x] = darken(row[x], 140 + (x - fold) * 115 / 26);
+    }
+}
+
+// --- the HENkaku settings, in the launcher ---
+
+using SItem = ps4settings::Item;
+
+struct SettingsLevel {
+    const std::vector<SItem> *items = nullptr;
+    std::string name;
+    int selected = 0;
+    int top = 0;
+};
+
+struct SettingsView {
+    // whose: "All games", or a game's name
+    std::string scope;
+    std::vector<SItem> root;
+    std::vector<SettingsLevel> stack;
+};
+
+constexpr int SET_Y = 236;
+constexpr int SET_ROW = 76;
+constexpr int SET_SECTION = 62;
+constexpr int SET_H = 740;
+
+bool settings_selectable(const SItem &item) {
+    return item.type != SItem::kind::section;
+}
+
+// To the next line that can be picked, up (-1) or down
+void settings_move(SettingsLevel &level, int step) {
+    const auto &items = *level.items;
+    for (int i = level.selected + step; i >= 0 && i < static_cast<int>(items.size()); i += step) {
+        if (settings_selectable(items[i])) {
+            level.selected = i;
+            return;
+        }
+    }
+    if (level.selected < static_cast<int>(items.size()) && !settings_selectable(items[level.selected])) {
+        for (int i = 0; i < static_cast<int>(items.size()); i++) {
+            if (settings_selectable(items[i])) {
+                level.selected = i;
+                return;
+            }
+        }
+    }
+}
+
+void settings_open(SettingsView &view, std::string scope, std::vector<SItem> root) {
+    view.scope = std::move(scope);
+    view.root = std::move(root);
+    view.stack.clear();
+    view.stack.push_back({ &view.root, {}, 0, 0 });
+    settings_move(view.stack.back(), 1);
+}
+
+int choice_value(const SItem &item) {
+    const int count = static_cast<int>(item.values.size());
+    return (count > 0 && item.get) ? std::clamp(item.get(), 0, count - 1) : -1;
+}
+
+// Left / right on a choice: its previous / next value
+void settings_change(const SItem &item, int step) {
+    const int count = static_cast<int>(item.values.size());
+    if (item.type != SItem::kind::choice || count == 0 || !item.set)
+        return;
+    item.set((std::max(choice_value(item), 0) + step + count) % count);
+}
+
+void draw_settings(Canvas &c, SettingsView &view, const ps4ui::Image &henkaku) {
+    static const Canvas made = [] {
+        Canvas c(W, H);
+        c.clear_gradient(rgb(0x10203c), rgb(0x03060d));
+        c.fill_circle(1700, -120, 620, rgb(0x2a6fd6, 22));
+        return c;
+    }();
+    c.copy_from(made);
+    // the heading: the ensō, HENkaku, whose settings and which page
+    int tx = MARGIN;
+    if (!henkaku.empty()) {
+        c.draw_image(henkaku, MARGIN, 60);
+        tx += henkaku.width + 30;
+    }
+    c.text(tx, 122, "HENkaku", 66, TEXT, Weight::Bold);
+    std::string path = view.scope;
+    for (size_t i = 1; i < view.stack.size(); i++)
+        path += "   >   " + view.stack[i].name;
+    c.text(tx + 4, 176, path, 32, ACCENT, Weight::Regular, W - tx - MARGIN);
+    c.fill_rect(MARGIN, 206, W - 2 * MARGIN, 2, rgb(0xffffff, 30));
+
+    SettingsLevel &level = view.stack.back();
+    const auto &items = *level.items;
+    const int count = static_cast<int>(items.size());
+    const auto height_of = [&](int i) { return items[i].type == SItem::kind::section ? SET_SECTION : SET_ROW; };
+    const auto span = [&](int first, int last) {
+        int h = 0;
+        for (int i = first; i <= last; i++)
+            h += height_of(i);
+        return h;
+    };
+    // the selection in view, with its section's heading when that's right above it
+    if (level.selected < level.top)
+        level.top = level.selected;
+    if (level.top > 0 && level.top == level.selected && items[level.top - 1].type == SItem::kind::section)
+        level.top--;
+    while (level.top < level.selected && span(level.top, level.selected) > SET_H)
+        level.top++;
+
+    int y = SET_Y;
+    int last = level.top - 1;
+    for (int i = level.top; i < count; i++) {
+        const int h = height_of(i);
+        if (y + h > SET_Y + SET_H)
+            break;
+        last = i;
+        const SItem &item = items[i];
+        if (item.type == SItem::kind::section) {
+            c.text(MARGIN + 6, y + 44, item.name, 26, ACCENT, Weight::Bold);
+            y += h;
+            continue;
+        }
+        const bool sel = i == level.selected;
+        c.fill_round_rect(MARGIN, y, W - 2 * MARGIN, h - 10, 18, sel ? rgb(0x2a6fd6, 120) : rgb(0xffffff, 14));
+        if (sel)
+            c.fill_round_rect(MARGIN, y + 16, 6, h - 42, 3, ACCENT);
+        const int right = W - MARGIN - 38;
+        // the value first: the name, then its note, get the room left of it (cut with "...")
+        std::string value_text;
+        int value_px = 30;
+        if (item.type == SItem::kind::choice) {
+            const int value = choice_value(item);
+            value_text = value < 0 ? std::string() : item.set ? "<   " + item.values[value] + "   >" : item.values[value];
+        } else if (item.type == SItem::kind::page) {
+            value_text = ">";
+            value_px = 28;
+        }
+        const int value_w = value_text.empty() ? 0 : std::min(c.text_width(value_text, value_px, Weight::Bold), (W - 2 * MARGIN) / 2);
+        const int name_room = right - (value_w ? value_w + 40 : 0) - (MARGIN + 38);
+        const int name_w = c.text(MARGIN + 38, y + 47, item.name, 32, TEXT, sel ? Weight::Bold : Weight::Regular, name_room);
+        const int note_x = MARGIN + 38 + name_w + 18, note_room = right - (value_w ? value_w + 40 : 0) - note_x;
+        if (item.type == SItem::kind::choice && !item.note.empty() && note_room > 120)
+            c.text(note_x, y + 45, item.note, 24, MUTED, Weight::Regular, note_room);
+        if (item.type == SItem::kind::choice)
+            c.text(right - value_w, y + 46, value_text, value_px, sel ? TEXT : ACCENT, Weight::Bold, value_w);
+        else if (item.type == SItem::kind::page)
+            c.text(right - value_w, y + 46, value_text, value_px, MUTED);
+        y += h;
+    }
+    // more above or below
+    if (level.top > 0)
+        c.text_centered(W / 2, SET_Y - 8, "...", 30, MUTED, Weight::Bold);
+    if (last + 1 < count)
+        c.text_centered(W / 2, SET_Y + SET_H + 26, "...", 30, MUTED, Weight::Bold);
+}
+
+// Who made HENkaku: the ensō, the name, the author and where to find them, and what it runs on
+void draw_about(Canvas &c, const ps4ui::Image &henkaku) {
+    c.copy_from(vita_wallpaper());
+    c.fill_rect(0, 0, W, H, rgb(0x000000, 120));
+    const int pw = 1360, ph = 700, px = (W - pw) / 2, py = (H - ph) / 2 - 20;
+    c.fill_round_rect(px, py, pw, ph, 36, rgb(0x0b0f18, 235));
+    if (!henkaku.empty())
+        c.draw_image(henkaku, px + 70, py + (ph - henkaku.height) / 2);
+    const int tx = px + 70 + 420 + 70, tw = px + pw - 60 - tx;
+    c.text(tx, py + 150, "HENkaku", 92, TEXT, Weight::Bold);
+    c.text(tx + 6, py + 206, "PS Vita games on the PS4   " + version_text(), 32, MUTED);
+    c.fill_rect(tx, py + 248, tw, 2, rgb(0xffffff, 30));
+    c.text(tx, py + 320, "Made by", 28, ACCENT, Weight::Bold);
+    c.text(tx, py + 372, ps4settings::AUTHOR, 48, TEXT, Weight::Bold);
+    c.text(tx, py + 424, ps4settings::AUTHOR_GITHUB, 34, rgb(0xc8d6ee));
+    c.fill_rect(tx, py + 470, tw, 2, rgb(0xffffff, 30));
+    c.text_wrapped(tx, py + 530, "Powered by Vita3K, the PS Vita emulator (GPL-2.0 or later), and Mesa RADV on the PS4's GPU. The ensō is HENkaku's, by team molecule.",
+        28, MUTED, tw, 42);
+}
