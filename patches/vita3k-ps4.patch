     return UNIMPLEMENTED();
 }
@@ -37,6 +52,84 @@ struct BufferInfo {
     SceSize bufferWrittenSize; // size written by method
 };
 
+struct DataInfo {
+    Ptr<const void> pData;
+    SceSize dataSize;
+};
+
+// The shell's download service (SceDownload): the clients made for it. PKGj queues a package with
+// method 0x12340012 (its parameters below; the download's id comes back in the second output
+// buffer), then 0x12340007 sets the queue going. On PS4 HENkaku downloads it itself.
+static std::mutex download_clients_mutex;
+static std::set<Address> download_clients;
+
+struct DownloadParam {
+    int32_t type[2]; // 0x16 game, 0x17 add-on, 0x0C theme, 0x06 PSM, 0x00 PSP
+    char unk_08[0x68];
+    char url[0x800];
+    char icon_path[0x100];
+    char title[0x33A];
+    char license_path[0x100]; // the license, which the download keeps a copy of
+    char unk_daa[0x16];
+};
+static_assert(sizeof(DownloadParam) == 0xDC0);
+
+static bool is_download_client(Address client) {
+    const std::lock_guard<std::mutex> lock(download_clients_mutex);
+    return download_clients.contains(client);
+}
+
+static std::string bounded(const char *text, size_t size) {
+    return std::string(text, strnlen(text, size));
+}
+
+static int download_method(EmuEnvState &emuenv, uint32_t method, const DataInfo *in, uint32_t in_count, int32_t *result, BufferInfo *out, uint32_t out_count) {
+    int32_t ret = 0;
+    switch (method) {
+    case 0x12340012: { // queue a download
+        const DownloadParam *param = (in && in_count >= 1 && in[0].dataSize >= sizeof(DownloadParam)) ? in[0].pData.cast<const DownloadParam>().get(emuenv.mem) : nullptr;
+        if (!param) {
+            ret = SCE_KERNEL_ERROR_ILLEGAL_ADDR;
+            break;
+        }
+        const std::string url = bounded(param->url, sizeof(param->url));
+        const std::string title = bounded(param->title, sizeof(param->title));
+        const std::string license_path = bounded(param->license_path, sizeof(param->license_path));
+        std::vector<uint8_t> license;
+        if (!license_path.empty()) {
+            fs::ifstream file(expand_path(emuenv.io, license_path.c_str(), emuenv.vita_fs_path), std::ios::binary);
+            license.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+        }
+        LOG_INFO("SceDownload: queue {} ({}), type {}, license {} ({} bytes)", title, url, log_hex(param->type[0]), license_path, license.size());
+#ifdef __PS4__
+        const int id = ps4_bgdl_queue(emuenv.vita_fs_path, param->type[0], url, title, license);
+#else
+        const int id = -1;
+#endif
+        if (id < 0) {
+            ret = SCE_KERNEL_ERROR_ERROR;
+            break;
+        }
+        if (out && out_count >= 2 && out[1].bufferSize >= sizeof(int32_t) && out[1].pBuffer) {
+            *out[1].pBuffer.cast<int32_t>().get(emuenv.mem) = id;
+            out[1].bufferWrittenSize = sizeof(int32_t);
+        }
+        break;
+    }
+    case 0x12340007: // the queue goes
+#ifdef __PS4__
+        ps4_bgdl_start(emuenv.vita_fs_path);
+#endif
+        break;
+    default:
+        LOG_WARN("SceDownload: method {} not handled", log_hex(method));
+        break;
+    }
+    if (result)
+        *result = ret;
+    return 0;
+}
+
