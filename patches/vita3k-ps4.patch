index 00000000..4cb2f9cf
--- /dev/null
+++ b/vita3k/ps4/ps4_launcher.cpp
@@ -0,0 +1,1336 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the launcher, in place of the desktop's Qt window: the installed apps with their icons, and
+// an install browser (Triangle) over /data/Vita3K/install, the PS4's storage and USB drives: .vpk
+// and .zip archives, .pkg files with their zRIF or .rif license, dumped game folders, the PS Vita
+// firmware and font package .PUP files. When the firmware or the font package isn't installed, it
+// downloads them from Sony's update server first. Drawn by the CPU into VideoOut buffers 12-13, so
+// it needs no Vulkan; the renderer's swapchain takes over the screen with its first flip.
+
+#include "ps4_launcher.h"
+
+#include "ps4_canvas.h"
+#include "ps4_download.h"
+#include "ps4_pad.h"
+#include "ps4_wsi.h"
+
+#include "archive.h"
+
+#include <app/functions.h>
+#include <app/state.h>
+#include <emuenv/state.h>
+#include <io/vfs.h>
+#include <packages/functions.h>
+#include <packages/license.h>
+#include <packages/pkg.h>
+#include <packages/sfo.h>
+#include <util/fs.h>
+#include <util/log.h>
+#include <util/string_utils.h>
+
+#include <orbis/Pad.h>
+#include <orbis/SystemService.h>
+#include <orbis/VideoOut.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <iterator>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <thread>
+
+extern "C" {
+// (the OpenOrbis prototypes of these are wrong)
+int32_t ps4l_allocate_direct(off_t start, off_t end, size_t len, size_t align, int32_t type, off_t *phys) __asm__("sceKernelAllocateDirectMemory");
+int32_t ps4l_map_direct(void **addr, size_t len, int32_t prot, int32_t flags, off_t phys, size_t align) __asm__("sceKernelMapDirectMemory");
+size_t ps4l_direct_memory_size() __asm__("sceKernelGetDirectMemorySize");
+void ps4_boot_trace(const char *line); // port/ps4_crashlog.cpp
+}
+
+namespace ps4launcher {
+
+using ps4ui::Canvas;
+using ps4ui::Color;
+using ps4ui::rgb;
+using ps4ui::Weight;
+using Clock = std::chrono::steady_clock;
+
+namespace {
+
+constexpr int W = 1920;
+constexpr int H = 1080;
+constexpr size_t BUFFER_SIZE = 8ull << 20; // 1920x1080x4 rounded up to 2 MiB pages
+constexpr int32_t WC_GARLIC = 3; // write-combined, what the display reads
+constexpr int32_t PROT_CPU_GPU_RW = 0x33;
+
+// layout
+constexpr int MARGIN = 96;
+constexpr int LIST_X = MARGIN;
+constexpr int LIST_W = 1040;
+constexpr int LIST_Y = 206;
+constexpr int ROW_H = 108;
+constexpr int VISIBLE_ROWS = 7;
+constexpr int ICON = 88;
+constexpr int PANEL_X = 1210;
+constexpr int PANEL_W = W - MARGIN - PANEL_X;
+constexpr int BIG_ICON = 300;
+
+const Color TEXT = rgb(0xf2f5fb);
+const Color MUTED = rgb(0x9aa6bd);
+const Color ACCENT = rgb(0x5fc4ff);
+const Color OK = rgb(0x4fe0b0);
+const Color WARN = rgb(0xffb35c);
+
+std::string version_text() {
+    static std::string version = [] {
+        std::string v;
+        if (FILE *f = std::fopen("/app0/version.txt", "r")) {
+            char line[32] = {};
+            if (std::fgets(line, sizeof(line), f))
+                v = line;
+            std::fclose(f);
+        }
+        while (!v.empty() && (v.back() == '\n' || v.back() == '\r' || v.back() == ' '))
+            v.pop_back();
+        return v.empty() ? std::string("dev") : "v" + v;
+    }();
+    return version;
+}
+
+// --- the screen ---
+
+uint8_t *buffers[2] = {};
+bool registered = false;
+bool splash_hidden = false;
+int current = 0;
+
+// (in boot-trace.log as well: whether the launcher ever reached the screen)
+void screen_trace(const std::string &line) {
+    LOG_INFO("PS4 launcher: {}", line);
+    ps4_boot_trace(("launcher: " + line).c_str());
+}
+
+bool setup_buffers() {
+    if (registered)
+        return true;
+    static bool failed = false; // once: it doesn't get better
+    if (failed)
+        return false;
+    const int video = ps4wsi_video_handle();
+    if (video < 0) {
+        screen_trace(fmt::format("no VideoOut ({:08X})", static_cast<uint32_t>(video)));
+        failed = true;
+        return false;
+    }
+    off_t phys = 0;
+    void *base = nullptr;
+    const int32_t allocated = ps4l_allocate_direct(0, static_cast<off_t>(ps4l_direct_memory_size()), 2 * BUFFER_SIZE, 2 << 20, WC_GARLIC, &phys);
+    const int32_t mapped = allocated != 0 ? -1 : ps4l_map_direct(&base, 2 * BUFFER_SIZE, PROT_CPU_GPU_RW, 0, phys, 2 << 20);
+    if (allocated != 0 || mapped != 0) {
+        screen_trace(fmt::format("no direct memory for the screen ({:08X} {:08X})", static_cast<uint32_t>(allocated), static_cast<uint32_t>(mapped)));
+        failed = true;
+        return false;
+    }
+    buffers[0] = static_cast<uint8_t *>(base);
+    buffers[1] = static_cast<uint8_t *>(base) + BUFFER_SIZE;
+    void *addresses[2] = { buffers[0], buffers[1] };
+    OrbisVideoOutBufferAttribute attribute;
+    sceVideoOutSetBufferAttribute(&attribute, ORBIS_VIDEO_OUT_PIXEL_FORMAT_A8B8G8R8_SRGB, ORBIS_VIDEO_OUT_TILING_MODE_LINEAR, 0, W, H, W);
+    const int set = sceVideoOutRegisterBuffers(video, ps4wsi::LAUNCHER_FIRST_BUFFER, addresses, 2, &attribute);
+    if (set < 0) {
+        screen_trace(fmt::format("sceVideoOutRegisterBuffers failed: {:08X}", static_cast<uint32_t>(set)));
+        failed = true;
+        return false;
+    }
+    registered = true;
+    screen_trace(fmt::format("screen ready (VideoOut {}, buffers {}-{})", video, ps4wsi::LAUNCHER_FIRST_BUFFER, ps4wsi::LAUNCHER_FIRST_BUFFER + 1));
+    return true;
+}
+
+void present(const Canvas &canvas) {
+    if (!setup_buffers())
+        return;
+    std::memcpy(buffers[current], canvas.data(), static_cast<size_t>(W) * H * 4);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST); // write-combined stores out before the flip
+    const int flip = sceVideoOutSubmitFlip(ps4wsi_video_handle(), ps4wsi::LAUNCHER_FIRST_BUFFER + current, ORBIS_VIDEO_OUT_FLIP_VSYNC, 0);
+    if (!splash_hidden) {
+        screen_trace(fmt::format("first frame (flip {:08X})", static_cast<uint32_t>(flip)));
+        // the system shows the app's splash picture until the app has one of its own
+        sceSystemServiceHideSplashScreen();
+        splash_hidden = true;
+    }
+    current ^= 1;
+}
+
+void background(Canvas &c) {
+    c.clear_gradient(rgb(0x0d2347), rgb(0x04070f));
+    // the Vita's bubbles, faintly
+    c.fill_circle(1660, 210, 420, rgb(0x2a6fd6, 18));
+    c.fill_circle(1500, 900, 300, rgb(0x5fc4ff, 12));
+    c.fill_circle(240, 1040, 260, rgb(0x2a6fd6, 14));
+}
+
+void header(Canvas &c, const app::FirmwareState &fw) {
+    const int x = c.text(MARGIN, 128, "Vita3K", 76, TEXT, Weight::Bold);
+    c.text(MARGIN + x + 18, 128, "for PS4", 38, ACCENT);
+    const std::string version = version_text();
+    c.text(W - MARGIN - c.text_width(version, 28), 92, version, 28, MUTED);
+    // firmware status chips, right to left
+    int right = W - MARGIN;
+    const auto chip = [&](const std::string &label, bool good) {
+        const int tw = c.text_width(label, 24, Weight::Bold);
+        const int cw = tw + 52;
+        right -= cw;
+        c.fill_round_rect(right, 112, cw, 40, 20, good ? rgb(0x123a2e) : rgb(0x3f2a12));
+        c.fill_circle(right + 22.f, 132.f, 7.f, good ? OK : WARN);
+        c.text(right + 38, 141, label, 24, good ? OK : WARN, Weight::Bold);
+        right -= 14;
+    };
+    chip(fw.font_package ? "Fonts" : "No fonts", fw.font_package);
+    chip(fw.main_firmware ? "Firmware" : "No firmware", fw.main_firmware);
+    c.fill_rect(MARGIN, 172, W - 2 * MARGIN, 2, rgb(0xffffff, 28));
+}
+
+enum class Pad {
+    Cross,
+    Circle,
+    Square,
+    Triangle,
+    Options,
+};
+
+struct Hint {
+    Pad button;
+    std::string label;
+};
+
+// What the buttons do on this screen, left to right
+void footer(Canvas &c, const std::vector<Hint> &hints) {
+    int x = MARGIN;
+    const int y = 1024;
+    for (const Hint &hint : hints) {
+        switch (hint.button) {
+        case Pad::Cross:
+            c.cross_button(x + 20.f, y - 10.f, 20.f);
+            x += 50;
+            break;
+        case Pad::Circle:
+            c.circle_button(x + 20.f, y - 10.f, 20.f);
+            x += 50;
+            break;
+        case Pad::Square:
+            c.square_button(x + 20.f, y - 10.f, 20.f);
+            x += 50;
+            break;
+        case Pad::Triangle:
+            c.triangle_button(x + 20.f, y - 10.f, 20.f);
+            x += 50;
+            break;
+        case Pad::Options:
+            c.pill_button(x, y - 10, "OPTIONS", 22);
+            x += c.text_width("OPTIONS", 22, Weight::Bold) + 40;
+            break;
+        }
+        x += c.text(x, y, hint.label, 30, TEXT) + 48;
+    }
+}
+
+// --- the apps ---
+
+struct Item {
+    app::AppEntry entry;
+    bool icons_loaded = false;
+    ps4ui::Image small;
+    ps4ui::Image large;
+};
+
+std::vector<Item> load_items(EmuEnvState &emuenv) {
+    std::vector<Item> items;
+    for (auto &entry : app::get_apps(emuenv)) {
+        Item item;
+        item.entry = std::move(entry);
+        items.push_back(std::move(item));
+    }
+    std::sort(items.begin(), items.end(), [](const Item &a, const Item &b) {
+        return string_utils::tolower(a.entry.title) < string_utils::tolower(b.entry.title);
+    });
+    return items;
+}
+
+void ensure_icons(Item &item) {
+    if (item.icons_loaded)
+        return;
+    item.icons_loaded = true;
+    if (item.entry.icon_path.empty() || !fs::exists(fs_utils::utf8_to_path(item.entry.icon_path)))
+        return;
+    item.small = ps4ui::load_image(item.entry.icon_path, ICON, ICON);
+    item.large = ps4ui::load_image(item.entry.icon_path, BIG_ICON, BIG_ICON);
+}
+
+void icon_placeholder(Canvas &c, int x, int y, int size) {
+    c.fill_round_rect(x, y, size, size, size / 6, rgb(0x1b2a44));
+    c.text_centered(x + size / 2, y + size / 2 + size / 8, "?", size / 3, MUTED, Weight::Bold);
+}
+
+// --- what can be installed (the install browser's entries) ---
+
+enum class Kind {
+    Location, // where to look: the install folder, the PS4's storage, a USB drive
+    Folder,
+    GameFolder, // a dumped app: a folder with sce_sys/param.sfo
+    Archive, // .vpk, .zip
+    Package, // .pkg, with its zRIF
+    Update, // .pup: the firmware or the font package
+    License, // .rif, work.bin
+};
+
+struct Entry {
+    Kind kind;
+    std::string name;
+    fs::path path;
+    uint64_t size = 0;
+    int zrif = -1; // a package's: whether there's a .zrif file next to it (-1: not looked yet)
+};
+
+bool installable(Kind kind) {
+    return kind != Kind::Location && kind != Kind::Folder;
+}
+
+std::optional<Kind> file_kind(const fs::path &p) {
+    const std::string ext = string_utils::tolower(p.extension().string());
+    if (ext == ".vpk" || ext == ".zip")
+        return Kind::Archive;
+    if (ext == ".pkg")
+        return Kind::Package;
+    if (ext == ".pup")
+        return Kind::Update;
+    if (ext == ".rif" || p.filename() == "work.bin")
+        return Kind::License;
+    return std::nullopt;
+}
+
+// Where the browser looks first: the install folder, the PS4's storage, the USB drives plugged in
+std::vector<Entry> locations() {
+    std::vector<Entry> list{
+        { Kind::Location, "Install folder", INSTALL_DIR },
+        { Kind::Location, "PS4 storage", "/data" },
+    };
+    for (int i = 0; i < 8; i++) {
+        const fs::path usb = fmt::format("/mnt/usb{}", i);
+        boost::system::error_code ec;
+        if (fs::is_directory(usb, ec))
+            list.push_back({ Kind::Location, fmt::format("USB drive {}", i + 1), usb });
+    }
+    return list;
+}
+
+bool is_location(const fs::path &dir) {
+    const std::vector<Entry> list = locations();
+    return std::any_of(list.begin(), list.end(), [&](const Entry &e) { return e.path == dir; });
+}
+
+// A folder's subfolders, then what in it can be installed
+std::vector<Entry> list_folder(const fs::path &dir) {
+    std::vector<Entry> folders, files;
+    boost::system::error_code ec;
+    for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        const fs::path p = it->path();
+        const std::string name = p.filename().string();
+        if (name.empty() || name[0] == '.')
+            continue;
+        boost::system::error_code entry_ec;
+        if (fs::is_directory(p, entry_ec)) {
+            const bool app = fs::exists(p / "sce_sys" / "param.sfo", entry_ec);
+            folders.push_back({ app ? Kind::GameFolder : Kind::Folder, name, p });
+        } else if (const auto kind = file_kind(p)) {
+            const auto size = fs::file_size(p, entry_ec);
+            files.push_back({ *kind, name, p, entry_ec ? 0 : static_cast<uint64_t>(size) });
+        }
+    }
+    const auto by_name = [](const Entry &a, const Entry &b) {
+        return string_utils::tolower(a.name) < string_utils::tolower(b.name);
+    };
+    std::sort(folders.begin(), folders.end(), by_name);
+    std::sort(files.begin(), files.end(), by_name);
+    folders.insert(folders.end(), files.begin(), files.end());
+    return folders;
+}
+
+std::string size_text(uint64_t bytes) {
+    if (bytes >= (1ull << 30))
+        return fmt::format("{:.1f} GB", bytes / static_cast<double>(1ull << 30));
+    if (bytes >= (1ull << 20))
+        return fmt::format("{} MB", bytes >> 20);
+    return fmt::format("{} KB", (bytes + 1023) >> 10);
+}
+
+// --- installing ---
+
+struct InstallJob {
+    std::thread thread;
+    std::atomic<bool> running{ false };
+    std::atomic<bool> finished{ false };
+    bool firmware = false; // the firmware download, rather than the install folder
+    std::mutex mutex;
+    std::string heading; // what the firmware download is doing
+    std::string current;
+    float progress = 0; // of the current file, 0-1
+    int index = 0;
+    int total = 0;
+    int installed = 0;
+    bool stoppable = false; // a download, which Circle stops
+    bool stop_requested = false;
+    bool stopped = false;
+    std::vector<std::string> done; // what was installed
+    std::vector<std::string> failures;
+    std::string title_id; // the app installed last, which the list selects
+    // an app being decrypted before it starts: it starts when that worked
+    std::string start_app;
+    std::string start_title;
+};
+
+void reset(InstallJob &job, bool firmware) {
+    job.running = true;
+    job.finished = false;
+    job.firmware = firmware;
+    const std::lock_guard<std::mutex> lock(job.mutex);
+    job.heading.clear();
+    job.current.clear();
+    job.progress = 0;
+    job.index = job.total = job.installed = 0;
+    job.stoppable = job.stop_requested = job.stopped = false;
+    job.done.clear();
+    job.failures.clear();
+    job.title_id.clear();
+    job.start_app.clear();
+    job.start_title.clear();
+}
+
+// install_pup, which throws when a file isn't what it expects: the firmware's version, or nothing
+std::string install_update(EmuEnvState &emuenv, const fs::path &pup, const std::function<void(float)> &progress) {
+    try {
+        return install_pup(emuenv.vita_fs_path, pup, [&](uint32_t percent) { progress(percent / 100.f); });
+    } catch (const std::exception &e) {
+        LOG_ERROR("PS4 launcher: {} couldn't be installed: {}", pup, e.what());
+        return {};
+    }
+}
+
+std::string read_zrif(const fs::path &pkg) {
+    for (const char *ext : { ".zrif", ".txt" }) {
+        fs::path candidate = pkg;
+        candidate.replace_extension(ext);
+        if (!fs::exists(candidate))
+            continue;
+        fs::ifstream in(candidate);
+        std::string token;
+        // the first word that looks like a zRIF
+        while (in >> token) {
+            if (token.rfind("KO5", 0) == 0 || token.size() > 64)
+                return token;
+        }
+    }
+    return {};
+}
+
+// Licenses first (the packages after them may need them), then updates, packages, archives, folders
+int install_order(Kind kind) {
+    switch (kind) {
+    case Kind::License: return 0;
+    case Kind::Update: return 1;
+    case Kind::Package: return 2;
+    case Kind::Archive: return 3;
+    default: return 4;
+    }
+}
+
+// Installs what the browser picked. consume: they're in the install folder, and what installs moves
+// into its done/ (with a package's .zrif file).
+void install_worker(EmuEnvState &emuenv, InstallJob &job, std::vector<Entry> list, bool consume) {
+    std::stable_sort(list.begin(), list.end(), [](const Entry &a, const Entry &b) { return install_order(a.kind) < install_order(b.kind); });
+    const fs::path done_dir = fs::path(INSTALL_DIR) / "done";
+    if (consume) {
+        boost::system::error_code ec;
+        fs::create_directories(done_dir, ec);
+    }
+    {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.total = static_cast<int>(list.size());
+    }
+
+    const auto begin = [&](const fs::path &p) {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.current = p.filename().string();
+        job.progress = 0;
+        job.index++;
+        LOG_INFO("PS4 launcher: installing {}", p);
+    };
+    const auto set_progress = [&](float v) {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.progress = std::clamp(v > 1.f ? v / 100.f : v, 0.f, 1.f);
+    };
+    // what installed, and in the install folder into its done/ (with a package's .zrif file)
+    const auto finish = [&](const fs::path &p, bool ok, const std::string &why) {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        if (!ok) {
+            job.failures.push_back(p.filename().string() + (why.empty() ? "" : ": " + why));
+            LOG_ERROR("PS4 launcher: {} not installed {}", p, why);
+            return;
+        }
+        job.installed++;
+        job.done.push_back(p.filename().string());
+        if (!consume)
+            return;
+        boost::system::error_code move_ec;
+        fs::rename(p, done_dir / p.filename(), move_ec);
+        for (const char *ext : { ".zrif", ".txt" }) {
+            fs::path companion = p;
+            companion.replace_extension(ext);
+            if (fs::exists(companion, move_ec))
+                fs::rename(companion, done_dir / companion.filename(), move_ec);
+        }
+    };
+    const auto installed_app = [&](const std::string &title_id) {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.title_id = title_id;
+    };
+
+    // (an exception here would end the app: it stops the installing instead, as a failure)
+    try {
+        for (Entry &e : list) {
+            const fs::path &p = e.path;
+            begin(p);
+            switch (e.kind) {
+            case Kind::License:
+                finish(p, copy_license(emuenv, p), "not a valid license");
+                break;
+            case Kind::Update:
+                finish(p, !install_update(emuenv, p, set_progress).empty(), "not a PS Vita firmware or font package");
+                break;
+            case Kind::Package: {
+                std::string zrif = read_zrif(p);
+                if (zrif.empty())
+                    zrif = find_pkg_zrif(p, emuenv.vita_fs_path);
+                if (zrif.empty()) {
+                    finish(p, false, "no license: put its zRIF in a .zrif file of the same name, or install its .rif first");
+                    break;
+                }
+                const bool ok = install_pkg(p, emuenv, zrif, set_progress);
+                if (ok)
+                    installed_app(emuenv.app_info.app_title_id);
+                finish(p, ok, "the package couldn't be installed");
+                break;
+            }
+            case Kind::Archive: {
+                const auto contents = install_archive(emuenv, p, [&](ArchiveContents progress) {
+                    if (progress.progress)
+                        set_progress(*progress.progress);
+                    else if (progress.count && progress.current && *progress.count > 0)
+                        set_progress(*progress.current / *progress.count);
+                });
+                const bool ok = !contents.empty() && std::all_of(contents.begin(), contents.end(), [](const ContentInfo &c) { return c.state; });
+                if (ok)
+                    installed_app(contents.front().title_id);
+                finish(p, ok, "nothing in it could be installed");
+                break;
+            }
+            case Kind::GameFolder: {
+                // one of Vita3K's own (ux0/app/...): installing deletes where it goes first, which
+                // is where it is
+                if (fs_utils::path_to_utf8(p).rfind(fs_utils::path_to_utf8(emuenv.vita_fs_path), 0) == 0) {
+                    finish(p, false, "it's in Vita3K's own folders already: start it from the list");
+                    break;
+                }
+                const bool ok = install_contents(emuenv, p) > 0;
+                if (ok)
+                    installed_app(emuenv.app_info.app_title_id);
+                finish(p, ok, "not an app folder");
+                break;
+            }
+            case Kind::Location:
+            case Kind::Folder:
+                break;
+            }
+        }
+        app::init_apps_list(emuenv);
+    } catch (const std::exception &e) {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.failures.push_back(job.current + ": " + e.what());
+        LOG_ERROR("PS4 launcher: installing {} stopped: {}", job.current, e.what());
+    }
+    job.finished = true;
+}
+
+// --- apps copied in still encrypted ---
+
+// A NoNpDrm dump copied into ux0/app as it was: its files are still encrypted (Vita3K decrypts a
+// dump when it installs one), so the game can't load. Decrypted, eboot.bin starts with "SCE".
+bool still_encrypted(const fs::path &app_dir) {
+    boost::system::error_code ec;
+    if (!fs::exists(app_dir / "sce_sys" / "package" / "work.bin", ec))
+        return false;
+    FILE *f = std::fopen(fs_utils::path_to_utf8(app_dir / "eboot.bin").c_str(), "rb");
+    if (!f)
+        return false;
+    char magic[4] = {};
+    const bool read = std::fread(magic, 1, sizeof(magic), f) == sizeof(magic);
+    std::fclose(f);
+    return read && std::memcmp(magic, "SCE\0", sizeof(magic)) != 0;
+}
+
+// Decrypts it in place with its work.bin, as installing the dump would have, license and all
+void decrypt_worker(EmuEnvState &emuenv, InstallJob &job, const fs::path &app_dir, const std::string &title) {
+    {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.total = 1;
+        job.index = 1;
+        job.heading = "Decrypting " + title;
+        job.current = "Only this once: it was copied in still encrypted";
+    }
+    ps4_boot_trace(("launcher: decrypting " + fs_utils::path_to_utf8(app_dir)).c_str());
+    bool ok = false;
+    try {
+        // (decrypt_install_nonpdrm goes by the category: a patch's license stays as it is)
+        vfs::FileBuffer sfo;
+        if (fs_utils::read_data(app_dir / "sce_sys" / "param.sfo", sfo))
+            sfo::get_param_info(emuenv.app_info, sfo, emuenv.cfg.sys_lang);
+        ok = decrypt_install_nonpdrm(emuenv, app_dir / "sce_sys" / "package" / "work.bin", app_dir, [&](float v) {
+            const std::lock_guard<std::mutex> lock(job.mutex);
+            job.progress = v;
+        });
+    } catch (const std::exception &e) {
+        LOG_ERROR("PS4 launcher: decrypting {} failed: {}", app_dir, e.what());
+    }
+    if (!ok) {
+        // what there is of the decrypted copy
+        boost::system::error_code ec;
+        fs::remove_all(fs_utils::path_concat(app_dir, "_dec"), ec);
+    }
+    ps4_boot_trace(ok ? "launcher: decrypted" : "launcher: decrypting failed");
+    const std::lock_guard<std::mutex> lock(job.mutex);
+    if (ok) {
+        job.installed = 1;
+        job.done.push_back(title);
+    } else {
+        job.failures.push_back("Couldn't decrypt " + title + ": see /data/Vita3K/vita3k.log");
+    }
+    job.finished = true;
+}
+
+// --- the firmware, from Sony ---
+
+// What Vita3K's welcome dialog sends the user to: the system software on Sony's support page
+// (3.74, the last there is) and the font package
+struct FirmwareDownload {
+    const char *name;
+    const char *file;
+    const char *url;
+    uint64_t size;
+};
+
+const FirmwareDownload FIRMWARE{
+    "the PS Vita firmware",
+    "PSVUPDAT.PUP",
+    "http://dus01.psv.update.playstation.net/update/psv/image/2022_0209/rel_f2c7b12fe85496ec88a0391b514d6e3b/PSVUPDAT.PUP?dest=us",
+    133834240,
+};
+const FirmwareDownload FONT_PACKAGE{
+    "the PS Vita font package",
+    "PSP2UPDAT.PUP",
+    "http://dus01.psp2.update.playstation.net/update/psp2/image/2019_0924/sd_8b5f60b56c3da8365b973dba570c53a5/PSP2UPDAT.PUP?dest=us",
+    56768512,
+};
+
+constexpr const char *DOWNLOAD_DIR = "/data/Vita3K/cache/download";
+// there once the user stopped a download: it doesn't start by itself again (Square still starts it)
+constexpr const char *DOWNLOAD_STOPPED = "/data/Vita3K/cache/download/stopped";
+
+std::vector<const FirmwareDownload *> missing_firmware(const app::FirmwareState &fw) {
+    std::vector<const FirmwareDownload *> missing;
+    if (!fw.main_firmware)
+        missing.push_back(&FIRMWARE);
+    if (!fw.font_package)
+        missing.push_back(&FONT_PACKAGE);
+    return missing;
+}
+
+// Update files the user copied to the install folder (Triangle installs them)
+bool updates_waiting() {
+    boost::system::error_code ec;
+    for (const auto &e : fs::directory_iterator(INSTALL_DIR, ec)) {
+        if (string_utils::tolower(e.path().extension().string()) == ".pup")
+            return true;
+    }
+    return false;
+}
+
+// Downloads each missing package and installs it. A download Circle stopped stays in DOWNLOAD_DIR
+// and carries on the next time; an installed one is deleted.
+void firmware_worker(EmuEnvState &emuenv, InstallJob &job, const std::vector<const FirmwareDownload *> &downloads) {
+    boost::system::error_code ec;
+    fs::create_directories(DOWNLOAD_DIR, ec);
+    fs::remove(DOWNLOAD_STOPPED, ec);
+    {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.total = static_cast<int>(downloads.size());
+    }
+    // (an exception here would end the app: it stops the download instead, as a failure)
+    try {
+        for (const FirmwareDownload *d : downloads) {
+            const std::string name = d->name;
+            const fs::path file = fs::path(DOWNLOAD_DIR) / d->file;
+            {
+                const std::lock_guard<std::mutex> lock(job.mutex);
+                job.index++;
+                job.heading = "Downloading " + name;
+                job.current = "From Sony's update server";
+                job.progress = 0;
+                job.stoppable = true;
+            }
+            ps4_boot_trace(fmt::format("firmware: downloading {}", d->file).c_str());
+            LOG_INFO("PS4 launcher: downloading {} from {}", name, d->url);
+            // the speed, over a second or so
+            Clock::time_point mark_time{};
+            uint64_t mark_bytes = UINT64_MAX;
+            double speed = 0;
+            const ps4download::Result result = ps4download::download(d->url, file, d->size, [&](uint64_t done) {
+                const auto now = Clock::now();
+                if (mark_bytes == UINT64_MAX || done < mark_bytes) {
+                    mark_time = now;
+                    mark_bytes = done;
+                } else if (now - mark_time >= std::chrono::seconds(1)) {
+                    speed = (done - mark_bytes) / std::chrono::duration<double>(now - mark_time).count();
+                    mark_time = now;
+                    mark_bytes = done;
+                }
+                const std::lock_guard<std::mutex> lock(job.mutex);
+                job.progress = static_cast<float>(static_cast<double>(done) / d->size);
+                job.current = fmt::format("{} of {} MB", done >> 20, d->size >> 20);
+                if (speed > 0)
+                    job.current += fmt::format("   {:.1f} MB/s", speed / (1 << 20));
+                return !job.stop_requested;
+            });
+            if (result.status != ps4download::Status::Done) {
+                const std::lock_guard<std::mutex> lock(job.mutex);
+                if (result.status == ps4download::Status::Stopped) {
+                    job.stopped = true;
+                    if (FILE *f = std::fopen(DOWNLOAD_STOPPED, "w"))
+                        std::fclose(f);
+                    ps4_boot_trace("firmware: stopped");
+                } else {
+                    job.failures.push_back("Couldn't download " + name + ": " + result.error);
+                    ps4_boot_trace(("firmware: " + result.error).c_str());
+                }
+                break;
+            }
+            {
+                const std::lock_guard<std::mutex> lock(job.mutex);
+                job.heading = "Installing " + name;
+                job.current = "This can take a few minutes";
+                job.progress = 0;
+                job.stoppable = false;
+            }
+            ps4_boot_trace(fmt::format("firmware: installing {}", d->file).c_str());
+            const std::string version = install_update(emuenv, file, [&](float v) {
+                const std::lock_guard<std::mutex> lock(job.mutex);
+                job.progress = v;
+            });
+            // a broken download is fetched again the next time
+            fs::remove(file, ec);
+            const std::lock_guard<std::mutex> lock(job.mutex);
+            if (version.empty()) {
+                job.failures.push_back("Couldn't install " + name + " (it is downloaded again next time)");
+                ps4_boot_trace("firmware: install failed");
+                break;
+            }
+            LOG_INFO("PS4 launcher: installed {} {}", name, version);
+            ps4_boot_trace(fmt::format("firmware: installed {}", version).c_str());
+            job.installed++;
+            job.done.push_back(name);
+        }
+    } catch (const std::exception &e) {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        job.failures.push_back("The firmware download stopped: " + std::string(e.what()));
+        ps4_boot_trace(fmt::format("firmware: {}", e.what()).c_str());
+    }
+    job.finished = true;
+}
+
+std::string summary(InstallJob &job) {
+    const std::lock_guard<std::mutex> lock(job.mutex);
+    if (job.firmware) {
+        std::string text;
+        for (size_t i = 0; i < job.done.size(); i++)
+            text += (i == 0 ? "Installed " : " and ") + job.done[i];
+        if (job.stopped)
+            text += std::string(text.empty() ? "" : "\n") + "Download stopped: Square carries on with it";
+        for (const auto &failure : job.failures)
+            text += (text.empty() ? "" : "\n") + failure + ". Square tries again";
+        return text;
+    }
+    // an app decrypted before it starts: only a failure has something to say
+    if (!job.start_app.empty())
+        return job.failures.empty() ? std::string() : job.failures.front();
+    if (job.total == 0)
+        return "Nothing there can be installed";
+    if (job.failures.empty() && job.done.size() == 1)
+        return "Installed " + job.done.front();
+    std::string text = fmt::format("Installed {} of {}", job.installed, job.total);
+    for (const auto &failure : job.failures)
+        text += "\n" + failure;
+    return text;
+}
+
+void draw_install(Canvas &c, InstallJob &job) {
+    c.fill_rect(0, 0, W, H, rgb(0x000000, 150));
+    const int pw = 1100, ph = 300;
+    const int px = (W - pw) / 2, py = (H - ph) / 2;
+    c.fill_round_rect(px, py, pw, ph, 28, rgb(0x14213a));
+    std::string heading, current;
+    float progress;
+    int index, total;
+    bool stoppable, stopping;
+    {
+        const std::lock_guard<std::mutex> lock(job.mutex);
+        heading = job.heading;
+        current = job.current;
+        progress = job.progress;
+        index = job.index;
+        total = job.total;
+        stoppable = job.stoppable;
+        stopping = job.stop_requested;
+    }
+    if (heading.empty())
+        heading = total ? fmt::format("Installing {} of {}", std::max(index, 1), total) : std::string("Looking for files");
+    else if (total > 1)
+        heading += fmt::format(" ({} of {})", std::max(index, 1), total);
+    c.text(px + 56, py + 92, heading, 44, TEXT, Weight::Bold, pw - 112);
+    c.text(px + 56, py + 150, current, 30, MUTED, Weight::Regular, pw - 112);
+    c.fill_round_rect(px + 56, py + 196, pw - 112, 22, 11, rgb(0xffffff, 30));
+    if (progress > 0)
+        c.fill_round_rect(px + 56, py + 196, std::max(22, static_cast<int>((pw - 112) * progress)), 22, 11, ACCENT);
+    c.text(px + 56, py + 264, fmt::format("{}%", static_cast<int>(progress * 100)), 26, MUTED);
+    if (stoppable) {
+        const char *label = stopping ? "Stopping" : "Stop";
+        const int right = px + pw - 56;
+        const int lw = c.text_width(label, 26);
+        c.text(right - lw, py + 264, label, 26, stopping ? MUTED : TEXT);
+        if (!stopping)
+            c.circle_button(right - lw - 30.f, py + 255.f, 18.f);
+    }
+}
+
+void draw_list(Canvas &c, std::vector<Item> &items, int selected, int top) {
+    if (items.empty()) {
+        const int cw = W - 2 * MARGIN;
+        c.fill_round_rect(MARGIN, LIST_Y + 20, cw, 600, 32, rgb(0x14213a, 220));
+        c.text(MARGIN + 64, LIST_Y + 120, "No games yet", 52, TEXT, Weight::Bold);
+        const int y = c.text_wrapped(MARGIN + 64, LIST_Y + 200,
+            "Press Triangle to install games. Vita3K installs:", 32, MUTED, cw - 128, 46);
+        const char *lines[] = {
