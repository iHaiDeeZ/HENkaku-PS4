+                        for (int i = first; i < last; i++) {
+                            if (!art.count(i)) {
+                                tile_art(i);
+                                break;
+                            }
+                        }
+                        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+                    }
+                    continue;
+                } else {
+                    // Vita3K's list, as it was
+                    if (selected < top)
+                        top = selected;
+                    if (selected >= top + VISIBLE_ROWS)
+                        top = selected - VISIBLE_ROWS + 1;
+                    background(canvas);
+                    header(canvas, fw);
+                    draw_list(canvas, items, selected, top);
+                    if (!items.empty()) {
+                        hints.push_back({ Pad::Cross, "Start" });
+                        hints.push_back({ Pad::Square, "Game settings" });
+                    }
+                    hints.push_back({ Pad::Triangle, "Install games" });
+                    hints.push_back({ Pad::Options, "HENkaku" });
+                }
+                break;
+            case Mode::Settings: {
+                draw_settings(canvas, settings, henkaku_heading);
+                const SettingsLevel &level = settings.stack.back();
+                const SItem *item = level.selected < static_cast<int>(level.items->size()) ? &(*level.items)[level.selected] : nullptr;
+                if (item && item->type == SItem::kind::choice) {
+                    hints.push_back({ Pad::DPad, "Change" });
+                    hints.push_back({ Pad::Cross, "Next value" });
+                } else if (item && item->type == SItem::kind::page) {
+                    hints.push_back({ Pad::Cross, "Open" });
+                } else if (item && item->type == SItem::kind::action) {
+                    hints.push_back({ Pad::Cross, "Do it" });
+                }
+                hints.push_back({ Pad::Circle, "Back" });
+                break;
+            }
+            case Mode::Browser:
+                if (browse_selected < browse_top)
+                    browse_top = browse_selected;
+                if (browse_selected >= browse_top + BROWSER_ROWS)
+                    browse_top = browse_selected - BROWSER_ROWS + 1;
+                background(canvas);
+                header(canvas, fw);
+                draw_browser(canvas, browse_dir, entries, browse_selected, browse_top);
+                if (!entries.empty())
+                    hints.push_back({ Pad::Cross, installable(entries[browse_selected].kind) ? "Install" : "Open" });
+                if (std::any_of(entries.begin(), entries.end(), [](const Entry &e) { return installable(e.kind); }))
+                    hints.push_back({ Pad::Square, "Install all here" });
+                hints.push_back({ Pad::Circle, "Back" });
+                break;
+            }
+            draw_notice(canvas, notice);
+            footer(canvas, hints);
+            if (job.running)
+                draw_install(canvas, job);
+            present(canvas);
+            dirty = false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    }
+}
+
+} // namespace ps4launcher
