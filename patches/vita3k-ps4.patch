+namespace {
+
+constexpr int BLOCK = 8; // luma pixels a side of a motion block
+constexpr uint32_t GROUP = 8; // the shaders' work groups: 8x8
+// the camera's counts (fg_motion) cover vectors of -LIMIT..LIMIT luma pixels
+constexpr uint32_t LIMIT = 48;
+// frames further apart than this (vblanks: loading, a pause) get no motion between them
+constexpr double LONG_GAP = 8.0;
+
+// Waits for what the last passes wrote (and the screen pass read) before the next ones
+void compute_barrier(vk::CommandBuffer cmd) {
+    const vk::MemoryBarrier barrier{
+        .srcAccessMask = vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eShaderRead,
+        .dstAccessMask = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite,
+    };
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eFragmentShader,
+        vk::PipelineStageFlagBits::eComputeShader, vk::DependencyFlags(), barrier, {}, {});
+}
+
+double fraction(double x) {
+    return x - std::floor(x);
+}
+
+vk::DescriptorBufferInfo whole(const vkutil::Buffer &buffer) {
+    return vk::DescriptorBufferInfo{ .buffer = buffer.buffer, .offset = 0, .range = VK_WHOLE_SIZE };
+}
+
+vk::WriteDescriptorSet write_image(vk::DescriptorSet dst, uint32_t binding, vk::DescriptorType type, const vk::DescriptorImageInfo &info) {
+    vk::WriteDescriptorSet write{ .dstSet = dst, .dstBinding = binding, .descriptorCount = 1, .descriptorType = type };
+    write.setImageInfo(info);
+    return write;
+}
+
+vk::WriteDescriptorSet write_buffer(vk::DescriptorSet dst, uint32_t binding, const vk::DescriptorBufferInfo &info) {
+    vk::WriteDescriptorSet write{ .dstSet = dst, .dstBinding = binding, .descriptorCount = 1, .descriptorType = vk::DescriptorType::eStorageBuffer };
+    write.setBufferInfo(info);
+    return write;
+}
+
+} // namespace
+
+FrameGenerator::FrameGenerator(VKState &state)
+    : state(state) {}
+
+FrameGenerator::~FrameGenerator() {
+    vk::Device device = state.device;
+    if (!device)
+        return;
+    device.waitIdle();
+    for (int i = 0; i < 3; i++) {
+        device.destroy(pipelines[i]);
+        device.destroy(pipeline_layouts[i]);
+        device.destroy(set_layouts[i]);
+        device.destroy(shaders[i]);
+    }
+    for (vk::Fence fence : fences)
+        device.destroy(fence);
+    device.destroy(command_pool);
+    device.destroy(pool);
+    device.destroy(nearest);
+    device.destroy(linear);
+}
+
+bool FrameGenerator::init() {
+    vk::Device device = state.device;
+    nearest = device.createSampler(vk::SamplerCreateInfo{
+        .magFilter = vk::Filter::eNearest,
+        .minFilter = vk::Filter::eNearest,
+        .addressModeU = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeV = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeW = vk::SamplerAddressMode::eClampToEdge,
+    });
+    linear = device.createSampler(vk::SamplerCreateInfo{
+        .magFilter = vk::Filter::eLinear,
+        .minFilter = vk::Filter::eLinear,
+        .addressModeU = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeV = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeW = vk::SamplerAddressMode::eClampToEdge,
+    });
+
+    const fs::path dir = state.static_assets / "shaders-builtin/vulkan";
+    const char *const names[3] = { "fg_copy.comp.spv", "fg_motion.comp.spv", "fg_interp.comp.spv" };
+    for (int i = 0; i < 3; i++) {
+        shaders[i] = vkutil::load_shader(device, dir / names[i]);
+        if (!shaders[i]) {
+            LOG_ERROR("Frame generation: {} couldn't be loaded", names[i]);
+            return false;
+        }
+    }
+
+    const auto binding = [](uint32_t index, vk::DescriptorType type, const vk::Sampler *sampler = nullptr) {
+        return vk::DescriptorSetLayoutBinding{
+            .binding = index,
+            .descriptorType = type,
+            .descriptorCount = 1,
+            .stageFlags = vk::ShaderStageFlagBits::eCompute,
+            .pImmutableSamplers = sampler,
+        };
+    };
+    constexpr vk::DescriptorType BUFFER = vk::DescriptorType::eStorageBuffer;
+    const std::vector<vk::DescriptorSetLayoutBinding> layouts[3] = {
+        // copy: the game's frame, the history's image, its luma, its luma at half and quarter size
+        { binding(0, vk::DescriptorType::eCombinedImageSampler, &nearest), binding(1, vk::DescriptorType::eStorageImage), binding(2, BUFFER),
+            binding(3, BUFFER) },
+        // motion: the frame before's luma, the luma, the vectors, the coarse vectors, the judge's
+        // counts, the frame before's vectors (where the search starts) and judge (its camera), the
+        // vectors' counts (the camera's), both frames' luma at half and quarter size, the quarter
+        // vectors
+        { binding(0, BUFFER), binding(1, BUFFER), binding(2, BUFFER), binding(3, BUFFER), binding(4, BUFFER), binding(5, BUFFER),
+            binding(6, BUFFER), binding(7, BUFFER), binding(8, BUFFER), binding(9, BUFFER), binding(10, BUFFER) },
+        // in-between: the two frames, the second's vectors, the result, the judge's counts
+        { binding(0, vk::DescriptorType::eCombinedImageSampler, &linear), binding(1, vk::DescriptorType::eCombinedImageSampler, &linear),
+            binding(2, BUFFER), binding(3, vk::DescriptorType::eStorageImage), binding(4, BUFFER) },
+    };
+    const vk::PushConstantRange push{
+        .stageFlags = vk::ShaderStageFlagBits::eCompute,
+        .offset = 0,
+        .size = sizeof(Constants),
+    };
+    for (int i = 0; i < 3; i++) {
+        vk::DescriptorSetLayoutCreateInfo layout_info{};
+        layout_info.setBindings(layouts[i]);
+        set_layouts[i] = device.createDescriptorSetLayout(layout_info);
+        vk::PipelineLayoutCreateInfo pipeline_layout_info{};
+        pipeline_layout_info.setSetLayouts(set_layouts[i]);
+        pipeline_layout_info.setPushConstantRanges(push);
+        pipeline_layouts[i] = device.createPipelineLayout(pipeline_layout_info);
+        const vk::ComputePipelineCreateInfo pipeline_info{
+            .stage = { .stage = vk::ShaderStageFlagBits::eCompute, .module = shaders[i], .pName = "main" },
+            .layout = pipeline_layouts[i],
+        };
+        const auto created = device.createComputePipeline(nullptr, pipeline_info);
+        if (created.result != vk::Result::eSuccess) {
+            LOG_ERROR("Frame generation: compute pipeline {} failed", i);
+            return false;
+        }
+        pipelines[i] = created.value;
+    }
+
+    // the sets: copy and motion per history slot, in-between per swapchain image (its last use is
+    // done once the image's fence passed)
+    const uint32_t screen_slots = std::max<uint32_t>(state.screen_renderer.swapchain_size, 1) + 1;
+    const std::array<vk::DescriptorPoolSize, 3> sizes = {
+        vk::DescriptorPoolSize{ .type = vk::DescriptorType::eCombinedImageSampler, .descriptorCount = HISTORY + screen_slots * 2 },
+        vk::DescriptorPoolSize{ .type = vk::DescriptorType::eStorageImage, .descriptorCount = HISTORY + screen_slots },
+        vk::DescriptorPoolSize{ .type = BUFFER, .descriptorCount = HISTORY * 13 + screen_slots * 2 },
+    };
+    vk::DescriptorPoolCreateInfo pool_info{ .maxSets = HISTORY * 2 + screen_slots };
+    pool_info.setPoolSizes(sizes);
+    pool = device.createDescriptorPool(pool_info);
+    const auto allocate = [&](vk::DescriptorSetLayout layout) {
+        vk::DescriptorSetAllocateInfo alloc{ .descriptorPool = pool };
+        alloc.setSetLayouts(layout);
+        return device.allocateDescriptorSets(alloc).front();
+    };
+    for (int i = 0; i < HISTORY; i++) {
+        copy_sets[i] = allocate(set_layouts[0]);
+        motion_sets[i] = allocate(set_layouts[1]);
+    }
+    for (uint32_t i = 0; i < screen_slots; i++)
+        interp_sets.push_back(allocate(set_layouts[2]));
+
+    // the command buffers adding frames, on the queue the game's frames are drawn on (in order after them)
+    command_pool = device.createCommandPool(vk::CommandPoolCreateInfo{
+        .flags = vk::CommandPoolCreateFlagBits::eResetCommandBuffer,
+        .queueFamilyIndex = state.general_family_index,
+    });
+    const auto buffers = device.allocateCommandBuffers(vk::CommandBufferAllocateInfo{
+        .commandPool = command_pool,
+        .level = vk::CommandBufferLevel::ePrimary,
+        .commandBufferCount = HISTORY,
+    });
+    for (int i = 0; i < HISTORY; i++) {
+        commands[i] = buffers[i];
+        fences[i] = device.createFence(vk::FenceCreateInfo{ .flags = vk::FenceCreateFlagBits::eSignaled });
+    }
+    LOG_INFO("Frame generation ready");
+    return true;
+}
+
+void FrameGenerator::resize(vk::CommandBuffer cmd, uint32_t new_width, uint32_t new_height) {
+    // what the screen and the other frames' passes still read goes away
+    state.general_queue.waitIdle();
+    width = new_width;
+    height = new_height;
+    // the luma is about 480 wide whatever the resolution multiplier
+    scale = std::max<uint32_t>(1, (width + 479) / 480);
+    luma_w = (width + scale - 1) / scale;
+    luma_h = (height + scale - 1) / scale;
+    blocks_w = (luma_w + BLOCK - 1) / BLOCK;
+    blocks_h = (luma_h + BLOCK - 1) / BLOCK;
+    // the search's levels: the luma at half and at quarter size
+    const uint32_t half_w = (luma_w + 1) / 2, half_h = (luma_h + 1) / 2;
+    const uint32_t quarter_w = (luma_w + 3) / 4, quarter_h = (luma_h + 3) / 4;
+
+    const auto make_image = [&](vkutil::Image &image) {
+        image.destroy();
+        image = vkutil::Image(width, height, vk::Format::eR8G8B8A8Unorm);
+        image.init_image(vk::ImageUsageFlagBits::eStorage | vk::ImageUsageFlagBits::eSampled);
+        image.transition_to_discard(cmd, vkutil::ImageLayout::StorageImage);
+    };
+    const auto make_buffer = [&](vkutil::Buffer &buffer, vk::DeviceSize size) {
+        buffer.destroy();
+        buffer = vkutil::Buffer(size);
+        buffer.init_buffer(vk::BufferUsageFlagBits::eStorageBuffer | vk::BufferUsageFlagBits::eTransferDst);
+        // (vectors start at no motion, counts at none)
+        cmd.fillBuffer(buffer.buffer, 0, VK_WHOLE_SIZE, 0);
+    };
+    for (Frame &frame : history) {
+        make_image(frame.image);
+        make_buffer(frame.luma, static_cast<vk::DeviceSize>(luma_w) * luma_h * sizeof(float));
+        make_buffer(frame.vectors, static_cast<vk::DeviceSize>(blocks_w) * blocks_h * 2 * sizeof(int32_t));
+        // (no_match, textured, unmatched, unused, the camera's vector)
+        make_buffer(frame.judge, 8 * sizeof(uint32_t));
+        make_buffer(frame.levels, static_cast<vk::DeviceSize>(half_w * half_h + quarter_w * quarter_h) * sizeof(float));
+        frame.valid = false;
+        frame.has_motion = false;
+    }
+    make_image(result);
+    // the coarse pass's blocks: on the luma at half size; the quarter pass's: at quarter size
+    const uint32_t coarse_w = (half_w + BLOCK - 1) / BLOCK, coarse_h = (half_h + BLOCK - 1) / BLOCK;
+    make_buffer(coarse, static_cast<vk::DeviceSize>(coarse_w) * coarse_h * 2 * sizeof(int32_t));
+    make_buffer(quarter, static_cast<vk::DeviceSize>((quarter_w + BLOCK - 1) / BLOCK) * ((quarter_h + BLOCK - 1) / BLOCK) * 2 * sizeof(int32_t));
+    make_buffer(counts, static_cast<vk::DeviceSize>(2 * LIMIT + 1) * (2 * LIMIT + 1) * sizeof(uint32_t));
+    const vk::MemoryBarrier filled{
+        .srcAccessMask = vk::AccessFlagBits::eTransferWrite,
+        .dstAccessMask = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite,
+    };
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eComputeShader, vk::DependencyFlags(), filled, {}, {});
+    newest = -1;
+}
+
+void FrameGenerator::reset() {
+    for (Frame &frame : history)
+        frame.valid = false;
+    newest = -1;
+    newest_stamp_ = -1.0;
+    latency = 0.0;
+}
+
+void FrameGenerator::add_frame(vk::ImageView src, vk::ImageLayout src_layout, const Viewport &viewport, double stamp, double now) {
+    if (failed || !src || viewport.width == 0 || viewport.height == 0)
+        return;
+    newest_stamp_ = stamp;
+    // where in a vblank the game queues its frames (averaged on a circle); held to its vblanks, the
+    // frames' times go on that point
+    const double angle = 2.0 * std::numbers::pi * fraction(stamp);
+    phase_x = phase_x * 0.9 + std::cos(angle) * 0.1;
+    phase_y = phase_y * 0.9 + std::sin(angle) * 0.1;
+    const double steadiness = std::sqrt(phase_x * phase_x + phase_y * phase_y);
+    steady = steadiness > (steady ? 0.6 : 0.8);
+    double time = stamp;
+    if (steady) {
+        const double phase = fraction(std::atan2(phase_y, phase_x) / (2.0 * std::numbers::pi));
+        time = phase + std::round(stamp - phase);
+    }
+    if (!ready) {
+        if (!init()) {
+            failed = true;
+            return;
+        }
+        ready = true;
+    }
+    vk::Device device = state.device;
+    const int slot = (newest + 1) % HISTORY;
+    // this slot's command buffer and sets are free once its last frame was added
+    if (device.waitForFences(fences[slot], VK_TRUE, std::numeric_limits<uint64_t>::max()) != vk::Result::eSuccess) {
+        LOG_ERROR("Frame generation: waiting for a frame's passes failed");
+        return;
+    }
+    device.resetFences(fences[slot]);
+    vk::CommandBuffer cmd = commands[slot];
+    cmd.reset();
+    cmd.begin(vk::CommandBufferBeginInfo{ .flags = vk::CommandBufferUsageFlagBits::eOneTimeSubmit });
+    if (viewport.width != width || viewport.height != height)
+        resize(cmd, viewport.width, viewport.height);
+
+    const int before = newest;
+    Frame &frame = history[slot];
+    const bool motion = before >= 0 && history[before].valid && time > history[before].time && time - history[before].time < LONG_GAP;
+
+    const vk::DescriptorImageInfo src_info{ .imageView = src, .imageLayout = src_layout };
+    const vk::DescriptorImageInfo storage{ .imageView = frame.image.view, .imageLayout = vk::ImageLayout::eGeneral };
+    const vk::DescriptorBufferInfo luma_info = whole(frame.luma);
+    const vk::DescriptorBufferInfo levels_info = whole(frame.levels);
+    std::vector<vk::WriteDescriptorSet> writes = {
+        write_image(copy_sets[slot], 0, vk::DescriptorType::eCombinedImageSampler, src_info),
+        write_image(copy_sets[slot], 1, vk::DescriptorType::eStorageImage, storage),
+        write_buffer(copy_sets[slot], 2, luma_info),
+        write_buffer(copy_sets[slot], 3, levels_info),
+    };
+    vk::DescriptorBufferInfo before_luma, vectors_info, coarse_info, judge_info, last_info, last_judge_info, counts_info, before_levels, quarter_info;
+    if (motion) {
+        before_luma = whole(history[before].luma);
+        vectors_info = whole(frame.vectors);
+        coarse_info = whole(coarse);
+        judge_info = whole(frame.judge);
+        last_info = whole(history[before].vectors);
+        last_judge_info = whole(history[before].judge);
+        counts_info = whole(counts);
+        before_levels = whole(history[before].levels);
+        quarter_info = whole(quarter);
+        writes.push_back(write_buffer(motion_sets[slot], 0, before_luma));
+        writes.push_back(write_buffer(motion_sets[slot], 1, luma_info));
+        writes.push_back(write_buffer(motion_sets[slot], 2, vectors_info));
+        writes.push_back(write_buffer(motion_sets[slot], 3, coarse_info));
+        writes.push_back(write_buffer(motion_sets[slot], 4, judge_info));
+        writes.push_back(write_buffer(motion_sets[slot], 5, last_info));
+        writes.push_back(write_buffer(motion_sets[slot], 6, last_judge_info));
+        writes.push_back(write_buffer(motion_sets[slot], 7, counts_info));
+        writes.push_back(write_buffer(motion_sets[slot], 8, before_levels));
+        writes.push_back(write_buffer(motion_sets[slot], 9, levels_info));
+        writes.push_back(write_buffer(motion_sets[slot], 10, quarter_info));
+    }
+    device.updateDescriptorSets(writes, {});
+
+    // the judge counts this pair's blocks from zero (a frame without motion has no camera either)
+    // and the vectors' counts start again, once what read or wrote them before is done
+    const vk::MemoryBarrier reused{
+        .srcAccessMask = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite,
+        .dstAccessMask = vk::AccessFlagBits::eTransferWrite,
+    };
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader, vk::PipelineStageFlagBits::eTransfer, vk::DependencyFlags(), reused, {}, {});
+    cmd.fillBuffer(frame.judge.buffer, 0, VK_WHOLE_SIZE, 0);
+    if (motion)
+        cmd.fillBuffer(counts.buffer, 0, VK_WHOLE_SIZE, 0);
+    // the game's frame (drawn before), and what the screen passes read from this slot before
+    const vk::MemoryBarrier drawn{
+        .srcAccessMask = vk::AccessFlagBits::eColorAttachmentWrite | vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferWrite | vk::AccessFlagBits::eShaderRead,
+        .dstAccessMask = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite,
+    };
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eColorAttachmentOutput | vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eFragmentShader | vk::PipelineStageFlagBits::eTransfer,
+        vk::PipelineStageFlagBits::eComputeShader, vk::DependencyFlags(), drawn, {}, {});
+
+    Constants constants{
+        .src_x = static_cast<int32_t>(viewport.offset_x),
+        .src_y = static_cast<int32_t>(viewport.offset_y),
+        .frame_w = width,
+        .frame_h = height,
+        .scale = scale,
+        .luma_w = luma_w,
+        .luma_h = luma_h,
+        .blocks_w = blocks_w,
+        .pass_index = 0,
+        .phase = 0.0f,
+    };
+    cmd.bindPipeline(vk::PipelineBindPoint::eCompute, pipelines[0]);
+    cmd.bindDescriptorSets(vk::PipelineBindPoint::eCompute, pipeline_layouts[0], 0, copy_sets[slot], {});
+    cmd.pushConstants(pipeline_layouts[0], vk::ShaderStageFlagBits::eCompute, 0, sizeof(Constants), &constants);
+    cmd.dispatch((luma_w + GROUP - 1) / GROUP, (luma_h + GROUP - 1) / GROUP, 1);
+
+    if (motion) {
+        // the motion: the quarter pass, the coarse one from it, the fine one from that (with the
+        // judge's counts), the camera's (one group)
+        const uint32_t quarter_blocks_w = ((luma_w + 3) / 4 + BLOCK - 1) / BLOCK, quarter_blocks_h = ((luma_h + 3) / 4 + BLOCK - 1) / BLOCK;
+        const uint32_t coarse_w = ((luma_w + 1) / 2 + BLOCK - 1) / BLOCK, coarse_h = ((luma_h + 1) / 2 + BLOCK - 1) / BLOCK;
+        const std::array<std::array<uint32_t, 3>, 4> passes = { {
+            { 3, (quarter_blocks_w + GROUP - 1) / GROUP, (quarter_blocks_h + GROUP - 1) / GROUP },
+            { 0, (coarse_w + GROUP - 1) / GROUP, (coarse_h + GROUP - 1) / GROUP },
+            { 1, (blocks_w + GROUP - 1) / GROUP, (blocks_h + GROUP - 1) / GROUP },
+            { 2, 1, 1 },
+        } };
+        cmd.bindPipeline(vk::PipelineBindPoint::eCompute, pipelines[1]);
+        cmd.bindDescriptorSets(vk::PipelineBindPoint::eCompute, pipeline_layouts[1], 0, motion_sets[slot], {});
+        for (const auto &[pass, groups_x, groups_y] : passes) {
+            compute_barrier(cmd);
+            constants.pass_index = pass;
+            cmd.pushConstants(pipeline_layouts[1], vk::ShaderStageFlagBits::eCompute, 0, sizeof(Constants), &constants);
+            cmd.dispatch(groups_x, groups_y, 1);
+        }
+    }
+    // (the screen passes, in later command buffers, wait for these with their own barrier)
+    cmd.end();
+    vk::SubmitInfo submit{};
+    submit.setCommandBuffers(cmd);
+    state.general_queue.submit(submit, fences[slot]);
+
+    // the pacing: how far apart the frames come, how long after the game queued them they get here
+    if (motion)
+        interval = interval * 0.9 + std::clamp(time - history[before].time, 0.5, 6.0) * 0.1;
+    delay = delay * 0.9 + std::clamp(now - stamp, 0.0, 4.0) * 0.1;
+
+    frame.time = time;
+    frame.valid = true;
+    frame.has_motion = motion;
+    newest = slot;
+}
+
+// How far behind its newest frame's time the screen shows the game, in vblanks: enough for the frame
+// after the moment shown to be here (a vblank to the screen, the frames' way here, a frame's time).
+// A game that queues its frames at the same point of every vblank (held to its vblanks) gets its
+// moments on that point: the screen then shows its frames themselves, and in-between ones half way;
+// as a moment then falls on a frame once a frame's time, it needs half a vblank less.
+double FrameGenerator::latency_for_screen() {
+    const double needed = (steady ? 0.5 : 1.0) + delay + interval + 0.1;
+    double target = needed;
+    if (steady) {
+        const double phase = fraction(std::atan2(phase_y, phase_x) / (2.0 * std::numbers::pi));
+        const double base = fraction(1.0 - phase);
+        target = base + std::ceil(needed - base);
+    }
+    // later at once (frames came later), earlier slowly (the screen hurries by 1%)
+    if (latency == 0.0 || target > latency + 0.05)
+        latency = target;
+    else if (target < latency)
+        latency = std::max(target, latency - 0.01);
+    return latency;
+}
+
+bool FrameGenerator::image_for(vk::CommandBuffer cmd, uint32_t slot, double vblank, vk::ImageView &view, Viewport &viewport) {
+    if (!cmd || newest < 0 || !history[newest].valid)
+        return false;
+    // the history's frames, oldest first
+    int order[HISTORY];
+    int count = 0;
+    for (int k = HISTORY - 1; k >= 0; k--) {
+        const int i = (newest - k + HISTORY) % HISTORY;
+        if (history[i].valid)
+            order[count++] = i;
+    }
+
+    // A game giving about a frame a vblank (48 fps and up) needs none made between two: its newest
+    // is shown at once. (Its late frames were filled with made ones, split where two blocks' motions
+    // met: Uncharted's menu at 59 fps.)
+    full_rate = interval < (full_rate ? 1.3 : 1.2);
+    // the moment shown: the frame of that moment, or one made between the two around it
+    const double moment = full_rate ? 0.0 : vblank - latency_for_screen();
+    int show = order[count - 1]; // past the newest (the next frame is late): the newest
+    int first = -1, second = -1;
+    double phase = 0.0;
+    if (full_rate) {
+        // (the newest, as it is)
+    } else if (moment <= history[order[0]].time) {
+        show = order[0];
+    } else {
+        for (int k = 0; k + 1 < count; k++) {
+            const Frame &a = history[order[k]], &b = history[order[k + 1]];
+            if (moment < a.time || moment >= b.time)
+                continue;
+            show = order[k];
+            if (b.has_motion && b.time > a.time) {
+                phase = (moment - a.time) / (b.time - a.time);
+                if (phase > 0.97)
+                    show = order[k + 1];
+                else if (phase >= 0.03) {
+                    first = order[k];
+                    second = order[k + 1];
+                }
+            }
+            break;
+        }
+    }
+
+    // what the frames' passes wrote (other command buffers, before), and the screen pass's reads of
+    // the in-between frame before it's made again
+    const vk::MemoryBarrier written{
+        .srcAccessMask = vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eShaderRead,
+        .dstAccessMask = vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite,
+    };
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eFragmentShader,
+        vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eFragmentShader, vk::DependencyFlags(), written, {}, {});
+    if (first >= 0) {
+        make_inbetween(cmd, slot, first, second, static_cast<float>(phase));
+        view = result.view;
+    } else {
+        view = history[show].image.view;
+    }
+    viewport = Viewport{
+        .offset_x = 0,
+        .offset_y = 0,
+        .width = width,
+        .height = height,
+        .texture_width = width,
+        .texture_height = height,
+    };
+    return true;
+}
+
+void FrameGenerator::make_inbetween(vk::CommandBuffer cmd, uint32_t slot, int first, int second, float phase) {
+    const vk::DescriptorSet set = interp_sets[slot % interp_sets.size()];
+    const vk::DescriptorImageInfo first_info{ .imageView = history[first].image.view, .imageLayout = vk::ImageLayout::eGeneral };
+    const vk::DescriptorImageInfo second_info{ .imageView = history[second].image.view, .imageLayout = vk::ImageLayout::eGeneral };
+    const vk::DescriptorImageInfo result_info{ .imageView = result.view, .imageLayout = vk::ImageLayout::eGeneral };
+    const vk::DescriptorBufferInfo vectors_info = whole(history[second].vectors);
+    const vk::DescriptorBufferInfo judge_info = whole(history[second].judge);
+    const std::array<vk::WriteDescriptorSet, 5> writes = {
+        write_image(set, 0, vk::DescriptorType::eCombinedImageSampler, first_info),
+        write_image(set, 1, vk::DescriptorType::eCombinedImageSampler, second_info),
+        write_buffer(set, 2, vectors_info),
+        write_image(set, 3, vk::DescriptorType::eStorageImage, result_info),
+        write_buffer(set, 4, judge_info),
+    };
+    state.device.updateDescriptorSets(writes, {});
+
+    const Constants constants{
+        .src_x = 0,
+        .src_y = 0,
+        .frame_w = width,
+        .frame_h = height,
+        .scale = scale,
+        .luma_w = luma_w,
+        .luma_h = luma_h,
+        .blocks_w = blocks_w,
+        .pass_index = 0,
+        .phase = phase,
+    };
+    cmd.bindPipeline(vk::PipelineBindPoint::eCompute, pipelines[2]);
+    cmd.bindDescriptorSets(vk::PipelineBindPoint::eCompute, pipeline_layouts[2], 0, set, {});
+    cmd.pushConstants(pipeline_layouts[2], vk::ShaderStageFlagBits::eCompute, 0, sizeof(Constants), &constants);
+    // (at odd scales the groups are shifted by half a group onto the blocks' centres: a group more)
+    const uint32_t shifted = (scale * BLOCK / 2) % GROUP != 0 ? 1 : 0;
+    cmd.dispatch((width + GROUP - 1) / GROUP + shifted, (height + GROUP - 1) / GROUP + shifted, 1);
+
+    // the screen pass (and its filter's compute passes) read it
+    const vk::MemoryBarrier made{
+        .srcAccessMask = vk::AccessFlagBits::eShaderWrite,
+        .dstAccessMask = vk::AccessFlagBits::eShaderRead,
+    };
+    cmd.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader, vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eFragmentShader,
+        vk::DependencyFlags(), made, {}, {});
+}
