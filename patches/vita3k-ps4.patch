+	ps4/ps4_settings.cpp
+	ps4/ps4_settings.h
+	ps4/ps4_vita_shell.cpp
+	ps4/ps4_vita_shell.h
+	ps4/ps4_wsi.cpp
+	ps4/ps4_wsi.h
+	ps4/ps4_stubs.c
+	${PS4_RUNTIME_SOURCES})
+
+# archive.h and the other headers next to main.cpp
+target_include_directories(vita3k PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
+target_link_libraries(vita3k PRIVATE camera dialog emuenv ime mem np overlay pugixml::pugixml stb vulkan SDL3::SDL3)
+# the launcher's firmware download and PKGj's (ps4_download.cpp)
+target_link_libraries(vita3k PRIVATE libcurl)
+
+# The network library's shares (port/ps4_netfs.cpp: SMB and NFS under /net)
