+        a0 = 1.0f + alpha;
+        a1 = -2.0f * cw;
+        a2 = 1.0f - alpha;
+        break;
+    case SCE_NGS_FILTER_HIGHPASS_RESONANT:
+        b0 = (1.0f + cw) * 0.5f;
+        b1 = -(1.0f + cw);
+        b2 = b0;
+        a0 = 1.0f + alpha;
+        a1 = -2.0f * cw;
+        a2 = 1.0f - alpha;
+        break;
+    case SCE_NGS_FILTER_BANDPASS_PEAK: {
+        const float peak = std::pow(10.0f, gain_db / 20.0f);
+        b0 = peak * alpha;
+        b1 = 0.0f;
+        b2 = -peak * alpha;
+        a0 = 1.0f + alpha;
+        a1 = -2.0f * cw;
+        a2 = 1.0f - alpha;
