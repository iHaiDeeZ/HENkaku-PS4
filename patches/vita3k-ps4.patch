+constexpr uint32_t PAGE = KiB(16);
+constexpr size_t SLAB = MiB(64);
+constexpr size_t LARGE_PAGE = MiB(2);
+constexpr size_t PAGES_PER_REGION = LARGE_PAGE / PAGE;
+constexpr int32_t WB_ONION = 0; // SCE_KERNEL_WB_ONION
+constexpr int32_t MAP_FIXED_FLAG = 0x10; // SCE_KERNEL_MAP_FIXED
+constexpr int32_t PROT_CPU_RW = 0x3;
+
+// The guest space is backed 2 MiB at a time, each region by 2 MiB of direct memory aligned like
+// its address, so the PS4 can map it with one large page. Backed 16 KiB at a time (up to v00.13),
+// the physical runs didn't line up with the addresses: every guest page took four of the CPU's
+// 4 KiB TLB entries, and the JIT's loads and stores spent their time in page walks (Jaguar's TLBs
+// hold a few hundred entries; a game's working set is tens of MiB).
+std::mutex mutex;
+uint8_t *base = nullptr;
+// For each 2 MiB region of the guest space: its physical region + 1, or 0 while it isn't backed
+std::vector<uint32_t> region_phys;
+// For each region: how many of its 16 KiB pages the allocator has committed
+std::vector<uint16_t> region_used;
+// For each 16 KiB page: committed by the allocator (a region goes back once none of its pages is)
+std::vector<uint8_t> page_committed;
+// Physical regions given back, used first
+std::vector<uint32_t> free_regions;
+// The rest of the newest block of direct memory
+off_t slab = 0;
+size_t slab_left = 0;
+size_t direct_total = 0;
+size_t committed = 0;
