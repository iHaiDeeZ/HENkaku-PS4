+const std::vector<std::string> &theme_names() {
+    static const std::vector<std::string> names = { "PS Vita blue", "Midnight", "Sakura", "Forest", "Sunset", "Carbon" };
+    return names;
+}
+
+std::string wallpaper_dir() {
+    return ps4_data_path("wallpapers");
+}
+
+std::vector<std::string> wallpaper_files() {
+    std::vector<std::string> files;
+    boost::system::error_code ec;
+    const fs::path dir = wallpaper_dir();
+    if (!fs::is_directory(dir, ec)) {
+        fs::create_directories(dir, ec);
+        return files;
+    }
+    for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        std::string ext = it->path().extension().string();
+        std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return std::tolower(c); });
+        if (ext == ".png" || ext == ".jpg" || ext == ".jpeg")
+            files.push_back(it->path().filename().string());
+    }
+    std::sort(files.begin(), files.end());
+    return files;
+}
