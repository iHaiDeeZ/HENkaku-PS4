+std::vector<Item> quick_menu(EmuEnvState &emuenv) {
+    const auto live = std::make_shared<LiveScope>(emuenv);
+    const std::string next_start = "next start";
+    std::vector<Item> items;
+
+    std::vector<Item> display;
+    display.push_back(section("Performance overlay"));
+    display.push_back(show_fps(emuenv));
+    display.push_back(global_choice<int>(emuenv, "FPS position", { "Top left", "Top centre", "Top right", "Bottom left", "Bottom centre", "Bottom right" }, { 0, 1, 2, 3, 4, 5 }, &Config::performance_overlay_position));
+    display.push_back(section("Picture"));
+    display.push_back(choice<std::string>(live, "Screen filter", FILTER_NAMES, FILTERS, &Config::CurrentConfig::screen_filter));
+    display.push_back(fsr_sharpness(emuenv));
+    display.push_back(frame_generation_choice());
+    display.push_back(touch_markers_choice());
+    display.push_back(choice<int>(live, "Texture filtering", { "Standard", "2x", "4x", "8x", "16x" }, { 1, 2, 4, 8, 16 }, &Config::CurrentConfig::anisotropic_filtering));
+
+    std::vector<Item> sound;
+    std::vector<std::string> labels;
+    std::vector<int> volumes;
+    for (int volume = 0; volume <= 100; volume += 10) {
+        labels.push_back(std::to_string(volume) + "%");
+        volumes.push_back(volume);
+    }
+    sound.push_back(choice<int>(live, "Volume", labels, volumes, &Config::CurrentConfig::audio_volume));
+
+    std::vector<Item> speed;
+    speed.push_back(choice<bool>(live, "Shader compiling", { "Background", "Before drawing" }, { true, false }, &Config::CurrentConfig::async_pipeline_compilation));
+    speed.push_back(choice<bool>(live, "FPS hack", { "Off", "On" }, { false, true }, &Config::CurrentConfig::fps_hack));
+    speed.push_back(frame_queue_choice());
+
+    items.push_back(section("Now"));
+    items.push_back(page("Display", std::move(display)));
+    items.push_back(page("Audio", std::move(sound)));
+    items.push_back(page("Speed", std::move(speed)));
+    {
+        std::vector<Item> controls = ps4controls::items(emuenv.io.app_path);
+        controls.push_back(section("Camera"));
+        controls.push_back(camera_choice(emuenv));
+        items.push_back(page("Controls", std::move(controls)));
+    }
+    items.push_back(section("Next start"));
+    if (!emuenv.io.app_path.empty())
+        items.push_back(page("This game", game_pages(emuenv, emuenv.io.app_path)));
+    items.push_back(section("HENkaku"));
+    items.push_back(page("Diagnostics", diagnostics_items()));
+    items.push_back(page("About", about_items()));
+    return items;
+}
