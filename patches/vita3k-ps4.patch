+// The status bar: HENkaku at the left; in the middle the home screen and the open LiveAreas (the
+// one on screen bright); the firmware's state and the time at the right
+void status_bar(Canvas &c, const app::FirmwareState &fw, const ps4ui::Image &henkaku, const std::vector<const ps4ui::Image *> &cards, float card_pos) {
+    c.fill_rect(0, 0, W, STATUS_H, rgb(0x000000, 90));
+    int x = 26;
+    if (!henkaku.empty()) {
+        c.draw_image(henkaku, x, STATUS_H / 2 - henkaku.height / 2);
+        x += henkaku.width + 12;
+    }
+    x += c.text(x, 42, "HENkaku", 28, TEXT, Weight::Bold) + 14;
+    c.text(x, 42, version_text(), 22, rgb(0xc8d6ee));
+    // home, then the cards, 56 px apart
+    const int n = static_cast<int>(cards.size()) + 1;
+    const float x0 = W / 2.f - (n - 1) * 28.f;
+    for (int i = 0; i < n; i++) {
+        const float near = std::clamp(1.f - std::fabs(card_pos - i), 0.f, 1.f);
+        const uint8_t a = static_cast<uint8_t>(120 + 135 * near);
+        const float cx = x0 + i * 56.f;
