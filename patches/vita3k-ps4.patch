new file mode 100644
index 00000000..baf4d8ea
--- /dev/null
+++ b/vita3k/ps4/ps4_download.cpp
@@ -0,0 +1,200 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: downloads with libcurl, which Vita3K links already (net_utils). Host names go through the
+// console's resolver (port/ps4_net.cpp wraps getaddrinfo); nothing here needs TLS, Sony's update
+// server is plain HTTP.
+
+#include "ps4_download.h"
+
+#include <util/log.h>
+
+#include <curl/curl.h>
+#include <fmt/format.h>
+
+#include <csignal>
+#include <cstdio>
+#include <mutex>
+
+namespace ps4download {
+
+namespace {
+
+const char *const SAVE_FAILED = "it couldn't be saved (is the PS4's storage full?)";
+
+struct Transfer {
+    FILE *file = nullptr;
+    uint64_t resumed = 0; // what the .part file had already
+    const Progress *progress = nullptr;
+    bool write_failed = false;
+};
+
+size_t on_data(char *data, size_t size, size_t count, void *user) {
+    auto *t = static_cast<Transfer *>(user);
+    const size_t bytes = size * count;
+    if (std::fwrite(data, 1, bytes, t->file) != bytes) {
+        t->write_failed = true;
+        return 0; // curl stops with CURLE_WRITE_ERROR
+    }
+    return bytes;
+}
+
+int on_progress(void *user, curl_off_t, curl_off_t now, curl_off_t, curl_off_t) {
+    auto *t = static_cast<Transfer *>(user);
+    return (*t->progress)(t->resumed + static_cast<uint64_t>(now)) ? 0 : 1;
+}
+
+std::string describe(CURLcode code, long http_status, const Transfer &t, const char *details) {
+    switch (code) {
+    case CURLE_COULDNT_RESOLVE_HOST:
+        return "the server couldn't be found (is the PS4 online?)";
+    case CURLE_COULDNT_CONNECT:
+        return "the server couldn't be reached";
+    case CURLE_OPERATION_TIMEDOUT:
+        return "the connection stalled";
+    case CURLE_HTTP_RETURNED_ERROR:
+        return fmt::format("the server answered {}", http_status);
+    case CURLE_WRITE_ERROR:
+        if (t.write_failed)
+            return SAVE_FAILED;
+        break;
+    default:
+        break;
+    }
+    return *details ? details : curl_easy_strerror(code);
+}
+
+uint64_t size_of(const fs::path &path) {
+    boost::system::error_code ec;
+    const auto size = fs::file_size(path, ec);
+    return ec ? 0 : static_cast<uint64_t>(size);
+}
+
+void init_curl() {
+    static std::once_flag init;
+    std::call_once(init, [] {
+        curl_global_init(CURL_GLOBAL_DEFAULT);
+        // a server that closes the connection raises SIGPIPE on the next write, which would end the app
+        std::signal(SIGPIPE, SIG_IGN);
+    });
+}
+
+} // namespace
+
+uint64_t remote_size(const std::string &url, std::string &error) {
+    init_curl();
+    char details[CURL_ERROR_SIZE] = {};
+    CURL *curl = curl_easy_init();
+    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl, CURLOPT_USERAGENT, "HENkaku (Vita3K)");
+    curl_easy_setopt(curl, CURLOPT_NOBODY, 1L);
+    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+    curl_easy_setopt(curl, CURLOPT_FAILONERROR, 1L);
+    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 20L);
+    curl_easy_setopt(curl, CURLOPT_TIMEOUT, 60L);
+    curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, details);
+    const CURLcode code = curl_easy_perform(curl);
+    long status = 0;
+    curl_off_t length = -1;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    curl_easy_getinfo(curl, CURLINFO_CONTENT_LENGTH_DOWNLOAD_T, &length);
+    curl_easy_cleanup(curl);
+    if (code != CURLE_OK) {
+        LOG_ERROR("Size of {}: {} ({}, HTTP {})", url, details, curl_easy_strerror(code), status);
+        error = describe(code, status, Transfer{}, details);
+        return 0;
+    }
+    if (length <= 0) {
+        LOG_ERROR("Size of {}: the server didn't say (HTTP {})", url, status);
+        error = "the server didn't say how big it is";
+        return 0;
+    }
+    return static_cast<uint64_t>(length);
+}
+
+Result download(const std::string &url, const fs::path &path, uint64_t size, const Progress &progress) {
+    init_curl();
+    boost::system::error_code ec;
+    if (size_of(path) == size)
+        return { Status::Done, {} };
+    fs::path part = path;
+    part += ".part";
+    uint64_t have = size_of(part);
+    if (have > size) {
+        fs::remove(part, ec);
+        have = 0;
+    }
+
+    // a second round only when the server wouldn't carry on where the .part file ends
+    for (int round = 0; round < 2 && have < size; round++) {
+        FILE *file = std::fopen(part.string().c_str(), have ? "ab" : "wb");
+        if (!file)
+            return { Status::Failed, "it couldn't be saved in " + part.parent_path().string() };
+        std::setvbuf(file, nullptr, _IOFBF, 1 << 20);
+        Transfer t{ file, have, &progress };
+        char details[CURL_ERROR_SIZE] = {};
+        CURL *curl = curl_easy_init();
+        curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+        curl_easy_setopt(curl, CURLOPT_USERAGENT, "HENkaku (Vita3K)");
+        curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+        curl_easy_setopt(curl, CURLOPT_FAILONERROR, 1L);
+        curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+        curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 20L);
+        // nothing for 30 s: give up (the next try carries on)
+        curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, 1L);
+        curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, 30L);
+        curl_easy_setopt(curl, CURLOPT_RESUME_FROM_LARGE, static_cast<curl_off_t>(have));
+        curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, on_data);
+        curl_easy_setopt(curl, CURLOPT_WRITEDATA, &t);
+        curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+        curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, on_progress);
+        curl_easy_setopt(curl, CURLOPT_XFERINFODATA, &t);
+        curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, details);
+        const CURLcode code = curl_easy_perform(curl);
+        long status = 0;
+        curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+        curl_easy_cleanup(curl);
+        if (std::fclose(file) != 0 && code == CURLE_OK)
+            return { Status::Failed, SAVE_FAILED };
+        if (code == CURLE_ABORTED_BY_CALLBACK)
+            return { Status::Stopped, {} };
+        if (code == CURLE_RANGE_ERROR || status == 416) {
+            // the server would send all of it again, or the .part file isn't part of what it has
+            LOG_WARN("Download of {}: no resuming at {} (HTTP {}), starting over", url, have, status);
+            fs::remove(part, ec);
+            have = 0;
+            continue;
+        }
+        if (code != CURLE_OK) {
+            LOG_ERROR("Download of {} failed: {} ({}, HTTP {})", url, details, curl_easy_strerror(code), status);
+            return { Status::Failed, describe(code, status, t, details) };
+        }
+        have = size_of(part);
+    }
+    if (have != size) {
+        LOG_ERROR("Download of {}: {} bytes, expected {}", url, have, size);
+        fs::remove(part, ec);
+        return { Status::Failed, have < size ? "the download ended early" : "the server's file isn't the expected one" };
+    }
+    fs::rename(part, path, ec);
+    if (ec)
+        return { Status::Failed, "it couldn't be saved: " + ec.message() };
+    return { Status::Done, {} };
+}
+
+} // namespace ps4download
