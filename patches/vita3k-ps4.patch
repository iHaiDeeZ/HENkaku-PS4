+#ifdef __PS4__
+// The PS4 has no overcommit: anonymous memory is flexible memory (a few hundred MiB, shared with
+// the eboot, the heap and the thread stacks), and mmap(PROT_NONE) can't reserve gigabytes. So the
+// 4 GiB of guest space is a virtual range reservation, and each host page the allocator commits is
+// backed by direct memory mapped in at its place, then given back to a free list when decommitted.
+// The PS4 maps and protects 16 KiB pages (sysconf says 4 KiB).
+extern "C" {
+// Declared by hand: several OpenOrbis prototypes are wrong.
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t length, size_t alignment, int32_t memory_type, off_t *physical_out);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int32_t protection, int32_t flags, off_t direct_memory_start, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void *address, size_t length);
+}
+
+namespace ps4_mem {
+
+constexpr uint32_t PAGE = KiB(16);
+constexpr size_t SLAB = MiB(64);
+constexpr size_t LARGE_PAGE = MiB(2);
+constexpr int32_t WB_ONION = 0; // SCE_KERNEL_WB_ONION
+constexpr int32_t MAP_FIXED_FLAG = 0x10; // SCE_KERNEL_MAP_FIXED
+constexpr int32_t PROT_CPU_RW = 0x3;
+
+std::mutex mutex;
+uint8_t *base = nullptr;
+// For each host page of the guest space: its physical page + 1, or 0 while not committed
+std::vector<uint32_t> phys_pages;
+// Physical pages given back, used first
+std::vector<uint32_t> free_pages;
+// The rest of the newest block of direct memory
+off_t slab = 0;
+size_t slab_left = 0;
+size_t direct_total = 0;
+size_t committed = 0;
+
+uint8_t *reserve(size_t size) {
+    // Above the kernel's own allocations at 0x200000000, away from the heap (0x1000000000) and
+    // RADV's GPU windows (0x4000000000-0x4600000000). A hint whose range isn't free fails
+    // instead of searching on, so try a few.
+    for (const uintptr_t hint : { 0x2000000000ULL, 0x2400000000ULL, 0x3000000000ULL, 0x1800000000ULL, 0x800000000ULL }) {
+        void *addr = reinterpret_cast<void *>(hint);
+        const int32_t ret = sceKernelReserveVirtualRange(&addr, size, 0, LARGE_PAGE);
+        if (ret == 0) {
+            const std::lock_guard<std::mutex> lock(mutex);
+            base = static_cast<uint8_t *>(addr);
+            phys_pages.assign(size / PAGE, 0);
+            LOG_INFO("PS4: {} MiB of guest address space at {}, {} MiB of direct memory reused", size >> 20, addr, (free_pages.size() * PAGE) >> 20);
+            return base;
+        }
+        LOG_WARN("PS4: reserving {} MiB at 0x{:X} failed: {:08X}", size >> 20, hint, static_cast<uint32_t>(ret));
+    }
+    return nullptr;
+}
+
+// Physical pages for a run of n host pages: one given back, else a contiguous piece of the newest
+// block of direct memory, else a new block. Returns how many it found (at least 1), 0 if none.
+size_t take(size_t n, off_t &phys) {
+    if (!free_pages.empty()) {
+        phys = static_cast<off_t>(free_pages.back()) * PAGE;
+        free_pages.pop_back();
+        return 1;
+    }
+    if (slab_left < PAGE) {
+        size_t size = std::max(SLAB, align(n * PAGE, LARGE_PAGE));
+        off_t start = 0;
+        int32_t ret = sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()), size, LARGE_PAGE, WB_ONION, &start);
+        if (ret != 0) {
+            // what's left, in smaller pieces
+            size = align(n * PAGE, PAGE);
+            ret = sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()), size, PAGE, WB_ONION, &start);
+        }
+        if (ret != 0) {
+            LOG_CRITICAL("PS4: out of direct memory ({} MiB in use for guest memory, {:08X})", direct_total >> 20, static_cast<uint32_t>(ret));
+            return 0;
+        }
+        direct_total += size;
+        slab = start;
+        slab_left = size;
+    }
+    const size_t pages = std::min<size_t>(n, slab_left / PAGE);
+    phys = slab;
+    slab += pages * PAGE;
+    slab_left -= pages * PAGE;
+    return pages;
+}
+
+// Unmaps a range of the guest space and reserves it again, so nothing else lands in it.
+void unmap_to_reserved(uint8_t *ptr, size_t size) {
+    sceKernelMunmap(ptr, size);
+    void *addr = ptr;
+    const int32_t ret = sceKernelReserveVirtualRange(&addr, size, MAP_FIXED_FLAG, PAGE);
+    LOG_CRITICAL_IF(ret != 0 || addr != ptr, "PS4: reserving {} again failed: {:08X}", static_cast<void *>(ptr), static_cast<uint32_t>(ret));
+}
+
+bool map_run(uint8_t *ptr, size_t size, off_t phys) {
+    void *addr = ptr;
+    // over the reservation, or failing that in its place
+    int32_t ret = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, MAP_FIXED_FLAG, phys, PAGE);
+    if (ret != 0 || addr != ptr) {
+        sceKernelMunmap(ptr, size);
+        addr = ptr;
+        ret = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, MAP_FIXED_FLAG, phys, PAGE);
+    }
+    if (ret != 0 || addr != ptr) {
+        LOG_CRITICAL("PS4: mapping {} KiB of direct memory at {} failed: {:08X}", size >> 10, static_cast<void *>(ptr), static_cast<uint32_t>(ret));
+        unmap_to_reserved(ptr, size);
+        return false;
+    }
+    return true;
+}
+
+// Backs the host pages of [ptr, ptr + size) that aren't yet (already committed ones keep their data).
+bool commit(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    const size_t first = (ptr - base) / PAGE;
+    const size_t last = (ptr + size - base + PAGE - 1) / PAGE;
+    for (size_t page = first; page < last;) {
+        if (phys_pages[page]) {
+            page++;
+            continue;
+        }
+        size_t end = page;
+        while (end < last && !phys_pages[end])
+            end++;
+        while (page < end) {
+            off_t phys = 0;
+            const size_t pages = take(end - page, phys);
+            if (!pages)
+                return false;
+            if (!map_run(base + page * PAGE, pages * PAGE, phys)) {
+                for (size_t i = 0; i < pages; i++)
+                    free_pages.push_back(static_cast<uint32_t>(phys / PAGE + i));
+                return false;
+            }
+            for (size_t i = 0; i < pages; i++)
+                phys_pages[page + i] = static_cast<uint32_t>(phys / PAGE + i + 1);
+            committed += pages * PAGE;
+            page += pages;
+        }
+    }
+    return true;
+}
+
+// Gives the physical pages of [ptr, ptr + size) back to the free list.
+void decommit(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    const size_t first = (ptr - base) / PAGE;
+    const size_t last = (ptr + size - base + PAGE - 1) / PAGE;
+    for (size_t page = first; page < last; page++) {
+        if (phys_pages[page]) {
+            free_pages.push_back(phys_pages[page] - 1);
+            phys_pages[page] = 0;
+            committed -= PAGE;
+        }
+    }
+    unmap_to_reserved(base + first * PAGE, (last - first) * PAGE);
+}
+
+// The whole guest space goes; its physical pages stay with us for the next one.
+void release(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    for (uint32_t &phys : phys_pages) {
+        if (phys) {
+            free_pages.push_back(phys - 1);
+            phys = 0;
+        }
+    }
+    committed = 0;
+    sceKernelMunmap(ptr, size);
+    base = nullptr;
+    phys_pages.clear();
+    phys_pages.shrink_to_fit();
+}
