+uint64_t VKTextureCache::release_all_cached_textures() {
+    uint64_t freed = 0;
+    for (auto &item : texture_queue.items) {
+        TextureCacheInfo &info = item.content;
+        if (info.texture_size == 0)
+            continue;
+
+        forget_content(info);
+        erase_key(info);
+        info.texture_size = 0;
+        info.dirty = false;
+        info.use_hash = false;
+        info.last_hash_scene = 0;
