+    uint8_t flag = 0;
+    seek_file(fd, sdslot_flag_offset(slot_id), SCE_SEEK_SET, emuenv.io, export_name);
+    read_file(&flag, emuenv.io, fd, sizeof(flag), export_name);
+    int n = 0;
