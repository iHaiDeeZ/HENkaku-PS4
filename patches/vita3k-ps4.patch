diff --git a/vita3k/shaders-builtin/vulkan/fg_motion.comp b/vita3k/shaders-builtin/vulkan/fg_motion.comp
new file mode 100644
index 00000000..f62c6673
--- /dev/null
+++ b/vita3k/shaders-builtin/vulkan/fg_motion.comp
@@ -0,0 +1,266 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#version 450
+// Frame generation, 2 of 3: per 8x8 block of the new frame's luma, where it was in the previous
+// frame's (the vector d: new(p) = previous(p + d)), by the sum of absolute differences plus a small
+// cost per pixel of motion away from the camera's (the frame before's most common vector), so flat
+// areas move with the camera (and keep still when it does). Coarse to fine, so camera pans are found:
+//   pass 3  on the luma at quarter size (fg_copy's 4x4 means): from no motion or the camera's,
+//           steps of 8, 4, 2 and 1, up to 16 (64 luma pixels)
+//   pass 0  on the luma at half size (fg_copy's 2x2 means): from no motion, the block's last coarse
+//           vector, the camera's or twice the quarter vectors around it, steps of 8, 4, 2 and 1, up
+//           to 40 (80 luma pixels)
+//   pass 1  on the luma: from the best of no motion, the block's vector in the frame before (its
+//           motion from the one before that), the camera's and twice the coarse vectors around it,
+//           steps of 2 and 1; a block whose best still differs by more than 0.07 a pixel is counted
+//           (it found no match), and a textured block (its luma's mean deviation over 0.023) whose best
+//           differs by more than half its texture (no real match anywhere); a textured block with
+//           a match counts its vector
+//   pass 2  one group: the most counted vector, the camera's (the next frame's search starts there)
+// Nearly all textured blocks without a match: a cut or a fade, where an in-between frame would be a
+// mess (fg_interp shows the new frame instead)
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(push_constant) uniform Constants {
+    ivec2 src_offset;
+    uvec2 frame_size;
+    uint scale;
+    uint luma_w;
+    uint luma_h;
+    uint blocks_w;
+    uint pass_index;
+    float phase;
+} c;
+
+layout(set = 0, binding = 0) readonly buffer Previous {
+    float previous[];
+};
+layout(set = 0, binding = 1) readonly buffer Current {
+    float current[];
+};
+layout(set = 0, binding = 2) buffer Vectors {
+    ivec2 vectors[];
+};
+layout(set = 0, binding = 3) buffer Coarse {
+    ivec2 coarse[];
+};
+layout(set = 0, binding = 4) buffer Judge {
+    uint no_match;
+    uint textured;
+    uint unmatched;
+    uint unused;
+    ivec2 camera;
+} judge;
+layout(set = 0, binding = 5) readonly buffer Last {
+    ivec2 last_vectors[];
+};
+// the frame before's judge (its camera)
+layout(set = 0, binding = 6) readonly buffer LastJudge {
+    uint no_match;
+    uint textured;
+    uint unmatched;
+    uint unused;
+    ivec2 camera;
+} last_judge;
+// the textured blocks' vectors with a match, counted (pass 1), cleared for each frame
+layout(set = 0, binding = 7) buffer Counts {
+    uint counts[];
+};
+// the frames' luma at half size, then at quarter size (fg_copy)
+layout(set = 0, binding = 8) readonly buffer PreviousLevels {
+    float previous_levels[];
+};
+layout(set = 0, binding = 9) readonly buffer CurrentLevels {
+    float current_levels[];
+};
+// the quarter pass's vectors
+layout(set = 0, binding = 10) buffer Quarter {
+    ivec2 quarter[];
+};
+
+const int BS = 8;
+const int LIMIT = 48; // luma pixels: the counts' range (the camera's)
+const int SIDE = 2 * LIMIT + 1;
+
+shared uint group_most[64];
+shared uint group_at[64];
+
+// the level's size: pass 3 the quarter, 0 the half, 1 the luma
+ivec2 level_size() {
+    const ivec2 luma = ivec2(int(c.luma_w), int(c.luma_h));
+    return c.pass_index == 3 ? (luma + 3) / 4 : c.pass_index == 0 ? (luma + 1) / 2 : luma;
+}
+
+float luma_at(bool is_current, ivec2 p) {
+    const ivec2 size = level_size();
+    const ivec2 q = clamp(p, ivec2(0), size - 1);
+    if (c.pass_index == 1)
+        return is_current ? current[q.y * size.x + q.x] : previous[q.y * size.x + q.x];
+    const ivec2 half_size = (ivec2(int(c.luma_w), int(c.luma_h)) + 1) / 2;
+    const int at = (c.pass_index == 3 ? half_size.x * half_size.y : 0) + q.y * size.x + q.x;
+    return is_current ? current_levels[at] : previous_levels[at];
+}
+
+// the camera's motion at this level
+ivec2 camera_here() {
+    return c.pass_index == 3 ? last_judge.camera / 4 : c.pass_index == 0 ? last_judge.camera / 2 : last_judge.camera;
+}
+
+float sad(ivec2 block, ivec2 d) {
+    float s = 0.0;
+    const ivec2 origin = block * BS;
+    for (int j = 0; j < BS; j++)
+        for (int i = 0; i < BS; i++)
+            s += abs(luma_at(true, origin + ivec2(i, j)) - luma_at(false, origin + ivec2(i, j) + d));
+    const ivec2 off = d - camera_here();
+    return s + 0.02 * float(abs(off.x) + abs(off.y));
+}
+
+void main() {
+    if (c.pass_index == 2) {
+        // the camera: the most counted vector (one group of 64)
+        const uint lane = gl_LocalInvocationIndex;
+        uint most = 0u, at = uint(LIMIT * SIDE + LIMIT); // (no motion when nothing was counted)
+        for (uint i = lane; i < uint(SIDE * SIDE); i += 64u) {
+            const uint n = counts[i];
+            if (n > most) {
+                most = n;
+                at = i;
+            }
+        }
+        group_most[lane] = most;
+        group_at[lane] = at;
+        barrier();
+        for (uint stride = 32u; stride > 0u; stride >>= 1) {
+            if (lane < stride && group_most[lane + stride] > group_most[lane]) {
+                group_most[lane] = group_most[lane + stride];
+                group_at[lane] = group_at[lane + stride];
+            }
+            barrier();
+        }
+        if (lane == 0u) {
+            // none from a cut (fg_interp's test), nor from a vector few blocks share
+            const uint blocks = c.blocks_w * uint((int(c.luma_h) + BS - 1) / BS);
+            const bool cut = judge.textured * 20u >= blocks ? judge.unmatched * 100u > judge.textured * 92u : judge.no_match * 4u > blocks;
+            judge.camera = cut || group_most[0] * 32u < blocks ? ivec2(0)
+                                                               : ivec2(int(group_at[0] % uint(SIDE)) - LIMIT, int(group_at[0] / uint(SIDE)) - LIMIT);
+        }
+        return;
+    }
+    const ivec2 block = ivec2(gl_GlobalInvocationID.xy);
+    const ivec2 blocks = (level_size() + BS - 1) / BS;
+    if (block.x >= blocks.x || block.y >= blocks.y)
+        return;
+    const int index = block.y * blocks.x + block.x;
+    const int limit = c.pass_index == 3 ? 16 : c.pass_index == 0 ? 40 : 80;
+
+    ivec2 d = ivec2(0);
+    float best = sad(block, d);
+    if (c.pass_index != 3) {
+        const ivec2 last = c.pass_index == 0 ? coarse[index] : last_vectors[index];
+        if (last != ivec2(0)) {
+            const float s = sad(block, last);
+            if (s < best) {
+                best = s;
+                d = last;
+            }
+        }
+    }
+    // the camera's motion
+    const ivec2 camera = camera_here();
+    if (camera != ivec2(0) && camera != d) {
+        const float s = sad(block, camera);
+        if (s < best) {
+            best = s;
+            d = camera;
+        }
+    }
+    if (c.pass_index == 0 || c.pass_index == 1) {
+        // the level above's vectors of the parent block and around it (twice: a level is twice the size)
+        const ivec2 above = (c.pass_index == 0 ? (ivec2(int(c.luma_w), int(c.luma_h)) + 3) / 4 : (ivec2(int(c.luma_w), int(c.luma_h)) + 1) / 2);
+        const ivec2 above_blocks = (above + BS - 1) / BS;
+        const ivec2 parent = block / 2;
+        for (int k = 0; k < 5; k++) {
+            const ivec2 around = k == 0 ? ivec2(0) : k == 1 ? ivec2(-1, 0) : k == 2 ? ivec2(1, 0) : k == 3 ? ivec2(0, -1) : ivec2(0, 1);
+            const ivec2 q = clamp(parent + around, ivec2(0), above_blocks - 1);
+            const int at = q.y * above_blocks.x + q.x;
+            const ivec2 candidate = clamp((c.pass_index == 0 ? quarter[at] : coarse[at]) * 2, ivec2(-limit), ivec2(limit));
+            if (candidate == d)
+                continue;
+            const float s = sad(block, candidate);
+            if (s < best) {
+                best = s;
+                d = candidate;
+            }
+        }
+    }
+    for (int step = c.pass_index == 1 ? 2 : 8; step >= 1; step >>= 1) {
+        ivec2 next = d;
+        float next_best = best;
+        for (int j = -1; j <= 1; j++) {
+            for (int i = -1; i <= 1; i++) {
+                if (i == 0 && j == 0)
+                    continue;
+                const ivec2 candidate = d + ivec2(i, j) * step;
+                if (abs(candidate.x) > limit || abs(candidate.y) > limit)
+                    continue;
+                const float s = sad(block, candidate);
+                if (s < next_best) {
+                    next_best = s;
+                    next = candidate;
+                }
+            }
+        }
+        d = next;
+        best = next_best;
+    }
+    if (c.pass_index == 3) {
+        quarter[index] = d;
+        return;
+    }
+    if (c.pass_index == 0) {
+        coarse[index] = d;
+        return;
+    }
+    vectors[index] = d;
+    const ivec2 off = d - camera;
+    const float differs = best - 0.02 * float(abs(off.x) + abs(off.y));
+    const bool matched = differs <= 0.07 * float(BS * BS);
+    if (!matched)
+        atomicAdd(judge.no_match, 1u);
+    // the block's texture: its luma's deviation from its mean (a flat block's vector is any motion)
+    float sum = 0.0;
+    const ivec2 origin = block * BS;
+    for (int j = 0; j < BS; j++)
+        for (int i = 0; i < BS; i++)
+            sum += luma_at(true, origin + ivec2(i, j));
+    const float mean = sum / float(BS * BS);
+    float texture = 0.0;
+    for (int j = 0; j < BS; j++)
+        for (int i = 0; i < BS; i++)
+            texture += abs(luma_at(true, origin + ivec2(i, j)) - mean);
+    if (texture > 1.5) {
+        atomicAdd(judge.textured, 1u);
+        if (differs > 0.5 * texture)
+            atomicAdd(judge.unmatched, 1u);
+        // a textured block with a match counts its vector (the camera's is the most counted)
+        if (matched && abs(d.x) <= LIMIT && abs(d.y) <= LIMIT)
+            atomicAdd(counts[(d.y + LIMIT) * SIDE + d.x + LIMIT], 1u);
+    }
+}
