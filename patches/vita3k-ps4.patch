+// To the next line that can be picked, up (step -1) or down
+void pause_overlay::move(int step) {
+    page_state &page = m_pages.back();
+    for (int i = page.selected + step; i >= 0 && i < static_cast<int>(m_rows.size()); i += step) {
+        if (selectable(i)) {
+            page.selected = i;
+            return;
+        }
+    }
+    // nothing further that way: the first line that can be picked, if the current one can't
+    if (!selectable(page.selected)) {
+        for (int i = 0; i < static_cast<int>(m_rows.size()); i++) {
+            if (selectable(i)) {
+                page.selected = i;
+                return;
+            }
+        }
+    }
+}
+
+// Left / right: the selected choice's previous / next value; right opens a page, left goes back
+void pause_overlay::change(int step) {
+    const page_state &page = m_pages.back();
+    if (!selectable(page.selected))
+        return;
+    const row &r = m_rows[page.selected];
+    if (r.type == row_kind::choice) {
+        const pause_menu_item &item = *r.item;
+        const int count = static_cast<int>(item.values.size());
+        if (count == 0 || !item.get || !item.set)
+            return;
+        const int current = std::clamp(item.get(), 0, count - 1);
+        item.set((current + step + count) % count);
+    } else if (r.type == row_kind::page && step > 0) {
+        confirm();
+    } else if (step < 0 && m_pages.size() > 1) {
+        back();
+    }
+}
+
+void pause_overlay::confirm() {
+    page_state &page = m_pages.back();
+    if (!selectable(page.selected))
+        return;
+    const row &r = m_rows[page.selected];
+    switch (r.type) {
+    case row_kind::resume:
+        m_session_controller.set_pause_reason(app::AppSessionPauseReason::All, false);
+        break;
+    case row_kind::exit:
+        m_session_controller.set_pause_reason(app::AppSessionPauseReason::All, false);
+        m_session_controller.request_stop();
+        break;
+    case row_kind::choice:
+        change(1);
+        break;
+    case row_kind::page:
+        m_pages.push_back({ r.item, 0, 0 });
+        build_rows();
+        layout();
+        break;
+    case row_kind::action:
+        if (r.item->run)
+            r.item->run();
+        break;
+    case row_kind::section:
+        break;
+    }
+}
+
+// The page before, or back to the game from the first one
+void pause_overlay::back() {
+    if (m_pages.size() > 1) {
+        m_pages.pop_back();
+        build_rows();
+        layout();
+    } else {
+        m_session_controller.set_pause_reason(app::AppSessionPauseReason::All, false);
+    }
+}
