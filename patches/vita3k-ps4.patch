+++ b/vita3k/shaders-builtin/vulkan/fg_interp.comp
@@ -0,0 +1,198 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#version 450
+// Frame generation, 3 of 3: the frame at a moment between two (the phase t: 0 the first frame, 1 the
+// second). Each pixel tries a few motions d (a point of the second frame at q was at q + d in the
+// first): none, the blocks' vectors around it blended (smooth motion), each of those 4 blocks' own
+// (an edge between two motions) and the camera's (fg_motion's most common vector). A try samples both
+// frames where the point was and will be (the first at p + d t, the second at p - d (1 - t)); a work
+// group is 8x8 pixels on the grid of the blocks' centres (all its pixels have the same 4 blocks), so
+// it shares its pixels' differences per try, and each pixel takes the try whose differences over its
+// neighbours (5x5, within the group) are the least: neighbours choose alike (no speckle, no torn
+// patches), no motion and the blend win near ties. The pixel is the two samples mixed by t; where the
+// best try still differs (something appears, is uncovered, or changes) it fades to the nearer frame:
+// along the blended vectors where the 4 blocks agree (at the frame's edges from the frame that shows
+// the point), as it is where they don't. A group where nothing moves (its 4 blocks and the camera
+// still) mixes the two frames. When fg_motion found a cut or a fade (nearly all textured blocks
+// without a match), the whole frame is the nearer one.
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(push_constant) uniform Constants {
+    ivec2 src_offset;
+    uvec2 frame_size;
+    uint scale;
+    uint luma_w;
+    uint luma_h;
+    uint blocks_w;
+    uint pass_index;
+    float phase;
+} c;
+
+layout(set = 0, binding = 0) uniform sampler2D previous;
+layout(set = 0, binding = 1) uniform sampler2D current;
+layout(set = 0, binding = 2) readonly buffer Vectors {
+    ivec2 vectors[];
+};
+layout(set = 0, binding = 3, rgba8) uniform writeonly image2D result;
+layout(set = 0, binding = 4) readonly buffer Judge {
+    uint no_match;
+    uint textured;
+    uint unmatched;
+    uint unused;
+    ivec2 camera;
+} judge;
+
+const int BS = 8;
+const vec3 WEIGHTS = vec3(0.299, 0.587, 0.114);
+// a match: the frames differ by less than this around the pixel (luma, 0 to 1); the result fades
+// from the made pixel to the nearer frame's between GOOD * 0.7 and GOOD * 1.6
+const float GOOD = 0.05;
+// the tries: no motion, the blend, the 4 blocks', the camera's, and how they're favoured
+const int TRIES = 7;
+const float BIAS[TRIES] = float[](0.9, 0.85, 1.0, 1.0, 1.0, 1.0, 0.95);
+// the neighbours a pixel's choice looks at: (2 RADIUS + 1)^2, within the group
+const int RADIUS = 2;
+
+shared float group_difference[TRIES][64];
+shared float group_rows[TRIES][64];
+
+vec2 vector_at(ivec2 b) {
+    const int blocks_h = (int(c.luma_h) + BS - 1) / BS;
+    b = clamp(b, ivec2(0), ivec2(int(c.blocks_w) - 1, blocks_h - 1));
+    return vec2(vectors[b.y * int(c.blocks_w) + b.x]);
+}
+
+float difference(vec3 a, vec3 b) {
+    return dot(abs(a - b), WEIGHTS);
+}
+
+bool inside(vec2 at, vec2 size) {
+    return all(greaterThanEqual(at, vec2(0.0))) && all(lessThanEqual(at, size));
+}
+
+void main() {
+    // (groups sit on the blocks' centres: shifted by half a group where half a block isn't a whole
+    // number of groups; threads off the frame work on its edge for their neighbours, store nothing)
+    const int shift = (int(c.scale) * BS / 2) % 8;
+    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) - ivec2(shift);
+    const bool live = all(greaterThanEqual(pixel, ivec2(0))) && pixel.x < int(c.frame_size.x) && pixel.y < int(c.frame_size.y);
+    const ivec2 q = clamp(pixel, ivec2(0), ivec2(c.frame_size) - 1);
+    const vec3 was = texelFetch(previous, q, 0).rgb;
+    const vec3 is = texelFetch(current, q, 0).rgb;
+    const vec3 nearer = c.phase < 0.5 ? was : is;
+    // a cut or a fade (the same for the whole frame): the nearer frame. Textured frames: nearly all
+    // their textured blocks found no match; frames with little texture: a quarter of the blocks
+    const uint blocks = c.blocks_w * uint((int(c.luma_h) + BS - 1) / BS);
+    const bool cut = judge.textured * 20u >= blocks ? judge.unmatched * 100u > judge.textured * 92u : judge.no_match * 4u > blocks;
+    if (cut) {
+        if (live)
+            imageStore(result, pixel, vec4(nearer, 1.0));
+        return;
+    }
+
+    const vec2 size = vec2(c.frame_size);
+    const vec2 p = vec2(q) + 0.5;
+    // the pixel among the blocks (their centres), in luma pixels
+    const vec2 at = p / float(c.scale) / float(BS) - 0.5;
+    const ivec2 b = ivec2(floor(at));
+    const vec2 f = at - vec2(b);
+    const float scale = float(c.scale);
+    const vec2 v00 = vector_at(b) * scale, v10 = vector_at(b + ivec2(1, 0)) * scale;
+    const vec2 v01 = vector_at(b + ivec2(0, 1)) * scale, v11 = vector_at(b + ivec2(1, 1)) * scale;
+    const vec2 blend = mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
+    const vec2 camera = vec2(judge.camera) * scale;
+    const vec2 none = vec2(0.0);
+    // nothing moves around here (the same for the whole group): the two frames mixed, where they
+    // differ (something changes in place) the nearer one
+    if (v00 == none && v10 == none && v01 == none && v11 == none && camera == none) {
+        const float w = smoothstep(GOOD * 0.7, GOOD * 1.6, difference(was, is));
+        if (live)
+            imageStore(result, pixel, vec4(mix(mix(was, is, c.phase), nearer, w), 1.0));
+        return;
+    }
+
+    // the tries, and which the group skips (the same for the whole group: no motion again, one the
+    // group already has; the blend stands for the 4 when they're alike)
+    const vec2 tries[TRIES] = vec2[](none, blend, v00, v10, v01, v11, camera);
+    const bool alike = v00 == v10 && v00 == v01 && v00 == v11;
+    bool skip[TRIES];
+    skip[0] = false;
+    skip[1] = alike && v00 == none;
+    skip[2] = alike || v00 == none;
+    skip[3] = alike || v10 == none || v10 == v00;
+    skip[4] = alike || v01 == none || v01 == v00 || v01 == v10;
+    skip[5] = alike || v11 == none || v11 == v00 || v11 == v10 || v11 == v01;
+    skip[6] = camera == none || camera == v00 || camera == v10 || camera == v01 || camera == v11;
+    const uint lane = gl_LocalInvocationIndex;
+    for (int i = 0; i < TRIES; i++) {
+        float m = 0.0;
+        if (!skip[i]) {
+            const vec3 from = textureLod(previous, (p + tries[i] * c.phase) / size, 0.0).rgb;
+            const vec3 to = textureLod(current, (p - tries[i] * (1.0 - c.phase)) / size, 0.0).rgb;
+            m = difference(from, to);
+        }
+        group_difference[i][lane] = m;
+    }
+    barrier();
+    // the differences summed over the neighbours: along the row, then down the column
+    const ivec2 l = ivec2(gl_LocalInvocationID.xy);
+    const ivec2 lo = max(l - RADIUS, ivec2(0)), hi = min(l + RADIUS, ivec2(7));
+    for (int i = 0; i < TRIES; i++) {
+        float sum = 0.0;
+        for (int x = lo.x; x <= hi.x; x++)
+            sum += group_difference[i][l.y * 8 + x];
+        group_rows[i][lane] = sum;
+    }
+    barrier();
+    const float count = float((hi.x - lo.x + 1) * (hi.y - lo.y + 1));
+    vec2 d = none;
+    float best = 1e9, best_difference = 1e9;
+    for (int i = 0; i < TRIES; i++) {
+        if (skip[i])
+            continue;
+        float sum = 0.0;
+        for (int y = lo.y; y <= hi.y; y++)
+            sum += group_rows[i][y * 8 + l.x];
+        const float m = sum / count;
+        const float score = m * BIAS[i];
+        if (score < best - 1e-4) {
+            best = score;
+            best_difference = m;
+            d = tries[i];
+        }
+    }
+
+    const vec3 before = textureLod(previous, (p + d * c.phase) / size, 0.0).rgb;
+    const vec3 after = textureLod(current, (p - d * (1.0 - c.phase)) / size, 0.0).rgb;
+    const vec3 made = mix(before, after, c.phase);
+    // no match: the nearer frame. Where the 4 blocks agree (one motion: what appears or changes there
+    // moves with it), along the blend, at the frame's edges from the frame that shows the point (the
+    // other one's is past its edge); where they don't (an edge between motions, a failed search), as
+    // it is (a warp along unlike vectors melts the picture)
+    const vec2 from = p + blend * c.phase, to = p - blend * (1.0 - c.phase);
+    const bool from_in = inside(from, size), to_in = inside(to, size);
+    const bool first = from_in != to_in ? from_in : c.phase < 0.5;
+    const vec3 along = first ? textureLod(previous, from / size, 0.0).rgb : textureLod(current, to / size, 0.0).rgb;
+    const vec2 s0 = abs(v00 - v10), s1 = abs(v00 - v01), s2 = abs(v00 - v11), s3 = abs(v10 - v01), s4 = abs(v10 - v11), s5 = abs(v01 - v11);
+    const float spread = max(max(max(s0.x + s0.y, s1.x + s1.y), max(s2.x + s2.y, s3.x + s3.y)), max(s4.x + s4.y, s5.x + s5.y)) / scale;
+    const vec3 lone = mix(along, nearer, smoothstep(2.0, 6.0, spread));
+    const float w = smoothstep(GOOD * 0.7, GOOD * 1.6, best_difference);
+    if (live)
+        imageStore(result, pixel, vec4(mix(made, lone, w), 1.0));
+}
