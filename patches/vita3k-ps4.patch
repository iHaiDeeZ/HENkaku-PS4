+namespace ps4settings {
+
+std::string icon_path() {
+    return "/app0/icons/henkaku.png";
+}
+
+const std::vector<std::string> &theme_names() {
+    static const std::vector<std::string> names = { "PS Vita blue", "Midnight", "Sakura", "Forest", "Sunset", "Carbon",
+        "Ocean", "Crimson", "Lavender", "Gold", "Custom colours" };
+    return names;
+}
+
+namespace {
+// in theme_names()' order, without "Custom colours"
+const ThemeColors THEMES[] = {
+    { 0x123ab0, 0x2662e2, 0xffffff, 0x9fe0ff }, // PS Vita blue
+    { 0x06080f, 0x161d33, 0x7896dc, 0x8fb4ff }, // Midnight
+    { 0x7a2a5c, 0xe48cb4, 0xffebf5, 0xffd2e8 }, // Sakura
+    { 0x08301f, 0x2a8250, 0xdcffe6, 0xa8ffc8 }, // Forest
+    { 0x46145a, 0xf07a3c, 0xffe6c8, 0xffc890 }, // Sunset
+    { 0x18181a, 0x3c3c42, 0xc8c8d2, 0xe0e0ea }, // Carbon
+    { 0x02303c, 0x1593a8, 0xd2fbff, 0x7ff0ff }, // Ocean
+    { 0x24040a, 0x9c1a2c, 0xffd6dc, 0xff8c9c }, // Crimson
+    { 0x2c1a52, 0xb48ce6, 0xf6eaff, 0xe2c8ff }, // Lavender
+    { 0x2e1e02, 0xc89412, 0xfff2cc, 0xffd666 }, // Gold
+};
+} // namespace
+
+int custom_theme() {
+    return static_cast<int>(std::size(THEMES));
+}
+
+ThemeColors theme_colors(const Prefs &prefs) {
+    if (prefs.theme == custom_theme())
+        return { prefs.custom_top, prefs.custom_bottom, prefs.custom_light, prefs.custom_accent };
+    return THEMES[std::clamp(prefs.theme, 0, custom_theme() - 1)];
+}
+
+std::vector<VitaTheme> vita_themes(const std::string &theme_root) {
+    std::vector<VitaTheme> themes;
+    boost::system::error_code ec;
+    for (fs::directory_iterator it(theme_root, ec), end; !ec && it != end; it.increment(ec)) {
+        const fs::path xml = it->path() / "theme.xml";
+        pugi::xml_document doc;
+        if (!doc.load_file(xml.string().c_str()))
+            continue;
+        const pugi::xml_node theme = doc.child("theme");
+        // a home screen picture at least
+        if (!theme.child("HomeProperty").child("m_bgParam").first_child())
+            continue;
+        const pugi::xml_node title = theme.child("InfomationProperty").child("m_title");
+        std::string name = title.child("m_default").text().as_string();
+        for (const pugi::xml_node child : title.children()) {
+            if (name.empty())
+                name = child.text().as_string();
+        }
+        themes.push_back({ it->path().filename().string(), name.empty() ? it->path().filename().string() : name });
+    }
+    std::sort(themes.begin(), themes.end(), [](const VitaTheme &a, const VitaTheme &b) { return a.title < b.title; });
+    return themes;
+}
+
+std::string wallpaper_dir() {
+    return ps4_data_path("wallpapers");
+}
+
+std::vector<std::string> wallpaper_files() {
+    std::vector<std::string> files;
+    boost::system::error_code ec;
+    const fs::path dir = wallpaper_dir();
+    if (!fs::is_directory(dir, ec)) {
+        fs::create_directories(dir, ec);
+        return files;
+    }
+    for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        std::string ext = it->path().extension().string();
+        std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return std::tolower(c); });
+        if (ext == ".png" || ext == ".jpg" || ext == ".jpeg")
+            files.push_back(it->path().filename().string());
+    }
+    std::sort(files.begin(), files.end());
+    return files;
+}
+
+std::vector<Item> global_pages(EmuEnvState &emuenv) {
+    const auto scope = std::make_shared<GlobalScope>(emuenv);
+    const std::string next_start = "next start";
+    std::vector<Item> pages;
+    pages.push_back(section("All games"));
+    pages.push_back(page("Display", display_items(emuenv, scope, true)));
+    pages.push_back(page("Graphics", graphics_items(emuenv, scope, true, next_start)));
+    pages.push_back(page("Audio", audio_items(scope, next_start)));
+    pages.push_back(page("CPU", cpu_items(scope, true, next_start)));
+    {
+        std::vector<Item> controls = ps4controls::items({});
+        controls.push_back(section("Camera"));
+        controls.push_back(camera_choice(emuenv));
+        pages.push_back(page("Controls", std::move(controls)));
+    }
+
+    std::vector<Item> system;
+    system.push_back(section("Buttons"));
+    system.push_back(global_choice<int>(emuenv, "Enter button", { "Cross", "Circle" },
+        { static_cast<int>(SCE_SYSTEM_PARAM_ENTER_BUTTON_CROSS), static_cast<int>(SCE_SYSTEM_PARAM_ENTER_BUTTON_CIRCLE) },
+        &Config::sys_button, next_start));
+    pages.push_back(section("PS4"));
+    pages.push_back(page("Themes", themes_items(emuenv), "colours, wallpaper, the home screen"));
+    pages.push_back(page("System", std::move(system)));
+    pages.push_back(page("Diagnostics", diagnostics_items()));
+    pages.push_back(page("About", about_items()));
+    return pages;
+}
+
+std::vector<Item> game_pages(EmuEnvState &emuenv, const std::string &app_path) {
+    const auto scope = std::make_shared<GameScope>(emuenv, app_path);
+    const std::string next_start = "next start";
+    std::vector<Item> pages;
+    pages.push_back(section("This game"));
+    pages.push_back(page("Display", display_items(emuenv, scope, false)));
+    pages.push_back(page("Graphics", graphics_items(emuenv, scope, false, next_start)));
+    pages.push_back(page("Audio", audio_items(scope, next_start)));
+    pages.push_back(page("CPU", cpu_items(scope, false, next_start)));
+    pages.push_back(page("Controls", ps4controls::items(app_path)));
+    pages.push_back(section("Reset"));
+    pages.push_back(action("Use all games' settings", [scope] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        scope->use_global();
+    }));
+    return pages;
+}
+
+std::vector<Item> quick_menu(EmuEnvState &emuenv) {
+    const auto live = std::make_shared<LiveScope>(emuenv);
+    const std::string next_start = "next start";
+    std::vector<Item> items;
+
+    std::vector<Item> display;
+    display.push_back(section("Performance overlay"));
+    display.push_back(show_fps(emuenv));
+    display.push_back(global_choice<int>(emuenv, "FPS position", { "Top left", "Top centre", "Top right", "Bottom left", "Bottom centre", "Bottom right" }, { 0, 1, 2, 3, 4, 5 }, &Config::performance_overlay_position));
+    display.push_back(section("Picture"));
+    display.push_back(choice<std::string>(live, "Screen filter", FILTER_NAMES, FILTERS, &Config::CurrentConfig::screen_filter));
+    display.push_back(fsr_sharpness(emuenv));
+    display.push_back(frame_generation_choice());
+    display.push_back(touch_markers_choice());
+    display.push_back(choice<int>(live, "Texture filtering", { "Standard", "2x", "4x", "8x", "16x" }, { 1, 2, 4, 8, 16 }, &Config::CurrentConfig::anisotropic_filtering));
+
+    std::vector<Item> sound;
+    std::vector<std::string> labels;
+    std::vector<int> volumes;
+    for (int volume = 0; volume <= 100; volume += 10) {
+        labels.push_back(std::to_string(volume) + "%");
+        volumes.push_back(volume);
+    }
+    sound.push_back(choice<int>(live, "Volume", labels, volumes, &Config::CurrentConfig::audio_volume));
+
+    std::vector<Item> speed;
+    speed.push_back(choice<bool>(live, "Shader compiling", { "Background", "Before drawing" }, { true, false }, &Config::CurrentConfig::async_pipeline_compilation));
+    speed.push_back(choice<bool>(live, "FPS hack", { "Off", "On" }, { false, true }, &Config::CurrentConfig::fps_hack));
+    speed.push_back(frame_queue_choice());
+
+    items.push_back(section("Now"));
+    items.push_back(page("Display", std::move(display)));
+    items.push_back(page("Audio", std::move(sound)));
+    items.push_back(page("Speed", std::move(speed)));
+    {
+        std::vector<Item> controls = ps4controls::items(emuenv.io.app_path);
+        controls.push_back(section("Camera"));
+        controls.push_back(camera_choice(emuenv));
+        items.push_back(page("Controls", std::move(controls)));
+    }
+    items.push_back(section("Next start"));
+    if (!emuenv.io.app_path.empty())
+        items.push_back(page("This game", game_pages(emuenv, emuenv.io.app_path)));
+    items.push_back(section("HENkaku"));
+    items.push_back(page("Diagnostics", diagnostics_items()));
+    items.push_back(page("About", about_items()));
+    return items;
+}
+
+} // namespace ps4settings
