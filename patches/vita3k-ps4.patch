index 00000000..58ddf62b
--- /dev/null
+++ b/vita3k/ps4/ps4_bgdl.cpp
@@ -0,0 +1,340 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: background downloads. Each queued package has a folder in ux0/bgdl/t, as on the PS Vita:
+// download.txt (title, url, type, size once known), license.rif (PKGj's), and the package itself,
+// a ".part" file until it's whole.
+
+#include "ps4_bgdl.h"
+
+#include <util/log.h>
+
+#include <fmt/format.h>
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <thread>
+
+namespace ps4bgdl {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr const char *JOB_FILE = "download.txt";
+constexpr const char *LICENSE_FILE = "license.rif";
+
+// queue's ids, and the thread's state below
+std::mutex g_mutex;
+bool g_running = false;
+bool g_more = false; // something was queued while the thread looked: it looks again
+std::string g_title; // the download going on
+uint64_t g_done = 0;
+uint64_t g_size = 0;
+int g_waiting = 0; // queued after it
+std::string g_last; // what happened last, said for a while
+Clock::time_point g_last_at{};
+
+fs::path root_of(const fs::path &vita_fs) {
+    return vita_fs / "ux0" / "bgdl" / "t";
+}
+
+fs::path stop_mark(const fs::path &vita_fs) {
+    return vita_fs / "ux0" / "bgdl" / "stopped";
+}
+
+bool is_id(const std::string &name) {
+    return name.size() == 8 && std::all_of(name.begin(), name.end(), [](unsigned char c) { return std::isxdigit(c); });
+}
+
+// the package's name: the URL's last part (PKGj's: EP0000-PCSB00000_00-....pkg on Sony's servers)
+std::string file_name(const std::string &url) {
+    std::string name = url.substr(0, url.find_first_of("?#"));
+    name = name.substr(name.find_last_of('/') + 1);
+    name.erase(std::remove_if(name.begin(), name.end(), [](unsigned char c) { return c < 0x20 || std::strchr("\\:*\"<>|", c); }), name.end());
+    if (name.empty() || name == "." || name == ".." || name == JOB_FILE || name == LICENSE_FILE)
+        return "package.pkg";
+    return name;
+}
+
+uint64_t size_of(const fs::path &path) {
+    boost::system::error_code ec;
+    const auto size = fs::file_size(path, ec);
+    return ec ? 0 : static_cast<uint64_t>(size);
+}
+
+bool save_job(const Download &d) {
+    const fs::path temp = d.dir / (std::string(JOB_FILE) + ".new");
+    {
+        std::string title = d.title;
+        std::replace_if(title.begin(), title.end(), [](char c) { return c == '\n' || c == '\r'; }, ' ');
+        fs::ofstream out(temp, std::ios::trunc);
+        out << "title=" << title << "\nurl=" << d.url << "\ntype=" << d.type << "\nsize=" << d.size << "\n";
+        out.flush();
+        if (!out.good())
+            return false;
+    }
+    boost::system::error_code ec;
+    fs::rename(temp, d.dir / JOB_FILE, ec);
+    return !ec;
+}
+
+std::optional<Download> load_job(const fs::path &dir) {
+    const std::string name = dir.filename().string();
+    if (!is_id(name))
+        return std::nullopt;
+    fs::ifstream in(dir / JOB_FILE);
+    if (!in)
+        return std::nullopt;
+    Download d;
+    d.dir = dir;
+    d.id = static_cast<int>(std::strtoul(name.c_str(), nullptr, 16) & 0x7fffffff);
+    std::string line;
+    while (std::getline(in, line)) {
+        const auto eq = line.find('=');
+        if (eq == std::string::npos)
+            continue;
+        const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+        if (key == "title")
+            d.title = value;
+        else if (key == "url")
+            d.url = value;
+        else if (key == "type")
+            d.type = std::atoi(value.c_str());
+        else if (key == "size")
+            d.size = std::strtoull(value.c_str(), nullptr, 10);
+    }
+    if (d.url.empty())
+        return std::nullopt;
+    if (d.title.empty())
+        d.title = file_name(d.url);
+    return d;
+}
+
+std::string short_title(const std::string &title) {
+    return title.size() > 40 ? title.substr(0, 37) + "..." : title;
+}
+
+// The game's downloads, one after the other, until none is left that this thread hasn't tried
+void worker(fs::path vita_fs) {
+    std::set<int> failed; // tried once here: the launcher tries them again
+    while (true) {
+        {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_more = false;
+        }
+        std::optional<Download> next;
+        int waiting = 0;
+        for (Download &d : list(vita_fs)) {
+            if (d.downloaded() || failed.contains(d.id))
+                continue;
+            if (next)
+                waiting++;
+            else
+                next = d;
+        }
+        if (!next) {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            if (g_more)
+                continue;
+            g_running = false;
+            g_title.clear();
+            return;
+        }
+        {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_title = next->title;
+            g_done = 0;
+            g_size = next->size;
+            g_waiting = waiting;
+        }
+        LOG_INFO("PS4 downloads: downloading {} from {}", next->title, next->url);
+        int logged = -1;
+        const ps4download::Result result = fetch(*next, [&](uint64_t done, uint64_t size) {
+            const std::lock_guard<std::mutex> lock(g_mutex);
+            g_done = done;
+            g_size = size;
+            // in the log every 10%
+            const int tenth = size ? static_cast<int>(done * 10 / size) : 0;
+            if (tenth != logged) {
+                logged = tenth;
+                LOG_INFO("PS4 downloads: {} at {}% ({} of {} MB)", next->title, tenth * 10, done >> 20, size >> 20);
+            }
+            return true;
+        });
+        const std::lock_guard<std::mutex> lock(g_mutex);
+        if (result.status == ps4download::Status::Done) {
+            LOG_INFO("PS4 downloads: {} downloaded", next->title);
+            g_last = short_title(next->title) + ": downloaded, it installs on the home screen";
+        } else {
+            LOG_ERROR("PS4 downloads: {} didn't download: {}", next->title, result.error);
+            failed.insert(next->id);
+            g_last = short_title(next->title) + " didn't download: " + result.error;
+        }
+        g_last_at = Clock::now();
+    }
+}
+
+} // namespace
+
+fs::path Download::package() const {
+    return dir / file_name(url);
+}
+
+fs::path Download::license() const {
+    return dir / LICENSE_FILE;
+}
+
+bool Download::downloaded() const {
+    // (the package gets its name only when it's whole)
+    const uint64_t have = size_of(package());
+    return have > 0 && (size == 0 || have == size);
+}
+
+int queue(const fs::path &vita_fs, int type, const std::string &url, const std::string &title, const std::vector<uint8_t> &license) {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    const fs::path root = root_of(vita_fs);
+    boost::system::error_code ec;
+    fs::create_directories(root, ec);
+    // one past the highest id there
+    int id = 1;
+    for (fs::directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec)) {
+        const std::string name = it->path().filename().string();
+        if (is_id(name))
+            id = std::max(id, static_cast<int>(std::strtoul(name.c_str(), nullptr, 16) & 0x7ffffffe) + 1);
+    }
+    Download d;
+    d.dir = root / fmt::format("{:08x}", id);
+    d.id = id;
+    d.type = type;
+    d.title = title;
+    d.url = url;
+    ec.clear();
+    fs::create_directories(d.dir, ec);
+    bool saved = !ec;
+    if (saved && !license.empty()) {
+        fs::ofstream out(d.license(), std::ios::binary | std::ios::trunc);
+        out.write(reinterpret_cast<const char *>(license.data()), static_cast<std::streamsize>(license.size()));
+        out.flush();
+        saved = out.good();
+    }
+    saved = saved && save_job(d);
+    if (!saved) {
+        LOG_ERROR("PS4 downloads: {} couldn't be queued in {}", title, d.dir);
+        fs::remove_all(d.dir, ec);
+        return -1;
+    }
+    fs::remove(stop_mark(vita_fs), ec);
+    LOG_INFO("PS4 downloads: queued {} as {:08x} ({}, type {:#x}, license of {} bytes)", title, id, url, type, license.size());
+    return id;
+}
+
+std::vector<Download> list(const fs::path &vita_fs) {
+    std::vector<Download> downloads;
+    boost::system::error_code ec;
+    for (fs::directory_iterator it(root_of(vita_fs), ec), end; !ec && it != end; it.increment(ec)) {
+        boost::system::error_code dir_ec;
+        if (!fs::is_directory(it->path(), dir_ec))
+            continue;
+        if (auto d = load_job(it->path()))
+            downloads.push_back(std::move(*d));
+    }
+    std::sort(downloads.begin(), downloads.end(), [](const Download &a, const Download &b) { return a.id < b.id; });
+    return downloads;
+}
+
+void remove(const Download &d) {
+    boost::system::error_code ec;
+    fs::remove_all(d.dir, ec);
+    if (ec)
+        LOG_WARN("PS4 downloads: {} couldn't be removed: {}", d.dir, ec.message());
+}
+
+bool stopped(const fs::path &vita_fs) {
+    boost::system::error_code ec;
+    return fs::exists(stop_mark(vita_fs), ec);
+}
+
+void set_stopped(const fs::path &vita_fs, bool stop) {
+    boost::system::error_code ec;
+    if (!stop) {
+        fs::remove(stop_mark(vita_fs), ec);
+        return;
+    }
+    fs::create_directories(stop_mark(vita_fs).parent_path(), ec);
+    fs::ofstream(stop_mark(vita_fs), std::ios::trunc);
+}
+
+ps4download::Result fetch(Download &d, const Progress &progress) {
+    if (d.downloaded())
+        return { ps4download::Status::Done, {} };
+    if (d.size == 0) {
+        std::string error;
+        d.size = ps4download::remote_size(d.url, error);
+        if (d.size == 0)
+            return { ps4download::Status::Failed, error };
+        save_job(d);
+    }
+    return ps4download::download(d.url, d.package(), d.size, [&](uint64_t done) { return progress(done, d.size); });
+}
+
+void start(const fs::path &vita_fs) {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_running) {
+        g_more = true;
+        return;
+    }
+    g_running = true;
+    std::thread(worker, vita_fs).detach();
+}
+
+std::string notice() {
+    const std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_running && !g_title.empty()) {
+        std::string text = "Downloading " + short_title(g_title);
+        if (g_size)
+            text += fmt::format(": {}%", g_done * 100 / g_size);
+        if (g_waiting)
+            text += fmt::format(" (+{} more)", g_waiting);
+        return text;
+    }
+    if (!g_last.empty() && Clock::now() - g_last_at < std::chrono::seconds(15))
+        return g_last;
+    return {};
+}
+
+} // namespace ps4bgdl
+
+// For modules/SceIpmi: the shell's download service
+int ps4_bgdl_queue(const fs::path &vita_fs, int type, const std::string &url, const std::string &title, const std::vector<uint8_t> &license) {
+    return ps4bgdl::queue(vita_fs, type, url, title, license);
+}
+
+void ps4_bgdl_start(const fs::path &vita_fs) {
+    ps4bgdl::start(vita_fs);
+}
+
+// For the renderer: the game's overlay
+std::string ps4_bgdl_notice() {
+    return ps4bgdl::notice();
+}
