+// --- the Trophy Collection (the firmware's app opens it) ---
+
+struct TrophyLine {
+    std::string name, detail, icon_path;
+    int grade = 0; // 1 platinum, 2 gold, 3 silver, 4 bronze
+    bool hidden = false;
+    bool earned = false;
+    int64_t earned_at = 0; // Unix time
+};
+struct TrophyGame {
+    std::string title, icon_path;
+    int total = 0, earned = 0;
+    std::array<int, 5> by_grade{}; // the earned ones, by grade
+    std::vector<TrophyLine> trophies;
+};
+struct TrophyView {
+    std::vector<TrophyGame> games;
+    int game = -1; // whose trophies are open (-1: the games)
+    int selected = 0, top = 0;
+    // pictures by path and size, loaded as they come into view
+    std::map<std::string, ps4ui::Image> pictures;
+};
+
+constexpr int TROPHY_Y = 236;
+constexpr int TROPHY_H = 740;
+constexpr int TROPHY_GAME_ROW = 148;
+constexpr int TROPHY_ROW = 114;
+
+Color grade_color(int grade) {
+    switch (grade) {
+    case 1: return rgb(0xbcd8f2);
+    case 2: return rgb(0xf2c230);
+    case 3: return rgb(0xc6ccd4);
+    case 4: return rgb(0xd08a4e);
+    default: return MUTED;
+    }
+}
+
+const char *grade_name(int grade) {
+    switch (grade) {
+    case 1: return "Platinum";
+    case 2: return "Gold";
+    case 3: return "Silver";
+    case 4: return "Bronze";
+    default: return "";
+    }
+}
+
+// "21 Oct 2026", in the PS4's time zone
+std::string date_text(int64_t when) {
+    time_t utc = static_cast<time_t>(when), local = utc;
+    uint32_t tsec[4] = {};
+    uint32_t dst = 0;
+    if (ps4l_utc_to_local(utc, &local, tsec, &dst) != 0)
+        local = utc;
+    std::tm tm{};
+    gmtime_r(&local, &tm);
+    static const char *const MONTHS[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
+    return fmt::format("{} {} {}", tm.tm_mday, MONTHS[std::clamp(tm.tm_mon, 0, 11)], tm.tm_year + 1900);
+}
+
+// A grade's dot and how many: returns the x after it
+int grade_count(Canvas &c, int x, int y, int grade, int count, int px) {
+    c.fill_circle(x + px * 0.4f, y - px * 0.36f, px * 0.36f, grade_color(grade));
+    x += static_cast<int>(px * 0.95f);
+    return x + c.text(x, y, std::to_string(count), px, TEXT) + px;
+}
+
+// The games with trophies (their progress), or a game's trophies (picture, name, what it's for,
+// grade, when it was earned), in the Trophy Collection's gold
+void draw_trophies(Canvas &c, TrophyView &view, const ps4ui::Image &icon) {
+    static const Canvas made = [] {
+        Canvas b(W, H);
+        b.clear_gradient(rgb(0x2a1f0c), rgb(0x050403));
+        b.fill_circle(1650, -160, 640, rgb(0xf2c230, 18));
+        return b;
+    }();
+    c.copy_from(made);
+    const Color GOLD = rgb(0xf2c230);
+    const auto picture = [&](const std::string &path, int w, int h) -> const ps4ui::Image & {
+        const std::string key = fmt::format("{}@{}x{}", path, w, h);
+        auto it = view.pictures.find(key);
+        if (it == view.pictures.end())
+            it = view.pictures.emplace(key, path.empty() ? ps4ui::Image{} : ps4ui::load_image(path, w, h)).first;
+        return it->second;
+    };
+
+    int tx = MARGIN;
+    if (!icon.empty()) {
+        c.draw_image(icon, MARGIN, 60);
+        tx += icon.width + 30;
+    }
+    c.text(tx, 122, "Trophy Collection", 66, TEXT, Weight::Bold);
+    if (view.game < 0) {
+        int earned = 0, total = 0;
+        std::array<int, 5> grades{};
+        for (const TrophyGame &g : view.games) {
+            earned += g.earned;
+            total += g.total;
+            for (size_t k = 0; k < grades.size(); k++)
+                grades[k] += g.by_grade[k];
+        }
+        int x = tx + 4 + c.text(tx + 4, 176, fmt::format("{} of {} trophies", earned, total), 32, GOLD) + 40;
+        for (int grade = 1; grade <= 4; grade++)
+            x = grade_count(c, x, 176, grade, grades[grade], 30);
+    } else {
+        c.text(tx + 4, 176, view.games[view.game].title, 32, GOLD, Weight::Regular, W - tx - MARGIN);
+    }
+    c.fill_rect(MARGIN, 206, W - 2 * MARGIN, 2, rgb(0xffffff, 30));
+
+    const bool games = view.game < 0;
+    const int count = games ? static_cast<int>(view.games.size()) : static_cast<int>(view.games[view.game].trophies.size());
+    if (count == 0) {
+        c.text_centered(W / 2, H / 2, games ? "No trophies yet: games add theirs when they start" : "This game has no trophies", 36, MUTED);
+        return;
+    }
+    const int row_h = games ? TROPHY_GAME_ROW : TROPHY_ROW;
+    const int rows = TROPHY_H / row_h;
+    view.selected = std::clamp(view.selected, 0, count - 1);
+    if (view.selected < view.top)
+        view.top = view.selected;
+    if (view.selected >= view.top + rows)
+        view.top = view.selected - rows + 1;
+    const int right = W - MARGIN - 38;
+    for (int i = view.top; i < std::min(count, view.top + rows); i++) {
+        const int y = TROPHY_Y + (i - view.top) * row_h;
+        const bool sel = i == view.selected;
+        c.fill_round_rect(MARGIN, y, W - 2 * MARGIN, row_h - 10, 18, sel ? rgb(0xf2c230, 64) : rgb(0xffffff, 14));
+        if (sel)
+            c.fill_round_rect(MARGIN, y + 16, 6, row_h - 42, 3, GOLD);
+        if (games) {
+            const TrophyGame &g = view.games[i];
+            // its trophy pack's picture (320x176 on the Vita), the name, a bar of how far it is, the grades
+            const ps4ui::Image &art = picture(g.icon_path, 218, 120);
+            if (!art.empty())
+                c.draw_image(art, MARGIN + 30, y + (row_h - 10 - art.height) / 2);
+            const int x = MARGIN + 30 + 218 + 36;
+            const int grades_w = 4 * 110;
+            c.text(x, y + 56, g.title, 36, TEXT, sel ? Weight::Bold : Weight::Regular, right - grades_w - 40 - x);
+            const int bar_w = 520, bar_y = y + 82;
+            c.fill_round_rect(x, bar_y, bar_w, 14, 7, rgb(0xffffff, 40));
+            if (g.total > 0 && g.earned > 0)
+                c.fill_round_rect(x, bar_y, std::max(14, bar_w * g.earned / g.total), 14, 7, GOLD);
+            c.text(x + bar_w + 24, bar_y + 14, fmt::format("{} / {}   {}%", g.earned, g.total, g.total ? 100 * g.earned / g.total : 0), 26, MUTED);
+            int gx = right - grades_w;
+            for (int grade = 1; grade <= 4; grade++)
+                gx = std::max(gx, grade_count(c, gx, y + 84, grade, g.by_grade[grade], 30));
+        } else {
+            const TrophyLine &t = view.games[view.game].trophies[i];
+            const bool secret = t.hidden && !t.earned;
+            // its picture (dimmed until earned; a secret one's is a question mark)
+            const int size = 92, ix = MARGIN + 30, iy = y + (row_h - 10 - size) / 2;
+            const ps4ui::Image &art = secret ? picture({}, size, size) : picture(t.icon_path, size, size);
+            if (!art.empty()) {
+                c.draw_image(art, ix, iy);
+                if (!t.earned)
+                    c.fill_rect(ix, iy, art.width, art.height, rgb(0x000000, 150));
+            } else {
+                c.fill_round_rect(ix, iy, size, size, 14, rgb(0x2b2416));
+                c.text_centered(ix + size / 2, iy + size / 2 + 16, "?", 48, MUTED, Weight::Bold);
+            }
+            const int x = ix + size + 32, info_w = 330;
+            c.text(x, y + 46, secret ? "Hidden trophy" : t.name, 32, t.earned ? TEXT : rgb(0xc9c2b0), sel ? Weight::Bold : Weight::Regular, right - info_w - 40 - x);
+            if (!secret)
+                c.text(x, y + 86, t.detail, 24, MUTED, Weight::Regular, right - info_w - 40 - x);
+            const int gx = right - info_w;
+            c.fill_circle(gx + 14.f, y + 36.f, 13.f, grade_color(t.grade));
+            c.text(gx + 38, y + 46, grade_name(t.grade), 28, grade_color(t.grade), Weight::Bold);
+            c.text(gx, y + 86, t.earned ? (t.earned_at > 0 ? "Earned " + date_text(t.earned_at) : std::string("Earned")) : std::string("Not earned"), 24, t.earned ? OK : MUTED);
+        }
+    }
+    if (view.top > 0)
+        c.text_centered(W / 2, TROPHY_Y - 8, "...", 30, MUTED, Weight::Bold);
+    if (view.top + rows < count)
+        c.text_centered(W / 2, TROPHY_Y + TROPHY_H + 26, "...", 30, MUTED, Weight::Bold);
+}
