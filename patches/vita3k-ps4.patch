     auto &touch = emuenv.touch;
     std::chrono::time_point<std::chrono::steady_clock> ts = std::chrono::steady_clock::now();
     uint64_t timestamp = std::chrono::duration_cast<std::chrono::microseconds>(ts.time_since_epoch()).count();
+#ifdef __PS4__
+    {
+        // both panels from the pad, as on a Vita: the front screen's 1920x1088, the rear pad's
+        // 1920 by 781 from y 108
+        const std::lock_guard<std::mutex> lock(ps4_touch_mutex);
+        SceTouchData *buffers = touch.touch_buffers[(touch.touch_buffer_idx + 1) % MAX_TOUCH_BUFFER_SAVED];
+        for (int port = 0; port < 2; port++) {
+            SceTouchData &data = buffers[port];
+            memset(&data, 0, sizeof(SceTouchData));
+            data.timeStamp = timestamp;
+            for (const Ps4TouchPoint &point : ps4_touch_points[port]) {
+                if (data.reportNum >= SCE_TOUCH_MAX_REPORT)
+                    break;
+                SceTouchReport &report = data.report[data.reportNum++];
+                report.id = point.id % 128;
+                report.force = touch.force_touch_enabled[port] ? 128 : 0;
+                report.x = static_cast<SceInt16>(std::clamp(point.x, 0.f, 1.f) * 1919);
+                report.y = port == SCE_TOUCH_PORT_FRONT ? static_cast<SceInt16>(std::clamp(point.y, 0.f, 1.f) * 1087)
+                                                        : static_cast<SceInt16>(108 + std::clamp(point.y, 0.f, 1.f) * 780);
+            }
+        }
+        touch.touch_buffer_idx++;
+        touch.touch_buffer_idx %= MAX_TOUCH_BUFFER_SAVED;
+        return;
+    }
