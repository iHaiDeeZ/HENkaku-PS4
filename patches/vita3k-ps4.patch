+    if (sector == last_sector)
+        return;
+    last_sector = sector;
+    logged++;
+    static const char *const NAMES[] = { "east", "north-east", "north", "north-west", "west", "south-west", "south", "south-east" };
+    const SceCtrlPadInputMode mode = from_ext ? state.input_mode_ext : state.input_mode;
+    LOG_INFO("PS4 input: the game read the left stick {} ({}, {}), mode {}, by {}{}{}", sector < 0 ? "in the middle" : NAMES[sector], data.lx, data.ly,
+        static_cast<int>(mode), is_peek ? "peek" : "read", is_v2 ? " v2" : "", from_ext ? " ext" : "");
