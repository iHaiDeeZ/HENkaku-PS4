+// --- the HENkaku settings, in the launcher ---
+
+using SItem = ps4settings::Item;
+
+struct SettingsLevel {
+    const std::vector<SItem> *items = nullptr;
+    std::string name;
+    int selected = 0;
+    int top = 0;
+};
+
+struct SettingsView {
+    // whose: "All games", or a game's name
+    std::string scope;
+    std::vector<SItem> root;
+    std::vector<SettingsLevel> stack;
+};
+
+constexpr int SET_Y = 236;
+constexpr int SET_ROW = 76;
+constexpr int SET_SECTION = 62;
+constexpr int SET_H = 740;
+
+bool settings_selectable(const SItem &item) {
+    return item.type != SItem::kind::section;
+}
+
+// To the next line that can be picked, up (-1) or down
+void settings_move(SettingsLevel &level, int step) {
+    const auto &items = *level.items;
+    for (int i = level.selected + step; i >= 0 && i < static_cast<int>(items.size()); i += step) {
+        if (settings_selectable(items[i])) {
+            level.selected = i;
+            return;
+        }
+    }
+    if (level.selected < static_cast<int>(items.size()) && !settings_selectable(items[level.selected])) {
+        for (int i = 0; i < static_cast<int>(items.size()); i++) {
+            if (settings_selectable(items[i])) {
+                level.selected = i;
+                return;
+            }
+        }
+    }
+}
+
+void settings_open(SettingsView &view, std::string scope, std::vector<SItem> root) {
+    view.scope = std::move(scope);
+    view.root = std::move(root);
+    view.stack.clear();
+    view.stack.push_back({ &view.root, {}, 0, 0 });
+    settings_move(view.stack.back(), 1);
+}
+
+int choice_value(const SItem &item) {
+    const int count = static_cast<int>(item.values.size());
+    return (count > 0 && item.get) ? std::clamp(item.get(), 0, count - 1) : -1;
+}
+
+// Left / right on a choice: its previous / next value
+void settings_change(const SItem &item, int step) {
+    const int count = static_cast<int>(item.values.size());
+    if (item.type != SItem::kind::choice || count == 0 || !item.set)
+        return;
+    item.set((std::max(choice_value(item), 0) + step + count) % count);
+}
+
+void draw_settings(Canvas &c, SettingsView &view, const ps4ui::Image &henkaku) {
+    static const Canvas made = [] {
+        Canvas c(W, H);
+        c.clear_gradient(rgb(0x10203c), rgb(0x03060d));
+        c.fill_circle(1700, -120, 620, rgb(0x2a6fd6, 22));
+        return c;
+    }();
+    c.copy_from(made);
+    // the heading: the ensō, HENkaku, whose settings and which page
+    int tx = MARGIN;
+    if (!henkaku.empty()) {
+        c.draw_image(henkaku, MARGIN, 60);
+        tx += henkaku.width + 30;
+    }
+    c.text(tx, 122, "HENkaku", 66, TEXT, Weight::Bold);
+    std::string path = view.scope;
+    for (size_t i = 1; i < view.stack.size(); i++)
+        path += "   >   " + view.stack[i].name;
+    c.text(tx + 4, 176, path, 32, ACCENT, Weight::Regular, W - tx - MARGIN);
+    c.fill_rect(MARGIN, 206, W - 2 * MARGIN, 2, rgb(0xffffff, 30));
+
+    SettingsLevel &level = view.stack.back();
+    const auto &items = *level.items;
+    const int count = static_cast<int>(items.size());
+    const auto height_of = [&](int i) { return items[i].type == SItem::kind::section ? SET_SECTION : SET_ROW; };
+    const auto span = [&](int first, int last) {
+        int h = 0;
+        for (int i = first; i <= last; i++)
+            h += height_of(i);
+        return h;
+    };
+    // the selection in view, with its section's heading when that's right above it
+    if (level.selected < level.top)
+        level.top = level.selected;
+    if (level.top > 0 && level.top == level.selected && items[level.top - 1].type == SItem::kind::section)
+        level.top--;
+    while (level.top < level.selected && span(level.top, level.selected) > SET_H)
+        level.top++;
+
+    int y = SET_Y;
+    int last = level.top - 1;
+    for (int i = level.top; i < count; i++) {
+        const int h = height_of(i);
+        if (y + h > SET_Y + SET_H)
+            break;
+        last = i;
+        const SItem &item = items[i];
+        if (item.type == SItem::kind::section) {
+            c.text(MARGIN + 6, y + 44, item.name, 26, ACCENT, Weight::Bold);
+            y += h;
+            continue;
+        }
+        const bool sel = i == level.selected;
+        c.fill_round_rect(MARGIN, y, W - 2 * MARGIN, h - 10, 18, sel ? rgb(0x2a6fd6, 120) : rgb(0xffffff, 14));
+        if (sel)
+            c.fill_round_rect(MARGIN, y + 16, 6, h - 42, 3, ACCENT);
+        const int name_w = c.text(MARGIN + 38, y + 47, item.name, 32, TEXT, sel ? Weight::Bold : Weight::Regular, 900);
+        const int right = W - MARGIN - 38;
+        if (item.type == SItem::kind::choice) {
+            if (!item.note.empty())
+                c.text(MARGIN + 38 + name_w + 18, y + 45, item.note, 24, MUTED);
+            const int value = choice_value(item);
+            const std::string text = value >= 0 ? "<   " + item.values[value] + "   >" : std::string();
+            c.text(right - c.text_width(text, 30, Weight::Bold), y + 46, text, 30, sel ? TEXT : ACCENT, Weight::Bold);
+        } else if (item.type == SItem::kind::page) {
+            const std::string text = item.note.empty() ? std::string(">") : item.note + "     >";
+            c.text(right - c.text_width(text, 28), y + 46, text, 28, MUTED);
+        }
+        y += h;
+    }
+    // more above or below
+    if (level.top > 0)
+        c.text_centered(W / 2, SET_Y - 8, "...", 30, MUTED, Weight::Bold);
+    if (last + 1 < count)
+        c.text_centered(W / 2, SET_Y + SET_H + 26, "...", 30, MUTED, Weight::Bold);
+}
