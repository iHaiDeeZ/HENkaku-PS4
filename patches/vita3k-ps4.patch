+            ".pkg packages, with a .zrif file of the same name holding the zRIF",
+            "from /data/Vita3K/install (copy them there over FTP), anywhere on the PS4's storage, or a USB drive",
+            "The PS Vita firmware and font package download from Sony by themselves when they're missing (Square)",
+        };
+        int ly = y + 24;
+        for (const char *line : lines) {
+            c.fill_circle(MARGIN + 82.f, ly - 10.f, 6.f, ACCENT);
+            ly = c.text_wrapped(MARGIN + 104, ly, line, 30, TEXT, cw - 200, 42) + 14;
+        }
+        return;
+    }
+    for (int row = 0; row < VISIBLE_ROWS && top + row < static_cast<int>(items.size()); row++) {
+        Item &item = items[top + row];
+        const int y = LIST_Y + row * ROW_H;
+        const bool sel = top + row == selected;
+        if (sel) {
+            c.fill_round_rect(LIST_X - 16, y, LIST_W + 32, ROW_H - 8, 22, rgb(0x2a6fd6, 90));
+            c.fill_round_rect(LIST_X - 16, y + 18, 6, ROW_H - 44, 3, ACCENT);
+        }
+        ensure_icons(item);
+        const int iy = y + (ROW_H - 8 - ICON) / 2;
+        if (!item.small.empty())
+            c.draw_image(item.small, LIST_X + 8 + (ICON - item.small.width) / 2, iy + (ICON - item.small.height) / 2);
+        else
+            icon_placeholder(c, LIST_X + 8, iy, ICON);
+        const int tx = LIST_X + ICON + 36;
+        c.text(tx, y + 50, item.entry.title, 36, sel ? TEXT : rgb(0xd5dbe7), sel ? Weight::Bold : Weight::Regular, LIST_W - ICON - 60);
+        c.text(tx, y + 86, item.entry.title_id + (item.entry.app_ver.empty() ? "" : "   v" + item.entry.app_ver), 24, MUTED);
+    }
+    // where the list is, when it's longer than the screen
+    if (static_cast<int>(items.size()) > VISIBLE_ROWS) {
+        const int track_h = VISIBLE_ROWS * ROW_H - 8;
+        const int thumb_h = std::max(40, track_h * VISIBLE_ROWS / static_cast<int>(items.size()));
+        const int thumb_y = LIST_Y + (track_h - thumb_h) * top / (static_cast<int>(items.size()) - VISIBLE_ROWS);
+        c.fill_round_rect(LIST_X + LIST_W + 30, LIST_Y, 6, track_h, 3, rgb(0xffffff, 24));
+        c.fill_round_rect(LIST_X + LIST_W + 30, thumb_y, 6, thumb_h, 3, rgb(0xffffff, 90));
+    }
+    // the selected app, larger
+    Item &item = items[selected];
+    ensure_icons(item);
+    const int ix = PANEL_X + (PANEL_W - BIG_ICON) / 2;
+    if (!item.large.empty())
+        c.draw_image(item.large, ix + (BIG_ICON - item.large.width) / 2, LIST_Y + 10 + (BIG_ICON - item.large.height) / 2);
+    else
+        icon_placeholder(c, ix, LIST_Y + 10, BIG_ICON);
+    int y = c.text_wrapped(PANEL_X, LIST_Y + BIG_ICON + 80, item.entry.title, 40, TEXT, PANEL_W, 52, Weight::Bold);
+    c.text(PANEL_X, y + 6, item.entry.title_id, 28, MUTED);
+    if (!item.entry.app_ver.empty())
+        c.text(PANEL_X, y + 46, "Version " + item.entry.app_ver, 28, MUTED);
+}
+
+// --- the install browser ---
+
+constexpr int BROWSER_Y = 286; // its list (its heading above)
+constexpr int BROWSER_ROWS = 6;
+
+bool has_zrif(Entry &e) {
+    if (e.zrif < 0)
+        e.zrif = read_zrif(e.path).empty() ? 0 : 1;
+    return e.zrif == 1;
+}
+
+// An entry's picture: a folder, or a tile saying what the file is
+void draw_entry_icon(Canvas &c, const Entry &e, int x, int y, int size) {
+    const float s = static_cast<float>(size);
+    if (e.kind == Kind::Folder || e.kind == Kind::GameFolder) {
+        const Color color = e.kind == Kind::GameFolder ? OK : rgb(0xe8b84a);
+        c.fill_round_rect(x + size / 10, y + size / 5, size * 2 / 5, size / 4, size / 14, color);
+        c.fill_round_rect(x + size / 10, y + size * 3 / 10, size * 4 / 5, size * 11 / 20, size / 12, color);
+        if (e.kind == Kind::GameFolder)
+            c.text_centered(x + size / 2, y + size * 13 / 20, "GAME", size / 5, rgb(0x0d2347), Weight::Bold);
+        return;
+    }
+    c.fill_round_rect(x, y, size, size, size / 6, rgb(0x1b2a44));
+    if (e.kind == Kind::Location && e.path == INSTALL_DIR) {
+        // an arrow into a tray
+        const float cx = x + s / 2;
+        c.line(cx, y + s * 0.2f, cx, y + s * 0.6f, s / 14, ACCENT);
+        c.line(cx - s * 0.16f, y + s * 0.45f, cx, y + s * 0.62f, s / 14, ACCENT);
+        c.line(cx + s * 0.16f, y + s * 0.45f, cx, y + s * 0.62f, s / 14, ACCENT);
+        c.line(x + s * 0.24f, y + s * 0.78f, x + s * 0.76f, y + s * 0.78f, s / 14, ACCENT);
+        return;
+    }
+    std::string label;
+    Color color = ACCENT;
+    switch (e.kind) {
+    case Kind::Location:
+        label = e.path.string().rfind("/mnt/usb", 0) == 0 ? "USB" : "PS4";
+        break;
+    case Kind::Archive:
+        label = e.path.extension().string().substr(1);
+        std::transform(label.begin(), label.end(), label.begin(), [](unsigned char ch) { return static_cast<char>(std::toupper(ch)); });
+        break;
+    case Kind::Package:
+        label = "PKG";
+        color = rgb(0xb48cff);
+        break;
+    case Kind::Update:
+        label = "PUP";
+        color = WARN;
+        break;
+    case Kind::License:
+        label = "RIF";
+        color = MUTED;
+        break;
+    default:
+        break;
+    }
+    c.text_centered(x + size / 2, y + size / 2 + size / 9, label, size / 4, color, Weight::Bold);
+    c.fill_round_rect(x + size / 4, y + size * 3 / 4, size / 2, std::max(3, size / 22), std::max(1, size / 44), color);
+}
+
+// The line under an entry's name
+std::string entry_summary(Entry &e) {
+    switch (e.kind) {
+    case Kind::Location: return e.path.string();
+    case Kind::Folder: return "Folder";
+    case Kind::GameFolder: return "Dumped game folder";
+    case Kind::Archive: return "PS Vita app archive   " + size_text(e.size);
+    case Kind::Package: return "PS Vita package   " + size_text(e.size) + (has_zrif(e) ? "" : "   no .zrif file");
+    case Kind::Update: return "PS Vita update file   " + size_text(e.size);
+    case Kind::License: return "PS Vita license";
+    }
+    return {};
+}
+
+// What the panel says about the selected entry
+std::vector<std::string> entry_details(Entry &e) {
+    std::vector<std::string> lines;
+    switch (e.kind) {
+    case Kind::Location:
+        lines = { e.path.string(), "Cross opens it" };
+        break;
+    case Kind::Folder:
+        lines = { "Cross opens it" };
+        break;
+    case Kind::GameFolder:
+        lines = { "A dumped game: its files are copied into Vita3K", "Cross installs it" };
+        break;
+    case Kind::Archive:
+        lines = { "PS Vita app archive, " + size_text(e.size), "Cross installs it" };
+        break;
+    case Kind::Package:
+        lines = { "PS Vita package, " + size_text(e.size),
+            has_zrif(e) ? std::string("Its zRIF is in the .zrif file next to it")
+                        : std::string("Its zRIF goes in a text file of the same name ending in .zrif (unless its .rif license is installed)"),
+            "Cross installs it" };
+        break;
+    case Kind::Update:
+        lines = { "PS Vita update file (the firmware or the font package), " + size_text(e.size), "Cross installs it" };
+        break;
+    case Kind::License:
+        lines = { "PS Vita license, for the packages that need one", "Cross installs it" };
+        break;
+    }
+    if (installable(e.kind) && e.path.parent_path() == INSTALL_DIR)
+        lines.push_back("Once it's installed it moves to install/done");
+    return lines;
+}
+
+void draw_browser(Canvas &c, const fs::path &dir, std::vector<Entry> &entries, int selected, int top) {
+    const int hx = c.text(MARGIN, 250, "Install", 44, TEXT, Weight::Bold);
+    c.text(MARGIN + hx + 28, 250, dir.empty() ? std::string("Where are the files?") : dir.string(), 30, MUTED, Weight::Regular, W - 2 * MARGIN - hx - 28);
+    if (entries.empty()) {
+        const int cw = W - 2 * MARGIN;
+        c.fill_round_rect(MARGIN, BROWSER_Y + 10, cw, 400, 32, rgb(0x14213a, 220));
+        c.text(MARGIN + 64, BROWSER_Y + 110, "Nothing to install here", 44, TEXT, Weight::Bold);
+        c.text_wrapped(MARGIN + 64, BROWSER_Y + 180,
+            "Vita3K installs .vpk and .zip archives, .pkg packages (with a .zrif file of the same name holding the zRIF), dumped game folders, PS Vita update files (.PUP) and licenses (.rif). Copy them here over FTP, or go back (Circle) and open a USB drive.",
+            30, MUTED, cw - 128, 44);
+        return;
+    }
+    const int count = static_cast<int>(entries.size());
+    for (int row = 0; row < BROWSER_ROWS && top + row < count; row++) {
+        Entry &e = entries[top + row];
+        const int y = BROWSER_Y + row * ROW_H;
+        const bool sel = top + row == selected;
+        if (sel) {
+            c.fill_round_rect(LIST_X - 16, y, LIST_W + 32, ROW_H - 8, 22, rgb(0x2a6fd6, 90));
+            c.fill_round_rect(LIST_X - 16, y + 18, 6, ROW_H - 44, 3, ACCENT);
+        }
+        draw_entry_icon(c, e, LIST_X + 8, y + (ROW_H - 8 - ICON) / 2, ICON);
+        const int tx = LIST_X + ICON + 36;
+        c.text(tx, y + 50, e.name, 36, sel ? TEXT : rgb(0xd5dbe7), sel ? Weight::Bold : Weight::Regular, LIST_W - ICON - 60);
+        c.text(tx, y + 86, entry_summary(e), 24, MUTED, Weight::Regular, LIST_W - ICON - 60);
+    }
+    if (count > BROWSER_ROWS) {
+        const int track_h = BROWSER_ROWS * ROW_H - 8;
+        const int thumb_h = std::max(40, track_h * BROWSER_ROWS / count);
+        const int thumb_y = BROWSER_Y + (track_h - thumb_h) * top / (count - BROWSER_ROWS);
+        c.fill_round_rect(LIST_X + LIST_W + 30, BROWSER_Y, 6, track_h, 3, rgb(0xffffff, 24));
+        c.fill_round_rect(LIST_X + LIST_W + 30, thumb_y, 6, thumb_h, 3, rgb(0xffffff, 90));
+    }
+    // the selected one, larger, and what Cross does with it
+    Entry &e = entries[selected];
+    constexpr int big = 200;
+    draw_entry_icon(c, e, PANEL_X + (PANEL_W - big) / 2, BROWSER_Y + 10, big);
+    int y = c.text_wrapped(PANEL_X, BROWSER_Y + big + 80, e.name, 36, TEXT, PANEL_W, 46, Weight::Bold);
+    for (const std::string &line : entry_details(e))
+        y = c.text_wrapped(PANEL_X, y + 12, line, 28, MUTED, PANEL_W, 38);
+}
+
+void draw_notice(Canvas &c, const std::string &notice) {
+    if (notice.empty())
+        return;
+    const int nw = W - 2 * MARGIN;
+    // one line per line of the notice, at most four
+    int lines = 1 + static_cast<int>(std::count(notice.begin(), notice.end(), '\n'));
+    lines = std::min(lines, 4);
+    const int nh = 30 + lines * 40;
+    const int ny = 960 - nh;
+    c.fill_round_rect(MARGIN, ny, nw, nh, 20, rgb(0x14213a, 235));
+    c.fill_round_rect(MARGIN, ny, 8, nh, 4, ACCENT);
+    c.text_wrapped(MARGIN + 36, ny + 50, notice, 28, TEXT, nw - 72, 40);
+}
+
+} // namespace
+
+void show_message(const std::string &title, const std::string &detail) {
+    Canvas c(W, H);
+    background(c);
+    const int x = c.text(MARGIN, 128, "Vita3K", 76, TEXT, Weight::Bold);
+    c.text(MARGIN + x + 18, 128, "for PS4", 38, ACCENT);
+    c.text_centered(W / 2, H / 2 - 10, title, 56, TEXT, Weight::Bold);
+    // one line centered, a longer one (an error) wrapped
+    if (c.text_width(detail, 32) <= W - 2 * MARGIN)
+        c.text_centered(W / 2, H / 2 + 60, detail, 32, MUTED);
+    else
+        c.text_wrapped(MARGIN, H / 2 + 60, detail, 32, MUTED, W - 2 * MARGIN, 44);
+    present(c);
+}
+
+Choice run(EmuEnvState &emuenv, const std::string &notice_text) {
+    Canvas canvas(W, H);
+    std::vector<Item> items = load_items(emuenv);
+    app::FirmwareState fw = app::get_firmware_state(emuenv);
+    int selected = 0;
+    int top = 0;
+    // the last game started is selected again
+    static std::string last_app_path;
+    for (size_t i = 0; i < items.size(); i++) {
+        if (!last_app_path.empty() && items[i].entry.path == last_app_path)
+            selected = static_cast<int>(i);
+    }
+    std::string notice = notice_text;
+    auto notice_until = Clock::now() + std::chrono::seconds(notice.empty() ? 0 : 12);
+    InstallJob job;
+    const auto start_firmware = [&] {
+        reset(job, true);
+        job.thread = std::thread([&emuenv, &job, downloads = missing_firmware(fw)] { firmware_worker(emuenv, job, downloads); });
+        notice.clear();
+    };
+    // the install browser (Triangle), where it was the last time
+    static fs::path browse_dir = INSTALL_DIR; // empty: the locations
+    bool browsing = false;
+    std::vector<Entry> entries;
+    int browse_selected = 0;
+    int browse_top = 0;
+    const auto open_dir = [&](const fs::path &dir) {
+        boost::system::error_code ec;
+        browse_dir = !dir.empty() && fs::is_directory(dir, ec) ? dir : fs::path();
+        entries = browse_dir.empty() ? locations() : list_folder(browse_dir);
+        browse_selected = browse_top = 0;
+    };
+    const auto start_install = [&](std::vector<Entry> list, bool consume) {
+        reset(job, false);
+        job.thread = std::thread([&emuenv, &job, list = std::move(list), consume]() mutable { install_worker(emuenv, job, std::move(list), consume); });
+        notice.clear();
+    };
+    // What's missing of the firmware comes from Sony by itself, unless the user stopped that
+    // before or copied update files to install
+    if (!missing_firmware(fw).empty()) {
+        boost::system::error_code ec;
+        if (!fs::exists(DOWNLOAD_STOPPED, ec) && !updates_waiting()) {
+            start_firmware();
+        } else if (notice.empty()) {
+            if (updates_waiting())
+                notice = "PS Vita update files are waiting in /data/Vita3K/install: Triangle, then Square installs them";
+            else
+                notice = std::string(fw.main_firmware ? "The PS Vita font package isn't installed: some games need it." : "The PS Vita firmware isn't installed: most games need it.") + " Press Square to download it from Sony.";
+            notice_until = Clock::now() + std::chrono::hours(1);
+        }
+    }
+
+    // buttons held from the game don't count as presses here
+    uint32_t previous = ps4pad::read().buttons;
+    Clock::time_point repeat_at{};
+    int repeat_dir = 0;
+    bool dirty = true;
+    auto last_progress = Clock::now();
+
+    while (true) {
+        const ps4pad::Snapshot pad = ps4pad::read();
+        uint32_t buttons = pad.buttons;
+        // the left stick as the D-pad
+        if (pad.connected && pad.ly < 48)
+            buttons |= ORBIS_PAD_BUTTON_UP;
+        if (pad.connected && pad.ly > 208)
+            buttons |= ORBIS_PAD_BUTTON_DOWN;
+        const uint32_t pressed = buttons & ~previous;
+        previous = buttons;
+        const auto now = Clock::now();
+
+        if (job.running) {
+            if (job.finished) {
+                job.thread.join();
+                job.running = false;
+                // decrypted: it starts now
+                std::string start_app, start_title;
+                {
+                    const std::lock_guard<std::mutex> lock(job.mutex);
+                    if (job.installed > 0) {
+                        start_app = job.start_app;
+                        start_title = job.start_title;
+                    }
+                }
+                if (!start_app.empty()) {
+                    last_app_path = start_app;
+                    show_message("Starting", start_title);
+                    return Choice{ false, start_app, start_title };
+                }
+                items = load_items(emuenv);
+                const bool had_font_package = fw.font_package;
+                fw = app::get_firmware_state(emuenv);
+                // the text in the PS Vita's fonts, now that they're there
+                if (fw.font_package && !had_font_package)
+                    ps4ui::set_vita_font_dir(fs_utils::path_to_utf8(emuenv.vita_fs_path / "sa0" / "data" / "font" / "pvf") + "/");
+                selected = std::min(selected, std::max(0, static_cast<int>(items.size()) - 1));
+                if (!job.firmware) {
+                    // back to the games, on the one just installed
+                    browsing = false;
+                    std::string title_id;
+                    {
+                        const std::lock_guard<std::mutex> lock(job.mutex);
+                        title_id = job.title_id;
+                    }
+                    for (size_t i = 0; i < items.size(); i++) {
+                        if (!title_id.empty() && items[i].entry.title_id == title_id)
+                            selected = static_cast<int>(i);
+                    }
+                }
+                notice = summary(job);
+                notice_until = now + std::chrono::seconds(20);
+                dirty = true;
+            } else {
+                // Circle stops a download
+                if ((pressed & ORBIS_PAD_BUTTON_CIRCLE) && job.firmware) {
+                    const std::lock_guard<std::mutex> lock(job.mutex);
+                    if (job.stoppable)
+                        job.stop_requested = true;
+                }
+                if (now - last_progress > std::chrono::milliseconds(100)) {
+                    last_progress = now;
+                    dirty = true;
+                }
+            }
+        } else {
+            const int count = static_cast<int>(browsing ? entries.size() : items.size());
+            const int page = browsing ? BROWSER_ROWS : VISIBLE_ROWS;
+            int &sel = browsing ? browse_selected : selected;
+            int dir = (buttons & ORBIS_PAD_BUTTON_UP) ? -1 : (buttons & ORBIS_PAD_BUTTON_DOWN) ? 1 : 0;
+            bool step = false;
+            if (dir != 0 && dir != repeat_dir) {
+                step = true;
+                repeat_at = now + std::chrono::milliseconds(380);
+            } else if (dir != 0 && now >= repeat_at) {
+                step = true;
+                repeat_at = now + std::chrono::milliseconds(70);
+            }
+            repeat_dir = dir;
+            if (step && count > 0) {
+                sel = std::clamp(sel + dir, 0, count - 1);
+                dirty = true;
+            }
+            // L1 / R1: a page at a time
+            if ((pressed & (ORBIS_PAD_BUTTON_L1 | ORBIS_PAD_BUTTON_R1)) && count > 0) {
+                sel = std::clamp(sel + ((pressed & ORBIS_PAD_BUTTON_L1) ? -page : page), 0, count - 1);
+                dirty = true;
+            }
+            if (browsing) {
+                if ((pressed & ORBIS_PAD_BUTTON_CROSS) && !entries.empty()) {
+                    const Entry e = entries[browse_selected];
+                    if (installable(e.kind))
+                        start_install({ e }, e.path.parent_path() == INSTALL_DIR);
+                    else
+                        open_dir(e.path);
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_SQUARE) {
+                    std::vector<Entry> all;
+                    std::copy_if(entries.begin(), entries.end(), std::back_inserter(all), [](const Entry &e) { return installable(e.kind); });
+                    if (!all.empty()) {
+                        start_install(std::move(all), browse_dir == INSTALL_DIR);
+                        dirty = true;
+                    }
+                } else if (pressed & ORBIS_PAD_BUTTON_CIRCLE) {
+                    if (browse_dir.empty()) {
+                        browsing = false;
+                    } else {
+                        // up a folder (from a location: to the locations), on the folder it came from
+                        const fs::path from = browse_dir;
+                        open_dir(is_location(from) ? fs::path() : from.parent_path());
+                        for (size_t i = 0; i < entries.size(); i++) {
+                            if (entries[i].path == from)
+                                browse_selected = static_cast<int>(i);
+                        }
+                    }
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_TRIANGLE) {
+                    browsing = false;
+                    dirty = true;
+                }
+            } else {
+                if ((pressed & ORBIS_PAD_BUTTON_CROSS) && !items.empty()) {
+                    const Item &item = items[selected];
+                    const fs::path app_dir = emuenv.vita_fs_path / "ux0" / "app" / item.entry.path;
+                    if (!still_encrypted(app_dir)) {
+                        last_app_path = item.entry.path;
+                        show_message("Starting", item.entry.title);
+                        return Choice{ false, item.entry.path, item.entry.title };
+                    }
+                    // decrypted first, then started
+                    reset(job, false);
+                    job.start_app = item.entry.path;
+                    job.start_title = item.entry.title;
+                    job.thread = std::thread([&emuenv, &job, app_dir, title = item.entry.title] { decrypt_worker(emuenv, job, app_dir, title); });
+                    notice.clear();
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_TRIANGLE) {
+                    browsing = true;
+                    open_dir(browse_dir);
+                    dirty = true;
+                } else if ((pressed & ORBIS_PAD_BUTTON_SQUARE) && !missing_firmware(fw).empty()) {
+                    start_firmware();
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_OPTIONS) {
+                    return Choice{ true, {}, {} };
+                }
+            }
+        }
+        if (!notice.empty() && now >= notice_until) {
+            notice.clear();
+            dirty = true;
+        }
+
+        if (dirty) {
+            // keep the selection in view
+            int &sel = browsing ? browse_selected : selected;
+            int &first = browsing ? browse_top : top;
+            const int rows = browsing ? BROWSER_ROWS : VISIBLE_ROWS;
+            if (sel < first)
+                first = sel;
+            if (sel >= first + rows)
+                first = sel - rows + 1;
+            background(canvas);
+            header(canvas, fw);
+            std::vector<Hint> hints;
+            if (browsing) {
+                draw_browser(canvas, browse_dir, entries, browse_selected, browse_top);
+                if (!entries.empty())
+                    hints.push_back({ Pad::Cross, installable(entries[browse_selected].kind) ? "Install" : "Open" });
+                if (std::any_of(entries.begin(), entries.end(), [](const Entry &e) { return installable(e.kind); }))
+                    hints.push_back({ Pad::Square, "Install all here" });
+                hints.push_back({ Pad::Circle, "Back" });
+            } else {
+                draw_list(canvas, items, selected, top);
+                if (!items.empty())
+                    hints.push_back({ Pad::Cross, "Start" });
+                hints.push_back({ Pad::Triangle, "Install games" });
+                if (!missing_firmware(fw).empty())
+                    hints.push_back({ Pad::Square, "Download firmware" });
+                hints.push_back({ Pad::Options, "Quit" });
+            }
+            draw_notice(canvas, notice);
+            footer(canvas, hints);
+            if (job.running)
+                draw_install(canvas, job);
+            present(canvas);
+            dirty = false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    }
+}
+
+} // namespace ps4launcher
