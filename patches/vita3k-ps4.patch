+static void log_stick_read(const CtrlState &state, const SceCtrlData2 &data, const bool is_peek, const bool is_v2, const bool from_ext) {
+    static int logged = 0;
+    static int last_sector = -2;
+    if (logged >= 60 || !ps4_input_log())
