+// The parser's progress (from `from` to `to` of what progress takes), and each encrypted file of
+// `source` removed as soon as its decrypted copy is written (the parser has read what it needs of it
+// before): decrypting needs room for one more file, not a whole second copy of the game (a game
+// copied in encrypted, NPS Browser's, filled a PS4's storage). The parser names each file by its full
+// path (the folder, then files.db's names), once before it and once after. The license
+// (sce_sys/package) stays, and the PFS's own files.
+static PfsProgressCallback consuming_progress(const fs::path &source, const std::function<void(float)> &progress, float from, float to) {
+    const std::string source_root = source.generic_string();
+    const auto done_bytes = std::make_shared<std::uint64_t>(0);
+    return [=](std::uint64_t processed, std::uint64_t total, const std::string &file) {
+        if (processed > *done_bytes) {
+            *done_bytes = processed;
+            std::string relative = file.size() > source_root.size() && file.compare(0, source_root.size(), source_root) == 0 ? file.substr(source_root.size()) : std::string();
+            while (!relative.empty() && relative.front() == '/')
+                relative.erase(0, 1);
+            std::string upper = relative;
+            std::transform(upper.begin(), upper.end(), upper.begin(), [](unsigned char c) { return static_cast<char>(std::toupper(c)); });
+            if (!relative.empty() && relative.find("..") == std::string::npos && !upper.starts_with("SCE_SYS/PACKAGE") && !upper.starts_with("SCE_PFS")) {
+                boost::system::error_code ec;
+                fs::path encrypted = source / fs_utils::utf8_to_path(relative);
+                if (!fs::is_regular_file(encrypted, ec))
+                    encrypted = vfs::find_case_insensitive(source, fs_utils::utf8_to_path(relative));
+                if (!encrypted.empty() && fs::is_regular_file(encrypted, ec))
+                    fs::remove(encrypted, ec);
+            }
+        }
+        if (progress)
+            progress(from + (to - from) * (total ? static_cast<float>(processed) / static_cast<float>(total) : 1.f));
+    };
+}
