+#include <vector>
+
+extern "C" void ps4_boot_trace(const char *line); // port/ps4_crashlog.cpp
+extern "C" const char *ps4_crash_log_path(); // port/ps4_crashlog.cpp
+// port/ps4_sampler.cpp: threads' own CPU time and the wait counters
+extern "C" void ps4_thread_busy_report(char *out, size_t size, int min_percent);
+extern "C" long long ps4_wait_total(int slot);
+
+// kernel/src/kernel.cpp: every guest thread's wait, and who holds what it waits for
+void ps4_log_waits(KernelState &kernel);
+
+// The renderer profiler's line: HENkaku's render thread's draws and what each part of them took,
+// its biggest kinds of state set and command (renderer/ps4_render_stats.h)
+void log_render_stats(double seconds, double ticks_per_ms) {
+    namespace st = renderer::ps4stats;
+    static const char *const commands[] = { "CreateContext", "CreateRenderTarget", "MemoryMap", "MemoryUnmap", "Draw", "TransferCopy", "TransferDownscale", "TransferFill", "Nop",
+        "SetState", "SetContext", "SyncSurfaceData", "MidSceneFlush", "SignalSyncObject", "WaitSyncObject", "SignalNotification", "SetScreenFilter", "NewFrame",
+        "DestroyRenderTarget", "DestroyContext" };
+    static const char *const states[] = { "RegionClip", "Program", "Viewport", "DepthBias", "DepthFunc", "DepthWriteEnable", "PolygonMode", "PointLineWidth",
+        "StencilFunc", "Texture", "StencilRef", "VertexStream", "TwoSided", "CullMode", "UniformBuffer", "FragmentProgramEnable", "VisibilityBuffer", "VisibilityIndex" };
+    static const char *const phases[] = { "pipeline", "shader info", "uniforms+textures", "indices", "vertices", "recording" };
+    static uint64_t last_command_ticks[st::MAX_KINDS], last_command_count[st::MAX_KINDS], last_state_ticks[st::MAX_KINDS], last_state_count[st::MAX_KINDS], last_phase[st::PhaseCount];
+    const auto take = [](std::atomic<uint64_t> &counter, uint64_t &last) {
+        const uint64_t now = counter.load(std::memory_order_relaxed);
+        const uint64_t delta = now - last;
+        last = now;
+        return delta;
+    };
+    const auto ms = [&](uint64_t ticks) { return ticks / ticks_per_ms / seconds; };
+
+    struct Part {
+        std::string name;
+        double ms_per_s, per_s;
+    };
+    const auto biggest = [](std::vector<Part> parts, size_t count) {
+        std::sort(parts.begin(), parts.end(), [](const Part &a, const Part &b) { return a.ms_per_s > b.ms_per_s; });
+        std::string text;
+        for (size_t i = 0; i < std::min(count, parts.size()) && parts[i].ms_per_s >= 1.0; i++)
+            text += fmt::format("{}{} {:.0f} ms/s ({:.0f}/s)", text.empty() ? "" : ", ", parts[i].name, parts[i].ms_per_s, parts[i].per_s);
+        return text.empty() ? std::string("-") : text;
+    };
+
+    std::vector<Part> command_parts, state_parts;
+    double draws = 0, draw_ms = 0;
+    for (int i = 0; i < st::MAX_KINDS; i++) {
+        const double c_ms = ms(take(st::command_ticks[i], last_command_ticks[i])), c_n = take(st::command_count[i], last_command_count[i]) / seconds;
+        if (i < static_cast<int>(std::size(commands)))
+            command_parts.push_back({ commands[i], c_ms, c_n });
+        if (i == static_cast<int>(renderer::CommandOpcode::Draw)) {
+            draws = c_n;
+            draw_ms = c_ms;
+        }
+        const double s_ms = ms(take(st::state_ticks[i], last_state_ticks[i])), s_n = take(st::state_count[i], last_state_count[i]) / seconds;
+        if (i < static_cast<int>(std::size(states)))
+            state_parts.push_back({ states[i], s_ms, s_n });
+    }
+    std::string draw_parts;
+    for (int i = 0; i < st::PhaseCount; i++) {
+        const double phase_ms = ms(take(st::phase_ticks[i], last_phase[i]));
+        draw_parts += fmt::format("{}{} {:.1f}", i ? ", " : "", phases[i], draws > 0 ? phase_ms * 1000.0 / draws : 0.0);
+    }
+    LOG_INFO("renderer: {:.0f} draws/s, {:.1f} us each ({}; us); commands: {}; state: {}", draws, draws > 0 ? draw_ms * 1000.0 / draws : 0.0, draw_parts,
+        biggest(command_parts, 6), biggest(state_parts, 5));
+}
+
+// The profiler's hottest places in each busy guest thread's code: the share of its samples, the
+// module and offset (to find in the game's code), and the code from there (the run the JIT
+// compiled as a block, up to its first branch)
+void log_profile(const EmuEnvState &emuenv) {
+    // (the kernel's lookups lock it, so they aren't const)
+    KernelState &kernel = const_cast<KernelState &>(emuenv.kernel);
+    for (const ps4perf::ProfileThread &thread : ps4perf::take_profile(16)) {
+        if (thread.total < 500) // a thread that ran guest code for under a second of the ten
+            continue;
+        const ThreadStatePtr guest = kernel.get_thread(thread.id);
+        LOG_INFO("profile: {}: {} samples", thread.name, thread.total);
+        for (const auto &[pc_bits, count] : thread.hottest) {
+            const bool thumb = pc_bits & 1;
+            const uint32_t pc = pc_bits & ~1u;
+            std::string where = fmt::format("{:08X}", pc);
+            if (const SceKernelModuleInfo *module = kernel.find_module_by_addr(pc))
+                where = fmt::format("{}+0x{:X}", module->module_name, pc - module->segments[0].vaddr.address());
+            std::string code;
+            if (guest && guest->cpu) {
+                uint32_t at = pc;
+                for (int i = 0; i < 10; i++) {
+                    uint16_t size = 0;
+                    const std::string insn = disassemble(*guest->cpu, at, thumb, &size);
+                    if (size == 0)
+                        break;
+                    code += (i ? "; " : "") + insn;
+                    at += size;
+                    if (insn.starts_with("b") || insn.starts_with("pop") || insn.find("pc") != std::string::npos)
+                        break;
+                }
+            }
+            LOG_INFO("profile:   {:4.1f}% {}{} {}", 100.0 * count / thread.total, where, thumb ? " (thumb)" : "", code);
+        }
+    }
+}
+
+namespace {
+
+// Every 10 s in the log while a game runs: its frame rate, the emulated vblanks (60 a second when
+// the timing holds), where the render thread's time went (waiting for the game's commands,
+// showing frames, waiting for the GPU), how long the game's threads waited for vblanks, and every
+// thread busier than 3% of a core (its own CPU time, busiest first): what holds a game back. Then
+// a line for each busy guest thread: its time in guest code and in its biggest imports.
+class PerfLine {
+public:
+    void update(const EmuEnvState &emuenv, const std::chrono::steady_clock::time_point now) {
+        if (now < next)
+            return;
+        char busy[768];
+        ps4_thread_busy_report(busy, sizeof(busy), 3);
+        const double seconds = std::chrono::duration<double>(now - last).count();
+        long long ms[5];
+        for (int i = 0; i < 5; i++) {
+            const long long total = ps4_wait_total(i);
+            ms[i] = static_cast<long long>((total - waits[i]) / 1e6 / seconds);
+            waits[i] = total;
+        }
+        const uint64_t vblank_count = emuenv.display.vblank_count.load();
+        const uint64_t tsc = __builtin_ia32_rdtsc();
+        if (started) {
+            LOG_INFO("perf: {} fps, {:.0f} vblanks/s; render thread: waits for the game {} ms/s, shows frames {} ms/s, waits for the GPU {} ms/s; frames wait for the renderer {} ms/s; the game waits for vblanks {} ms/s; busy: {}",
+                emuenv.fps, (vblank_count - vblanks) / seconds, ms[1], ms[2], ms[3], ms[4], ms[0], busy);
+            // a freeze (the render thread neither showed a frame nor waited for the game all that
+            // time): the waits behind it, a few times. (A thread in one call for 15 s was the sign:
+            // threads that always wait used the three up at the start.)
+            static int wait_logs = 0;
+            ps4perf::report(seconds, (tsc - last_tsc) / (seconds * 1000.0));
+            if (ms[1] == 0 && ms[2] == 0 && wait_logs < 3 && ps4settings::prefs().freeze_log) {
+                wait_logs++;
+                ps4_log_waits(emuenv.kernel);
+            }
+            log_profile(emuenv);
+            if (ps4settings::prefs().host_profiler)
+                log_render_stats(seconds, (tsc - last_tsc) / (seconds * 1000.0));
+        } else {
+            ps4perf::report(0, 0);
+        }
+        started = true;
+        vblanks = vblank_count;
+        last_tsc = tsc;
+        last = now;
+        next = now + std::chrono::seconds(10);
+    }
+
+private:
+    bool started = false;
+    std::chrono::steady_clock::time_point last{}, next{};
+    uint64_t vblanks = 0;
+    uint64_t last_tsc = 0;
+    long long waits[5] = {};
+};
+
+// vita3k.prev.log to vita3k.game.log when it's a game's run (it has "Game started:")
+void keep_game_log(const fs::path &log_dir) {
+    const fs::path prev = log_dir / "vita3k.prev.log";
+    std::ifstream in(prev.c_str(), std::ios::binary);
+    if (!in)
+        return;
+    std::string line;
+    bool game = false;
+    while (!game && std::getline(in, line))
+        game = line.find("Game started:") != std::string::npos;
+    in.close();
+    if (!game)
+        return;
+    boost::system::error_code ec;
+    fs::copy_file(prev, log_dir / "vita3k.game.log", fs::copy_options::overwrite_existing, ec);
+}
+
+EmuEnvState *crash_emuenv = nullptr;
+// The package's version (/app0/version.txt), in the logs: an app installed over an older one is
+// easy to forget (v00.06 was "tested" as v00.05)
+char app_version[32] = "dev";
+
+void read_app_version() {
+    FILE *f = std::fopen("/app0/version.txt", "r");
+    if (!f)
+        return;
+    char line[24] = {};
+    if (std::fgets(line, sizeof(line), f)) {
+        line[std::strcspn(line, "\r\n ")] = 0;
+        if (line[0])
+            std::snprintf(app_version, sizeof(app_version), "v%s", line);
+    }
+    std::fclose(f);
+}
+
+} // namespace
+
+// The game's threads on the first Jaguar cluster (cores 0-3, which share their L2 cache) when
+// HENkaku > CPU > Game threads says so, else on all the app's cores like every other thread.
+// kernel/src/kernel.cpp calls it as each guest thread starts.
+extern "C" void ps4_place_guest_thread() {
+    if (!ps4settings::prefs().cluster_threads)
+        return;
+    using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+    reinterpret_cast<SetAffinityFn>(&scePthreadSetaffinity)(scePthreadSelf(), 0x0F);
+}
+
+// The crash log's guest part (port/ps4_crashlog.cpp calls it after the host's): which app ran
+extern "C" void ps4_crash_guest_info() {
+    if (!crash_emuenv)
+        return;
+    FILE *f = std::fopen(ps4_crash_log_path(), "a");
+    if (!f)
+        return;
+    std::fprintf(f, "\n== HENkaku (Vita3K for PS4) %s: %s (%s), the details are in vita3k.log (vita3k.prev.log once Vita3K started again)\n", app_version,
+        crash_emuenv->current_app_title.c_str(), crash_emuenv->app_info.app_title_id.c_str());
+    std::fclose(f);
+}
+
+namespace {
+
+std::string notice_file() {
+    return ps4_data_path("notice.txt");
+}
+std::string relaunch_file() {
+    return ps4_data_path("relaunch.txt");
+}
+
+void trace(const std::string &line) {
+    ps4_boot_trace(line.c_str());
+}
+
+// Lets the renderer draw on VideoOut: a headless surface, which ps4_wsi.cpp turns into VideoOut buffers
+class PS4FrameHost final : public renderer::FrameHost, public renderer::VulkanSurfaceProvider {
+public:
+    renderer::DisplayHandle handle() const override {
+        return {};
+    }
+    const renderer::VulkanSurfaceProvider *vulkan_surface_provider() const override {
+        return this;
+    }
+    std::vector<const char *> instance_extensions() const override {
+        return { VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME };
+    }
+    VkSurfaceKHR create_surface(VkInstance instance) const override {
+        const auto create = reinterpret_cast<PFN_vkCreateHeadlessSurfaceEXT>(ps4_vk_get_instance_proc_addr()(instance, "vkCreateHeadlessSurfaceEXT"));
+        VkHeadlessSurfaceCreateInfoEXT info{ VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT };
+        VkSurfaceKHR surface = VK_NULL_HANDLE;
+        if (!create || create(instance, &info, nullptr, &surface) != VK_SUCCESS)
+            return VK_NULL_HANDLE;
+        return surface;
+    }
+    void destroy_surface(VkInstance instance, VkSurfaceKHR surface) const override {
+        const auto destroy = reinterpret_cast<PFN_vkDestroySurfaceKHR>(ps4_vk_get_instance_proc_addr()(instance, "vkDestroySurfaceKHR"));
+        if (destroy)
+            destroy(instance, surface, nullptr);
+    }
+    int drawable_width() const override {
+        return ps4wsi::WIDTH;
+    }
+    int drawable_height() const override {
+        return ps4wsi::HEIGHT;
+    }
+    std::vector<std::string> font_dirs() const override {
+        return { "/preinst/common/font/", "/app0/fonts/" };
+    }
+};
+
+void save_text(const std::string &path, const std::string &text) {
+    std::ofstream out(path, std::ios::trunc);
+    out << text;
+}
+
+std::string take_text(const std::string &path) {
+    std::ifstream in(path);
+    if (!in)
+        return {};
+    std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    in.close();
+    std::remove(path.c_str());
+    return text;
+}
+
+// A launch request carried over the restart: app path, self path, then one argument per line
+void save_relaunch(const AppLaunchRequest &request) {
+    std::string text = request.app_path + "\n" + request.self_path + "\n";
+    for (const auto &arg : request.argv)
+        text += arg + "\n";
+    save_text(relaunch_file(), text);
+}
+
+std::optional<AppLaunchRequest> take_relaunch() {
+    const std::string text = take_text(relaunch_file());
+    if (text.empty())
+        return std::nullopt;
+    AppLaunchRequest request;
+    request.reason = AppLaunchReason::LoadExec;
+    size_t start = 0;
+    int field = 0;
+    while (start < text.size()) {
+        size_t end = text.find('\n', start);
+        if (end == std::string::npos)
+            end = text.size();
+        const std::string line = text.substr(start, end - start);
+        if (field == 0)
+            request.app_path = line;
+        else if (field == 1)
+            request.self_path = line;
+        else
+            request.argv.push_back(line);
+        field++;
+        start = end + 1;
+    }
+    if (request.app_path.empty())
+        return std::nullopt;
+    return request;
+}
+
+[[noreturn]] void restart(const std::string &notice) {
+    if (!notice.empty())
+        save_text(notice_file(), notice);
+    trace("restarting");
+    sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+    std::_Exit(0);
+}
+
+// Runs one app until it ends. Returns what the launcher should say about it, and the launch request
+// if the app asked for another executable.
+std::string run_session(EmuEnvState &emuenv, const AppLaunchRequest &request, std::optional<AppLaunchRequest> &next) {
+    app::AppSessionController session(emuenv);
+    PS4FrameHost frame_host;
+
+    trace("session: launching " + request.app_path);
+    ps4perf::benchmark_large_pages();
+    if (!session.begin_launch(request, request.reason != AppLaunchReason::LoadExec))
+        return "Couldn't find " + request.app_path + " among the installed apps";
+    trace("session: renderer");
+    // (what these say is shown after the app started over: this run's log is vita3k.prev.log then)
+    if (!session.initialize_renderer(frame_host)) {
+        session.stop(app::AppSessionStopReason::LaunchFailure);
+        trace("session: the renderer failed");
+        return "The renderer couldn't start (Vulkan): see " + ps4_data_path("vita3k.prev.log");
+    }
+    emuenv.renderer->fsr_sharpening = ps4settings::fsr_sharpening(ps4settings::prefs().fsr_sharpness);
+    trace("session: runtime");
+    if (!session.initialize_runtime()) {
+        session.stop(app::AppSessionStopReason::LaunchFailure);
+        trace("session: the runtime failed");
+        return "The emulator couldn't start: see " + ps4_data_path("vita3k.prev.log");
+    }
+    trace("session: loading the app");
+    if (!session.load_and_run()) {
+        session.stop(app::AppSessionStopReason::LaunchFailure);
+        trace("session: loading the app failed");
+        return "The game couldn't be loaded: see " + ps4_data_path("vita3k.prev.log");
+    }
+    trace("session: running " + emuenv.current_app_title);
+    // L3 + R3: the HENkaku menu, with what can change now and this game's own settings
+    overlay::set_pause_menu({ "HENkaku", ps4settings::icon_path(), ps4settings::quick_menu(emuenv) });
+    LOG_INFO("Game started: {} ({})", emuenv.current_app_title, request.app_path);
+    ps4controls::set_running_app(request.app_path);
+
+    std::optional<AppLaunchRequest> pending = emuenv.take_app_launch_request();
+    app::LaunchRuntimeMetrics metrics{};
+    PerfLine perf;
+    bool running = !pending.has_value();
+    auto next_flush = std::chrono::steady_clock::now();
+    while (running) {
+        const ps4pad::Snapshot pad = ps4pad::read();
+        if (ps4pad::feed(emuenv, pad, session.is_paused())) {
+            // L3 + R3: Vita3K's pause menu (Resume / Exit), or back from it
+            if (session.is_paused())
+                session.set_pause_reason(app::AppSessionPauseReason::All, false);
+            else
+                session.set_pause_reason(app::AppSessionPauseReason::User, true);
+        }
+        if (!pending) {
+            if (auto r = emuenv.take_app_launch_request()) {
+                pending = std::move(r);
+                running = false;
+            }
+        }
+        app::update_runtime_metrics(emuenv, metrics);
+        perf.update(emuenv, std::chrono::steady_clock::now());
+        // stop asked for by the pause menu, or the app crashed
+        if (session.stop_requested() || !session.is_running()) {
+            running = false;
+            session.reset_stop_request();
+        }
+        // nothing reads SDL's event queue: don't let it fill up
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= next_flush) {
+            SDL_PumpEvents();
+            SDL_FlushEvents(SDL_EVENT_FIRST, SDL_EVENT_LAST);
+            next_flush = now + std::chrono::seconds(1);
+        }
+        if (running)
+            std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    }
+
+    trace("session: stopping");
+    ps4pad::release(emuenv);
+    std::string notice;
+    if (pending && pending->reason == AppLaunchReason::ProcessExit) {
+        LOG_INFO("The app exited with code {}", pending->exit_code);
+        notice = emuenv.current_app_title + " closed";
+        session.stop(app::AppSessionStopReason::UserRequest);
+    } else if (pending) {
+        LOG_INFO("The app starts '{}'", pending->self_path);
+        next = std::move(pending);
+        session.stop(app::AppSessionStopReason::Relaunch);
+    } else {
+        notice = emuenv.current_app_title + " closed";
+        session.stop(app::AppSessionStopReason::UserRequest);
+    }
+    trace("session: stopped");
+    return notice;
+}
+
+// The folder of the app before 1.00, /data/Vita3K, next to a /data/HENkaku it has never run in (made
+// by hand, say, to copy games into): port/ps4_crashlog.cpp renames the old folder only when there's
+// no new one, so what the old one has that the new one doesn't moves over here
+void move_missing(const fs::path &from, const fs::path &to, boost::system::error_code &ec) {
+    std::vector<fs::path> entries;
+    for (const auto &entry : fs::directory_iterator(from, ec))
+        entries.push_back(entry.path());
+    for (const fs::path &entry : entries) {
+        const fs::path target = to / entry.filename();
+        if (!fs::exists(target, ec))
+            fs::rename(entry, target, ec);
+        else if (fs::is_directory(entry, ec) && fs::is_directory(target, ec))
+            move_missing(entry, target, ec);
+    }
+    fs::remove(from, ec); // (when nothing's left)
+}
+
+void adopt_old_data() {
+    boost::system::error_code ec;
+    const fs::path data = ps4_data_dir(), old = "/data/Vita3K";
+    if (data == old || fs::exists(data / "config.yml", ec) || !fs::exists(old / "config.yml", ec))
+        return;
+    move_missing(old, data, ec);
+    trace("data: what /data/Vita3K had moved into " + data.string());
+}
+
+// main, inside its catch-all
+int run_app() {
+    read_app_version();
+    trace(std::string("main: HENkaku (Vita3K for PS4) ") + app_version);
+    adopt_old_data();
+    Root root_paths;
+    app::init_paths(root_paths);
+    // the launcher's text: the PS Vita's fonts once the font package is installed
+    ps4ui::set_vita_font_dir(fs_utils::path_to_utf8(root_paths.get_vita_fs_path() / "sa0" / "data" / "font" / "pvf") + "/");
+    boost::system::error_code ec;
+    fs::create_directories(root_paths.get_vita_fs_path(), ec);
+    fs::create_directories(ps4launcher::install_dir(), ec);
+    // The last run's log stays as vita3k.prev.log: after every game the app starts over, and the
+    // game's log went with it (v00.07: why PCSE00003 didn't load)
+    fs::rename(root_paths.get_log_path() / "vita3k.log", root_paths.get_log_path() / "vita3k.prev.log", ec);
+    // A game's run is kept apart as well, as vita3k.game.log until the next game: started again from
+    // the launcher, the app had rotated v00.14's game log away before it was read
+    keep_game_log(root_paths.get_log_path());
+    ps4settings::load_prefs();
+    if (logging::init(root_paths, false) != Success)
+        trace("logging could not start");
+    LOG_INFO("Vita3K for PS4 {}", app_version);
+    if (ps4_data_dir_moved() > 0)
+        LOG_INFO("PS4: /data/Vita3K moved to {}", ps4_data_dir());
+    else if (ps4_data_dir_moved() < 0)
+        LOG_WARN("PS4: /data/Vita3K couldn't be moved to /data/HENkaku: the app keeps using it");
+    // Which draw a GPU hang is on: RADV's per-draw trace ids (RADV_DEBUG=hang, which also ends the
+    // app when a submission doesn't finish, rather than the whole PS4 freezing) and the PS4
+    // winsys' flight recorder (port/mesa/ac_ps4_drm.c, into /data/DolphinPS4/flight), when
+    // /data/HENkaku/radv-trace is there; it slows the rendering down.
+    if (fs::exists(root_paths.get_log_path() / "radv-trace", ec)) {
+        setenv("RADV_PS4_TRACE", "1", 1);
+        setenv("RADV_DEBUG", "hang", 1);
+        trace("radv: RADV_DEBUG=hang, flight recorder on");
+    }
+
+    // CLI11 needs a program name (a PS4 app gets none)
+    char program[] = "vita3k";
+    char *args[] = { program, nullptr };
+    Config cfg{};
+    // Set before the command line options are made: they list <vita fs>/ux0/app, which is
+    // "ux0/app" with no path yet, and the PS4 refuses relative paths (Boost threw on it)
+    cfg.set_vita_fs_path(root_paths.get_vita_fs_path());
+    EmuEnvState emuenv;
+    crash_emuenv = &emuenv;
+    if (config::init_config(cfg, 1, args, root_paths, false) != Success) {
+        trace("config failed");
+        LOG_ERROR("Failed to initialise config");
+    }
+    // Trace and debug lines (every shader instruction translated, every directory entry a game
+    // reads: thousands while a game loads) each cost a write to the file here, where the log is
+    // flushed at every line. Info and up, unless /data/HENkaku/trace-log is there.
+    if (fs::exists(root_paths.get_log_path() / "trace-log", ec))
+        logging::set_level(spdlog::level::trace);
+    else if (cfg.log_level < static_cast<int>(spdlog::level::info))
+        logging::set_level(spdlog::level::info);
+    // the PS4 has Vulkan (RADV) only
+    cfg.backend_renderer = "Vulkan";
+
+    ps4launcher::show_message("HENkaku", "Starting");
+    ps4pad::init();
+
+    // SDL's services Vita3K uses (no window: VideoOut; no sound: sceAudioOut)
+    if (!SDL_Init(SDL_INIT_GAMEPAD | SDL_INIT_SENSOR | SDL_INIT_HAPTIC))
+        LOG_WARN("SDL_Init: {}", SDL_GetError());
+
+    trace("app init");
+    if (!app::init(emuenv, cfg, root_paths)) {
+        trace("app init failed");
+        LOG_ERROR("Emulated environment initialization failed.");
+        ps4launcher::show_message("HENkaku couldn't start", "See " + ps4_data_path("vita3k.log"));
+        std::this_thread::sleep_for(std::chrono::seconds(10));
+        sceSystemServiceLoadExec("exit", nullptr);
+        return 1;
+    }
+    init_libraries(emuenv);
+    app::init_apps_list(emuenv);
+    app::load_users(emuenv);
+    app::ensure_current_user(emuenv);
+    trace("ready");
+
+    std::optional<AppLaunchRequest> next = take_relaunch();
+    std::string notice = take_text(notice_file());
+    if (!next) {
+        const ps4launcher::Choice choice = ps4launcher::run(emuenv, notice);
+        if (choice.quit) {
+            trace("quit");
+            sceSystemServiceLoadExec("exit", nullptr);
+            return 0;
+        }
+        next = AppLaunchRequest{ .app_path = choice.app_path };
+    }
+
+    std::optional<AppLaunchRequest> following;
+    notice = run_session(emuenv, *next, following);
+    if (following)
+        save_relaunch(*following);
+    restart(notice);
+}
+
+} // namespace
+
+int main(int argc, char *argv[]) {
+    (void)argc;
+    (void)argv;
+    try {
+        return run_app();
+    } catch (const std::exception &e) {
+        // what nothing else caught goes on the screen (and in the logs) rather than the app vanishing
+        trace(std::string("uncaught exception: ") + e.what());
+        LOG_ERROR("Uncaught exception: {}", e.what());
+        ps4launcher::show_message("HENkaku stopped", e.what());
+        std::this_thread::sleep_for(std::chrono::seconds(15));
+        sceSystemServiceLoadExec("exit", nullptr);
+        return 1;
+    }
+}
