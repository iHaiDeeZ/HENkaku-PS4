diff --git a/vita3k/renderer/include/renderer/vulkan/frame_generation.h b/vita3k/renderer/include/renderer/vulkan/frame_generation.h
new file mode 100644
index 00000000..87777396
--- /dev/null
+++ b/vita3k/renderer/include/renderer/vulkan/frame_generation.h
@@ -0,0 +1,135 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#pragma once
+
+// Frame generation: the screen gets an image at every vblank, showing the game at that moment: one
+// of its frames, or a frame made between the two around that moment from the motion between them.
+// Motion is smooth whatever the game's frame rate (30, 45, 60), a few vblanks behind the game, and
+// the game isn't held back. The game's frames go into a history as they come (copied out of their
+// surface, with their luma and their motion from the frame before), on the frame generator's own
+// command buffers; each vblank's image is chosen (and made) in the screen's command buffer
+// (renderer.cpp, render_generated). Compute passes over the frames as Vita3K presents them (before
+// the screen filter, which then scales a made frame like a real one):
+//   fg_copy    the frame copied out of its surface, and its luma at 1/scale of its size (and that
+//              at half and quarter size)
+//   fg_motion  per 8x8 luma block, a search for where it was in the frame before: on the luma at
+//              quarter size, then half size (fast pans), then on the luma, each from the level
+//              above's vectors and the camera's motion; a count of the textured blocks that found
+//              no match (the judge), and the camera's motion (the most common vector)
+//   fg_interp  each pixel along the motion that fits it and its neighbours best, at the moment's
+//              place between the two frames; where none fits the nearer frame (along the blocks'
+//              motion where they agree), and the whole nearer frame when the judge saw a cut or a fade
+
+#include <renderer/vulkan/state.h>
+#include <vkutil/objects.h>
+
+#include <array>
+
+namespace renderer::vulkan {
+
+class FrameGenerator {
+public:
+    explicit FrameGenerator(VKState &state);
+    ~FrameGenerator();
+
+    // A frame of the game (the view of its surface, the part the viewport says), with its time in
+    // vblanks (when the game queued it) and the time now: into the history, with its motion from the
+    // frame before. Recorded and submitted at once.
+    void add_frame(vk::ImageView src, vk::ImageLayout src_layout, const Viewport &viewport, double time, double now);
+    // The time the game gave the newest frame (-1 without one): a frame with another is a new one
+    double newest_stamp() const { return newest_stamp_; }
+    // The image for the screen from vblank `vblank` on: the history's frame of that moment, or one
+    // made between two in cmd (for swapchain image `slot`). False without a frame.
+    bool image_for(vk::CommandBuffer cmd, uint32_t slot, double vblank, vk::ImageView &view, Viewport &viewport);
+    // Forgets the frames (frame generation was turned off)
+    void reset();
+    // False once its shaders or pipelines couldn't be made: the frames are shown as they come
+    bool usable() const { return !failed; }
+
+private:
+    struct Constants {
+        int32_t src_x, src_y;
+        uint32_t frame_w, frame_h;
+        uint32_t scale;
+        uint32_t luma_w, luma_h;
+        uint32_t blocks_w;
+        uint32_t pass_index; // fg_motion: 3 the quarter pass, 0 the coarse one, 1 the fine one, 2 the camera's
+        float phase; // fg_interp: the moment between the two frames (0 the first, 1 the second)
+    };
+    // a frame of the history: its picture, luma (and that at half and quarter size), motion from the
+    // frame before and the judge's counts for it (and the camera's motion), its time
+    struct Frame {
+        vkutil::Image image;
+        vkutil::Buffer luma;
+        vkutil::Buffer levels;
+        vkutil::Buffer vectors;
+        vkutil::Buffer judge;
+        double time = 0.0;
+        bool valid = false;
+        // vectors from the frame before (not the first, nor after a long gap)
+        bool has_motion = false;
+    };
+    static constexpr int HISTORY = 5;
+
+    bool init();
+    void resize(vk::CommandBuffer cmd, uint32_t width, uint32_t height);
+    void make_inbetween(vk::CommandBuffer cmd, uint32_t slot, int first, int second, float phase);
+    double latency_for_screen();
+
+    VKState &state;
+    bool ready = false;
+    bool failed = false;
+
+    vk::Sampler nearest, linear;
+    vk::ShaderModule shaders[3];
+    vk::DescriptorSetLayout set_layouts[3];
+    vk::PipelineLayout pipeline_layouts[3];
+    vk::Pipeline pipelines[3];
+    vk::DescriptorPool pool;
+    // per history slot: copy, motion; per swapchain slot: in-between
+    std::array<vk::DescriptorSet, HISTORY> copy_sets{}, motion_sets{};
+    std::vector<vk::DescriptorSet> interp_sets;
+    // the command buffers adding frames (one per history slot) and their fences
+    vk::CommandPool command_pool;
+    std::array<vk::CommandBuffer, HISTORY> commands{};
+    std::array<vk::Fence, HISTORY> fences{};
+
+    uint32_t width = 0, height = 0, scale = 1, luma_w = 0, luma_h = 0, blocks_w = 0, blocks_h = 0;
+    std::array<Frame, HISTORY> history;
+    int newest = -1;
+    double newest_stamp_ = -1.0;
+    // the coarse and quarter passes' vectors (the next ones start from them), the fine pass's matched
+    // vectors counted (the most common is the camera's)
+    vkutil::Buffer coarse, quarter, counts;
+    vkutil::Image result;
+
+    // the pacing (vblanks): how far apart frames come and how long they take to get here (averaged),
+    // where in a vblank they come (averaged on a circle), and how far behind the newest frame's time
+    // the screen is
+    double interval = 2.0;
+    double delay = 1.0;
+    double phase_x = 0.0, phase_y = 0.0;
+    // the frames come at the same point of each vblank (the game holds to its vblanks): their times
+    // are put on that point (the few ms they move around it are the game's work, not its motion)
+    bool steady = false;
+    double latency = 0.0;
+    // the game gives about a frame a vblank: its newest is shown as it is (image_for)
+    bool full_rate = false;
+};
+
+} // namespace renderer::vulkan
