+
+// PS4: HTTP downloads (ps4_download.cpp), for the PS Vita firmware the launcher gets from Sony and
+// the packages PKGj queues (ps4_bgdl.cpp).
+
+#pragma once
+
+#include <util/fs.h>
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace ps4download {
+
+// Told how many bytes there are so far; returning false stops the download.
+using Progress = std::function<bool(uint64_t done)>;
+
+enum class Status {
+    Done,
+    Stopped,
+    Failed,
+};
+
+struct Result {
+    Status status = Status::Failed;
+    std::string error; // why it failed, for the user
+};
+
+// How big what url holds is (a HEAD request), or 0 with error saying why not
+uint64_t remote_size(const std::string &url, std::string &error);
+
+// Downloads url to path, which must come out `size` bytes long. Until it's complete the file is
+// path + ".part", and the next call for it carries on from where this one stopped.
+Result download(const std::string &url, const fs::path &path, uint64_t size, const Progress &progress);
+
+} // namespace ps4download
