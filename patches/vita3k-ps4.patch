+// colour: dark, or bright for the puzzles that want light on a camera (Uncharted: Golden Abyss,
+// chapter 13). Changes at once.
+Item camera_choice(EmuEnvState &emuenv) {
+    constexpr uint32_t DARK = 0xFF000000, BRIGHT = 0xFFFFFFFF;
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = "Camera";
+    item.values = { "PS4 camera", "Picture", "Dark", "Bright" };
+    item.get = [&emuenv] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        switch (emuenv.cfg.back_camera_type) {
+        case CameraType::WebCamera: return 0;
+        case CameraType::Image: return 1;
+        default: return emuenv.cfg.back_camera_color == BRIGHT ? 3 : 2;
+        }
+    };
+    item.set = [&emuenv](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        const int type = index == 0 ? CameraType::WebCamera : index == 1 ? CameraType::Image : CameraType::SolidColor;
+        const uint32_t color = index == 3 ? BRIGHT : DARK;
+        emuenv.cfg.front_camera_type = emuenv.cfg.back_camera_type = type;
+        emuenv.cfg.front_camera_color = emuenv.cfg.back_camera_color = index >= 2 ? color : 0;
+        emuenv.cfg.front_camera_image = emuenv.cfg.back_camera_image = {};
+        config::serialize_config(emuenv.cfg, emuenv.cfg.config_path);
+        // a camera the game has open shows it from its next frame
+        emuenv.camera.front()->update_config(type, {}, {}, emuenv.cfg.front_camera_color);
+        emuenv.camera.back()->update_config(type, {}, {}, emuenv.cfg.back_camera_color);
+    };
