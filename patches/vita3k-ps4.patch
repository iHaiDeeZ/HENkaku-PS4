diff --git a/external/ps4/no_page_size.h b/external/ps4/no_page_size.h
new file mode 100644
index 00000000..ec5cbb1b
--- /dev/null
+++ b/external/ps4/no_page_size.h
@@ -0,0 +1,6 @@
+// PS4: the OpenOrbis limits.h defines PAGE_SIZE (and PAGESIZE), which psvpfstools names a constant
+// of its own (PfsSaveData.cpp). Included before each of its files: limits.h once, without them.
+#pragma once
+#include <limits.h>
+#undef PAGE_SIZE
+#undef PAGESIZE
