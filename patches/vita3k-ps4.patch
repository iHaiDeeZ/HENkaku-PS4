+// PS4: the DualShock 4 through ScePad (ps4_pad.cpp).
+
+#pragma once
+
+#include <cstdint>
+
+struct EmuEnvState;
+
+namespace ps4pad {
+
+struct Touch {
+    uint16_t x = 0;
+    uint16_t y = 0;
+    uint8_t id = 0;
+};
+
+// The first signed-in user's pad
+struct Snapshot {
+    bool connected = false;
+    uint32_t buttons = 0; // ORBIS_PAD_BUTTON_*
+    uint8_t lx = 128, ly = 128, rx = 128, ry = 128;
+    uint8_t l2 = 0, r2 = 0;
+    uint8_t touch_count = 0;
+    Touch touch[2];
+    float accel[3] = {}; // in g
+    float gyro[3] = {}; // in rad/s
+    uint64_t timestamp = 0;
+};
+
+// The DS4 touchpad's size in its own units
+constexpr float TOUCHPAD_WIDTH = 1920.f;
+constexpr float TOUCHPAD_HEIGHT = 943.f;
+
+void init();
+Snapshot read();
+
+// While a game runs: buttons, sticks, the touchpad and motion into Vita3K's input state, through the
+// controls (ps4_controls.h); with its menu open, the buttons as they are and no touches. Returns
+// true once each time L3 + R3 are pressed together.
+bool feed(EmuEnvState &emuenv, const Snapshot &pad, bool menu_open = false);
+// Releases everything feed() holds (before the launcher takes over again)
+void release(EmuEnvState &emuenv);
+
+} // namespace ps4pad
