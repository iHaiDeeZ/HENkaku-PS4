+void load_prefs() {
+    FILE *f = std::fopen(prefs_file().c_str(), "r");
+    if (!f)
+        return;
+    char line[256];
+    // the file's settings version: 1.08's is 2 (none before)
+    int version = 1;
+    while (std::fgets(line, sizeof(line), f)) {
+        const std::string text = line;
+        const size_t eq = text.find('=');
+        if (eq == std::string::npos)
+            continue;
+        const std::string key = trim(text.substr(0, eq));
+        const std::string value = trim(text.substr(eq + 1));
+        if (key == "settings")
+            version = std::atoi(value.c_str());
+        else if (key == "home")
+            g_prefs.home_style = value == "list" ? HOME_LIST : value == "cards" ? HOME_CARDS : HOME_BUBBLES;
+        else if (key == "fsr-sharpness")
+            g_prefs.fsr_sharpness = std::clamp(std::atoi(value.c_str()), 0, static_cast<int>(std::size(SHARPENING_STOPS)) - 1);
+        else if (key == "game-threads")
+            g_prefs.cluster_threads = value == "cluster";
+        else if (key == "frame-queue")
+            g_prefs.frame_overlap = value != "vita3k";
+        else if (key == "frame-generation")
+            g_prefs.frame_generation = value == "on";
+        else if (key == "touch-markers")
+            g_prefs.touch_markers = value == "on";
+        else if (key == "gpu-compression")
+            g_prefs.gpu_compression = value == "on";
+        else if (key == "ordered-blending")
+            g_prefs.ordered_blending = value == "on";
+        else if (key == "fast-calls")
+            g_prefs.fast_calls = value == "on";
+        else if (key == "fast-atomics")
+            g_prefs.fast_atomics = value == "on";
+        else if (key == "vita-cores")
+            g_prefs.vita_cores = value != "parallel";
+        else if (key == "profiler")
+            g_prefs.profiler = value == "on";
+        else if (key == "renderer-profiler")
+            g_prefs.host_profiler = value == "on";
+        else if (key == "freeze-log")
+            g_prefs.freeze_log = value == "on";
+        else if (key == "input-log")
+            g_prefs.input_log = value == "on";
+        else if (key == "format-log")
+            g_prefs.format_log = value == "on";
+        else if (key == "theme")
+            g_prefs.theme = std::clamp(std::atoi(value.c_str()), 0, static_cast<int>(theme_names().size()) - 1);
+        else if (key == "moving-wallpaper")
+            g_prefs.moving_wallpaper = value == "on";
+        else if (key == "wallpaper")
+            g_prefs.wallpaper = value == "wave" ? std::string() : value;
+        else if (key == "vita-theme")
+            g_prefs.vita_theme = value;
+        else if (key == "custom-top")
+            g_prefs.custom_top = static_cast<uint32_t>(std::strtoul(value.c_str(), nullptr, 16)) & 0xFFFFFF;
+        else if (key == "custom-bottom")
+            g_prefs.custom_bottom = static_cast<uint32_t>(std::strtoul(value.c_str(), nullptr, 16)) & 0xFFFFFF;
+        else if (key == "custom-light")
+            g_prefs.custom_light = static_cast<uint32_t>(std::strtoul(value.c_str(), nullptr, 16)) & 0xFFFFFF;
+        else if (key == "custom-accent")
+            g_prefs.custom_accent = static_cast<uint32_t>(std::strtoul(value.c_str(), nullptr, 16)) & 0xFFFFFF;
+        else if (key == "bubbles")
+            g_prefs.bubbles_3d = value != "flat";
+    }
+    std::fclose(f);
+    if (version < 2) {
+        // 1.05 and 1.06 turned these two around to find Uncharted's garbage, which 1.07's barriers
+        // fixed: back to the faster defaults once (files from before 1.08 saved them all)
+        g_prefs.gpu_compression = true;
+        g_prefs.ordered_blending = false;
+    }
+}
+
+void save_prefs() {
+    FILE *f = std::fopen(prefs_file().c_str(), "w");
+    if (!f) {
+        LOG_WARN("PS4: couldn't write {}", prefs_file());
+        return;
+    }
+    std::fprintf(f, "# HENkaku (Vita3K for PS4): the frontend's own settings (HENkaku > System, Display, CPU)\n");
+    std::fprintf(f, "settings = 2\n");
+    std::fprintf(f, "home = %s\n", g_prefs.home_style == HOME_LIST ? "list" : g_prefs.home_style == HOME_CARDS ? "cards" : "bubbles");
+    std::fprintf(f, "fsr-sharpness = %d\n", g_prefs.fsr_sharpness);
+    std::fprintf(f, "game-threads = %s\n", g_prefs.cluster_threads ? "cluster" : "all");
+    std::fprintf(f, "frame-queue = %s\n", g_prefs.frame_overlap ? "vita" : "vita3k");
+    std::fprintf(f, "vita-cores = %s\n", g_prefs.vita_cores ? "vita" : "parallel");
+    std::fprintf(f, "frame-generation = %s\n", g_prefs.frame_generation ? "on" : "off");
+    std::fprintf(f, "touch-markers = %s\n", g_prefs.touch_markers ? "on" : "off");
+    std::fprintf(f, "gpu-compression = %s\n", g_prefs.gpu_compression ? "on" : "off");
+    std::fprintf(f, "ordered-blending = %s\n", g_prefs.ordered_blending ? "on" : "off");
+    std::fprintf(f, "fast-calls = %s\n", g_prefs.fast_calls ? "on" : "off");
+    std::fprintf(f, "fast-atomics = %s\n", g_prefs.fast_atomics ? "on" : "off");
+    std::fprintf(f, "profiler = %s\n", g_prefs.profiler ? "on" : "off");
+    std::fprintf(f, "renderer-profiler = %s\n", g_prefs.host_profiler ? "on" : "off");
+    std::fprintf(f, "freeze-log = %s\n", g_prefs.freeze_log ? "on" : "off");
+    std::fprintf(f, "input-log = %s\n", g_prefs.input_log ? "on" : "off");
+    std::fprintf(f, "format-log = %s\n", g_prefs.format_log ? "on" : "off");
+    std::fprintf(f, "theme = %d\n", g_prefs.theme);
+    std::fprintf(f, "moving-wallpaper = %s\n", g_prefs.moving_wallpaper ? "on" : "off");
+    std::fprintf(f, "wallpaper = %s\n", g_prefs.wallpaper.empty() ? "wave" : g_prefs.wallpaper.c_str());
+    std::fprintf(f, "vita-theme = %s\n", g_prefs.vita_theme.c_str());
+    std::fprintf(f, "custom-top = %06x\n", g_prefs.custom_top);
+    std::fprintf(f, "custom-bottom = %06x\n", g_prefs.custom_bottom);
+    std::fprintf(f, "custom-light = %06x\n", g_prefs.custom_light);
+    std::fprintf(f, "custom-accent = %06x\n", g_prefs.custom_accent);
+    std::fprintf(f, "bubbles = %s\n", g_prefs.bubbles_3d ? "3d" : "flat");
+    std::fclose(f);
+}
+
+float fsr_sharpening(int index) {
+    return SHARPENING_STOPS[std::clamp(index, 0, static_cast<int>(std::size(SHARPENING_STOPS)) - 1)];
+}
+
