+
+// The local time, as the Vita's status bar shows it
+std::string clock_text() {
+    time_t now = std::time(nullptr);
+    time_t local = now;
+    uint32_t tsec[4] = {};
+    uint32_t dst = 0;
+    if (ps4l_utc_to_local(now, &local, tsec, &dst) != 0)
+        local = now;
+    std::tm tm{};
+    gmtime_r(&local, &tm);
+    char text[16];
+    std::snprintf(text, sizeof(text), "%02d:%02d", tm.tm_hour, tm.tm_min);
+    return text;
+}
