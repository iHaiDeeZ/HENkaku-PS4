+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#include "audio/impl/ps4_audio.h"
+#include "util/log.h"
+
+#include <orbis/AudioOut.h>
+#include <orbis/libkernel.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+
+namespace {
+
+constexpr int RATE = 48000;
+constexpr int GRAIN = 256; // frames per sceAudioOutOutput
+constexpr size_t RING_FRAMES = 16384; // ~340 ms
+// As the SDL backend: a port's thread waits while more than this many frames are queued
+constexpr size_t THRESHOLD_FRAMES = 4 * 512;
+constexpr int32_t SYSTEM_USER = 0xFF; // the main port, whoever is signed in
+constexpr int32_t VOLUME_MAX = 32768;
+
+// libkernel declares these without parameters
+using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+using SetPrioFn = int32_t (*)(OrbisPthread, int);
+
+int16_t lerp(int a, int b, float t) {
+    return static_cast<int16_t>(a + (b - a) * t);
+}
+
+} // namespace
+
+PS4AudioAdapter::PS4AudioAdapter(AudioState &audio_state)
+    : AudioAdapter(audio_state) {}
+
+PS4AudioAdapter::~PS4AudioAdapter() {
+    quit = true;
+    wake_all_ports();
+    if (mixer.joinable())
+        mixer.join();
+    if (handle >= 0)
+        sceAudioOutClose(handle);
+}
+
+bool PS4AudioAdapter::init() {
+    const int32_t result = sceAudioOutInit();
+    // already initialized is fine
+    if (result != 0 && result != static_cast<int32_t>(0x8026000E)) {
+        LOG_ERROR("sceAudioOutInit failed: {:08X}", static_cast<uint32_t>(result));
+        return false;
+    }
+    handle = sceAudioOutOpen(SYSTEM_USER, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, GRAIN, RATE, ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+    if (handle < 0) {
+        LOG_ERROR("sceAudioOutOpen failed: {:08X}", static_cast<uint32_t>(handle));
+        return false;
+    }
+    int32_t volume[2] = { VOLUME_MAX, VOLUME_MAX };
+    sceAudioOutSetVolume(handle, 0x3, volume); // front left + right
+    mixer = std::thread([this] { mix_loop(); });
+    LOG_INFO("PS4 audio: sceAudioOut port {:08X}, {} frames at {} Hz", static_cast<uint32_t>(handle), GRAIN, RATE);
+    return true;
+}
+
+void PS4AudioAdapter::mix_loop() {
+    // Above the emulation threads, so a slow frame doesn't make the sound crackle
+    const OrbisPthread self = scePthreadSelf();
+    reinterpret_cast<SetPrioFn>(&scePthreadSetprio)(self, 400);
+
+    alignas(32) int16_t grains[2][GRAIN * 2];
+    int32_t acc[GRAIN * 2];
+    int current = 0;
+    std::vector<std::shared_ptr<PS4AudioOutPort>> live;
+    while (!quit) {
+        std::memset(acc, 0, sizeof(acc));
+        if (!paused) {
+            live.clear();
+            {
+                const std::lock_guard<std::mutex> lock(ports_mutex);
+                std::erase_if(ports, [](const auto &weak) { return weak.expired(); });
+                for (const auto &weak : ports) {
+                    if (auto port = weak.lock())
+                        live.push_back(std::move(port));
+                }
+            }
+            for (const auto &port : live) {
+                const float gain = port->gain;
+                {
+                    const std::lock_guard<std::mutex> lock(port->mutex);
+                    const size_t frames = std::min<size_t>(port->count, GRAIN);
+                    for (size_t i = 0; i < frames; i++) {
+                        const size_t at = ((port->read_pos + i) % RING_FRAMES) * 2;
+                        acc[i * 2] += static_cast<int32_t>(port->ring[at] * gain);
+                        acc[i * 2 + 1] += static_cast<int32_t>(port->ring[at + 1] * gain);
+                    }
+                    port->read_pos = (port->read_pos + frames) % RING_FRAMES;
+                    port->count -= frames;
+                }
+                if (port->count < THRESHOLD_FRAMES)
+                    port->cond_var.notify_one();
+            }
+            live.clear();
+        }
+        int16_t *out = grains[current];
+        for (int i = 0; i < GRAIN * 2; i++)
+            out[i] = static_cast<int16_t>(std::clamp(acc[i], -32768, 32767));
+        // blocks until the previous grain is playing, which paces this thread
+        sceAudioOutOutput(handle, out);
+        current ^= 1;
+    }
+    sceAudioOutOutput(handle, nullptr); // wait for the last grain
+}
+
+void PS4AudioAdapter::switch_state(const bool pause) {
+    paused = pause;
+}
+
+AudioOutPortPtr PS4AudioAdapter::open_port(int nb_channels, int freq, int nb_sample) {
+    auto port = std::make_shared<PS4AudioOutPort>();
+    port->channels = nb_channels;
+    port->len_microseconds = (nb_sample * 1'000'000ULL) / freq;
+    port->len_bytes = nb_sample * nb_channels * sizeof(int16_t);
+    port->freq = freq;
+    port->ring.resize(RING_FRAMES * 2);
+    {
+        const std::lock_guard<std::mutex> lock(ports_mutex);
+        ports.push_back(port);
+    }
+    return port;
+}
+
+void PS4AudioAdapter::audio_output(AudioOutPort &out_port, const void *buffer) {
+    if (out_port.stopping)
+        return;
+
+    auto &port = static_cast<PS4AudioOutPort &>(out_port);
+    const int16_t *in = static_cast<const int16_t *>(buffer);
+    const int channels = port.channels;
+    const int in_frames = port.len_bytes / (channels * static_cast<int>(sizeof(int16_t)));
+    if (in_frames <= 0 || port.freq <= 0)
+        return;
+
+    // Linear resampling to 48 kHz, continuing from the previous call (its last frame is at -1)
+    const auto frame = [&](int i, int c) -> int {
+        if (i < 0)
+            return port.prev[c];
+        return in[i * channels + (channels == 2 ? c : 0)];
+    };
+    const double step = static_cast<double>(port.freq) / RATE;
+    auto &scratch = port.scratch;
+    scratch.clear();
+    double pos = port.phase;
+    while (pos < in_frames - 1) {
+        const int i = static_cast<int>(std::floor(pos));
+        const float t = static_cast<float>(pos - i);
+        scratch.push_back(lerp(frame(i, 0), frame(i + 1, 0), t));
+        scratch.push_back(lerp(frame(i, 1), frame(i + 1, 1), t));
+        pos += step;
+    }
+    port.phase = pos - in_frames;
+    port.prev[0] = static_cast<int16_t>(frame(in_frames - 1, 0));
+    port.prev[1] = static_cast<int16_t>(frame(in_frames - 1, 1));
+
+    // If there's lots of audio left to play, wait: the mixer wakes this thread when it runs low
+    std::unique_lock<std::mutex> lock(port.mutex);
+    if (port.count > THRESHOLD_FRAMES) {
+        port.cond_var.wait_for(lock, std::chrono::microseconds(port.len_microseconds * 2));
+        if (out_port.stopping || quit)
+            return;
+    }
+    const size_t frames = scratch.size() / 2;
+    for (size_t i = 0; i < frames; i++) {
+        if (port.count == RING_FRAMES) {
+            // full: drop the oldest frame
+            port.read_pos = (port.read_pos + 1) % RING_FRAMES;
+            port.count--;
+        }
+        const size_t at = ((port.read_pos + port.count) % RING_FRAMES) * 2;
+        port.ring[at] = scratch[i * 2];
+        port.ring[at + 1] = scratch[i * 2 + 1];
+        port.count++;
+    }
+}
+
+void PS4AudioAdapter::set_volume(AudioOutPort &out_port, float volume) {
+    static_cast<PS4AudioOutPort &>(out_port).gain = volume;
+}
+
+int PS4AudioAdapter::get_rest_sample(AudioOutPort &out_port) {
+    auto &port = static_cast<PS4AudioOutPort &>(out_port);
+    const std::lock_guard<std::mutex> lock(port.mutex);
+    return static_cast<int>(port.count);
+}
+
+void PS4AudioAdapter::wake_all_ports() {
+    for (auto &[_, port_ptr] : state.out_ports) {
+        auto &port = static_cast<PS4AudioOutPort &>(*port_ptr);
+        {
+            const std::lock_guard<std::mutex> lock(port.mutex);
+        }
+        port.cond_var.notify_all();
+    }
+}
