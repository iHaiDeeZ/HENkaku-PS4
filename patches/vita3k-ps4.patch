+VKAPI_ATTR VkResult VKAPI_CALL GetPhysicalDeviceSurfaceFormatsKHR(VkPhysicalDevice, VkSurfaceKHR, uint32_t *count, VkSurfaceFormatKHR *formats) {
+    // VideoOut A8B8G8R8 = R8G8B8A8 in memory (verified by DolphinPS4)
+    if (formats == nullptr) {
+        *count = 1;
+        return VK_SUCCESS;
