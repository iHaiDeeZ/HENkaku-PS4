+bool call_fast_import(EmuEnvState &emuenv, CPUState &cpu) {
+    // the stub is "svc #0; mov pc, lr; .word nid", and the pc is past the svc
+    const uint32_t nid = *Ptr<uint32_t>(read_pc(cpu) + 4).get(emuenv.mem);
+    const FastImport kind = fast_import_kind(nid);
+    if (kind == FastImport::No || emuenv.kernel.debugger.watch_import_calls || !ps4_fast_calls())
+        return false;
+    if (kind == FastImport::ImmediateContext && !gxm_context_is_immediate(emuenv, read_reg(cpu, 0)))
+        return false;
+    const ImportFn *fn = resolve_import(nid);
+    if (!fn)
+        return false;
+    const uint64_t start = __builtin_ia32_rdtsc();
+    (*fn)(emuenv, cpu, cpu.thread_id);
+    ps4_perf_fast_import(nid, __builtin_ia32_rdtsc() - start);
+    return true;
+}
