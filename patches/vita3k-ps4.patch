@@ -367,6 +367,26 @@ std::unique_ptr<Dynarmic::A32::Jit> DynarmicCPU::make_jit() {
     config.coprocessors[15] = cp15;
     config.processor_id = core_id;
     config.optimizations = cpu_opt ? Dynarmic::all_safe_optimizations : Dynarmic::no_optimizations;
+#ifdef __PS4__
+    // The PS4's Jaguar cores have no FMA: NEON's fused reciprocal steps (VRECPS/VRSQRTS) and the
+    // estimates (VRECPE/VRSQRTE) went through dynarmic's soft-float code element by element, every
+    // VFP result was checked for NaNs, and NEON code switched MXCSR to the standard FPSCR value
+    // around each instruction. The unsafe floating-point optimizations (yuzu's "Unsafe" accuracy)
+    // use the host's own instructions instead. Exclusive accesses stay accurate.
+    if (cpu_opt) {
+        config.unsafe_optimizations = true;
+        config.optimizations |= Dynarmic::OptimizationFlag::Unsafe_UnfuseFMA
+            | Dynarmic::OptimizationFlag::Unsafe_ReducedErrorFP
+            | Dynarmic::OptimizationFlag::Unsafe_InaccurateNaN
+            | Dynarmic::OptimizationFlag::Unsafe_IgnoreStandardFPCRValue;
+    }
+    // LDREX/STREX (the game's atomics and locks) inline, with the store a lock cmpxchg on the
+    // guest memory, instead of a call into the monitor under its spin lock each: yuzu's default
+    if (config.fastmem_pointer) {
+        config.fastmem_exclusive_access = true;
+        config.recompile_on_exclusive_fastmem_failure = true;
+    }
+#endif
     config.enable_cycle_counting = false;
 
     return std::make_unique<Dynarmic::A32::Jit>(config);
