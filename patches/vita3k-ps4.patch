+#ifdef __PS4__
+// The PS4 has no overcommit: anonymous memory is flexible memory (a few hundred MiB, shared with
+// the eboot, the heap and the thread stacks), and mmap(PROT_NONE) can't reserve gigabytes. So the
+// 4 GiB of guest space is a virtual range reservation, and the host pages the allocator commits are
+// backed by direct memory mapped in at their place (2 MiB regions), given back to a free list when
+// decommitted. The PS4 maps and protects 16 KiB pages (sysconf says 4 KiB).
+extern "C" {
+// Declared by hand: several OpenOrbis prototypes are wrong.
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t length, size_t alignment, int32_t memory_type, off_t *physical_out);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int32_t protection, int32_t flags, off_t direct_memory_start, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void *address, size_t length);
+}
+
+namespace ps4_mem {
+
+constexpr uint32_t PAGE = KiB(16);
+constexpr size_t SLAB = MiB(64);
+constexpr size_t LARGE_PAGE = MiB(2);
+constexpr size_t PAGES_PER_REGION = LARGE_PAGE / PAGE;
+constexpr int32_t WB_ONION = 0; // SCE_KERNEL_WB_ONION
+constexpr int32_t MAP_FIXED_FLAG = 0x10; // SCE_KERNEL_MAP_FIXED
+constexpr int32_t PROT_CPU_RW = 0x3;
+
+// The guest space is backed 2 MiB at a time, each region by 2 MiB of direct memory aligned like
+// its address, so the PS4 can map it with one large page. Backed 16 KiB at a time (up to v00.13),
+// the physical runs didn't line up with the addresses: every guest page took four of the CPU's
+// 4 KiB TLB entries, and the JIT's loads and stores spent their time in page walks (Jaguar's TLBs
+// hold a few hundred entries; a game's working set is tens of MiB).
+std::mutex mutex;
+uint8_t *base = nullptr;
+// For each 2 MiB region of the guest space: its physical region + 1, or 0 while it isn't backed
+std::vector<uint32_t> region_phys;
+// For each region: how many of its 16 KiB pages the allocator has committed
+std::vector<uint16_t> region_used;
+// For each 16 KiB page: committed by the allocator (a region goes back once none of its pages is)
+std::vector<uint8_t> page_committed;
+// Physical regions given back, used first
+std::vector<uint32_t> free_regions;
+// The rest of the newest block of direct memory
+off_t slab = 0;
+size_t slab_left = 0;
+size_t direct_total = 0;
+size_t committed = 0;
+
+uint8_t *reserve(size_t size) {
+    // Above the kernel's own allocations at 0x200000000, away from the heap (0x1000000000) and
+    // RADV's GPU windows (0x4000000000-0x4600000000). A hint whose range isn't free fails
+    // instead of searching on, so try a few.
+    for (const uintptr_t hint : { 0x2000000000ULL, 0x2400000000ULL, 0x3000000000ULL, 0x1800000000ULL, 0x800000000ULL }) {
+        void *addr = reinterpret_cast<void *>(hint);
+        const int32_t ret = sceKernelReserveVirtualRange(&addr, size, 0, LARGE_PAGE);
+        if (ret == 0) {
+            const std::lock_guard<std::mutex> lock(mutex);
+            base = static_cast<uint8_t *>(addr);
+            region_phys.assign(size / LARGE_PAGE, 0);
+            region_used.assign(size / LARGE_PAGE, 0);
+            page_committed.assign(size / PAGE, 0);
+            LOG_INFO("PS4: {} MiB of guest address space at {}, backed in 2 MiB regions, {} MiB of direct memory reused", size >> 20, addr, (free_regions.size() * LARGE_PAGE) >> 20);
+            return base;
+        }
+        LOG_WARN("PS4: reserving {} MiB at 0x{:X} failed: {:08X}", size >> 20, hint, static_cast<uint32_t>(ret));
+    }
+    return nullptr;
+}
+
+// 2 MiB of direct memory, 2 MiB aligned: one given back, else the next piece of the newest block,
+// else a new block (64 MiB, or 2 MiB when that much isn't left in one piece).
+bool take_region(off_t &phys) {
+    if (!free_regions.empty()) {
+        phys = static_cast<off_t>(free_regions.back()) * LARGE_PAGE;
+        free_regions.pop_back();
+        return true;
+    }
+    if (slab_left < LARGE_PAGE) {
+        size_t size = SLAB;
+        off_t start = 0;
+        int32_t ret = sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()), size, LARGE_PAGE, WB_ONION, &start);
+        if (ret != 0) {
+            size = LARGE_PAGE;
+            ret = sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()), size, LARGE_PAGE, WB_ONION, &start);
+        }
+        if (ret != 0) {
+            LOG_CRITICAL("PS4: out of direct memory ({} MiB in use for guest memory, {:08X})", direct_total >> 20, static_cast<uint32_t>(ret));
+            return false;
+        }
+        direct_total += size;
+        slab = start;
+        slab_left = size;
+    }
+    phys = slab;
+    slab += LARGE_PAGE;
+    slab_left -= LARGE_PAGE;
+    return true;
+}
+
+// Unmaps a range of the guest space and reserves it again, so nothing else lands in it.
+void unmap_to_reserved(uint8_t *ptr, size_t size) {
+    sceKernelMunmap(ptr, size);
+    void *addr = ptr;
+    const int32_t ret = sceKernelReserveVirtualRange(&addr, size, MAP_FIXED_FLAG, PAGE);
+    LOG_CRITICAL_IF(ret != 0 || addr != ptr, "PS4: reserving {} again failed: {:08X}", static_cast<void *>(ptr), static_cast<uint32_t>(ret));
+}
+
+bool map_run(uint8_t *ptr, size_t size, off_t phys) {
+    void *addr = ptr;
+    // over the reservation, or failing that in its place (and if the 2 MiB alignment is what the
+    // kernel minds, with the 16 KiB one)
+    int32_t ret = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, MAP_FIXED_FLAG, phys, LARGE_PAGE);
+    if (ret != 0 || addr != ptr) {
+        sceKernelMunmap(ptr, size);
+        addr = ptr;
+        ret = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, MAP_FIXED_FLAG, phys, LARGE_PAGE);
+    }
+    if (ret != 0 || addr != ptr) {
+        LOG_WARN_ONCE("PS4: mapping guest memory 2 MiB aligned failed ({:08X}), mapping it 16 KiB aligned", static_cast<uint32_t>(ret));
+        sceKernelMunmap(ptr, size);
+        addr = ptr;
+        ret = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, MAP_FIXED_FLAG, phys, PAGE);
+    }
+    if (ret != 0 || addr != ptr) {
+        LOG_CRITICAL("PS4: mapping {} KiB of direct memory at {} failed: {:08X}", size >> 10, static_cast<void *>(ptr), static_cast<uint32_t>(ret));
+        unmap_to_reserved(ptr, size);
+        return false;
+    }
+    return true;
+}
+
+// Backs the regions of [ptr, ptr + size) that aren't yet (backed ones keep their data) and counts
+// its pages as committed.
+bool commit(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    const size_t first = (ptr - base) / PAGE;
+    const size_t last = (ptr + size - base + PAGE - 1) / PAGE;
+    if (first >= last)
+        return true;
+    for (size_t region = first / PAGES_PER_REGION; region <= (last - 1) / PAGES_PER_REGION; region++) {
+        if (region_phys[region])
+            continue;
+        off_t phys = 0;
+        if (!take_region(phys))
+            return false;
+        if (!map_run(base + region * LARGE_PAGE, LARGE_PAGE, phys)) {
+            free_regions.push_back(static_cast<uint32_t>(phys / LARGE_PAGE));
+            return false;
+        }
+        region_phys[region] = static_cast<uint32_t>(phys / LARGE_PAGE + 1);
+    }
+    for (size_t page = first; page < last; page++) {
+        if (!page_committed[page]) {
+            page_committed[page] = 1;
+            region_used[page / PAGES_PER_REGION]++;
+            committed += PAGE;
+        }
+    }
+    return true;
+}
+
+// Counts the pages of [ptr, ptr + size) as free; a region none of whose pages is committed any
+// more is unmapped and its direct memory goes back to the free list. (A freed page in a region
+// still in use stays mapped: a stray access to it isn't caught, as it wouldn't be on a Vita.)
+void decommit(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    const size_t first = (ptr - base) / PAGE;
+    const size_t last = (ptr + size - base + PAGE - 1) / PAGE;
+    if (first >= last)
+        return;
+    for (size_t page = first; page < last; page++) {
+        if (page_committed[page]) {
+            page_committed[page] = 0;
+            region_used[page / PAGES_PER_REGION]--;
+            committed -= PAGE;
+        }
+    }
+    for (size_t region = first / PAGES_PER_REGION; region <= (last - 1) / PAGES_PER_REGION; region++) {
+        if (region_phys[region] && region_used[region] == 0) {
+            unmap_to_reserved(base + region * LARGE_PAGE, LARGE_PAGE);
+            free_regions.push_back(region_phys[region] - 1);
+            region_phys[region] = 0;
+        }
+    }
+}
+
+// The whole guest space goes; its physical regions stay with us for the next one.
+void release(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    for (uint32_t &phys : region_phys) {
+        if (phys) {
+            free_regions.push_back(phys - 1);
+            phys = 0;
+        }
+    }
+    committed = 0;
+    sceKernelMunmap(ptr, size);
+    base = nullptr;
+    region_phys.clear();
+    region_phys.shrink_to_fit();
+    region_used.clear();
+    region_used.shrink_to_fit();
+    page_committed.clear();
+    page_committed.shrink_to_fit();
+}
