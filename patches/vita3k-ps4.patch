index 00000000..0756bfd9
--- /dev/null
+++ b/vita3k/ps4/ps4_perf.cpp
@@ -0,0 +1,423 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: where the game's threads spend their time, call by call, and how the PS4 maps memory.
+//
+// Every guest thread's JIT loop (kernel/src/thread.cpp) hands over the time of each run of guest
+// code (dynarmic, up to the next import) and of each import it calls (the HLE function: its own
+// work, or its wait), with the import's NID. ps4perf::report() puts each busy thread's split in
+// the log next to the perf line: which imports a thread waits in, and how much of its time is
+// emulated code. The time is the TSC's (rdtsc: invariant on the Jaguar cores), wall time.
+
+#include "ps4_perf.h"
+
+#include <nids/functions.h>
+#include <util/log.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <string>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include <sys/types.h>
+
+namespace {
+
+constexpr int kMaxThreads = 64;
+constexpr int kSlots = 256; // per thread, open addressing on the NID
+
+struct ImportSlot {
+    std::atomic<uint32_t> nid{ 0 };
+    std::atomic<uint64_t> ticks{ 0 };
+    std::atomic<uint64_t> calls{ 0 };
+};
+
+struct GuestThread {
+    char name[32] = {};
+    std::atomic<bool> ready{ false };
+    std::atomic<uint64_t> code_ticks{ 0 };
+    std::atomic<uint64_t> code_runs{ 0 };
+    ImportSlot slots[kSlots];
+    // the imports it is in now, innermost last (a callback can call imports from inside one)
+    static constexpr int kDepth = 4;
+    std::atomic<int> depth{ 0 };
+    std::atomic<uint32_t> current_nid[kDepth] = {};
+    std::atomic<uint32_t> current_arg[kDepth] = {};
+    std::atomic<uint64_t> current_start[kDepth] = {};
+    // the run of guest code it is in now (0: none), and its CPU
+    std::atomic<uint64_t> code_start{ 0 };
+    std::atomic<void *> cpu{ nullptr };
+    void (*halt)(void *) = nullptr;
+    std::atomic<bool> halted_for_pc{ false };
+    // the profiler: a sample asked for (the thread stopped), and the samples by pc
+    int id = 0;
+    std::atomic<bool> sample_requested{ false };
+    std::mutex samples_mutex;
+    std::unordered_map<uint32_t, uint32_t> samples;
+    uint64_t sample_count = 0;
+};
+
+GuestThread g_threads[kMaxThreads];
+std::atomic<int> g_count{ 0 };
+constinit thread_local GuestThread *t_thread = nullptr;
+
+// Only the owning thread writes its counters: plain adds, published with relaxed stores
+void add(std::atomic<uint64_t> &counter, uint64_t value) {
+    counter.store(counter.load(std::memory_order_relaxed) + value, std::memory_order_relaxed);
+}
+
+} // namespace
+
+namespace {
+void sampler_loop();
+} // namespace
+
+extern "C" void ps4_perf_guest_thread(const char *name) {
+    static std::once_flag sampler;
+    std::call_once(sampler, [] { std::thread(sampler_loop).detach(); });
+    const int index = g_count.fetch_add(1);
+    if (index >= kMaxThreads) {
+        t_thread = nullptr;
+        return;
+    }
+    GuestThread &thread = g_threads[index];
+    snprintf(thread.name, sizeof(thread.name), "%s", name ? name : "?");
+    thread.ready.store(true, std::memory_order_release);
+    t_thread = &thread;
+}
+
+extern "C" void ps4_perf_code(uint64_t ticks) {
+    GuestThread *const thread = t_thread;
+    if (!thread)
+        return;
+    add(thread->code_ticks, ticks);
+    add(thread->code_runs, 1);
+}
+
+extern "C" void ps4_perf_code_begin(void *cpu, void (*halt)(void *)) {
+    GuestThread *const thread = t_thread;
+    if (!thread)
+        return;
+    thread->halt = halt;
+    thread->cpu.store(cpu, std::memory_order_relaxed);
+    thread->code_start.store(__builtin_ia32_rdtsc(), std::memory_order_release);
+}
+
+extern "C" bool ps4_profiler(); // vita3k/ps4/ps4_settings.cpp
+extern "C" bool ps4_freeze_log();
+
+extern "C" int ps4_perf_code_end() {
+    GuestThread *const thread = t_thread;
+    if (!thread)
+        return 0;
+    thread->code_start.store(0, std::memory_order_release);
+    return (thread->halted_for_pc.exchange(false) ? 1 : 0) | (thread->sample_requested.exchange(false) ? 2 : 0);
+}
+
+extern "C" void ps4_perf_thread_id(int id) {
+    if (t_thread)
+        t_thread->id = id;
+}
+
+extern "C" void ps4_perf_sample(uint32_t pc) {
+    GuestThread *const thread = t_thread;
+    if (!thread)
+        return;
+    const std::lock_guard<std::mutex> lock(thread->samples_mutex);
+    thread->samples[pc]++;
+    thread->sample_count++;
+}
+
+namespace {
+
+// Stops each thread that runs guest code 500 times a second, which then takes a sample of where
+// it is (kernel/src/thread.cpp) and goes on: about a microsecond each
+void sampler_loop() {
+    while (true) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        if (!ps4_profiler())
+            continue;
+        const int count = std::min(g_count.load(), kMaxThreads);
+        for (int i = 0; i < count; i++) {
+            GuestThread &thread = g_threads[i];
+            if (!thread.ready.load(std::memory_order_acquire) || !thread.halt)
+                continue;
+            if (thread.code_start.load(std::memory_order_acquire) == 0 || thread.sample_requested.exchange(true))
+                continue;
+            thread.halt(thread.cpu.load(std::memory_order_relaxed));
+        }
+    }
+}
+
+} // namespace
+
+extern "C" void ps4_perf_import_begin(uint32_t nid, uint32_t arg0) {
+    GuestThread *const thread = t_thread;
+    if (!thread)
+        return;
+    const int depth = thread->depth.load(std::memory_order_relaxed);
+    if (depth < GuestThread::kDepth) {
+        thread->current_nid[depth].store(nid, std::memory_order_relaxed);
+        thread->current_arg[depth].store(arg0, std::memory_order_relaxed);
+        thread->current_start[depth].store(__builtin_ia32_rdtsc(), std::memory_order_relaxed);
+    }
+    thread->depth.store(depth + 1, std::memory_order_release);
+}
+
+extern "C" void ps4_perf_import(uint32_t nid, uint64_t ticks) {
+    GuestThread *const thread = t_thread;
+    if (!thread)
+        return;
+    const int depth = thread->depth.load(std::memory_order_relaxed);
+    if (depth > 0)
+        thread->depth.store(depth - 1, std::memory_order_release);
+    if (nid == 0)
+        return;
+    const uint32_t start = (nid * 0x9E3779B1u) >> 24;
+    for (int probe = 0; probe < kSlots; probe++) {
+        ImportSlot &slot = thread->slots[(start + probe) & (kSlots - 1)];
+        const uint32_t slot_nid = slot.nid.load(std::memory_order_relaxed);
+        if (slot_nid == nid) {
+            add(slot.ticks, ticks);
+            add(slot.calls, 1);
+            return;
+        }
+        if (slot_nid == 0) {
+            slot.ticks.store(ticks, std::memory_order_relaxed);
+            slot.calls.store(1, std::memory_order_relaxed);
+            slot.nid.store(nid, std::memory_order_release);
+            return;
+        }
+    }
+}
+
+namespace ps4perf {
+
+namespace {
+
+struct Snapshot {
+    uint64_t code_ticks = 0;
+    uint64_t code_runs = 0;
+    uint64_t ticks[kSlots] = {};
+    uint64_t calls[kSlots] = {};
+};
+Snapshot g_previous[kMaxThreads];
+
+} // namespace
+
+double report(double seconds, double ticks_per_ms) {
+    double longest = 0;
+    // the first call only takes the counters as they are
+    const bool log = seconds > 0 && ticks_per_ms > 0;
+    if (!log)
+        seconds = ticks_per_ms = 1;
+    const int count = std::min(g_count.load(), kMaxThreads);
+    for (int i = 0; i < count; i++) {
+        GuestThread &thread = g_threads[i];
+        if (!thread.ready.load(std::memory_order_acquire))
+            continue;
+        Snapshot &previous = g_previous[i];
+
+        struct Entry {
+            uint32_t nid;
+            double ms;
+            double calls;
+        };
+        std::vector<Entry> entries;
+        double imports_ms = 0, import_calls = 0;
+        for (int s = 0; s < kSlots; s++) {
+            ImportSlot &slot = thread.slots[s];
+            const uint32_t nid = slot.nid.load(std::memory_order_acquire);
+            if (nid == 0)
+                continue;
+            const uint64_t ticks = slot.ticks.load(std::memory_order_relaxed);
+            const uint64_t calls = slot.calls.load(std::memory_order_relaxed);
+            const double ms = (ticks - previous.ticks[s]) / ticks_per_ms / seconds;
+            const double per_second = (calls - previous.calls[s]) / seconds;
+            previous.ticks[s] = ticks;
+            previous.calls[s] = calls;
+            imports_ms += ms;
+            import_calls += per_second;
+            if (ms >= 1.0)
+                entries.push_back({ nid, ms, per_second });
+        }
+        const uint64_t code_ticks = thread.code_ticks.load(std::memory_order_relaxed);
+        const uint64_t code_runs = thread.code_runs.load(std::memory_order_relaxed);
+        const double code_ms = (code_ticks - previous.code_ticks) / ticks_per_ms / seconds;
+        previous.code_ticks = code_ticks;
+        previous.code_runs = code_runs;
+
+        // a thread in guest code for 2 s or more without a call: a spin. Stopped once, it logs where
+        // (and goes on).
+        const uint64_t code_start = thread.code_start.load(std::memory_order_acquire);
+        if (log && ps4_freeze_log() && code_start != 0 && (__builtin_ia32_rdtsc() - code_start) / ticks_per_ms >= 2000.0 && thread.halt && !thread.halted_for_pc.load()) {
+            thread.halted_for_pc.store(true);
+            thread.halt(thread.cpu.load(std::memory_order_relaxed));
+        }
+
+        // a thread in the same import for 2 s or more: what it waits for (a freeze shows here)
+        const int depth = std::min(thread.depth.load(std::memory_order_acquire), static_cast<int>(GuestThread::kDepth));
+        if (log && depth > 0 && ps4_freeze_log()) {
+            const uint64_t now = __builtin_ia32_rdtsc();
+            std::string stuck;
+            for (int d = 0; d < depth; d++) {
+                const double in_s = (now - thread.current_start[d].load(std::memory_order_relaxed)) / ticks_per_ms / 1000.0;
+                const char *name = import_name(thread.current_nid[d].load(std::memory_order_relaxed));
+                // (a thread that ended inside its exit call stays there)
+                if (in_s < 2.0 || std::strstr(name, "Exit"))
+                    continue;
+                longest = std::max(longest, in_s);
+                char part[128];
+                snprintf(part, sizeof(part), "%s%s(0x%x) for %.0f s", stuck.empty() ? "" : ", then ", name,
+                    thread.current_arg[d].load(std::memory_order_relaxed), in_s);
+                stuck += part;
+            }
+            if (!stuck.empty())
+                LOG_INFO("perf: {} is in {}", thread.name, stuck);
+        }
+
+        // the threads that did something: more than 5% of the time in code and imports together
+        if (!log || code_ms + imports_ms < 50)
+            continue;
+        std::sort(entries.begin(), entries.end(), [](const Entry &a, const Entry &b) { return a.ms > b.ms; });
+        std::string line;
+        for (size_t e = 0; e < std::min<size_t>(entries.size(), 8); e++) {
+            char part[128];
+            snprintf(part, sizeof(part), "%s%s %.0f (%.0f/s)", e ? ", " : "", import_name(entries[e].nid), entries[e].ms, entries[e].calls);
+            line += part;
+        }
+        LOG_INFO("perf: {}: guest code {:.0f} ms/s, imports {:.0f} ms/s ({:.0f} calls/s): {}", thread.name, code_ms, imports_ms, import_calls, line);
+    }
+    return longest;
+}
+
+std::vector<ProfileThread> take_profile(size_t top) {
+    std::vector<ProfileThread> profile;
+    const int count = std::min(g_count.load(), kMaxThreads);
+    for (int i = 0; i < count; i++) {
+        GuestThread &thread = g_threads[i];
+        if (!thread.ready.load(std::memory_order_acquire))
+            continue;
+        ProfileThread entry;
+        {
+            const std::lock_guard<std::mutex> lock(thread.samples_mutex);
+            if (thread.sample_count == 0)
+                continue;
+            entry.total = thread.sample_count;
+            entry.hottest.assign(thread.samples.begin(), thread.samples.end());
+            thread.samples.clear();
+            thread.sample_count = 0;
+        }
+        entry.name = thread.name;
+        entry.id = thread.id;
+        std::sort(entry.hottest.begin(), entry.hottest.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+        if (entry.hottest.size() > top)
+            entry.hottest.resize(top);
+        profile.push_back(std::move(entry));
+    }
+    return profile;
+}
+
+// --- Large pages ---------------------------------------------------------------------------
+
+extern "C" {
+// Declared by hand, as in mem/src/mem.cpp
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t length, size_t alignment, int32_t memory_type, off_t *physical_out);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int32_t protection, int32_t flags, off_t direct_memory_start, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void *address, size_t length);
+}
+
+namespace {
+
+// Average latency of dependent loads following a random cycle through the cache lines of
+// [memory, memory + size): mostly cache misses, each with a TLB miss unless large pages cover it.
+double chase_ns(const uint8_t *memory, size_t steps) {
+    uint32_t offset = 0;
+    const auto start = std::chrono::steady_clock::now();
+    for (size_t i = 0; i < steps; i++)
+        offset = *reinterpret_cast<const volatile uint32_t *>(memory + offset);
+    const auto end = std::chrono::steady_clock::now();
+    // keeps the chain
+    if (offset == 0xFFFFFFFF)
+        LOG_INFO("");
+    return std::chrono::duration<double, std::nano>(end - start).count() / steps;
+}
+
+} // namespace
+
+void benchmark_large_pages() {
+    constexpr size_t SIZE = 32 * 1024 * 1024;
+    constexpr size_t LARGE_PAGE = 2 * 1024 * 1024;
+    constexpr size_t PAGE = 16 * 1024;
+    constexpr size_t LINE = 64;
+    constexpr int32_t MAP_FIXED_FLAG = 0x10;
+    constexpr int32_t PROT_CPU_RW = 0x3;
+
+    off_t phys = 0;
+    if (sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()), SIZE, LARGE_PAGE, 0, &phys) != 0) {
+        LOG_INFO("PS4 memory test: no direct memory for it");
+        return;
+    }
+    // one range, room for both mappings of the same memory: 2 MiB aligned, and 16 KiB off that
+    void *range = nullptr;
+    const size_t range_size = 2 * SIZE + 2 * LARGE_PAGE;
+    if (sceKernelReserveVirtualRange(&range, range_size, 0, LARGE_PAGE) != 0) {
+        sceKernelReleaseDirectMemory(phys, SIZE);
+        LOG_INFO("PS4 memory test: no address space for it");
+        return;
+    }
+    sceKernelMunmap(range, range_size);
+    void *aligned = range;
+    void *shifted = static_cast<uint8_t *>(range) + SIZE + LARGE_PAGE + PAGE;
+    const bool mapped = sceKernelMapDirectMemory(&aligned, SIZE, PROT_CPU_RW, MAP_FIXED_FLAG, phys, LARGE_PAGE) == 0
+        && sceKernelMapDirectMemory(&shifted, SIZE, PROT_CPU_RW, MAP_FIXED_FLAG, phys, PAGE) == 0;
+    if (mapped) {
+        // a random cycle through the lines, written through the first mapping
+        const uint32_t lines = SIZE / LINE;
+        std::vector<uint32_t> order(lines);
+        for (uint32_t i = 0; i < lines; i++)
+            order[i] = i;
+        std::mt19937 random(1234);
+        std::shuffle(order.begin() + 1, order.end(), random);
+        uint8_t *const memory = static_cast<uint8_t *>(aligned);
+        for (uint32_t i = 0; i < lines; i++)
+            *reinterpret_cast<uint32_t *>(memory + order[i] * LINE) = order[(i + 1) % lines] * LINE;
+        constexpr size_t STEPS = 200000;
+        chase_ns(static_cast<const uint8_t *>(aligned), STEPS / 4); // warm up
+        const double large = chase_ns(static_cast<const uint8_t *>(aligned), STEPS);
+        const double small = chase_ns(static_cast<const uint8_t *>(shifted), STEPS);
+        LOG_INFO("PS4 memory test: random reads over 32 MiB take {:.0f} ns mapped 2 MiB aligned, {:.0f} ns mapped 16 KiB off ({})",
+            large, small, large < small * 0.85 ? "large pages help: the guest memory uses them" : "no difference: no large pages?");
+    } else {
+        LOG_INFO("PS4 memory test: mapping failed");
+    }
+    sceKernelMunmap(range, range_size);
+    sceKernelReleaseDirectMemory(phys, SIZE);
+}
+
+} // namespace ps4perf
