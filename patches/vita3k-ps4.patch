+
+// PS4: the HENkaku settings, the same pages in the launcher (the HENkaku bubble: all games; a
+// game's LiveArea: that game) and in a game's quick menu (L3 + R3): sections, choices, pages
+// within pages, as overlay::pause_menu_item (the in-game menu draws them itself, the launcher
+// with its canvas).
+
+#pragma once
+
+#include <overlay/pause_overlay.h>
+
+#include <string>
+#include <vector>
+
+struct EmuEnvState;
+
+namespace ps4settings {
+
+using Item = overlay::pause_menu_item;
+
+// The PS4 frontend's own settings, which Vita3K's config.yml has no place for
+// (/data/HENkaku/ps4.cfg, "key = value" lines)
+struct Prefs {
+    // the home screen: the PS Vita's bubbles, or Vita3K's list
+    bool bubbles = true;
+    // FSR 1's sharpening, an index into the choices (1: 0.2 stops, Vita3K's)
+    int fsr_sharpness = 1;
+    // the game's threads on the first four cores (one Jaguar cluster, sharing their L2 cache), or
+    // on all six like everything else
+    bool cluster_threads = false;
+    // a game that keeps one frame in its display queue (Mortal Kombat) may build the next one while
+    // that frame waits for its vblank, as on the Vita, where Vita3K waits until it is shown
+    bool frame_overlap = true;
+    // frame generation: in-between frames for games at 30 to 40 fps, which the screen then shows at
+    // 60 (renderer/vulkan/frame_generation.h); a vblank more of delay
+    bool frame_generation = false;
+    // a circle where each finger is on the front screen (the touch pad shows no picture)
+    bool touch_markers = true;
+    // the threads a game pins to one Vita core run one at a time, switching when one blocks, as on
+    // the Vita (some games deadlock when they run side by side), or all side by side
+    bool vita_cores = true;
+    // the diagnostics (HENkaku > Diagnostics), each one can be switched off:
+    // samples where the game's threads run, and logs the hottest code every 10 s
+    bool profiler = true;
+    // times what HENkaku's render thread does (commands, state, the parts of a draw) every 10 s
+    bool host_profiler = true;
+    // a thread stuck in one call for seconds: the call, and every thread's wait and lock holders
+    bool freeze_log = true;
+    // the left stick as games read it, each time its direction changes (the first 60 times a run)
+    bool input_log = true;
+    // each vertex and texture format a game uses, once
+    bool format_log = false;
+    // the home screen's look: a theme (its colours, theme_names()), its wave moving, and the
+    // wallpaper: the theme's wave, or a picture's file name in wallpaper_dir()
+    int theme = 0;
+    bool moving_wallpaper = false;
+    std::string wallpaper;
+};
+Prefs &prefs();
+void load_prefs();
+void save_prefs();
+// RCAS stops for an fsr_sharpness index
+float fsr_sharpening(int index);
+// The themes, in Prefs::theme's order (the launcher has their colours)
+const std::vector<std::string> &theme_names();
+// Where wallpaper pictures go (/data/HENkaku/wallpapers), and the ones there (.png, .jpg)
+std::string wallpaper_dir();
+std::vector<std::string> wallpaper_files();
+
+// Who made HENkaku
+constexpr const char *AUTHOR = "iHaiDeeZ / ShiroKlein";
+constexpr const char *AUTHOR_GITHUB = "github.com/iHaiDeeZ";
+
+// All games' settings (config.yml, and ps4.cfg), as the launcher's HENkaku pages
+std::vector<Item> global_pages(EmuEnvState &emuenv);
+// One game's own settings (config/config_<app>.xml over the global ones), as its pages
+std::vector<Item> game_pages(EmuEnvState &emuenv, const std::string &app_path);
+// In a game: what applies at once, then the game's own settings for its next start
+std::vector<Item> quick_menu(EmuEnvState &emuenv);
+
+// The HENkaku icon (in the package)
+std::string icon_path();
+
+} // namespace ps4settings
