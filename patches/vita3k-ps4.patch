+} // namespace
+
+void show_message(const std::string &title, const std::string &detail) {
+    Canvas c(W, H);
+    background(c);
+    const int x = c.text(MARGIN, 128, "Vita3K", 76, TEXT, Weight::Bold);
+    c.text(MARGIN + x + 18, 128, "for PS4", 38, ACCENT);
+    c.text_centered(W / 2, H / 2 - 10, title, 56, TEXT, Weight::Bold);
+    c.text_centered(W / 2, H / 2 + 60, detail, 32, MUTED);
+    present(c);
+}
+
+Choice run(EmuEnvState &emuenv, const std::string &notice_text) {
+    Canvas canvas(W, H);
+    std::vector<Item> items = load_items(emuenv);
+    app::FirmwareState fw = app::get_firmware_state(emuenv);
+    int selected = 0;
+    int top = 0;
+    // the last game started is selected again
+    static std::string last_app_path;
+    for (size_t i = 0; i < items.size(); i++) {
+        if (!last_app_path.empty() && items[i].entry.path == last_app_path)
+            selected = static_cast<int>(i);
+    }
+    std::string notice = notice_text;
+    auto notice_until = Clock::now() + std::chrono::seconds(notice.empty() ? 0 : 12);
+    if (!fw.main_firmware && notice.empty()) {
+        notice = "The PS Vita firmware isn't installed: most games need it. Copy PSVUPDAT.PUP and PSP2UPDAT.PUP to /data/Vita3K/install and press Triangle.";
+        notice_until = Clock::now() + std::chrono::hours(1);
+    }
+    InstallJob job;
+
+    // buttons held from the game don't count as presses here
+    uint32_t previous = ps4pad::read().buttons;
+    Clock::time_point repeat_at{};
+    int repeat_dir = 0;
+    bool dirty = true;
+    auto last_progress = Clock::now();
+
+    while (true) {
+        const ps4pad::Snapshot pad = ps4pad::read();
+        uint32_t buttons = pad.buttons;
+        // the left stick as the D-pad
+        if (pad.connected && pad.ly < 48)
+            buttons |= ORBIS_PAD_BUTTON_UP;
+        if (pad.connected && pad.ly > 208)
+            buttons |= ORBIS_PAD_BUTTON_DOWN;
+        const uint32_t pressed = buttons & ~previous;
+        previous = buttons;
+        const auto now = Clock::now();
+
+        if (job.running) {
+            if (job.finished) {
+                job.thread.join();
+                job.running = false;
+                items = load_items(emuenv);
+                fw = app::get_firmware_state(emuenv);
+                selected = std::min(selected, std::max(0, static_cast<int>(items.size()) - 1));
+                notice = summary(job);
+                notice_until = now + std::chrono::seconds(20);
+                dirty = true;
+            } else if (now - last_progress > std::chrono::milliseconds(100)) {
+                last_progress = now;
+                dirty = true;
+            }
+        } else {
+            int dir = (buttons & ORBIS_PAD_BUTTON_UP) ? -1 : (buttons & ORBIS_PAD_BUTTON_DOWN) ? 1 : 0;
+            bool step = false;
+            if (dir != 0 && dir != repeat_dir) {
+                step = true;
+                repeat_at = now + std::chrono::milliseconds(380);
+            } else if (dir != 0 && now >= repeat_at) {
+                step = true;
+                repeat_at = now + std::chrono::milliseconds(70);
+            }
+            repeat_dir = dir;
+            if (step && !items.empty()) {
+                selected = std::clamp(selected + dir, 0, static_cast<int>(items.size()) - 1);
+                dirty = true;
+            }
+            if ((pressed & ORBIS_PAD_BUTTON_CROSS) && !items.empty()) {
+                const Item &item = items[selected];
+                last_app_path = item.entry.path;
+                show_message("Starting", item.entry.title);
+                return Choice{ false, item.entry.path, item.entry.title };
+            }
+            if (pressed & ORBIS_PAD_BUTTON_TRIANGLE) {
+                job.finished = false;
+                job.running = true;
+                job.index = job.total = job.installed = 0;
+                job.failures.clear();
+                job.thread = std::thread([&emuenv, &job] { install_worker(emuenv, job); });
+                notice.clear();
+                dirty = true;
+            }
+            if (pressed & ORBIS_PAD_BUTTON_OPTIONS)
+                return Choice{ true, {}, {} };
+        }
+        if (!notice.empty() && now >= notice_until) {
+            notice.clear();
+            dirty = true;
+        }
+
+        if (dirty) {
+            // keep the selection in view
+            if (selected < top)
+                top = selected;
+            if (selected >= top + VISIBLE_ROWS)
+                top = selected - VISIBLE_ROWS + 1;
+            background(canvas);
+            header(canvas, fw);
+            draw_list(canvas, items, selected, top);
+            draw_notice(canvas, notice);
+            footer(canvas, !items.empty());
+            if (job.running)
+                draw_install(canvas, job);
+            present(canvas);
+            dirty = false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    }
+}
+
+} // namespace ps4launcher
