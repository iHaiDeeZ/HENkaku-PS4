+// The home screen's theme, its wave moving, and its wallpaper (a picture copied to
+// /data/HENkaku/wallpapers, or the theme's wave)
+std::vector<Item> look_items() {
+    std::vector<Item> items;
+    items.push_back(section("Home screen"));
+    items.push_back(pref_choice("Theme", theme_names(),
+        [](const Prefs &p) { return p.theme; },
+        [](Prefs &p, int value) { p.theme = value; }));
+    items.push_back(pref_choice("Moving wallpaper", { "Off", "On" },
+        [](const Prefs &p) { return p.moving_wallpaper ? 1 : 0; },
+        [](Prefs &p, int value) { p.moving_wallpaper = value == 1; }));
+    std::vector<std::string> files = wallpaper_files();
+    std::vector<std::string> labels{ "Wave" };
+    labels.insert(labels.end(), files.begin(), files.end());
+    items.push_back(pref_choice("Wallpaper", labels,
+        [files](const Prefs &p) {
+            const auto it = std::find(files.begin(), files.end(), p.wallpaper);
+            return it == files.end() ? 0 : static_cast<int>(it - files.begin()) + 1;
+        },
+        [files](Prefs &p, int value) { p.wallpaper = value == 0 ? std::string() : files[value - 1]; }));
+    items.push_back(section("Pictures: " + wallpaper_dir()));
+    return items;
+}
