+// What the panel says about the selected entry
+std::vector<std::string> entry_details(Entry &e) {
+    std::vector<std::string> lines;
+    switch (e.kind) {
+    case Kind::Location:
+        lines = { e.path.string(), "Cross opens it" };
+        break;
+    case Kind::Folder:
+        lines = { "Cross opens it" };
+        break;
+    case Kind::GameFolder:
+        lines = { "A dumped game: its files are copied into HENkaku", "Cross installs it" };
+        break;
+    case Kind::Archive:
+        lines = { "PS Vita app archive, " + size_text(e.size), "Cross installs it" };
+        break;
+    case Kind::Package:
+        lines = { "PS Vita package, " + size_text(e.size),
+            has_zrif(e) ? std::string("Its zRIF is in the .zrif file next to it")
+                        : std::string("Its zRIF goes in a text file of the same name ending in .zrif (unless its .rif license is installed)"),
+            "Cross installs it" };
+        break;
+    case Kind::Update:
+        lines = { "PS Vita update file (the firmware or the font package), " + size_text(e.size), "Cross installs it" };
+        break;
+    case Kind::License:
+        lines = { "PS Vita license, for the packages that need one", "Cross installs it" };
+        break;
+    }
+    if (installable(e.kind) && e.path.parent_path() == fs::path(install_dir()))
+        lines.push_back("Once it's installed it moves to install/done");
+    return lines;
