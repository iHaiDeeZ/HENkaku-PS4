+// The palette the colours are picked from (HENkaku > Themes > Colours)
+struct NamedColor {
+    const char *name;
+    uint32_t rgb;
+};
+const NamedColor PALETTE[] = {
+    { "White", 0xffffff }, { "Silver", 0xc8ccd6 }, { "Grey", 0x767c88 }, { "Charcoal", 0x2c2f36 }, { "Black", 0x050608 },
+    { "Navy", 0x0b1d4f }, { "Blue", 0x1e5bd8 }, { "PS Vita blue", 0x2662e2 }, { "Sky", 0x5fc4ff }, { "Ice", 0x9fe0ff },
+    { "Cyan", 0x22d3e6 }, { "Teal", 0x149c8c }, { "Green", 0x2a8250 }, { "Lime", 0x8ad63c }, { "Olive", 0x6b7a2a },
+    { "Yellow", 0xf2d43c }, { "Gold", 0xd4a017 }, { "Orange", 0xf07a3c }, { "Red", 0xd8322e }, { "Crimson", 0x8c1430 },
+    { "Pink", 0xe48cb4 }, { "Magenta", 0xd33ca8 }, { "Purple", 0x7a3cc8 }, { "Plum", 0x46145a }, { "Brown", 0x6b4426 },
+};
+
+int nearest_color(uint32_t rgb) {
+    int best = 0;
+    long best_distance = -1;
+    for (int i = 0; i < static_cast<int>(std::size(PALETTE)); i++) {
+        const long dr = static_cast<long>((rgb >> 16) & 0xFF) - static_cast<long>((PALETTE[i].rgb >> 16) & 0xFF);
+        const long dg = static_cast<long>((rgb >> 8) & 0xFF) - static_cast<long>((PALETTE[i].rgb >> 8) & 0xFF);
+        const long db = static_cast<long>(rgb & 0xFF) - static_cast<long>(PALETTE[i].rgb & 0xFF);
+        const long distance = dr * dr + dg * dg + db * db;
+        if (best_distance < 0 || distance < best_distance) {
+            best_distance = distance;
+            best = i;
+        }
+    }
+    return best;
+}
+
+// One of a theme's colours (0 top, 1 bottom, 2 light, 3 accent): as the theme in use has it, and
+// changed it makes the theme "Custom colours", starting from the theme's
+Item colour_choice(std::string name, int part) {
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = std::move(name);
+    for (const NamedColor &c : PALETTE) {
+        item.values.push_back(c.name);
+        item.swatches.push_back(c.rgb);
+    }
+    const auto component = [](const ThemeColors &c, int part) {
+        return part == 0 ? c.top : part == 1 ? c.bottom : part == 2 ? c.light : c.accent;
+    };
+    item.get = [part, component] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return nearest_color(component(theme_colors(g_prefs), part));
+    };
+    item.set = [part](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        if (g_prefs.theme != custom_theme() || !g_prefs.vita_theme.empty()) {
+            const ThemeColors now = theme_colors(g_prefs);
+            g_prefs.custom_top = now.top;
+            g_prefs.custom_bottom = now.bottom;
+            g_prefs.custom_light = now.light;
+            g_prefs.custom_accent = now.accent;
+            g_prefs.theme = custom_theme();
+            g_prefs.vita_theme.clear();
+        }
+        uint32_t &field = part == 0 ? g_prefs.custom_top : part == 1 ? g_prefs.custom_bottom : part == 2 ? g_prefs.custom_light : g_prefs.custom_accent;
+        field = PALETTE[std::clamp(index, 0, static_cast<int>(std::size(PALETTE)) - 1)].rgb;
+        save_prefs();
+    };
+    return item;
+}
