--- /dev/null
+++ b/vita3k/ps4/ps4_main.cpp
@@ -0,0 +1,388 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: Vita3K's frontend, in place of main.cpp (Qt) and sdl-frontend.
+//
+//   /app0              the package: eboot.bin, version.txt, data/, shaders-builtin/, icons/
+//   /data/Vita3K       config.yml, vita3k.log (and the run before's vita3k.prev.log), boot-trace.log,
+//                      crash.log, cache/, patch/
+//   /data/Vita3K/fs    the Vita's file system (ux0, vs0, os0, sa0, pd0, ...)
+//   /data/Vita3K/install  what the launcher installs (firmware, games, licenses)
+//
+// The launcher (ps4_launcher.cpp) shows the installed apps; the picked one runs in a session drawn
+// by Vita3K's Vulkan renderer on RADV, presented through VideoOut (ps4_wsi.cpp). When the game
+// ends the app starts over (sceSystemServiceLoadExec of itself): a session leaves guest threads,
+// the guest memory and the GPU device behind, and a fresh process is the clean way back to the
+// launcher. A game starting another of its executables goes through the same restart.
+
+#include "ps4_canvas.h"
+#include "ps4_launcher.h"
+#include "ps4_pad.h"
+#include "ps4_wsi.h"
+
+#include <app/functions.h>
+#include <app/session_controller.h>
+#include <config/functions.h>
+#include <config/state.h>
+#include <emuenv/app_launch_request.h>
+#include <emuenv/state.h>
+#include <modules/module_parent.h>
+#include <packages/sfo.h>
+#include <renderer/frame_host.h>
+#include <util/fs.h>
+#include <util/log.h>
+
+#include <SDL3/SDL_events.h>
+#include <SDL3/SDL_init.h>
+
+#include <orbis/SystemService.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <thread>
+
+extern "C" void ps4_boot_trace(const char *line); // port/ps4_crashlog.cpp
+
+namespace {
+
+EmuEnvState *crash_emuenv = nullptr;
+// The package's version (/app0/version.txt), in the logs: an app installed over an older one is
+// easy to forget (v00.06 was "tested" as v00.05)
+char app_version[32] = "dev";
+
+void read_app_version() {
+    FILE *f = std::fopen("/app0/version.txt", "r");
+    if (!f)
+        return;
+    char line[24] = {};
+    if (std::fgets(line, sizeof(line), f)) {
+        line[std::strcspn(line, "\r\n ")] = 0;
+        if (line[0])
+            std::snprintf(app_version, sizeof(app_version), "v%s", line);
+    }
+    std::fclose(f);
+}
+
+} // namespace
+
+// The crash log's guest part (port/ps4_crashlog.cpp calls it after the host's): which app ran
+extern "C" void ps4_crash_guest_info() {
+    if (!crash_emuenv)
+        return;
+    FILE *f = std::fopen("/data/Vita3K/crash.log", "a");
+    if (!f)
+        return;
+    std::fprintf(f, "\n== Vita3K for PS4 %s: %s (%s), the details are in vita3k.log (vita3k.prev.log once Vita3K started again)\n", app_version,
+        crash_emuenv->current_app_title.c_str(), crash_emuenv->app_info.app_title_id.c_str());
+    std::fclose(f);
+}
+
+namespace {
+
+const char *const NOTICE_FILE = "/data/Vita3K/notice.txt";
+const char *const RELAUNCH_FILE = "/data/Vita3K/relaunch.txt";
+
+void trace(const std::string &line) {
+    ps4_boot_trace(line.c_str());
+}
+
+// Lets the renderer draw on VideoOut: a headless surface, which ps4_wsi.cpp turns into VideoOut buffers
+class PS4FrameHost final : public renderer::FrameHost, public renderer::VulkanSurfaceProvider {
+public:
+    renderer::DisplayHandle handle() const override {
+        return {};
+    }
+    const renderer::VulkanSurfaceProvider *vulkan_surface_provider() const override {
+        return this;
+    }
+    std::vector<const char *> instance_extensions() const override {
+        return { VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME };
+    }
+    VkSurfaceKHR create_surface(VkInstance instance) const override {
+        const auto create = reinterpret_cast<PFN_vkCreateHeadlessSurfaceEXT>(ps4_vk_get_instance_proc_addr()(instance, "vkCreateHeadlessSurfaceEXT"));
+        VkHeadlessSurfaceCreateInfoEXT info{ VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT };
+        VkSurfaceKHR surface = VK_NULL_HANDLE;
+        if (!create || create(instance, &info, nullptr, &surface) != VK_SUCCESS)
+            return VK_NULL_HANDLE;
+        return surface;
+    }
+    void destroy_surface(VkInstance instance, VkSurfaceKHR surface) const override {
+        const auto destroy = reinterpret_cast<PFN_vkDestroySurfaceKHR>(ps4_vk_get_instance_proc_addr()(instance, "vkDestroySurfaceKHR"));
+        if (destroy)
+            destroy(instance, surface, nullptr);
+    }
+    int drawable_width() const override {
+        return ps4wsi::WIDTH;
+    }
+    int drawable_height() const override {
+        return ps4wsi::HEIGHT;
+    }
+    std::vector<std::string> font_dirs() const override {
+        return { "/preinst/common/font/", "/app0/fonts/" };
+    }
+};
+
+void save_text(const char *path, const std::string &text) {
+    std::ofstream out(path, std::ios::trunc);
+    out << text;
+}
+
+std::string take_text(const char *path) {
+    std::ifstream in(path);
+    if (!in)
+        return {};
+    std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    in.close();
+    std::remove(path);
+    return text;
+}
+
+// A launch request carried over the restart: app path, self path, then one argument per line
+void save_relaunch(const AppLaunchRequest &request) {
+    std::string text = request.app_path + "\n" + request.self_path + "\n";
+    for (const auto &arg : request.argv)
+        text += arg + "\n";
+    save_text(RELAUNCH_FILE, text);
+}
+
+std::optional<AppLaunchRequest> take_relaunch() {
+    const std::string text = take_text(RELAUNCH_FILE);
+    if (text.empty())
+        return std::nullopt;
+    AppLaunchRequest request;
+    request.reason = AppLaunchReason::LoadExec;
+    size_t start = 0;
+    int field = 0;
+    while (start < text.size()) {
+        size_t end = text.find('\n', start);
+        if (end == std::string::npos)
+            end = text.size();
+        const std::string line = text.substr(start, end - start);
+        if (field == 0)
+            request.app_path = line;
+        else if (field == 1)
+            request.self_path = line;
+        else
+            request.argv.push_back(line);
+        field++;
+        start = end + 1;
+    }
+    if (request.app_path.empty())
+        return std::nullopt;
+    return request;
+}
+
+[[noreturn]] void restart(const std::string &notice) {
+    if (!notice.empty())
+        save_text(NOTICE_FILE, notice);
+    trace("restarting");
+    sceSystemServiceLoadExec("/app0/eboot.bin", nullptr);
+    std::_Exit(0);
+}
+
+// Runs one app until it ends. Returns what the launcher should say about it, and the launch request
+// if the app asked for another executable.
+std::string run_session(EmuEnvState &emuenv, const AppLaunchRequest &request, std::optional<AppLaunchRequest> &next) {
+    app::AppSessionController session(emuenv);
+    PS4FrameHost frame_host;
+
+    trace("session: launching " + request.app_path);
+    if (!session.begin_launch(request, request.reason != AppLaunchReason::LoadExec))
+        return "Couldn't find " + request.app_path + " among the installed apps";
+    trace("session: renderer");
+    // (what these say is shown after the app started over: this run's log is vita3k.prev.log then)
+    if (!session.initialize_renderer(frame_host)) {
+        session.stop(app::AppSessionStopReason::LaunchFailure);
+        trace("session: the renderer failed");
+        return "The renderer couldn't start (Vulkan): see /data/Vita3K/vita3k.prev.log";
+    }
+    trace("session: runtime");
+    if (!session.initialize_runtime()) {
+        session.stop(app::AppSessionStopReason::LaunchFailure);
+        trace("session: the runtime failed");
+        return "The emulator couldn't start: see /data/Vita3K/vita3k.prev.log";
+    }
+    trace("session: loading the app");
+    if (!session.load_and_run()) {
+        session.stop(app::AppSessionStopReason::LaunchFailure);
+        trace("session: loading the app failed");
+        return "The game couldn't be loaded: see /data/Vita3K/vita3k.prev.log";
+    }
+    trace("session: running " + emuenv.current_app_title);
+    LOG_INFO("Game started: {} ({})", emuenv.current_app_title, request.app_path);
+
+    std::optional<AppLaunchRequest> pending = emuenv.take_app_launch_request();
+    app::LaunchRuntimeMetrics metrics{};
+    bool running = !pending.has_value();
+    auto next_flush = std::chrono::steady_clock::now();
+    while (running) {
+        const ps4pad::Snapshot pad = ps4pad::read();
+        if (ps4pad::feed(emuenv, pad)) {
+            // L3 + R3: Vita3K's pause menu (Resume / Exit), or back from it
+            if (session.is_paused())
+                session.set_pause_reason(app::AppSessionPauseReason::All, false);
+            else
+                session.set_pause_reason(app::AppSessionPauseReason::User, true);
+        }
+        if (!pending) {
+            if (auto r = emuenv.take_app_launch_request()) {
+                pending = std::move(r);
+                running = false;
+            }
+        }
+        app::update_runtime_metrics(emuenv, metrics);
+        // stop asked for by the pause menu, or the app crashed
+        if (session.stop_requested() || !session.is_running()) {
+            running = false;
+            session.reset_stop_request();
+        }
+        // nothing reads SDL's event queue: don't let it fill up
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= next_flush) {
+            SDL_PumpEvents();
+            SDL_FlushEvents(SDL_EVENT_FIRST, SDL_EVENT_LAST);
+            next_flush = now + std::chrono::seconds(1);
+        }
+        if (running)
+            std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    }
+
+    trace("session: stopping");
+    ps4pad::release(emuenv);
+    std::string notice;
+    if (pending && pending->reason == AppLaunchReason::ProcessExit) {
+        LOG_INFO("The app exited with code {}", pending->exit_code);
+        notice = emuenv.current_app_title + " closed";
+        session.stop(app::AppSessionStopReason::UserRequest);
+    } else if (pending) {
+        LOG_INFO("The app starts '{}'", pending->self_path);
+        next = std::move(pending);
+        session.stop(app::AppSessionStopReason::Relaunch);
+    } else {
+        notice = emuenv.current_app_title + " closed";
+        session.stop(app::AppSessionStopReason::UserRequest);
+    }
+    trace("session: stopped");
+    return notice;
+}
+
+// main, inside its catch-all
+int run_app() {
+    read_app_version();
+    trace(std::string("main: Vita3K for PS4 ") + app_version);
+    Root root_paths;
+    app::init_paths(root_paths);
+    // the launcher's text: the PS Vita's fonts once the font package is installed
+    ps4ui::set_vita_font_dir(fs_utils::path_to_utf8(root_paths.get_vita_fs_path() / "sa0" / "data" / "font" / "pvf") + "/");
+    boost::system::error_code ec;
+    fs::create_directories(root_paths.get_vita_fs_path(), ec);
+    fs::create_directories(ps4launcher::INSTALL_DIR, ec);
+    // The last run's log stays as vita3k.prev.log: after every game the app starts over, and the
+    // game's log went with it (v00.07: why PCSE00003 didn't load)
+    fs::rename(root_paths.get_log_path() / "vita3k.log", root_paths.get_log_path() / "vita3k.prev.log", ec);
+    if (logging::init(root_paths, false) != Success)
+        trace("logging could not start");
+    LOG_INFO("Vita3K for PS4 {}", app_version);
+    // Which draw a GPU hang is on: RADV's per-draw trace ids and the PS4 winsys' flight recorder
+    // (port/mesa/ac_ps4_drm.c, into /data/DolphinPS4/flight), when /data/Vita3K/radv-trace is there.
+    // It slows the rendering down.
+    if (fs::exists(root_paths.get_log_path() / "radv-trace", ec)) {
+        setenv("RADV_PS4_TRACE", "1", 1);
+        setenv("RADV_DEBUG", "hang", 1);
+        trace("radv: flight recorder on");
+    }
+
+    // CLI11 needs a program name (a PS4 app gets none)
+    char program[] = "vita3k";
+    char *args[] = { program, nullptr };
+    Config cfg{};
+    // Set before the command line options are made: they list <vita fs>/ux0/app, which is
+    // "ux0/app" with no path yet, and the PS4 refuses relative paths (Boost threw on it)
+    cfg.set_vita_fs_path(root_paths.get_vita_fs_path());
+    EmuEnvState emuenv;
+    crash_emuenv = &emuenv;
+    if (config::init_config(cfg, 1, args, root_paths, false) != Success) {
+        trace("config failed");
+        LOG_ERROR("Failed to initialise config");
+    }
+    // the PS4 has Vulkan (RADV) only
+    cfg.backend_renderer = "Vulkan";
+
+    ps4launcher::show_message("Vita3K", "Starting");
+    ps4pad::init();
+
+    // SDL's services Vita3K uses (no window: VideoOut; no sound: sceAudioOut)
+    if (!SDL_Init(SDL_INIT_GAMEPAD | SDL_INIT_SENSOR | SDL_INIT_HAPTIC))
+        LOG_WARN("SDL_Init: {}", SDL_GetError());
+
+    trace("app init");
+    if (!app::init(emuenv, cfg, root_paths)) {
+        trace("app init failed");
+        LOG_ERROR("Emulated environment initialization failed.");
+        ps4launcher::show_message("Vita3K couldn't start", "See /data/Vita3K/vita3k.log");
+        std::this_thread::sleep_for(std::chrono::seconds(10));
+        sceSystemServiceLoadExec("exit", nullptr);
+        return 1;
+    }
+    init_libraries(emuenv);
+    app::init_apps_list(emuenv);
+    app::load_users(emuenv);
+    app::ensure_current_user(emuenv);
+    trace("ready");
+
+    std::optional<AppLaunchRequest> next = take_relaunch();
+    std::string notice = take_text(NOTICE_FILE);
+    if (!next) {
+        const ps4launcher::Choice choice = ps4launcher::run(emuenv, notice);
+        if (choice.quit) {
+            trace("quit");
+            sceSystemServiceLoadExec("exit", nullptr);
+            return 0;
+        }
+        next = AppLaunchRequest{ .app_path = choice.app_path };
+    }
+
+    std::optional<AppLaunchRequest> following;
+    notice = run_session(emuenv, *next, following);
+    if (following)
+        save_relaunch(*following);
+    restart(notice);
+}
+
+} // namespace
+
+int main(int argc, char *argv[]) {
+    (void)argc;
+    (void)argv;
+    try {
+        return run_app();
+    } catch (const std::exception &e) {
+        // what nothing else caught goes on the screen (and in the logs) rather than the app vanishing
+        trace(std::string("uncaught exception: ") + e.what());
+        LOG_ERROR("Uncaught exception: {}", e.what());
+        ps4launcher::show_message("Vita3K stopped", e.what());
+        std::this_thread::sleep_for(std::chrono::seconds(15));
+        sceSystemServiceLoadExec("exit", nullptr);
+        return 1;
+    }
+}
