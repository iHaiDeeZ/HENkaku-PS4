+std::vector<Item> global_pages(EmuEnvState &emuenv) {
+    const auto scope = std::make_shared<GlobalScope>(emuenv);
+    const std::string next_start = "next start";
+    std::vector<Item> pages;
+    pages.push_back(section("All games"));
+    pages.push_back(page("Display", display_items(emuenv, scope, true)));
+    pages.push_back(page("Graphics", graphics_items(emuenv, scope, true, next_start)));
+    pages.push_back(page("Audio", audio_items(scope, next_start)));
+    pages.push_back(page("CPU", cpu_items(scope, true, next_start)));
+    {
+        std::vector<Item> controls = ps4controls::items({});
+        controls.push_back(section("Camera"));
+        controls.push_back(camera_choice(emuenv));
+        pages.push_back(page("Controls", std::move(controls)));
+    }
+
+    std::vector<Item> system;
+    system.push_back(section("Home screen"));
+    system.push_back(pref_choice("Style", { "Bubbles", "List" },
+        [](const Prefs &p) { return p.bubbles ? 0 : 1; },
+        [](Prefs &p, int value) { p.bubbles = value == 0; }));
+    system.push_back(section("Buttons"));
+    system.push_back(global_choice<int>(emuenv, "Enter button", { "Cross", "Circle" },
+        { static_cast<int>(SCE_SYSTEM_PARAM_ENTER_BUTTON_CROSS), static_cast<int>(SCE_SYSTEM_PARAM_ENTER_BUTTON_CIRCLE) },
+        &Config::sys_button, next_start));
+    pages.push_back(section("PS4"));
+    pages.push_back(page("Look", look_items()));
+    pages.push_back(page("System", std::move(system)));
+    pages.push_back(page("Diagnostics", diagnostics_items()));
+    pages.push_back(page("About", about_items()));
+    return pages;
+}
