index 00000000..38518fbc
--- /dev/null
+++ b/vita3k/ps4/ps4.cmake
@@ -0,0 +1,31 @@
+# PS4: Vita3K's frontend for the console, included from vita3k/CMakeLists.txt once the vita3k target
+# exists. Built with the port's toolchain (toolchain/ps4-vita3k.cmake, and ps4-love-style.cmake as
+# the project include: PS4_RUNTIME_SOURCES, ps4_link_mesa, ps4_add_eboot).
+
+target_sources(vita3k PRIVATE
+	ps4/ps4_main.cpp
+	ps4/ps4_canvas.cpp
+	ps4/ps4_canvas.h
+	ps4/ps4_launcher.cpp
+	ps4/ps4_launcher.h
+	ps4/ps4_pad.cpp
+	ps4/ps4_pad.h
+	ps4/ps4_wsi.cpp
+	ps4/ps4_wsi.h
+	ps4/ps4_stubs.c
+	${PS4_RUNTIME_SOURCES})
+
+# archive.h and the other headers next to main.cpp
+target_include_directories(vita3k PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
+target_link_libraries(vita3k PRIVATE emuenv mem overlay stb vulkan SDL3::SDL3)
+
+# The network library's shares (port/ps4_netfs.cpp: SMB and NFS under /net)
+target_link_libraries(vita3k PRIVATE ${PS4_SYSROOT}/lib/libnfs.a ${PS4_SYSROOT}/lib/libsmb2.a)
+# every undefined symbol at once
+target_link_options(vita3k PRIVATE --error-limit=0)
+
+# RADV on GNM, the system libraries, and eboot.bin
+ps4_link_mesa(vita3k)
+target_link_libraries(vita3k PRIVATE
+	SceSysmodule SceSystemService SceUserService SceVideoOut SceAudioOut ScePad SceNet SceCommonDialog SceImeDialog)
+ps4_add_eboot(vita3k)
