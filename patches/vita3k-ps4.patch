+                    .bufferOffset = static_cast<vk::DeviceSize>(count) * 4,
+                    .imageSubresource = { vk::ImageAspectFlagBits::eStencil, 0, 0, 1 },
+                    .imageOffset = { static_cast<int32_t>(source_x), static_cast<int32_t>(source_y + y), 0 },
