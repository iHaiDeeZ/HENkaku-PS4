+std::vector<Item> graphics_items(EmuEnvState &emuenv, const std::shared_ptr<Scope> &scope, bool global, const std::string &next_start) {
+    std::vector<Item> items;
+    items.push_back(section("Rendering"));
+    items.push_back(choice<float>(scope, "Resolution", { "1x", "1.5x", "2x" }, { 1.0f, 1.5f, 2.0f }, &Config::CurrentConfig::resolution_multiplier, next_start));
+    items.push_back(choice<bool>(scope, "GPU accuracy", { "Standard", "High" }, { false, true }, &Config::CurrentConfig::high_accuracy, next_start));
+    // Vita3K's "disable surface sync", the other way round
+    items.push_back(choice<bool>(scope, "Frame read-back", { "Off", "On" }, { true, false }, &Config::CurrentConfig::disable_surface_sync));
+    items.push_back(section("Shaders and textures"));
+    items.push_back(choice<bool>(scope, "Shader compiling", { "Background", "Before drawing" }, { true, false }, &Config::CurrentConfig::async_pipeline_compilation));
+    if (global)
+        items.push_back(global_choice<bool>(emuenv, "Texture checks", { "Hash", "Watch writes" }, { false, true }, &Config::hashless_texture_cache, next_start));
+    items.push_back(section("Frame rate"));
+    // a game that waits for two vblanks a frame (30 fps) waits for one
+    items.push_back(choice<bool>(scope, "FPS hack", { "Off", "On" }, { false, true }, &Config::CurrentConfig::fps_hack));
+    return items;
+}
