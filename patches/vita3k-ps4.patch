index 00000000..fcc5014c
--- /dev/null
+++ b/vita3k/ps4/ps4_pad.cpp
@@ -0,0 +1,264 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the DualShock 4 through ScePad.
+//
+// While a game runs the pad goes into Vita3K's virtual keyboard state (ctrl/state.h), which both
+// the game's sceCtrl reads and Vita3K's own menus (overlay) merge in:
+//   Cross/Circle/Square/Triangle, D-pad, sticks = the Vita's, L1/R1 = L/R, OPTIONS = START,
+//   touchpad click = SELECT, touchpad = the front touch screen, L2/R2/L3/R3 = the PS TV's,
+//   L3 + R3 together = Vita3K's pause menu (Resume / Exit).
+
+#include "ps4_pad.h"
+
+#include <config/state.h>
+#include <ctrl/ctrl.h>
+#include <ctrl/state.h>
+#include <emuenv/state.h>
+#include <motion/event_handler.h>
+#include <touch/functions.h>
+#include <touch/touch.h>
+#include <util/log.h>
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <SDL3/SDL_events.h>
+#include <SDL3/SDL_sensor.h>
+
+#include <algorithm>
+#include <chrono>
+#include <mutex>
+
+namespace ps4pad {
+
+namespace {
+
+constexpr uint32_t MENU_COMBO = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+constexpr float STANDARD_GRAVITY = 9.80665f;
+
+struct ButtonMap {
+    uint32_t pad;
+    uint32_t vita;
+    uint32_t vita_ext;
+};
+
+const ButtonMap BUTTONS[] = {
+    { ORBIS_PAD_BUTTON_CROSS, SCE_CTRL_CROSS, SCE_CTRL_CROSS },
+    { ORBIS_PAD_BUTTON_CIRCLE, SCE_CTRL_CIRCLE, SCE_CTRL_CIRCLE },
+    { ORBIS_PAD_BUTTON_SQUARE, SCE_CTRL_SQUARE, SCE_CTRL_SQUARE },
+    { ORBIS_PAD_BUTTON_TRIANGLE, SCE_CTRL_TRIANGLE, SCE_CTRL_TRIANGLE },
+    { ORBIS_PAD_BUTTON_UP, SCE_CTRL_UP, SCE_CTRL_UP },
+    { ORBIS_PAD_BUTTON_DOWN, SCE_CTRL_DOWN, SCE_CTRL_DOWN },
+    { ORBIS_PAD_BUTTON_LEFT, SCE_CTRL_LEFT, SCE_CTRL_LEFT },
+    { ORBIS_PAD_BUTTON_RIGHT, SCE_CTRL_RIGHT, SCE_CTRL_RIGHT },
+    { ORBIS_PAD_BUTTON_L1, SCE_CTRL_L, SCE_CTRL_L1 },
+    { ORBIS_PAD_BUTTON_R1, SCE_CTRL_R, SCE_CTRL_R1 },
+    { ORBIS_PAD_BUTTON_OPTIONS, SCE_CTRL_START, SCE_CTRL_START },
+    { ORBIS_PAD_BUTTON_TOUCH_PAD, SCE_CTRL_SELECT, SCE_CTRL_SELECT },
+    { ORBIS_PAD_BUTTON_L2, 0, SCE_CTRL_L2 },
+    { ORBIS_PAD_BUTTON_R2, 0, SCE_CTRL_R2 },
+    { ORBIS_PAD_BUTTON_L3, 0, SCE_CTRL_L3 },
+    { ORBIS_PAD_BUTTON_R3, 0, SCE_CTRL_R3 },
+};
+
+std::mutex lock;
+int user = -1;
+int handle = -1;
+std::chrono::steady_clock::time_point next_open{};
+
+// While a game runs
+bool combo_held = false;
+bool menu_suppress = false; // L3/R3 stay out of the game until both are released
+Touch fingers[2];
+uint8_t finger_count = 0;
+
+float stick(uint8_t v) {
+    return std::clamp((static_cast<int>(v) - 128) / 127.f, -1.f, 1.f);
+}
+
+// Opens the pad of the first signed-in user (and again after it went away)
+void open_pad() {
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next_open)
+        return;
+    next_open = now + std::chrono::seconds(1);
+    int initial = -1;
+    if (sceUserServiceGetInitialUser(&initial) != 0 || initial < 0) {
+        OrbisUserServiceLoginUserIdList list{};
+        if (sceUserServiceGetLoginUserIdList(&list) != 0)
+            return;
+        for (int i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+            if (list.userId[i] != -1 && list.userId[i] != 0) {
+                initial = list.userId[i];
+                break;
+            }
+        }
+    }
+    if (initial < 0)
+        return;
+    const int h = scePadOpen(initial, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+    if (h < 0) {
+        LOG_WARN_ONCE("PS4 pad: scePadOpen for user {:08X} failed: {:08X}", static_cast<uint32_t>(initial), static_cast<uint32_t>(h));
+        return;
+    }
+    user = initial;
+    handle = h;
+    LOG_INFO("PS4 pad: user {:08X} on handle {}", static_cast<uint32_t>(user), handle);
+}
+
+void send_touch(EmuEnvState &emuenv, Uint32 type, const Touch &t) {
+    SDL_GamepadTouchpadEvent ev{};
+    ev.type = static_cast<SDL_EventType>(type);
+    ev.touchpad = 0;
+    ev.finger = t.id;
+    ev.x = std::clamp(t.x / TOUCHPAD_WIDTH, 0.f, 1.f);
+    ev.y = std::clamp(t.y / TOUCHPAD_HEIGHT, 0.f, 1.f);
+    ev.pressure = type == SDL_EVENT_GAMEPAD_TOUCHPAD_UP ? 0.f : 1.f;
+    handle_touchpad_event(emuenv.touch, ev);
+}
+
+void update_touch(EmuEnvState &emuenv, const Snapshot &pad) {
+    // lifted fingers
+    for (uint8_t i = 0; i < finger_count; i++) {
+        bool still = false;
+        for (uint8_t j = 0; j < pad.touch_count; j++)
+            still |= pad.touch[j].id == fingers[i].id;
+        if (!still)
+            send_touch(emuenv, SDL_EVENT_GAMEPAD_TOUCHPAD_UP, fingers[i]);
+    }
+    // new and moved fingers
+    for (uint8_t j = 0; j < pad.touch_count; j++) {
+        bool known = false;
+        for (uint8_t i = 0; i < finger_count; i++)
+            known |= pad.touch[j].id == fingers[i].id;
+        send_touch(emuenv, known ? SDL_EVENT_GAMEPAD_TOUCHPAD_MOTION : SDL_EVENT_GAMEPAD_TOUCHPAD_DOWN, pad.touch[j]);
+    }
+    finger_count = pad.touch_count;
+    std::copy_n(pad.touch, pad.touch_count, fingers);
+}
+
+void update_motion(EmuEnvState &emuenv, const Snapshot &pad) {
+    SDL_GamepadSensorEvent ev{};
+    ev.type = SDL_EVENT_GAMEPAD_SENSOR_UPDATE;
+    ev.sensor_timestamp = pad.timestamp * 1000; // us -> ns
+    ev.sensor = SDL_SENSOR_ACCEL;
+    for (int i = 0; i < 3; i++)
+        ev.data[i] = pad.accel[i] * STANDARD_GRAVITY;
+    handle_motion_event(emuenv, SDL_SENSOR_ACCEL, ev);
+    ev.sensor = SDL_SENSOR_GYRO;
+    for (int i = 0; i < 3; i++)
+        ev.data[i] = pad.gyro[i];
+    handle_motion_event(emuenv, SDL_SENSOR_GYRO, ev);
+}
+
+} // namespace
+
+void init() {
+    // (an error if it already was, which is fine)
+    sceUserServiceInitialize(nullptr);
+    const int32_t r = scePadInit();
+    if (r != 0)
+        LOG_ERROR("PS4 pad: scePadInit failed: {:08X}", static_cast<uint32_t>(r));
+    const std::lock_guard<std::mutex> guard(lock);
+    open_pad();
+}
+
+Snapshot read() {
+    const std::lock_guard<std::mutex> guard(lock);
+    Snapshot snap;
+    if (handle < 0) {
+        open_pad();
+        if (handle < 0)
+            return snap;
+    }
+    OrbisPadData data{};
+    if (scePadReadState(handle, &data) != 0)
+        return snap;
+    if (!data.connected)
+        return snap;
+    snap.connected = true;
+    snap.buttons = data.buttons;
+    snap.lx = data.leftStick.x;
+    snap.ly = data.leftStick.y;
+    snap.rx = data.rightStick.x;
+    snap.ry = data.rightStick.y;
+    snap.l2 = data.analogButtons.l2;
+    snap.r2 = data.analogButtons.r2;
+    snap.touch_count = std::min<uint8_t>(data.touch.fingers, 2);
+    for (uint8_t i = 0; i < snap.touch_count; i++) {
+        snap.touch[i].x = data.touch.touch[i].x;
+        snap.touch[i].y = data.touch.touch[i].y;
+        snap.touch[i].id = data.touch.touch[i].finger;
+    }
+    snap.accel[0] = data.acell.x;
+    snap.accel[1] = data.acell.y;
+    snap.accel[2] = data.acell.z;
+    snap.gyro[0] = data.vel.x;
+    snap.gyro[1] = data.vel.y;
+    snap.gyro[2] = data.vel.z;
+    snap.timestamp = data.timestamp;
+    return snap;
+}
+
+bool feed(EmuEnvState &emuenv, const Snapshot &pad) {
+    // L3 + R3: the pause menu, and neither reaches the game until both are up again
+    const bool combo = (pad.buttons & MENU_COMBO) == MENU_COMBO;
+    const bool menu = combo && !combo_held;
+    combo_held = combo;
+    if (combo)
+        menu_suppress = true;
+    else if (!(pad.buttons & MENU_COMBO))
+        menu_suppress = false;
+    const uint32_t buttons = menu_suppress ? pad.buttons & ~MENU_COMBO : pad.buttons;
+
+    uint32_t vita = 0;
+    uint32_t vita_ext = 0;
+    for (const ButtonMap &b : BUTTONS) {
+        if (buttons & b.pad) {
+            vita |= b.vita;
+            vita_ext |= b.vita_ext;
+        }
+    }
+    {
+        const std::lock_guard<std::mutex> guard(emuenv.ctrl.mutex);
+        auto &kb = emuenv.ctrl.keyboard_state;
+        kb.buttons = vita;
+        kb.buttons_ext = vita_ext;
+        const float mult = emuenv.cfg.controller_analog_multiplier;
+        kb.axes[0] = std::clamp(stick(pad.lx) * mult, -1.f, 1.f);
+        kb.axes[1] = std::clamp(stick(pad.ly) * mult, -1.f, 1.f);
+        kb.axes[2] = std::clamp(stick(pad.rx) * mult, -1.f, 1.f);
+        kb.axes[3] = std::clamp(stick(pad.ry) * mult, -1.f, 1.f);
+    }
+    update_touch(emuenv, pad);
+    if (pad.connected)
+        update_motion(emuenv, pad);
+    return menu;
+}
+
+void release(EmuEnvState &emuenv) {
+    {
+        const std::lock_guard<std::mutex> guard(emuenv.ctrl.mutex);
+        emuenv.ctrl.keyboard_state = {};
+    }
+    update_touch(emuenv, Snapshot{});
+    combo_held = false;
+    menu_suppress = false;
+}
+
+} // namespace ps4pad
