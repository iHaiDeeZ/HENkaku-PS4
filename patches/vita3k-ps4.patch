+// PS4: the app's folder in /data, /data/HENkaku (port/ps4_crashlog.cpp works it out at the first
+// file the app writes). Up to v00.42 it was /data/Vita3K, which the first start of 1.00 renames.
+
+#pragma once
+
+#include <string>
+
+extern "C" const char *ps4_data_dir();
+// 1 when this start moved /data/Vita3K to /data/HENkaku, -1 when it couldn't (the old one is in use)
+extern "C" int ps4_data_dir_moved();
+
+// a file or folder in the app's folder
+inline std::string ps4_data_path(const std::string &name) {
+    return std::string(ps4_data_dir()) + "/" + name;
+}
