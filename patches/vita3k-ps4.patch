+// frame generation is making in-between frames now (renderer.cpp): the FPS overlay's "on screen"
+std::atomic<bool> g_frame_doubling{ false };
+
+extern "C" void ps4_set_frame_doubling(bool on) {
+    g_frame_doubling.store(on, std::memory_order_relaxed);
+}
