+// The wallpaper: the theme's own, or a picture: HENkaku's (wallpaper_dir()), a USB drive's (its top
+// folder and a "wallpapers" folder in it), or the PS4's screenshots (the newest 60), each shown
+// beside the list while it's picked
+std::vector<Item> wallpaper_items() {
+    std::vector<Item> items;
+    items.push_back(section("Wallpaper"));
+    Item theme_own = action("The theme's own", [] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        g_prefs.wallpaper.clear();
+        save_prefs();
+    });
+    theme_own.checked = [] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return g_prefs.wallpaper.empty();
+    };
+    items.push_back(std::move(theme_own));
+    const auto add_all = [&](const std::string &heading, const std::vector<fs::path> &pictures) {
+        if (pictures.empty())
+            return;
+        items.push_back(section(heading));
+        for (const fs::path &p : pictures)
+            items.push_back(picture_item(p));
+    };
+    add_all("HENkaku's pictures: " + wallpaper_dir(), pictures_in(wallpaper_dir(), false, 500));
+    for (int i = 0; i < 8; i++) {
+        const fs::path usb = fmt::format("/mnt/usb{}", i);
+        std::vector<fs::path> pictures = pictures_in(usb / "wallpapers", false, 200);
+        const std::vector<fs::path> top = pictures_in(usb, false, 200);
+        pictures.insert(pictures.end(), top.begin(), top.end());
+        add_all(fmt::format("USB drive {}", i + 1), pictures);
+    }
+    add_all("PS4 screenshots", pictures_in("/user/av_contents/photo", true, 60));
+    if (items.size() == 2)
+        items.push_back(section("Copy pictures (.png, .jpg) to " + wallpaper_dir() + " or a USB drive"));
+    return items;
+}
