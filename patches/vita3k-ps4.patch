+
+// A card peeled away from its top right corner, `d` px along the diagonal (0 to W + H): over
+// what `frame` already has under it. The fold runs at 45 degrees; the peeled corner lies folded
+// back over the card, its white back shaded toward the fold.
+void peel(Canvas &frame, const Canvas &card, float d) {
+    uint32_t *dst = frame.data();
+    const uint32_t *src = card.data();
+    const auto darken = [](uint32_t p, uint32_t keep) {
+        const uint32_t rb = (((p & 0x00FF00FFu) * keep) >> 8) & 0x00FF00FFu;
+        const uint32_t g = (((p & 0x0000FF00u) * keep) >> 8) & 0x0000FF00u;
+        return rb | g | 0xFF000000u;
+    };
+    for (int y = 0; y < H; y++) {
+        uint32_t *row = dst + static_cast<size_t>(y) * W;
+        const uint32_t *from = src + static_cast<size_t>(y) * W;
+        // right of the fold: what's under the card
+        const int fold = std::clamp(static_cast<int>(W + y - d), 0, W);
+        const int flap = y <= d ? std::clamp(static_cast<int>(std::max(W + y - 2 * d, W - d)), 0, fold) : fold;
+        std::memcpy(row, from, static_cast<size_t>(flap) * 4);
+        // the flap's shadow on the card
+        for (int x = std::max(0, flap - 22); x < flap; x++)
+            row[x] = darken(row[x], 150 + (flap - x) * 105 / 22);
+        for (int x = flap; x < fold; x++) {
+            const float t = std::clamp((fold - x) / std::max(1.f, d), 0.f, 1.f);
+            const uint32_t v = static_cast<uint32_t>(246 - 70 * t);
+            row[x] = v | (v << 8) | (std::min(255u, v + 8) << 16) | 0xFF000000u;
+        }
+        // the fold's shadow on what's under
+        for (int x = fold; x < std::min(W, fold + 26); x++)
+            row[x] = darken(row[x], 140 + (x - fold) * 115 / 26);
+    }
+}
