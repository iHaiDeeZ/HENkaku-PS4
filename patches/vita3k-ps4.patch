+//   left and right, L3/R3 = the front screen's;
+//   each button and the touchpad can be set otherwise (ps4_controls.h: Vita buttons, touches on the
+//   front screen or the rear touch pad), L3 + R3 together = the HENkaku menu.
+
+#include "ps4_controls.h"
+
+#include "ps4_pad.h"
+
+#include <config/state.h>
+#include <ctrl/ctrl.h>
+#include <ctrl/state.h>
+#include <emuenv/state.h>
+#include <motion/event_handler.h>
+#include <touch/functions.h>
+#include <touch/state.h>
+#include <touch/touch.h>
+#include <util/log.h>
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <SDL3/SDL_events.h>
+#include <SDL3/SDL_sensor.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <mutex>
+
+namespace ps4pad {
+
+namespace {
+
+constexpr uint32_t MENU_COMBO = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+constexpr float STANDARD_GRAVITY = 9.80665f;
+
+std::mutex lock;
+int user = -1;
+int handle = -1;
+std::chrono::steady_clock::time_point next_open{};
+
+// While a game runs
+bool combo_held = false;
+bool menu_suppress = false; // L3/R3 stay out of the game until both are released
+
+float stick(uint8_t v) {
+    return std::clamp((static_cast<int>(v) - 128) / 127.f, -1.f, 1.f);
+}
+
+// The DualShock 4's sticks reach a circle: a diagonal pushed all the way is about 70% on each axis.
+// The PS2's and PS3's pads, and the games made for them, reach a square, a full diagonal full on
+// both: a game that wants each axis past a mark for a diagonal (Ratchet & Clank) saw only up or only
+// left. Square (HENkaku > Controls > Sticks): the point goes out along its own direction to the
+// square, so the direction stays and a full diagonal reaches the corner.
+void to_square(float &x, float &y) {
+    const float most = std::max(std::abs(x), std::abs(y));
+    if (most < 1e-4f)
+        return;
+    const float scale = std::min(std::sqrt(x * x + y * y) / most, 1.41421356f);
+    x = std::clamp(x * scale, -1.f, 1.f);
+    y = std::clamp(y * scale, -1.f, 1.f);
+}
+
+// Opens the pad of the first signed-in user (and again after it went away)
+void open_pad() {
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next_open)
+        return;
+    next_open = now + std::chrono::seconds(1);
+    int initial = -1;
+    if (sceUserServiceGetInitialUser(&initial) != 0 || initial < 0) {
+        OrbisUserServiceLoginUserIdList list{};
+        if (sceUserServiceGetLoginUserIdList(&list) != 0)
+            return;
+        for (int i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+            if (list.userId[i] != -1 && list.userId[i] != 0) {
+                initial = list.userId[i];
+                break;
+            }
+        }
+    }
+    if (initial < 0)
+        return;
+    const int h = scePadOpen(initial, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+    if (h < 0) {
+        LOG_WARN_ONCE("PS4 pad: scePadOpen for user {:08X} failed: {:08X}", static_cast<uint32_t>(initial), static_cast<uint32_t>(h));
+        return;
+    }
+    user = initial;
+    handle = h;
+    LOG_INFO("PS4 pad: user {:08X} on handle {}", static_cast<uint32_t>(user), handle);
+}
+
+// The fingers on each Vita panel: the touchpad's (where its use puts them) and the buttons set to
+// touch (held = a finger on their place). Ids: the touchpad's finger ids, the buttons' 64 and up.
+void update_touch(EmuEnvState &emuenv, const Snapshot &pad, const ps4controls::Controls &controls, uint32_t buttons) {
+    std::vector<Ps4TouchPoint> points[2];
+    for (uint8_t j = 0; j < pad.touch_count; j++) {
+        float x = std::clamp(pad.touch[j].x / TOUCHPAD_WIDTH, 0.f, 1.f);
+        const float y = std::clamp(pad.touch[j].y / TOUCHPAD_HEIGHT, 0.f, 1.f);
+        const uint8_t id = pad.touch[j].id % 64;
+        switch (controls.touchpad) {
+        case ps4controls::TouchpadFront:
+            points[0].push_back({ x, y, id });
+            break;
+        case ps4controls::TouchpadBack:
+            points[1].push_back({ x, y, id });
+            break;
+        case ps4controls::TouchpadSplit:
+            if (x < 0.5f)
+                points[0].push_back({ x * 2.f, y, id });
+            else
+                points[1].push_back({ (x - 0.5f) * 2.f, y, id });
+            break;
+        default:
+            break;
+        }
+    }
+    for (int b = 0; b < ps4controls::PadButtonCount; b++) {
+        const uint8_t action = controls.button[b];
+        if (action < ps4controls::ActFrontTouch || !(buttons & ps4controls::pad_bit(static_cast<ps4controls::PadButton>(b))))
+            continue;
+        const int port = action >= ps4controls::ActBackTouch ? 1 : 0;
+        const int place = action - (port ? ps4controls::ActBackTouch : ps4controls::ActFrontTouch);
+        float x, y;
+        ps4controls::touch_place(place, x, y);
+        points[port].push_back({ x, y, static_cast<uint8_t>(64 + b) });
+    }
+    // (once per panel: the log shows touches got through)
+    static bool logged[2] = {};
+    for (int port = 0; port < 2; port++) {
+        if (!points[port].empty() && !logged[port]) {
+            logged[port] = true;
+            LOG_INFO("PS4 controls: first touch on the {}", port ? "rear touch pad" : "front screen");
+        }
+    }
+    ps4_set_touches(emuenv.touch, points);
+}
+
+// The Vita buttons an action gives (sceCtrl's, and the PS TV's extended set)
+void action_buttons(uint8_t action, uint32_t &vita, uint32_t &vita_ext) {
+    static const uint32_t BUTTONS[][2] = {
+        { 0, 0 }, // nothing
+        { SCE_CTRL_CROSS, SCE_CTRL_CROSS },
+        { SCE_CTRL_CIRCLE, SCE_CTRL_CIRCLE },
+        { SCE_CTRL_SQUARE, SCE_CTRL_SQUARE },
+        { SCE_CTRL_TRIANGLE, SCE_CTRL_TRIANGLE },
+        { SCE_CTRL_UP, SCE_CTRL_UP },
+        { SCE_CTRL_DOWN, SCE_CTRL_DOWN },
+        { SCE_CTRL_LEFT, SCE_CTRL_LEFT },
+        { SCE_CTRL_RIGHT, SCE_CTRL_RIGHT },
+        { SCE_CTRL_L, SCE_CTRL_L1 },
+        { SCE_CTRL_R, SCE_CTRL_R1 },
+        { SCE_CTRL_START, SCE_CTRL_START },
+        { SCE_CTRL_SELECT, SCE_CTRL_SELECT },
+        { 0, SCE_CTRL_L2 },
+        { 0, SCE_CTRL_R2 },
+        { 0, SCE_CTRL_L3 },
+        { 0, SCE_CTRL_R3 },
+    };
+    if (action < std::size(BUTTONS)) {
+        vita |= BUTTONS[action][0];
+        vita_ext |= BUTTONS[action][1];
+    }
+}
+
+void update_motion(EmuEnvState &emuenv, const Snapshot &pad) {
+    SDL_GamepadSensorEvent ev{};
+    ev.type = SDL_EVENT_GAMEPAD_SENSOR_UPDATE;
+    ev.sensor_timestamp = pad.timestamp * 1000; // us -> ns
+    ev.sensor = SDL_SENSOR_ACCEL;
+    for (int i = 0; i < 3; i++)
+        ev.data[i] = pad.accel[i] * STANDARD_GRAVITY;
+    handle_motion_event(emuenv, SDL_SENSOR_ACCEL, ev);
+    ev.sensor = SDL_SENSOR_GYRO;
+    for (int i = 0; i < 3; i++)
+        ev.data[i] = pad.gyro[i];
+    handle_motion_event(emuenv, SDL_SENSOR_GYRO, ev);
+}
+
+} // namespace
+
+void init() {
+    // (an error if it already was, which is fine)
+    sceUserServiceInitialize(nullptr);
+    const int32_t r = scePadInit();
+    if (r != 0)
+        LOG_ERROR("PS4 pad: scePadInit failed: {:08X}", static_cast<uint32_t>(r));
+    const std::lock_guard<std::mutex> guard(lock);
+    open_pad();
+}
+
+Snapshot read() {
+    const std::lock_guard<std::mutex> guard(lock);
+    Snapshot snap;
+    if (handle < 0) {
+        open_pad();
+        if (handle < 0)
+            return snap;
+    }
+    OrbisPadData data{};
+    if (scePadReadState(handle, &data) != 0)
+        return snap;
+    if (!data.connected)
+        return snap;
+    snap.connected = true;
+    snap.buttons = data.buttons;
+    snap.lx = data.leftStick.x;
+    snap.ly = data.leftStick.y;
+    snap.rx = data.rightStick.x;
+    snap.ry = data.rightStick.y;
+    snap.l2 = data.analogButtons.l2;
+    snap.r2 = data.analogButtons.r2;
+    snap.touch_count = std::min<uint8_t>(data.touch.fingers, 2);
+    for (uint8_t i = 0; i < snap.touch_count; i++) {
+        snap.touch[i].x = data.touch.touch[i].x;
+        snap.touch[i].y = data.touch.touch[i].y;
+        snap.touch[i].id = data.touch.touch[i].finger;
+    }
+    snap.accel[0] = data.acell.x;
+    snap.accel[1] = data.acell.y;
+    snap.accel[2] = data.acell.z;
+    snap.gyro[0] = data.vel.x;
+    snap.gyro[1] = data.vel.y;
+    snap.gyro[2] = data.vel.z;
+    snap.timestamp = data.timestamp;
+    return snap;
+}
+
+bool feed(EmuEnvState &emuenv, const Snapshot &pad, bool menu_open) {
+    // L3 + R3: the pause menu, and neither reaches the game until both are up again
+    const bool combo = (pad.buttons & MENU_COMBO) == MENU_COMBO;
+    const bool menu = combo && !combo_held;
+    combo_held = combo;
+    if (combo)
+        menu_suppress = true;
+    else if (!(pad.buttons & MENU_COMBO))
+        menu_suppress = false;
+    const uint32_t buttons = menu_suppress ? pad.buttons & ~MENU_COMBO : pad.buttons;
+
+    // the menu is worked with the buttons as they are, and gets no touches
+    const ps4controls::Controls controls = menu_open ? ps4controls::defaults() : ps4controls::running();
+    uint32_t vita = 0;
+    uint32_t vita_ext = 0;
+    for (int b = 0; b < ps4controls::PadButtonCount; b++) {
+        if (buttons & ps4controls::pad_bit(static_cast<ps4controls::PadButton>(b)))
+            action_buttons(controls.button[b], vita, vita_ext);
+    }
+    {
+        const std::lock_guard<std::mutex> guard(emuenv.ctrl.mutex);
+        auto &kb = emuenv.ctrl.keyboard_state;
+        kb.buttons = vita;
+        kb.buttons_ext = vita_ext;
+        const float mult = emuenv.cfg.controller_analog_multiplier;
+        float lx = stick(pad.lx), ly = stick(pad.ly), rx = stick(pad.rx), ry = stick(pad.ry);
+        if (!menu_open && controls.sticks == ps4controls::SticksSquare) {
+            to_square(lx, ly);
+            to_square(rx, ry);
+        }
+        kb.axes[0] = std::clamp(lx * mult, -1.f, 1.f);
+        kb.axes[1] = std::clamp(ly * mult, -1.f, 1.f);
+        kb.axes[2] = std::clamp(rx * mult, -1.f, 1.f);
+        kb.axes[3] = std::clamp(ry * mult, -1.f, 1.f);
+    }
+    if (menu_open)
+        update_touch(emuenv, Snapshot{}, controls, 0);
+    else
+        update_touch(emuenv, pad, controls, buttons);
+    if (pad.connected)
+        update_motion(emuenv, pad);
+    return menu;
+}
+
+void release(EmuEnvState &emuenv) {
+    {
+        const std::lock_guard<std::mutex> guard(emuenv.ctrl.mutex);
+        emuenv.ctrl.keyboard_state = {};
+    }
+    update_touch(emuenv, Snapshot{}, ps4controls::defaults(), 0);
+    combo_held = false;
+    menu_suppress = false;
+}
+
+} // namespace ps4pad
