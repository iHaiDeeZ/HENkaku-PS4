+void VKSurfaceCache::resolve_ds_scene_end(bool scene_wrote_depth) {
+    if (pending_ds_scene != nullptr && scene_wrote_depth)
+        pending_ds_scene->depth_content_stored = pending_ds_scene_stores;
+    pending_ds_scene = nullptr;
+}
