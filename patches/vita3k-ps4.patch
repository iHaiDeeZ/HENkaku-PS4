+void draw_settings(Canvas &c, SettingsView &view, const ps4ui::Image &henkaku) {
+    static const Canvas made = [] {
+        Canvas c(W, H);
+        c.clear_gradient(rgb(0x10203c), rgb(0x03060d));
+        c.fill_circle(1700, -120, 620, rgb(0x2a6fd6, 22));
+        return c;
+    }();
+    c.copy_from(made);
+    // the heading: the ensō, HENkaku, whose settings and which page
+    int tx = MARGIN;
+    if (!henkaku.empty()) {
+        c.draw_image(henkaku, MARGIN, 60);
+        tx += henkaku.width + 30;
+    }
+    c.text(tx, 122, "HENkaku", 66, TEXT, Weight::Bold);
+    std::string path = view.scope;
+    for (size_t i = 1; i < view.stack.size(); i++)
+        path += "   >   " + view.stack[i].name;
+    c.text(tx + 4, 176, path, 32, ACCENT, Weight::Regular, W - tx - MARGIN);
+    c.fill_rect(MARGIN, 206, W - 2 * MARGIN, 2, rgb(0xffffff, 30));
+
+    SettingsLevel &level = view.stack.back();
+    const auto &items = *level.items;
+    const int count = static_cast<int>(items.size());
+    const auto height_of = [&](int i) { return items[i].type == SItem::kind::section ? SET_SECTION : SET_ROW; };
+    const auto span = [&](int first, int last) {
+        int h = 0;
+        for (int i = first; i <= last; i++)
+            h += height_of(i);
+        return h;
+    };
+    // the selection in view, with its section's heading when that's right above it
+    if (level.selected < level.top)
+        level.top = level.selected;
+    if (level.top > 0 && level.top == level.selected && items[level.top - 1].type == SItem::kind::section)
+        level.top--;
+    while (level.top < level.selected && span(level.top, level.selected) > SET_H)
+        level.top++;
+
+    // a page of pictures: the picked one beside the list
+    constexpr int PREVIEW_W = 640, PREVIEW_H = 360;
+    const bool previews = std::any_of(items.begin(), items.end(), [](const SItem &i) { return !i.preview.empty(); });
+    const int row_w = previews ? W - 2 * MARGIN - PREVIEW_W - 48 : W - 2 * MARGIN;
+
+    int y = SET_Y;
+    int last = level.top - 1;
+    for (int i = level.top; i < count; i++) {
+        const int h = height_of(i);
+        if (y + h > SET_Y + SET_H)
+            break;
+        last = i;
+        const SItem &item = items[i];
+        if (item.type == SItem::kind::section) {
+            c.text(MARGIN + 6, y + 44, item.name, 26, ACCENT, Weight::Bold, row_w - 12);
+            y += h;
+            continue;
+        }
+        const bool sel = i == level.selected;
+        c.fill_round_rect(MARGIN, y, row_w, h - 10, 18, sel ? rgb(0x2a6fd6, 120) : rgb(0xffffff, 14));
+        if (sel)
+            c.fill_round_rect(MARGIN, y + 16, 6, h - 42, 3, ACCENT);
+        const int right = MARGIN + row_w - 38;
+        // the value first: the name, then its note, get the room left of it (cut with "...")
+        std::string value_text;
+        int value_px = 30;
+        int value = -1;
+        if (item.type == SItem::kind::choice) {
+            value = choice_value(item);
+            value_text = value < 0 ? std::string() : item.set ? "<   " + item.values[value] + "   >" : item.values[value];
+        } else if (item.type == SItem::kind::page) {
+            value_text = ">";
+            value_px = 28;
+        } else if (item.type == SItem::kind::action && item.checked && item.checked()) {
+            value_text = "In use";
+        }
+        // a colour: its dot left of its name
+        const bool swatch = item.type == SItem::kind::choice && value >= 0 && value < static_cast<int>(item.swatches.size());
+        const int value_w = value_text.empty() ? 0 : std::min(c.text_width(value_text, value_px, Weight::Bold), row_w / 2);
+        const int value_room = (value_w ? value_w + 40 : 0) + (swatch ? 50 : 0);
+        const int name_room = right - value_room - (MARGIN + 38);
+        const int name_w = c.text(MARGIN + 38, y + 47, item.name, 32, TEXT, sel ? Weight::Bold : Weight::Regular, name_room);
+        const int note_x = MARGIN + 38 + name_w + 18, note_room = right - value_room - note_x;
+        if ((item.type == SItem::kind::choice || item.type == SItem::kind::page) && !item.note.empty() && note_room > 120)
+            c.text(note_x, y + 45, item.note, 24, MUTED, Weight::Regular, note_room);
+        if (swatch) {
+            const float sx = right - value_w - 34.f, sy = y + 33.f;
+            c.fill_circle(sx, sy, 17.f, rgb(0xffffff));
+            c.fill_circle(sx, sy, 14.f, rgb(item.swatches[value]));
+        }
+        if (item.type == SItem::kind::choice)
+            c.text(right - value_w, y + 46, value_text, value_px, sel ? TEXT : ACCENT, Weight::Bold, value_w);
+        else if (item.type == SItem::kind::page)
+            c.text(right - value_w, y + 46, value_text, value_px, MUTED);
+        else if (!value_text.empty())
+            c.text(right - value_w, y + 46, value_text, value_px, ACCENT, Weight::Bold, value_w);
+        y += h;
+    }
+    // more above or below
+    if (level.top > 0)
+        c.text_centered(MARGIN + row_w / 2, SET_Y - 8, "...", 30, MUTED, Weight::Bold);
+    if (last + 1 < count)
+        c.text_centered(MARGIN + row_w / 2, SET_Y + SET_H + 26, "...", 30, MUTED, Weight::Bold);
+    // the picked picture (made when first picked, a few kept)
+    if (previews) {
+        const int px = W - MARGIN - PREVIEW_W, py = SET_Y + 6;
+        c.fill_round_rect(px - 10, py - 10, PREVIEW_W + 20, PREVIEW_H + 20, 20, rgb(0xffffff, 28));
+        c.fill_rect(px, py, PREVIEW_W, PREVIEW_H, rgb(0x000000));
+        const SItem *picked = level.selected < count ? &items[level.selected] : nullptr;
+        if (picked && !picked->preview.empty()) {
+            if (const std::shared_ptr<const ps4ui::Image> picture = preview_loader().get(picked->preview)) {
+                if (!picture->empty())
+                    c.draw_image(*picture, px + (PREVIEW_W - picture->width) / 2, py + (PREVIEW_H - picture->height) / 2);
+            } else {
+                c.text_centered(px + PREVIEW_W / 2, py + PREVIEW_H / 2 + 12, "Loading...", 30, MUTED, Weight::Bold);
+            }
+            c.text(px, py + PREVIEW_H + 50, fs_utils::path_to_utf8(fs::path(picked->preview).filename()), 26, MUTED, Weight::Regular, PREVIEW_W);
+        } else {
+            c.text_centered(px + PREVIEW_W / 2, py + PREVIEW_H / 2 + 12, "The theme's own wallpaper", 30, MUTED, Weight::Bold);
+        }
+    }
+}
