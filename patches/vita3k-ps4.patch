+// The games' trophies (ux0/user/<user>/trophy: what games add when they start), by name
+std::vector<TrophyGame> load_trophies(EmuEnvState &emuenv) {
+    np::trophy::CollectionSource source;
+    source.io = &emuenv.io;
+    source.vita_fs_path = emuenv.vita_fs_path;
+    source.user_id = emuenv.io.user_id.empty() ? std::string("00") : emuenv.io.user_id;
+    source.lang = static_cast<uint32_t>(emuenv.cfg.sys_lang);
+    std::vector<TrophyGame> games;
+    try {
+        for (const std::string &id : np::trophy::list_collection_ids(source)) {
+            np::trophy::CollectionSnapshot snapshot;
+            if (!np::trophy::load_collection(source, id, snapshot))
+                continue;
+            TrophyGame game;
+            game.title = snapshot.title;
+            game.icon_path = snapshot.icon_path;
+            game.total = snapshot.total;
+            game.earned = snapshot.unlocked;
+            for (size_t k = 0; k < game.by_grade.size(); k++)
+                game.by_grade[k] = snapshot.grade_unlocked[k];
+            for (const np::trophy::TrophyRecord &t : snapshot.trophies)
+                game.trophies.push_back({ t.name, t.detail, t.icon_path, t.grade, t.hidden, t.earned, static_cast<int64_t>(t.timestamp) });
+            games.push_back(std::move(game));
+        }
+    } catch (const std::exception &e) {
+        LOG_ERROR("PS4 launcher: reading the trophies failed: {}", e.what());
+    }
+    std::sort(games.begin(), games.end(), [](const TrophyGame &a, const TrophyGame &b) {
+        return string_utils::tolower(a.title) < string_utils::tolower(b.title);
+    });
+    return games;
+}
+
+} // namespace
+
+void show_message(const std::string &title, const std::string &detail) {
+    Canvas c(W, H);
+    background(c);
+    const int x = c.text(MARGIN, 128, "HENkaku", 76, TEXT, Weight::Bold);
+    c.text(MARGIN + x + 18, 128, "PS Vita on PS4", 38, ACCENT);
+    c.text_centered(W / 2, H / 2 - 10, title, 56, TEXT, Weight::Bold);
+    // one line centered, a longer one (an error) wrapped
+    if (c.text_width(detail, 32) <= W - 2 * MARGIN)
+        c.text_centered(W / 2, H / 2 + 60, detail, 32, MUTED);
+    else
+        c.text_wrapped(MARGIN, H / 2 + 60, detail, 32, MUTED, W - 2 * MARGIN, 44);
+    present(c);
+}
+
+Choice run(EmuEnvState &emuenv, const std::string &notice_text) {
+    // the PS Vita shell's own pictures, from the firmware (the home screen's look as the Vita's)
+    ps4shell::load(fs_utils::path_to_utf8(emuenv.vita_fs_path / "vs0"));
+    Canvas canvas(W, H);
+    std::vector<Item> items = load_items(emuenv);
+    std::vector<Tile> tiles = make_tiles(items);
+    app::FirmwareState fw = app::get_firmware_state(emuenv);
+    const ps4settings::Prefs &prefs = ps4settings::prefs();
+    // the HENkaku ensō, at the status bar's, the bubble's and the settings heading's sizes
+    const std::string henkaku_path = ps4settings::icon_path();
+    const ps4ui::Image henkaku_bar = ps4ui::load_image(henkaku_path, 42, 42);
+    const ps4ui::Image henkaku_icon = ps4ui::load_image(henkaku_path, ICON_SIZE * 7 / 10, ICON_SIZE * 7 / 10);
+    const ps4ui::Image henkaku_heading = ps4ui::load_image(henkaku_path, 124, 124);
+    const ps4ui::Image henkaku_about = ps4ui::load_image(henkaku_path, 420, 420);
+
+    // the bubbles' sprites, by tile, made when first needed (or ahead, while nothing moves)
+    std::map<int, TileArt> art;
+    const auto tile_art = [&](int index) -> TileArt & {
+        auto it = art.find(index);
+        if (it != art.end())
+            return it->second;
+        const Tile &tl = tiles[index];
+        ps4ui::Image icon;
+        Canvas ic(ICON_SIZE, ICON_SIZE);
+        switch (tl.kind) {
+        case TileKind::Henkaku:
+            ic.clear_gradient(rgb(0x30353f), rgb(0x040506));
+            if (!henkaku_icon.empty())
+                ic.draw_image(henkaku_icon, (ICON_SIZE - henkaku_icon.width) / 2, (ICON_SIZE - henkaku_icon.height) / 2);
+            icon = ic.snapshot();
+            break;
+        case TileKind::Install:
+            ic.clear_gradient(rgb(0x45a8ff), rgb(0x0b56c4));
+            install_glyph(ic, ICON_SIZE / 2.f, ICON_SIZE / 2.f, ICON_SIZE * 0.42f);
+            icon = ic.snapshot();
+            break;
+        case TileKind::Game:
+            ensure_icons(items[tl.item]);
+            icon = items[tl.item].bubble;
+            if (icon.empty()) {
+                ic.clear_gradient(rgb(0x2b3c5c), rgb(0x16223a));
+                ic.text_centered(ICON_SIZE / 2, ICON_SIZE / 2 + 34, "?", 100, MUTED, Weight::Bold);
+                icon = ic.snapshot();
+            }
+            break;
+        }
+        TileArt t;
+        t.bubble = make_bubble(icon, rgb(0x1b2a44));
+        t.mini = ps4ui::shrink_image(t.bubble, 46, 46);
+        return art.emplace(index, std::move(t)).first->second;
+    };
+    const std::function<TileArt &(int)> tile_art_fn = tile_art;
+
+    HomeView home;
+    // the open LiveAreas, as cards right of the home screen (they stay open between games)
+    static std::vector<std::string> cards;
+    std::map<std::string, std::unique_ptr<Canvas>> card_pictures;
+    int card = 0; // the card on screen: 0 the home screen, k the LiveArea of cards[k - 1]
+    Spring card_pos;
+    bool peeling = false;
+    Clock::time_point peel_at{};
+    bool launching = false;
+    Clock::time_point launch_at{};
+    int pending_open = -1; // a pressed bubble opens when its press has shown
+    Clock::time_point pending_at{};
+
+    enum class Mode {
+        Home, // the bubbles or the list (HENkaku > System > Style)
+        Browser, // the install browser
+        LiveArea, // a game's
+        Settings, // the HENkaku settings: all games', or a game's
+        About, // who made HENkaku
+        Trophies, // the Trophy Collection
+    };
+    Mode mode = Mode::Home;
+    Mode settings_return = Mode::Home;
+    int selected = 0; // the list's
+    int top = 0;
+    int tile = 0; // the bubbles'
+    int live = -1; // the game whose LiveArea is on screen
+    SettingsView settings;
+    TrophyView trophies;
+    Mode trophies_return = Mode::Home;
+    ps4ui::Image trophies_icon;
+    bool quit_requested = false;
+    bool about_requested = false;
+    bool firmware_requested = false;
+    bool downloads_requested = false;
+    bool cancel_downloads_requested = false;
+
+    // the last game started is selected again
+    static std::string last_app_path;
+    const auto select_app = [&](const std::string &app_path, const std::string &title_id) {
+        for (size_t i = 0; i < items.size(); i++) {
+            if ((!app_path.empty() && items[i].entry.path == app_path) || (!title_id.empty() && items[i].entry.title_id == title_id)) {
+                selected = static_cast<int>(i);
+                tile = static_cast<int>(i) + 2; // after the HENkaku and Install bubbles
+            }
+        }
+    };
+    select_app(last_app_path, {});
+    const auto find_item = [&](const std::string &path) {
+        for (size_t i = 0; i < items.size(); i++)
+            if (items[i].entry.path == path)
+                return static_cast<int>(i);
+        return -1;
+    };
+    // cards of games no longer installed go
+    cards.erase(std::remove_if(cards.begin(), cards.end(), [&](const std::string &path) { return find_item(path) < 0; }), cards.end());
+    const auto card_picture = [&](int k) -> Canvas & {
+        const std::string &path = cards[k - 1];
+        auto &picture = card_pictures[path];
+        if (!picture) {
+            picture = std::make_unique<Canvas>(W, H);
+            Item &item = items[find_item(path)];
+            ensure_livearea(item, item.dir.empty() ? emuenv.vita_fs_path / "ux0" / "app" / item.entry.path : item.dir);
+            draw_livearea(*picture, item);
+        }
+        return *picture;
+    };
+    const auto show_card = [&](int k) {
+        card = std::clamp(k, 0, static_cast<int>(cards.size()));
+        if (card == 0) {
+            mode = Mode::Home;
+        } else {
+            mode = Mode::LiveArea;
+            live = find_item(cards[card - 1]);
+        }
+    };
+    // a game's LiveArea: its card (opened, or moved to)
+    const auto open_livearea = [&](int item) {
+        const std::string &path = items[item].entry.path;
+        auto it = std::find(cards.begin(), cards.end(), path);
+        if (it == cards.end()) {
+            if (static_cast<int>(cards.size()) >= MAX_CARDS) {
+                card_pictures.erase(cards.front());
+                cards.erase(cards.begin());
+                card_pos.pos = std::max(0.f, card_pos.pos - 1);
+            }
+            cards.push_back(path);
+            it = cards.end() - 1;
+        }
+        show_card(static_cast<int>(it - cards.begin()) + 1);
+    };
+    home.page = tile / PER_PAGE;
+    for (int r = 0; r < 3; r++)
+        home.rows[r].pos = home.row_target[r] = static_cast<float>(home.page);
+    // the first page's bubbles made before they come in
+    for (int i = home.page * PER_PAGE; i < std::min(static_cast<int>(tiles.size()), (home.page + 1) * PER_PAGE); i++)
+        tile_art(i);
+    home.appearing = true;
+    home.appear_at = Clock::now();
+    std::string notice = notice_text;
+    auto notice_until = Clock::now() + std::chrono::seconds(notice.empty() ? 0 : 12);
+    InstallJob job;
+    const auto start_firmware = [&] {
+        reset(job, true);
+        job.thread = std::thread([&emuenv, &job, downloads = missing_firmware(fw)] { firmware_worker(emuenv, job, downloads); });
+        notice.clear();
+    };
+    // PKGj's downloads, a stop undone
+    const auto start_downloads = [&] {
+        reset(job, false, true);
+        ps4bgdl::set_stopped(emuenv.vita_fs_path, false);
+        job.thread = std::thread([&emuenv, &job, list = ps4bgdl::list(emuenv.vita_fs_path)]() mutable { bgdl_worker(emuenv, job, std::move(list)); });
+        notice.clear();
+    };
+    bool downloads_checked = false;
+    // the install browser, where it was the last time
+    static fs::path browse_dir = install_dir(); // empty: the locations
+    std::vector<Entry> entries;
+    int browse_selected = 0;
+    int browse_top = 0;
+    const auto open_dir = [&](const fs::path &dir) {
+        boost::system::error_code ec;
+        browse_dir = !dir.empty() && fs::is_directory(dir, ec) ? dir : fs::path();
+        entries = browse_dir.empty() ? locations() : list_folder(browse_dir);
+        browse_selected = browse_top = 0;
+    };
+    const auto open_browser = [&] {
+        mode = Mode::Browser;
+        open_dir(browse_dir);
+    };
+    const auto start_install = [&](std::vector<Entry> list, bool consume) {
+        reset(job, false);
+        job.thread = std::thread([&emuenv, &job, list = std::move(list), consume]() mutable { install_worker(emuenv, job, std::move(list), consume); });
+        notice.clear();
+    };
+    // starts a game, or decrypts it first when it's still a NoNpDrm dump (it starts when done)
+    const auto start_game = [&](int index) -> std::optional<Choice> {
+        const Item &item = items[index];
+        const fs::path app_dir = emuenv.vita_fs_path / "ux0" / "app" / item.entry.path;
+        if (!still_encrypted(app_dir)) {
+            last_app_path = item.entry.path;
+            show_message("Starting", item.entry.title);
+            return Choice{ false, item.entry.path, item.entry.title };
+        }
+        reset(job, false);
+        job.start_app = item.entry.path;
+        job.start_title = item.entry.title;
+        job.thread = std::thread([&emuenv, &job, app_dir, title = item.entry.title] { decrypt_worker(emuenv, job, app_dir, title); });
+        notice.clear();
+        return std::nullopt;
+    };
+    // the HENkaku settings: a game's (game >= 0) or all games', with the launcher's own lines
+    const auto open_settings = [&](int game) {
+        settings_return = mode;
+        if (game >= 0) {
+            settings_open(settings, items[game].entry.title, ps4settings::game_pages(emuenv, items[game].entry.path));
+        } else {
+            std::vector<SItem> root = ps4settings::global_pages(emuenv);
+            if (!missing_firmware(fw).empty()) {
+                root.push_back(section_item("PS Vita firmware"));
+                root.push_back(action_item(fw.main_firmware ? "Download the font package from Sony" : "Download the firmware from Sony", [&] { firmware_requested = true; }));
+            }
+            if (const size_t waiting = ps4bgdl::list(emuenv.vita_fs_path).size()) {
+                root.push_back(section_item("PKGj downloads"));
+                root.push_back(action_item(fmt::format("Download and install ({})", waiting), [&] { downloads_requested = true; }));
+                root.push_back(action_item("Cancel them", [&] { cancel_downloads_requested = true; }));
+            }
+            root.push_back(section_item("HENkaku"));
+            root.push_back(action_item("About HENkaku", [&] { about_requested = true; }));
+            root.push_back(action_item("Quit HENkaku", [&] { quit_requested = true; }));
+            settings_open(settings, "All games", std::move(root));
+        }
+        mode = Mode::Settings;
+    };
+    // A firmware app started (from its LiveArea, or the list): HENkaku's screen for it
+    const auto open_system = [&](const Item &item) {
+        switch (item.system) {
+        case SystemApp::Settings:
+            open_settings(-1);
+            break;
+        case SystemApp::ContentManager:
+            open_browser();
+            break;
+        case SystemApp::Trophies:
+            trophies_return = mode;
+            trophies.games = load_trophies(emuenv);
+            trophies.game = -1;
+            trophies.selected = trophies.top = 0;
+            trophies.pictures.clear();
+            if (trophies_icon.empty())
+                trophies_icon = ps4ui::load_image(item.entry.icon_path, 124, 124);
+            mode = Mode::Trophies;
+            break;
+        case SystemApp::None:
+            break;
+        }
+    };
+    // What's missing of the firmware comes from Sony by itself, unless the user stopped that
+    // before or copied update files to install
+    if (!missing_firmware(fw).empty()) {
+        boost::system::error_code ec;
+        if (!fs::exists(download_stopped(), ec) && !updates_waiting()) {
+            start_firmware();
+        } else if (notice.empty()) {
+            if (updates_waiting())
+                notice = "PS Vita update files are waiting in " + install_dir() + ": Triangle, then Square installs them";
+            else
+                notice = std::string(fw.main_firmware ? "The PS Vita font package isn't installed: some games need it." : "The PS Vita firmware isn't installed: most games need it.") + " HENkaku (OPTIONS) downloads it from Sony.";
+            notice_until = Clock::now() + std::chrono::hours(1);
+        }
+    }
+
+    // buttons held from the game don't count as presses here
+    uint32_t previous = ps4pad::read().buttons;
+    Clock::time_point repeat_at{};
+    int repeat_key = 0;
+    bool dirty = true;
+    auto last_progress = Clock::now();
+    auto last_frame = Clock::now();
+    std::string shown_clock = clock_text();
+
+    while (true) {
+        const ps4pad::Snapshot pad = ps4pad::read();
+        uint32_t buttons = pad.buttons;
+        // the left stick as the D-pad
+        if (pad.connected && pad.ly < 48)
+            buttons |= ORBIS_PAD_BUTTON_UP;
+        if (pad.connected && pad.ly > 208)
+            buttons |= ORBIS_PAD_BUTTON_DOWN;
+        if (pad.connected && pad.lx < 48)
+            buttons |= ORBIS_PAD_BUTTON_LEFT;
+        if (pad.connected && pad.lx > 208)
+            buttons |= ORBIS_PAD_BUTTON_RIGHT;
+        const uint32_t pressed = buttons & ~previous;
+        previous = buttons;
+        const auto now = Clock::now();
+
+        // PKGj's downloads carry on by themselves (after the firmware's), unless they were stopped
+        if (!job.running && !downloads_checked) {
+            downloads_checked = true;
+            const size_t waiting = ps4bgdl::list(emuenv.vita_fs_path).size();
+            if (waiting && !ps4bgdl::stopped(emuenv.vita_fs_path)) {
+                start_downloads();
+            } else if (waiting && notice.empty()) {
+                notice = waiting == 1 ? std::string("A PKGj download is waiting: HENkaku (OPTIONS) carries on with it") : fmt::format("{} PKGj downloads are waiting: HENkaku (OPTIONS) carries on with them", waiting);
+                notice_until = now + std::chrono::seconds(20);
+                dirty = true;
+            }
+        }
+
+        if (job.running) {
+            if (job.finished) {
+                job.thread.join();
+                job.running = false;
+                // decrypted: it starts now
+                std::string start_app, start_title;
+                {
+                    const std::lock_guard<std::mutex> lock(job.mutex);
+                    if (job.installed > 0) {
+                        start_app = job.start_app;
+                        start_title = job.start_title;
+                    }
+                }
+                if (!start_app.empty()) {
+                    last_app_path = start_app;
+                    show_message("Starting", start_title);
+                    return Choice{ false, start_app, start_title };
+                }
+                items = load_items(emuenv);
+                tiles = make_tiles(items);
+                art.clear();
+                card_pictures.clear();
+                cards.erase(std::remove_if(cards.begin(), cards.end(), [&](const std::string &path) { return find_item(path) < 0; }), cards.end());
+                show_card(0);
+                card_pos = {};
+                const bool had_font_package = fw.font_package;
+                fw = app::get_firmware_state(emuenv);
+                // the text in the PS Vita's fonts, now that they're there
+                if (fw.font_package && !had_font_package)
+                    ps4ui::set_vita_font_dir(fs_utils::path_to_utf8(emuenv.vita_fs_path / "sa0" / "data" / "font" / "pvf") + "/");
+                selected = std::min(selected, std::max(0, static_cast<int>(items.size()) - 1));
+                tile = std::min(tile, static_cast<int>(tiles.size()) - 1);
+                home_go_to_page(home, tile / PER_PAGE, now);
+                if (!job.firmware) {
+                    // back home, on the game just installed
+                    mode = Mode::Home;
+                    std::string title_id;
+                    {
+                        const std::lock_guard<std::mutex> lock(job.mutex);
+                        title_id = job.title_id;
+                    }
+                    select_app({}, title_id);
+                    home_go_to_page(home, tile / PER_PAGE, now);
+                }
+                notice = summary(job);
+                notice_until = now + std::chrono::seconds(20);
+                dirty = true;
+            } else {
+                // Circle stops a download
+                if ((pressed & ORBIS_PAD_BUTTON_CIRCLE) && (job.firmware || job.downloads)) {
+                    const std::lock_guard<std::mutex> lock(job.mutex);
+                    if (job.stoppable)
+                        job.stop_requested = true;
+                }
+                if (now - last_progress > std::chrono::milliseconds(100)) {
+                    last_progress = now;
+                    dirty = true;
+                }
+            }
+        } else {
+            // the D-pad, repeating while held
+            int dx = (buttons & ORBIS_PAD_BUTTON_LEFT) ? -1 : (buttons & ORBIS_PAD_BUTTON_RIGHT) ? 1 : 0;
+            int dy = (buttons & ORBIS_PAD_BUTTON_UP) ? -1 : (buttons & ORBIS_PAD_BUTTON_DOWN) ? 1 : 0;
+            if (dy != 0)
+                dx = 0;
+            const int key = dx * 3 + dy;
+            bool step = false;
+            if (key != 0 && key != repeat_key) {
+                step = true;
+                repeat_at = now + std::chrono::milliseconds(380);
+            } else if (key != 0 && now >= repeat_at) {
+                step = true;
+                repeat_at = now + std::chrono::milliseconds(mode == Mode::Home && prefs.bubbles ? 150 : 70);
+            }
+            repeat_key = key;
+            if (!step)
+                dx = dy = 0;
+
+            switch (mode) {
+            case Mode::Home:
+                if (prefs.bubbles) {
+                    const int count = static_cast<int>(tiles.size());
+                    if (pending_open >= 0 || peeling || launching) {
+                        // a bubble opening, or a card going: the buttons wait
+                    } else {
+                        if (dx != 0 || dy != 0) {
+                            tile = bubble_step(tile, count, dx, dy);
+                            home_go_to_page(home, tile / PER_PAGE, now);
+                            dirty = true;
+                        }
+                        // L1 / R1: the open LiveAreas, as a swipe would on the Vita
+                        if ((pressed & ORBIS_PAD_BUTTON_R1) && !cards.empty()) {
+                            show_card(1);
+                            dirty = true;
+                        }
+                    }
+                    const Tile &t = tiles[tile];
+                    if (pending_open >= 0 || peeling || launching) {
+                    } else if (pressed & ORBIS_PAD_BUTTON_CROSS) {
+                        // the bubble gives, springs back, and then opens
+                        home.pressed = tile;
+                        home.press_at = now;
+                        pending_open = tile;
+                        pending_at = now + std::chrono::milliseconds(200);
+                        dirty = true;
+                    } else if ((pressed & ORBIS_PAD_BUTTON_SQUARE) && t.kind == TileKind::Game && items[t.item].system == SystemApp::None) {
+                        open_settings(t.item);
+                        dirty = true;
+                    }
+                } else {
+                    const int count = static_cast<int>(items.size());
+                    if (dy != 0 && count > 0) {
+                        selected = std::clamp(selected + dy, 0, count - 1);
+                        dirty = true;
+                    }
+                    // L1 / R1: a page at a time
+                    if ((pressed & (ORBIS_PAD_BUTTON_L1 | ORBIS_PAD_BUTTON_R1)) && count > 0) {
+                        selected = std::clamp(selected + ((pressed & ORBIS_PAD_BUTTON_L1) ? -VISIBLE_ROWS : VISIBLE_ROWS), 0, count - 1);
+                        dirty = true;
+                    }
+                    if ((pressed & ORBIS_PAD_BUTTON_CROSS) && count > 0) {
+                        if (items[selected].system != SystemApp::None)
+                            open_system(items[selected]);
+                        else if (auto choice = start_game(selected))
+                            return *choice;
+                        dirty = true;
+                    } else if ((pressed & ORBIS_PAD_BUTTON_SQUARE) && count > 0 && items[selected].system == SystemApp::None) {
+                        open_settings(selected);
+                        dirty = true;
+                    }
+                }
+                if (pending_open >= 0 || peeling || launching) {
+                } else if (pressed & ORBIS_PAD_BUTTON_TRIANGLE) {
+                    open_browser();
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_OPTIONS) {
+                    open_settings(-1);
+                    dirty = true;
+                }
+                break;
+
+            case Mode::LiveArea:
+                if (peeling || launching) {
+                } else if (pressed & ORBIS_PAD_BUTTON_CROSS) {
+                    // the gate opens: its picture grows into the game
+                    launching = true;
+                    launch_at = now;
+                } else if ((pressed & ORBIS_PAD_BUTTON_SQUARE) && live >= 0 && items[live].system == SystemApp::None) {
+                    open_settings(live);
+                } else if (pressed & ORBIS_PAD_BUTTON_CIRCLE) {
+                    show_card(0);
+                } else if (pressed & ORBIS_PAD_BUTTON_TRIANGLE) {
+                    // closed as on the Vita: peeled away from its top right corner
+                    peeling = true;
+                    peel_at = now;
+                } else if ((pressed & ORBIS_PAD_BUTTON_L1) || dx < 0) {
+                    show_card(card - 1);
+                } else if ((pressed & ORBIS_PAD_BUTTON_R1) || dx > 0) {
+                    show_card(card + 1);
+                }
+                dirty = true;
+                break;
+
+            case Mode::Settings: {
+                SettingsLevel &level = settings.stack.back();
+                const auto &list = *level.items;
+                const SItem *item = level.selected < static_cast<int>(list.size()) ? &list[level.selected] : nullptr;
+                const auto open_page = [&](const SItem &page) {
+                    settings.stack.push_back({ &page.items, page.name, 0, 0 });
+                    if (!page.items.empty() && !settings_selectable(page.items[0]))
+                        settings_move(settings.stack.back(), 1);
+                };
+                const auto back = [&] {
+                    if (settings.stack.size() > 1) {
+                        settings.stack.pop_back();
+                    } else {
+                        mode = settings_return;
+                        // the home screen's style may have changed
+                        tiles = make_tiles(items);
+                        art.clear();
+                        if (mode == Mode::LiveArea)
+                            card_pictures.clear();
+                    }
+                };
+                if (dy != 0) {
+                    settings_move(level, dy);
+                } else if (dx != 0 && item) {
+                    if (item->type == SItem::kind::choice)
+                        settings_change(*item, dx);
+                    else if (item->type == SItem::kind::page && dx > 0)
+                        open_page(*item);
+                    else if (dx < 0)
+                        back();
+                } else if ((pressed & ORBIS_PAD_BUTTON_CROSS) && item) {
+                    if (item->type == SItem::kind::choice)
+                        settings_change(*item, 1);
+                    else if (item->type == SItem::kind::page)
+                        open_page(*item);
+                    else if (item->type == SItem::kind::action && item->run)
+                        item->run();
+                } else if (pressed & ORBIS_PAD_BUTTON_CIRCLE) {
+                    back();
+                }
+                if (dx != 0 || dy != 0 || (pressed & (ORBIS_PAD_BUTTON_CROSS | ORBIS_PAD_BUTTON_CIRCLE)))
+                    dirty = true;
+                if (quit_requested)
+                    return Choice{ true, {}, {} };
+                if (about_requested) {
+                    about_requested = false;
+                    mode = Mode::About;
+                }
+                if (firmware_requested) {
+                    firmware_requested = false;
+                    mode = Mode::Home;
+                    start_firmware();
+                    dirty = true;
+                }
+                if (downloads_requested) {
+                    downloads_requested = false;
+                    mode = Mode::Home;
+                    start_downloads();
+                    dirty = true;
+                }
+                if (cancel_downloads_requested) {
+                    cancel_downloads_requested = false;
+                    for (const ps4bgdl::Download &d : ps4bgdl::list(emuenv.vita_fs_path))
+                        ps4bgdl::remove(d);
+                    ps4bgdl::set_stopped(emuenv.vita_fs_path, false);
+                    mode = Mode::Home;
+                    notice = "PKGj's downloads cancelled";
+                    notice_until = now + std::chrono::seconds(8);
+                    dirty = true;
+                }
+                break;
+            }
+
+            case Mode::About:
+                if (pressed & (ORBIS_PAD_BUTTON_CIRCLE | ORBIS_PAD_BUTTON_CROSS))
+                    mode = Mode::Settings;
+                dirty |= pressed != 0;
+                break;
+
+            case Mode::Trophies: {
+                // the games, Cross a game's trophies, Circle back
+                const int count = trophies.game < 0 ? static_cast<int>(trophies.games.size()) : static_cast<int>(trophies.games[trophies.game].trophies.size());
+                const int rows = TROPHY_H / (trophies.game < 0 ? TROPHY_GAME_ROW : TROPHY_ROW);
+                if (dy != 0 && count > 0)
+                    trophies.selected = std::clamp(trophies.selected + dy, 0, count - 1);
+                if ((pressed & (ORBIS_PAD_BUTTON_L1 | ORBIS_PAD_BUTTON_R1)) && count > 0)
+                    trophies.selected = std::clamp(trophies.selected + ((pressed & ORBIS_PAD_BUTTON_L1) ? -rows : rows), 0, count - 1);
+                if ((pressed & ORBIS_PAD_BUTTON_CROSS) && trophies.game < 0 && count > 0) {
+                    trophies.game = trophies.selected;
+                    trophies.selected = trophies.top = 0;
+                } else if (pressed & ORBIS_PAD_BUTTON_CIRCLE) {
+                    if (trophies.game >= 0) {
+                        trophies.selected = trophies.game;
+                        trophies.top = 0;
+                        trophies.game = -1;
+                    } else {
+                        mode = trophies_return;
+                    }
+                }
+                dirty |= dy != 0 || pressed != 0;
+                break;
+            }
+
+            case Mode::Browser: {
+                const int count = static_cast<int>(entries.size());
+                if (dy != 0 && count > 0) {
+                    browse_selected = std::clamp(browse_selected + dy, 0, count - 1);
+                    dirty = true;
+                }
+                if ((pressed & (ORBIS_PAD_BUTTON_L1 | ORBIS_PAD_BUTTON_R1)) && count > 0) {
+                    browse_selected = std::clamp(browse_selected + ((pressed & ORBIS_PAD_BUTTON_L1) ? -BROWSER_ROWS : BROWSER_ROWS), 0, count - 1);
+                    dirty = true;
+                }
+                if ((pressed & ORBIS_PAD_BUTTON_CROSS) && !entries.empty()) {
+                    const Entry e = entries[browse_selected];
+                    if (installable(e.kind))
+                        start_install({ e }, e.path.parent_path() == fs::path(install_dir()));
+                    else
+                        open_dir(e.path);
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_SQUARE) {
+                    std::vector<Entry> all;
+                    std::copy_if(entries.begin(), entries.end(), std::back_inserter(all), [](const Entry &e) { return installable(e.kind); });
+                    if (!all.empty()) {
+                        start_install(std::move(all), browse_dir == fs::path(install_dir()));
+                        dirty = true;
+                    }
+                } else if (pressed & ORBIS_PAD_BUTTON_CIRCLE) {
+                    if (browse_dir.empty()) {
+                        mode = Mode::Home;
+                    } else {
+                        // up a folder (from a location: to the locations), on the folder it came from
+                        const fs::path from = browse_dir;
+                        open_dir(is_location(from) ? fs::path() : from.parent_path());
+                        for (size_t i = 0; i < entries.size(); i++) {
+                            if (entries[i].path == from)
+                                browse_selected = static_cast<int>(i);
+                        }
+                    }
+                    dirty = true;
+                } else if (pressed & ORBIS_PAD_BUTTON_TRIANGLE) {
+                    mode = Mode::Home;
+                    dirty = true;
+                }
+                break;
+            }
+            }
+        }
+        if (!notice.empty() && now >= notice_until) {
+            notice.clear();
+            dirty = true;
+        }
+        if (const std::string time = clock_text(); time != shown_clock) {
+            shown_clock = time;
+            dirty = true;
+        }
+
+        // a pressed bubble opens
+        if (pending_open >= 0 && now >= pending_at) {
+            const Tile t = tiles[pending_open];
+            pending_open = -1;
+            if (t.kind == TileKind::Henkaku)
+                open_settings(-1);
+            else if (t.kind == TileKind::Install)
+                open_browser();
+            else
+                open_livearea(t.item);
+            dirty = true;
+        }
+
+        // the animations, a step for the time since the last frame
+        const float dt = std::min(0.05f, std::chrono::duration<float>(now - last_frame).count());
+        last_frame = now;
+        const bool vita_home = prefs.bubbles && (mode == Mode::Home || mode == Mode::LiveArea);
+        bool animating = false;
+        if (vita_home) {
+            if (update_wallpaper(now)) {
+                dirty = true;
+                if (!ps4settings::prefs().moving_wallpaper)
+                    card_pictures.clear(); // (LiveAreas without a picture show the wallpaper)
+            }
+            animating |= prefs.moving_wallpaper && mode == Mode::Home && card_pos.pos < 0.5f && !job.running;
+            animating |= home_animate(home, static_cast<int>(tiles.size()), mode == Mode::Home ? tile : -1, dt, now);
+            card_pos.step(static_cast<float>(card), dt, 210.f, 0.86f);
+            animating |= card_pos.moving(static_cast<float>(card)) || peeling || launching || pending_open >= 0;
+        }
+
+        if (dirty || animating) {
+            std::vector<Hint> hints;
+            switch (mode) {
+            case Mode::Home:
+            case Mode::LiveArea:
+                if (prefs.bubbles) {
+                    if (peeling) {
+                        // what's under the card shows as it goes
+                        const int under = card - 1;
+                        if (under == 0)
+                            draw_home(canvas, home, tiles, tile_art_fn, 0, now);
+                        else
+                            canvas.copy_from(card_picture(under));
+                        const float t = std::min(1.f, ms_since(peel_at, now) / 520.f);
+                        peel(canvas, card_picture(card), t * t * (W + H + 40.f));
+                        if (t >= 1.f) {
+                            peeling = false;
+                            card_pictures.erase(cards[card - 1]);
+                            cards.erase(cards.begin() + (card - 1));
+                            show_card(under);
+                            card_pos.pos = static_cast<float>(card);
+                            card_pos.vel = 0;
+                        }
+                    } else {
+                        const float pos = card_pos.pos;
+                        for (int k = static_cast<int>(std::floor(pos)); k <= static_cast<int>(std::floor(pos)) + 1; k++) {
+                            if (k < 0 || k > static_cast<int>(cards.size()))
+                                continue;
+                            const int ox = static_cast<int>(std::lround((k - pos) * W));
+                            if (std::abs(ox) >= W)
+                                continue;
+                            if (k == 0)
+                                draw_home(canvas, home, tiles, tile_art_fn, ox, now);
+                            else
+                                canvas.copy_from(card_picture(k), ox);
+                        }
+                    }
+                    if (launching && live >= 0) {
+                        const float t = std::min(1.f, ms_since(launch_at, now) / 380.f);
+                        const float e = smoothstep(0.f, 1.f, t);
+                        const Item &item = items[live];
+                        const ps4ui::Image &picture = !item.livearea_gate.empty() ? item.livearea_gate : item.large;
+                        const LiveRect gate = gate_rect(item);
+                        canvas.blit_scaled(picture, gate.x + gate.w / 2.f, gate.y + gate.h / 2.f, 1.f + 2.4f * e);
+                        canvas.fill_rect(0, 0, W, H, rgb(0x000000, static_cast<uint8_t>(255 * e)));
+                        if (t >= 1.f) {
+                            launching = false;
+                            if (items[live].system != SystemApp::None)
+                                open_system(items[live]);
+                            else if (auto choice = start_game(live))
+                                return *choice;
+                        }
+                    }
+                    std::vector<const ps4ui::Image *> minis;
+                    for (const std::string &path : cards) {
+                        const int item = find_item(path);
+                        minis.push_back(item >= 0 ? &tile_art(item + 2).mini : &henkaku_bar);
+                    }
+                    status_bar(canvas, fw, minis, card_pos.pos);
+                    // (as on the Vita: no button hints on the home screen or a LiveArea)
+                    draw_notice(canvas, notice);
+                    if (job.running)
+                        draw_install(canvas, job);
+                    present(canvas);
+                    dirty = false;
+                    if (!animating) {
+                        // the bubbles of this page and the ones next to it, made while nothing moves
+                        const int count = static_cast<int>(tiles.size());
+                        const int first = std::max(0, (home.page - 1) * PER_PAGE), last = std::min(count, (home.page + 2) * PER_PAGE);
+                        for (int i = first; i < last; i++) {
+                            if (!art.count(i)) {
+                                tile_art(i);
+                                break;
+                            }
+                        }
+                        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+                    }
+                    continue;
+                } else {
+                    // Vita3K's list, as it was
+                    if (selected < top)
+                        top = selected;
+                    if (selected >= top + VISIBLE_ROWS)
+                        top = selected - VISIBLE_ROWS + 1;
+                    background(canvas);
+                    header(canvas, fw);
+                    draw_list(canvas, items, selected, top);
+                    if (!items.empty()) {
+                        hints.push_back({ Pad::Cross, items[selected].system != SystemApp::None ? "Open" : "Start" });
+                        if (items[selected].system == SystemApp::None)
+                            hints.push_back({ Pad::Square, "Game settings" });
+                    }
+                    hints.push_back({ Pad::Triangle, "Install games" });
+                    hints.push_back({ Pad::Options, "HENkaku" });
+                }
+                break;
+            case Mode::Settings: {
+                draw_settings(canvas, settings, henkaku_heading);
+                const SettingsLevel &level = settings.stack.back();
+                const SItem *item = level.selected < static_cast<int>(level.items->size()) ? &(*level.items)[level.selected] : nullptr;
+                if (item && item->type == SItem::kind::choice) {
+                    hints.push_back({ Pad::DPad, "Change" });
+                    hints.push_back({ Pad::Cross, "Next value" });
+                } else if (item && item->type == SItem::kind::page) {
+                    hints.push_back({ Pad::Cross, "Open" });
+                } else if (item && item->type == SItem::kind::action) {
+                    hints.push_back({ Pad::Cross, "Do it" });
+                }
+                hints.push_back({ Pad::Circle, "Back" });
+                break;
+            }
+            case Mode::About:
+                draw_about(canvas, henkaku_about);
+                hints.push_back({ Pad::Circle, "Back" });
+                break;
+            case Mode::Trophies:
+                draw_trophies(canvas, trophies, trophies_icon);
+                if (trophies.game < 0 && !trophies.games.empty())
+                    hints.push_back({ Pad::Cross, "Trophies" });
+                hints.push_back({ Pad::Circle, "Back" });
+                break;
+            case Mode::Browser:
+                if (browse_selected < browse_top)
+                    browse_top = browse_selected;
+                if (browse_selected >= browse_top + BROWSER_ROWS)
+                    browse_top = browse_selected - BROWSER_ROWS + 1;
+                background(canvas);
+                header(canvas, fw);
+                draw_browser(canvas, browse_dir, entries, browse_selected, browse_top);
+                if (!entries.empty())
+                    hints.push_back({ Pad::Cross, installable(entries[browse_selected].kind) ? "Install" : "Open" });
+                if (std::any_of(entries.begin(), entries.end(), [](const Entry &e) { return installable(e.kind); }))
+                    hints.push_back({ Pad::Square, "Install all here" });
+                hints.push_back({ Pad::Circle, "Back" });
+                break;
+            }
+            draw_notice(canvas, notice);
+            footer(canvas, hints);
+            if (job.running)
+                draw_install(canvas, job);
+            present(canvas);
+            dirty = false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    }
+}
+
+} // namespace ps4launcher
