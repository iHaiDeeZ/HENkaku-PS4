+// A picture as the wallpaper: copied to wallpaper_dir() first when it's elsewhere (a USB drive,
+// the PS4's screenshots), so it stays when that's gone
+void use_wallpaper(const fs::path &picture) {
+    const fs::path dir = wallpaper_dir();
+    const fs::path target = dir / picture.filename();
+    boost::system::error_code ec;
+    if (picture.parent_path() != dir) {
+        fs::create_directories(dir, ec);
+        fs::copy_file(picture, target, fs::copy_options::overwrite_existing, ec);
+        if (ec) {
+            LOG_WARN("PS4: couldn't copy {} to {}: {}", picture.string(), target.string(), ec.message());
+            return;
+        }
+    }
+    const std::lock_guard<std::mutex> lock(settings_mutex);
+    g_prefs.wallpaper = picture.filename().string();
+    save_prefs();
+}
+
+Item picture_item(const fs::path &picture) {
+    Item item = action(picture.filename().string(), [picture] { use_wallpaper(picture); });
+    item.preview = picture.string();
+    item.checked = [file = picture.filename().string()] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return g_prefs.wallpaper == file;
+    };
+    return item;
+}
