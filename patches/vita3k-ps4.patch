+// PS4: the PS Vita shell's own pictures (its home screen's wave, page dots and status bar icons, the
+// LiveArea's button), read from the firmware the user installed: vs0:vsh/shell/*.rco, CXML resource
+// files whose file table holds GIM images, each zlib-compressed. Nothing of Sony's ships with
+// HENkaku: without the firmware they're missing and the launcher draws its own.
+
+#pragma once
+
+#include "ps4_canvas.h"
+
+#include <string>
+
+namespace ps4shell {
+
+enum class Picture {
+    Wave, // the default theme's wave: white, its alpha a curtain under a curve (theme_plugin)
+    PageDot, // a home screen page's dot (topmenu_plugin)
+    Home, // the home screen's icon (applauncher_plugin)
+    Glow, // a soft light (applauncher_plugin)
+    Wifi, // the status bar's Wi-Fi at full strength (indicator_plugin)
