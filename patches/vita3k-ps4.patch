+// A tray with an arrow into it: the install bubble
+void install_glyph(Canvas &c, float x, float y, float r) {
+    const Color white = rgb(0xffffff);
+    const float s = r / 100.f;
+    c.line(x, y - 52 * s, x, y + 16 * s, 15 * s, white);
+    c.line(x - 34 * s, y - 16 * s, x, y + 20 * s, 15 * s, white);
+    c.line(x + 34 * s, y - 16 * s, x, y + 20 * s, 15 * s, white);
+    c.line(x - 54 * s, y + 18 * s, x - 54 * s, y + 52 * s, 13 * s, white);
+    c.line(x + 54 * s, y + 18 * s, x + 54 * s, y + 52 * s, 13 * s, white);
+    c.line(x - 54 * s, y + 52 * s, x + 54 * s, y + 52 * s, 13 * s, white);
+}
+
+// The home screen's glyph in the status bar: a small house
+void home_glyph(Canvas &c, float x, float y, Color color) {
+    c.line(x - 15, y - 1, x, y - 15, 4.5f, color);
+    c.line(x + 15, y - 1, x, y - 15, 4.5f, color);
+    c.fill_rect(static_cast<int>(x) - 10, static_cast<int>(y) - 2, 20, 15, color);
+}
+
+// A picture's colour at (x, y) between its pixels (its edge going on outside it), each 0..255
+void sample(const ps4ui::Image &image, float x, float y, float out[4]) {
+    const float cx = std::clamp(x, 0.f, image.width - 1.f), cy = std::clamp(y, 0.f, image.height - 1.f);
+    const int x0 = static_cast<int>(cx), y0 = static_cast<int>(cy);
+    const int x1 = std::min(x0 + 1, image.width - 1), y1 = std::min(y0 + 1, image.height - 1);
+    const float fx = cx - x0, fy = cy - y0;
+    const uint32_t p[4] = { image.pixels[static_cast<size_t>(y0) * image.width + x0], image.pixels[static_cast<size_t>(y0) * image.width + x1],
+        image.pixels[static_cast<size_t>(y1) * image.width + x0], image.pixels[static_cast<size_t>(y1) * image.width + x1] };
+    const float w[4] = { (1 - fx) * (1 - fy), fx * (1 - fy), (1 - fx) * fy, fx * fy };
+    for (int ch = 0; ch < 4; ch++) {
+        out[ch] = 0;
+        for (int i = 0; i < 4; i++)
+            out[ch] += w[i] * static_cast<float>((p[i] >> (8 * ch)) & 0xFF);
+    }
+}
+
+// A bubble as the Vita's: the icon covering a circle (it was smaller than the circle, which showed
+// round it), a thin light rim and a soft light around it. In 3D (HENkaku > Themes > Bubbles) it's
+// lit as a glass ball from the top left: shaded toward its lower edge, a gloss over its top and a
+// glint, light coming round its bottom, and a shadow under it. Premultiplied.
+ps4ui::Image make_bubble(const ps4ui::Image &icon, Color fill, bool lit) {
+    ps4ui::Image out;
+    out.width = out.height = SPRITE;
+    out.pixels.resize(static_cast<size_t>(SPRITE) * SPRITE);
+    const float c = SPRITE / 2.f, R = BUBBLE_R;
+    // the icon's pixels for one of the bubble's: its shorter side right across the circle
+    const float k = icon.empty() ? 0.f : std::min(icon.width, icon.height) / (2.f * R);
+    ps4ui::parallel_rows(0, SPRITE, static_cast<size_t>(SPRITE) * SPRITE, [&](int y_first, int y_last) {
+        for (int y = y_first; y < y_last; y++) {
+            for (int x = 0; x < SPRITE; x++) {
+                const float px = x + 0.5f - c, py = y + 0.5f - c;
+                const float d = std::sqrt(px * px + py * py);
+                const float cov = std::clamp(R - d + 0.5f, 0.f, 1.f);
+                float r = fill.r, g = fill.g, b = fill.b;
+                if (cov > 0) {
+                    if (!icon.empty()) {
+                        float p[4];
+                        sample(icon, icon.width / 2.f + px * k - 0.5f, icon.height / 2.f + py * k - 0.5f, p);
+                        const float a = p[3] / 255.f;
+                        r = r * (1 - a) + p[0] * a;
+                        g = g * (1 - a) + p[1] * a;
+                        b = b * (1 - a) + p[2] * a;
+                    }
+                    const float nx = px / R, ny = py / R, nd = d / R;
+                    if (lit) {
+                        const float nz = std::sqrt(std::max(0.f, 1.f - nx * nx - ny * ny));
+                        // the light from the top left, the edge darker
+                        const float diffuse = std::clamp(-0.42f * nx - 0.55f * ny + 0.72f * nz, 0.f, 1.f);
+                        const float shade = (0.80f + 0.26f * diffuse) * (1.f - 0.20f * smoothstep(0.70f, 1.f, nd));
+                        r = std::min(255.f, r * shade);
+                        g = std::min(255.f, g * shade);
+                        b = std::min(255.f, b * shade);
+                        // the gloss over its top, a glint, the light coming round its bottom, and the
+                        // rim: light along its top, darker along its bottom
+                        const float gx = nx / 0.80f, gy = (ny + 0.50f) / 0.44f;
+                        const float gloss = 0.30f * smoothstep(1.f, 0.15f, gx * gx + gy * gy) * smoothstep(0.15f, -0.55f, ny);
+                        const float hx = nx + 0.36f, hy = ny + 0.56f;
+                        const float glint = 0.55f * std::exp(-(hx * hx + hy * hy) / 0.006f);
+                        const float bounce = 0.16f * smoothstep(0.78f, 0.98f, nd) * smoothstep(0.2f, 0.9f, ny);
+                        const float rim = std::clamp(2.f - std::fabs(d - (R - 1.8f)), 0.f, 1.f);
+                        const float light = std::min(1.f, gloss + glint + bounce + rim * (0.40f + 0.45f * std::clamp(-ny, 0.f, 1.f)));
+                        r += (255 - r) * light;
+                        g += (255 - g) * light;
+                        b += (255 - b) * light;
+                        const float dark = rim * 0.30f * std::clamp(ny, 0.f, 1.f);
+                        r *= 1 - dark;
+                        g *= 1 - dark;
+                        b *= 1 - dark;
+                    } else {
+                        // its edge a little shaded, lit again just inside the rim (the glass), then the
+                        // rim: a light line along it
+                        const float shade = 0.14f * smoothstep(R * 0.74f, R * 0.94f, d);
+                        r *= 1 - shade;
+                        g *= 1 - shade;
+                        b *= 1 - shade;
+                        const float inner = 0.22f * smoothstep(R - 12.f, R - 2.f, d);
+                        r += (255 - r) * inner;
+                        g += (255 - g) * inner;
+                        b += (255 - b) * inner;
+                        const float rim = std::clamp(2.2f - std::fabs(d - (R - 2.0f)), 0.f, 1.f) * 0.78f;
+                        r += (255 - r) * rim;
+                        g += (255 - g) * rim;
+                        b += (255 - b) * rim;
+                    }
+                }
+                // around it: the light (white), and in 3D a shadow under it
+                const float out_d = std::max(0.f, d - R);
+                float halo = d > R - 1 ? 0.42f * std::exp(-out_d * out_d / 55.f) : 0.f;
+                float shadow = 0.f;
+                if (lit) {
+                    halo *= 0.65f;
+                    const float sd = std::max(0.f, std::hypot(px, py - 13.f) - (R - 4.f));
+                    shadow = 0.40f * std::exp(-sd * sd / 190.f);
+                }
+                // (premultiplied: the light white, its colour its alpha, over the black shadow, and the
+                // bubble over both)
+                const float around = halo + shadow * (1 - halo);
+                const float a = cov + around * (1 - cov);
+                const float light = 255.f * halo * (1 - cov);
+                out.pixels[static_cast<size_t>(y) * SPRITE + x] = static_cast<uint32_t>(std::min(255.f, r * cov + light) + 0.5f)
+                    | (static_cast<uint32_t>(std::min(255.f, g * cov + light) + 0.5f) << 8)
+                    | (static_cast<uint32_t>(std::min(255.f, b * cov + light) + 0.5f) << 16) | (static_cast<uint32_t>(a * 255 + 0.5f) << 24);
+            }
+        }
+    });
+    return out;
+}
+
+// The focus: a soft glow in the focus colour around a bubble, premultiplied (made again when the
+// colour changes)
+const ps4ui::Image &focus_glow(uint32_t accent) {
+    static ps4ui::Image img;
+    static uint32_t made_for = 0xFFFFFFFFu;
+    if (made_for != accent || img.empty()) {
+        made_for = accent;
+        img.width = img.height = SPRITE;
+        img.pixels.assign(static_cast<size_t>(SPRITE) * SPRITE, 0);
+        const float c = SPRITE / 2.f;
+        const uint32_t cr = (accent >> 16) & 0xFF, cg = (accent >> 8) & 0xFF, cb = accent & 0xFF;
+        for (int y = 0; y < SPRITE; y++) {
+            for (int x = 0; x < SPRITE; x++) {
+                const float d = std::hypot(x + 0.5f - c, y + 0.5f - c);
+                const float k = (d - (BUBBLE_R + 5)) / 7.f;
+                const float a = d < BUBBLE_R - 1 ? 0.f : std::exp(-k * k) * 0.95f;
+                const uint32_t A = static_cast<uint32_t>(a * 255);
+                img.pixels[static_cast<size_t>(y) * SPRITE + x] = (cr * A / 255) | ((cg * A / 255) << 8) | ((cb * A / 255) << 16) | (A << 24);
+            }
+        }
+    }
+    return img;
+}
