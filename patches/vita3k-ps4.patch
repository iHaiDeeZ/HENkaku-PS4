+bool is_picture(const fs::path &path) {
+    std::string ext = path.extension().string();
+    std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return std::tolower(c); });
+    return ext == ".png" || ext == ".jpg" || ext == ".jpeg";
+}
+
+// The pictures in a folder (and its subfolders, deep), the newest first, at most `most`
+std::vector<fs::path> pictures_in(const fs::path &dir, bool deep, size_t most) {
+    std::vector<std::pair<std::time_t, fs::path>> found;
+    boost::system::error_code ec;
+    if (!fs::is_directory(dir, ec))
+        return {};
+    const auto add = [&](const fs::path &p) {
+        boost::system::error_code e;
+        if (fs::is_regular_file(p, e) && is_picture(p))
+            found.emplace_back(fs::last_write_time(p, e), p);
+    };
+    if (deep) {
+        for (fs::recursive_directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+            add(it->path());
+    } else {
+        for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+            add(it->path());
+    }
+    std::sort(found.begin(), found.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+    std::vector<fs::path> paths;
+    for (size_t i = 0; i < found.size() && i < most; i++)
+        paths.push_back(found[i].second);
+    return paths;
+}
