+
+// --- the PS Vita's home screen: bubbles ---
+//
+// As on the Vita (960x544, here twice its size): pages of 10 bubbles in rows of 3, 4 and 3, the
+// rows across the whole screen, pages one under another with their dots down the right edge. A
+// game's bubble opens its LiveArea as a card to the right of the home screen; open cards stay
+// (their bubbles in the status bar) until peeled away from their top right corner. Drawn by the
+// CPU, so everything that moves is a sprite made once (bubble, label, focus glow) over a wallpaper
+// made once, and only what an animation needs is drawn again for each frame.
+
+constexpr int PER_PAGE = 10;
+constexpr float BUBBLE_R = 134.f;
+constexpr int SPRITE_PAD = 24; // room for the rim's glow and the focus glow
+constexpr int SPRITE = 2 * static_cast<int>(BUBBLE_R) + 2 * SPRITE_PAD;
+constexpr int ICON_SIZE = 2 * static_cast<int>(BUBBLE_R);
+constexpr float COLUMN = 460.f;
+constexpr int STATUS_H = 60;
+constexpr int MAX_CARDS = 5;
+
+struct Slot {
+    float x, y;
+    int row;
+};
+// the Vita's rows (its firmware's picture of the home screen, vs0:data/internal/theme, at 1080p)
+const float ROW_Y[3] = { 224.f, 538.f, 858.f };
+const Slot SLOTS[PER_PAGE] = {
+    { W / 2 - COLUMN, ROW_Y[0], 0 },
+    { W / 2.f, ROW_Y[0], 0 },
+    { W / 2 + COLUMN, ROW_Y[0], 0 },
+    { W / 2 - 1.5f * COLUMN, ROW_Y[1], 1 },
+    { W / 2 - 0.5f * COLUMN, ROW_Y[1], 1 },
+    { W / 2 + 0.5f * COLUMN, ROW_Y[1], 1 },
+    { W / 2 + 1.5f * COLUMN, ROW_Y[1], 1 },
+    { W / 2 - COLUMN, ROW_Y[2], 2 },
+    { W / 2.f, ROW_Y[2], 2 },
+    { W / 2 + COLUMN, ROW_Y[2], 2 },
+};
+
+// what a bubble opens: the HENkaku settings, the install browser, or a game (its LiveArea)
+enum class TileKind {
+    Henkaku,
+    Install,
+    Game,
+};
+
+struct Tile {
+    TileKind kind;
+    int item = -1;
+};
+
+// The system's bubbles first, as on a Vita, then the games
+std::vector<Tile> make_tiles(const std::vector<Item> &items) {
+    std::vector<Tile> tiles{ { TileKind::Henkaku }, { TileKind::Install } };
+    for (int i = 0; i < static_cast<int>(items.size()); i++)
+        tiles.push_back({ TileKind::Game, i });
+    return tiles;
+}
+
+// Where a direction leads from bubble `index`: left / right along the order, up / down to the
+// nearest bubble of the row above or below, across pages
+int bubble_step(int index, int count, int dx, int dy) {
+    if (count <= 0)
+        return 0;
+    if (dx != 0)
+        return std::clamp(index + dx, 0, count - 1);
+    const int page = index / PER_PAGE;
+    const int slot = index % PER_PAGE;
+    int target_page = page;
+    int target_row = SLOTS[slot].row + dy;
+    if (target_row < 0) {
+        if (page == 0)
+            return index;
+        target_page--;
+        target_row = 2;
+    } else if (target_row > 2) {
+        if ((page + 1) * PER_PAGE >= count)
+            return index;
+        target_page++;
+        target_row = 0;
+    }
+    int best = -1;
+    float best_distance = 1e9f;
+    for (int s = 0; s < PER_PAGE; s++) {
+        const int i = target_page * PER_PAGE + s;
+        if (SLOTS[s].row != target_row || i >= count)
+            continue;
+        const float distance = std::fabs(SLOTS[s].x - SLOTS[slot].x);
+        if (distance < best_distance) {
+            best_distance = distance;
+            best = i;
+        }
+    }
+    // a short last page: its last bubble
+    if (best < 0)
+        return dy > 0 && target_page * PER_PAGE < count ? count - 1 : index;
+    return best;
+}
+
+std::string tile_title(const Tile &tile, const std::vector<Item> &items) {
+    switch (tile.kind) {
+    case TileKind::Henkaku:
+        return "HENkaku";
+    case TileKind::Install:
+        return "Install";
+    case TileKind::Game:
+        return items[tile.item].entry.title;
+    }
+    return {};
+}
+
+float smoothstep(float e0, float e1, float x) {
+    const float t = std::clamp((x - e0) / (e1 - e0), 0.f, 1.f);
+    return t * t * (3 - 2 * t);
+}
+
+// The home screen's wallpaper: the theme's colours with a band of light waving across them (the
+// Vita's, in its blue), or a picture from /data/HENkaku/wallpapers. Made again only when the look
+// changes, or for each other frame while the wave moves (HENkaku > Look).
+struct Theme {
+    uint32_t top, bottom, light;
+};
+// in ps4settings::theme_names()'s order
+const Theme THEMES[] = {
+    { 0x123ab0, 0x2662e2, 0xffffff }, // PS Vita blue
+    { 0x06080f, 0x161d33, 0x7896dc }, // Midnight
+    { 0x7a2a5c, 0xe48cb4, 0xffebf5 }, // Sakura
+    { 0x08301f, 0x2a8250, 0xdcffe6 }, // Forest
+    { 0x46145a, 0xf07a3c, 0xffe6c8 }, // Sunset
+    { 0x18181a, 0x3c3c42, 0xc8c8d2 }, // Carbon
+};
+
+struct Wallpaper {
+    std::string key; // the look it was made for
+    Canvas base{ W, H }; // the theme's colours, without the light
+    Canvas out{ W, H };
+    bool wave = true;
+    // the PS Vita's own default theme (its wave from the firmware)
+    bool vita = false;
+    float phase = -1.f;
+    std::vector<uint8_t> wide, thin; // the two bands' light by distance from their middle
+    std::vector<int> wide_y, thin_y; // their middles, by column
+    Clock::time_point made{};
+};
+
+Wallpaper &wallpaper_state() {
+    static Wallpaper w;
+    return w;
+}
+
+const Theme &current_theme() {
+    const int theme = ps4settings::prefs().theme;
+    return THEMES[std::clamp(theme, 0, static_cast<int>(std::size(THEMES)) - 1)];
+}
+
+void wave_light(Wallpaper &w, float phase) {
+    const Theme &theme = current_theme();
+    const int tr = (theme.light >> 16) & 0xFF, tg = (theme.light >> 8) & 0xFF, tb = theme.light & 0xFF;
+    for (int x = 0; x < W; x++) {
+        const float fx = static_cast<float>(x) / W;
+        const float wave = H * 0.60f + 70.f * std::sin(fx * 5.2f + 0.7f + phase) - 150.f * fx;
+        w.wide_y[x] = static_cast<int>(wave);
+        w.thin_y[x] = static_cast<int>(wave - 46.f + 30.f * std::sin(fx * 8.1f + 2.1f + phase * 1.7f));
+    }
+    const int wide_r = static_cast<int>(w.wide.size() / 2), thin_r = static_cast<int>(w.thin.size() / 2);
+    for (int y = 0; y < H; y++) {
+        const uint32_t *src = w.base.data() + static_cast<size_t>(y) * W;
+        uint32_t *dst = w.out.data() + static_cast<size_t>(y) * W;
+        for (int x = 0; x < W; x++) {
+            const int d1 = y - w.wide_y[x] + wide_r, d2 = y - w.thin_y[x] + thin_r;
+            uint32_t light = (d1 >= 0 && d1 < 2 * wide_r ? w.wide[d1] : 0) + (d2 >= 0 && d2 < 2 * thin_r ? w.thin[d2] : 0);
+            const uint32_t p = src[x];
+            if (light == 0) {
+                dst[x] = p;
+                continue;
+            }
+            light = std::min(light, 255u);
+            const int r = p & 0xFF, g = (p >> 8) & 0xFF, b = (p >> 16) & 0xFF;
+            dst[x] = static_cast<uint32_t>(r + (((tr - r) * static_cast<int>(light)) >> 8)) | (static_cast<uint32_t>(g + (((tg - g) * static_cast<int>(light)) >> 8)) << 8)
+                | (static_cast<uint32_t>(b + (((tb - b) * static_cast<int>(light)) >> 8)) << 16) | 0xFF000000u;
+        }
+    }
+    w.phase = phase;
+}
+
+// The PS Vita's default theme as its home screen shows it, fitted to the firmware's picture of it
+// (vs0:data/internal/theme): a blue lighter at the top and toward the bottom, and the theme's own wave
+// (vs0:vsh/shell/theme_plugin.rco: white, its alpha a curtain under a curve) three times over it,
+// mirrored, drifting when the wallpaper moves
+const float VITA_STOPS[9] = { 0.06f, 0.18f, 0.32f, 0.46f, 0.58f, 0.70f, 0.80f, 0.90f, 1.0f };
+const float VITA_COLORS[9][3] = { { 0.000f, 0.452f, 0.882f }, { 0.000f, 0.464f, 0.882f }, { 0.000f, 0.378f, 0.877f },
+    { 0.017f, 0.135f, 0.925f }, { 0.265f, 0.448f, 1.000f }, { 0.568f, 0.735f, 1.000f }, { 0.785f, 0.918f, 1.000f },
+    { 0.774f, 0.926f, 1.000f }, { 0.102f, 0.525f, 0.991f } };
+struct VitaWave {
+    float x0, y0, w, h, opacity; // where on the screen (fractions of it), how strong
+};
+const VitaWave VITA_WAVES[3] = {
+    { -0.184f, 0.939f, 1.244f, 0.460f, 0.557f },
+    { -0.060f, 0.753f, 1.252f, 0.603f, 0.374f },
+    { -0.381f, 0.298f, 1.441f, 0.312f, 0.069f },
+};
+
+void vita_gradient(Canvas &base) {
+    uint32_t *p = base.data();
+    for (int y = 0; y < H; y++) {
+        const float fy = (y + 0.5f) / H;
+        int k = 0;
+        while (k < 8 && fy > VITA_STOPS[k + 1])
+            k++;
+        const float t = std::clamp((fy - VITA_STOPS[k]) / (VITA_STOPS[k + 1] - VITA_STOPS[k]), 0.f, 1.f);
+        uint32_t px = 0xFF000000u;
+        for (int ch = 0; ch < 3; ch++) {
+            const float v = VITA_COLORS[k][ch] + (VITA_COLORS[k + 1][ch] - VITA_COLORS[k][ch]) * t;
+            px |= static_cast<uint32_t>(std::clamp(v, 0.f, 1.f) * 255.f + 0.5f) << (8 * ch);
+        }
+        std::fill_n(p + static_cast<size_t>(y) * W, W, px);
+    }
+}
+
+void vita_waves(Wallpaper &w, const ps4ui::Image &wave, float phase) {
+    std::memcpy(w.out.data(), w.base.data(), static_cast<size_t>(W) * H * 4);
+    std::vector<int> column(W);
+    for (int i = 0; i < 3; i++) {
+        const VitaWave &v = VITA_WAVES[i];
+        // (drifting: back and forth, each at its own pace, never far enough to show its end)
+        const float x0 = v.x0 + 0.05f * std::sin(phase * (0.8f + 0.3f * i) + 1.7f * i) - 0.05f;
+        for (int x = 0; x < W; x++) {
+            const float u = 1.f - ((x + 0.5f) / W - x0) / v.w; // mirrored
+            column[x] = std::clamp(static_cast<int>(u * wave.width), 0, wave.width - 1);
+        }
+        const uint32_t opacity = static_cast<uint32_t>(v.opacity * 256.f);
+        const int top = std::max(0, static_cast<int>(v.y0 * H));
+        for (int y = top; y < H; y++) {
+            // (below the picture its last row goes on)
+            const int row = std::min(wave.height - 1, static_cast<int>(((y + 0.5f) / H - v.y0) / v.h * wave.height));
+            const uint32_t *src = wave.pixels.data() + static_cast<size_t>(row) * wave.width;
+            uint32_t *dst = w.out.data() + static_cast<size_t>(y) * W;
+            for (int x = 0; x < W; x++) {
+                const uint32_t a = ((src[column[x]] >> 24) * opacity) >> 8;
+                if (a == 0)
+                    continue;
+                const uint32_t p = dst[x];
+                const uint32_t r = p & 0xFF, g = (p >> 8) & 0xFF, b = (p >> 16) & 0xFF;
+                dst[x] = (r + (((255 - r) * a) >> 8)) | ((g + (((255 - g) * a) >> 8)) << 8) | ((b + (((255 - b) * a) >> 8)) << 16) | 0xFF000000u;
+            }
+        }
+    }
+    w.phase = phase;
+}
+
+// Brings the wallpaper up to date; whether it changed
+bool update_wallpaper(Clock::time_point now) {
+    Wallpaper &w = wallpaper_state();
+    const ps4settings::Prefs &prefs = ps4settings::prefs();
+    const std::string key = std::to_string(prefs.theme) + "|" + prefs.wallpaper;
+    if (key != w.key) {
+        w.key = key;
+        w.phase = -1.f;
+        w.wave = true;
+        if (!prefs.wallpaper.empty()) {
+            // a picture, covering the screen
+            ps4ui::Image picture = ps4ui::load_image(ps4settings::wallpaper_dir() + "/" + prefs.wallpaper);
+            if (!picture.empty()) {
+                for (uint32_t &px : picture.pixels)
+                    px |= 0xFF000000u;
+                w.out.clear_gradient(rgb(0), rgb(0));
+                const float scale = std::max(static_cast<float>(W) / picture.width, static_cast<float>(H) / picture.height);
+                w.out.blit_scaled(picture, W / 2.f, H / 2.f, scale);
+                w.wave = false;
+            }
+        }
+        const ps4ui::Image *vita_wave = ps4shell::picture(ps4shell::Picture::Wave);
+        w.vita = w.wave && prefs.theme == 0 && vita_wave;
+        if (w.vita) {
+            vita_gradient(w.base);
+            vita_waves(w, *vita_wave, 0.f);
+        } else if (w.wave) {
+            const Theme &theme = current_theme();
+            const Color top = rgb(theme.top), bottom = rgb(theme.bottom);
+            uint32_t *p = w.base.data();
+            for (int y = 0; y < H; y++) {
+                const float fy = static_cast<float>(y) / H;
+                for (int x = 0; x < W; x++) {
+                    const float fx = static_cast<float>(x) / W;
+                    // darker at the top corners
+                    const float v = 1.f - 0.28f * (1.f - fy) * (std::fabs(fx - 0.5f) * 2.f);
+                    const float r = (top.r + (bottom.r - top.r) * fy) * v, g = (top.g + (bottom.g - top.g) * fy) * v, b = (top.b + (bottom.b - top.b) * fy) * v;
+                    p[static_cast<size_t>(y) * W + x] = static_cast<uint32_t>(r) | (static_cast<uint32_t>(g) << 8) | (static_cast<uint32_t>(b) << 16) | 0xFF000000u;
+                }
+            }
+            w.wide.resize(2 * 360);
+            for (int i = 0; i < 720; i++) {
+                const float d = (i - 360) / 120.f;
+                w.wide[i] = static_cast<uint8_t>(0.62f * 255.f * std::exp(-d * d));
+            }
+            w.thin.resize(2 * 66);
+            for (int i = 0; i < 132; i++) {
+                const float d = (i - 66) / 22.f;
+                w.thin[i] = static_cast<uint8_t>(0.30f * 255.f * std::exp(-d * d));
+            }
+            w.wide_y.resize(W);
+            w.thin_y.resize(W);
+            wave_light(w, 0.f);
+        }
+        w.made = now;
+        return true;
+    }
+    // the wave moving: about a turn a minute, made again 30 times a second
+    if (w.wave && prefs.moving_wallpaper && now - w.made >= std::chrono::milliseconds(33)) {
+        static const Clock::time_point start = now;
+        const float phase = std::chrono::duration<float>(now - start).count() * 0.11f;
+        if (w.vita)
+            vita_waves(w, *ps4shell::picture(ps4shell::Picture::Wave), phase);
+        else
+            wave_light(w, phase);
+        w.made = now;
+        return true;
+    }
+    return false;
+}
+
+const Canvas &vita_wallpaper() {
+    Wallpaper &w = wallpaper_state();
+    if (w.key.empty())
+        update_wallpaper(Clock::now());
+    return w.out;
+}
