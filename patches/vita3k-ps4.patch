+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the controls (HENkaku > Controls, a game's own Controls, and Controls in the quick menu).
+// Each DualShock 4 button gives a Vita button, a PS TV button, a touch at one of nine places of the
+// front screen or of the rear touch pad, or nothing; the DS4's touch pad is the front screen, the
+// rear pad, both (left half and right half) or nothing. All games share one set, and a game can
+// have its own (/data/HENkaku/controls/all.cfg and <app>.cfg).
+
+#pragma once
+
+#include <overlay/pause_overlay.h>
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ps4controls {
+
+// The DS4's buttons, in the menus' order
+enum PadButton : uint8_t {
+    PadCross,
+    PadCircle,
+    PadSquare,
+    PadTriangle,
+    PadUp,
+    PadDown,
+    PadLeft,
+    PadRight,
+    PadL1,
+    PadR1,
+    PadL2,
+    PadR2,
+    PadL3,
+    PadR3,
+    PadOptions,
+    PadTouchClick,
+    PadButtonCount
+};
+
+// What a button gives
+enum Action : uint8_t {
+    ActNone,
+    ActCross,
+    ActCircle,
+    ActSquare,
+    ActTriangle,
+    ActUp,
+    ActDown,
+    ActLeft,
+    ActRight,
+    ActL,
+    ActR,
+    ActStart,
+    ActSelect,
+    ActL2, // the PS TV's
+    ActR2,
+    ActL3,
+    ActR3,
+    ActFrontTouch, // + one of the nine places
+    ActBackTouch = ActFrontTouch + 9,
+    ActionCount = ActBackTouch + 9
+};
+
+// The DS4's touch pad
+enum TouchpadUse : uint8_t {
+    TouchpadFront,
+    TouchpadBack,
+    TouchpadSplit, // left half the front screen, right half the rear pad
+    TouchpadOff,
+    TouchpadUseCount
+};
+
+// The sticks' range (ps4_pad.cpp: to_square)
+enum SticksRange : uint8_t {
+    SticksSquare, // a full diagonal full on both axes, as on a PS2's or PS3's pad
+    SticksRound, // as the DualShock 4 gives them
+    SticksRangeCount
+};
+
+struct Controls {
+    uint8_t button[PadButtonCount];
+    uint8_t touchpad = TouchpadFront;
+    uint8_t sticks = SticksSquare;
+};
+
+// The DS4 button's ORBIS_PAD_BUTTON_* bit
+uint32_t pad_bit(PadButton button);
+// The nine places, in tenths of the panel (x, y)
+void touch_place(int place, float &x, float &y);
+
+// HENkaku's own: the PS4 layout as on a PS TV
+Controls defaults();
+// The controls a game plays with (its own, else all games'), and those of all games
+Controls effective(const std::string &app_path);
+// Which game's controls the pad uses now ("" while no game runs), read again after each change
+void set_running_app(const std::string &app_path);
+Controls running();
+
+// The Controls page: for app_path "" all games', else that game's (with the choice of its own set)
+std::vector<overlay::pause_menu_item> items(const std::string &app_path);
+
+} // namespace ps4controls
