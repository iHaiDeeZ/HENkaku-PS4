+Item fsr_sharpness(EmuEnvState &emuenv) {
+    return pref_choice("FSR sharpness", { "Sharpest", "Sharp", "Medium", "Soft", "Softest" },
+        [](const Prefs &p) { return p.fsr_sharpness; },
+        [&emuenv](Prefs &p, int value) {
+            p.fsr_sharpness = value;
+            if (emuenv.renderer)
+                emuenv.renderer->fsr_sharpening = fsr_sharpening(value);
+        });
+}
