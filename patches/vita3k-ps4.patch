+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#pragma once
+
+// PS4: the PS4's GPU (GCN 2) fetches a vertex attribute wrong when its address isn't aligned to its
+// components, which Vulkan doesn't allow but the Vita does: God of War II keeps 19 byte vertices with
+// half floats at offsets 3 and 11, which came out as spikes and blocks for letters. A stream with a
+// stride or an attribute offset that isn't a multiple of 4 is repacked when it is uploaded: each
+// attribute in a slot of its own, 4 byte aligned, in the order of the program's attributes. The
+// pipeline's vertex input takes the same layout.
+
+#include <gxm/functions.h>
+#include <renderer/gxm_types.h>
+#include <renderer/types.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace renderer::vulkan::ps4 {
+
+inline uint32_t attribute_bytes(const SceGxmVertexAttribute &attribute) {
+    return gxm::attribute_format_size(static_cast<SceGxmAttributeFormat>(attribute.format)) * attribute.componentCount;
+}
+
+inline uint32_t slot_bytes(const SceGxmVertexAttribute &attribute) {
+    return (attribute_bytes(attribute) + 3) & ~3u;
+}
+
+// Whether a stream is repacked: its stride or one of its attributes isn't 4 byte aligned (a
+// stream with an attribute the shader reads as raw registers is left as it is)
+inline bool stream_repacked(const SceGxmVertexProgram &program, uint32_t stream_index) {
+    if (stream_index >= program.streams.size())
+        return false;
+    bool misaligned = program.streams[stream_index].stride % 4 != 0;
+    const auto &infos = program.renderer_data->attribute_infos;
+    for (const SceGxmVertexAttribute &attribute : program.attributes) {
+        if (attribute.streamIndex != stream_index)
+            continue;
+        const auto info = infos.find(attribute.regIndex);
+        if (info != infos.end() && info->second.regformat)
+            return false;
+        if (attribute.offset % 4 != 0)
+            misaligned = true;
+    }
+    return misaligned;
+}
+
+// Where the attribute at attribute_index goes in its repacked vertex
+inline uint32_t repacked_offset(const SceGxmVertexProgram &program, size_t attribute_index) {
+    const uint32_t stream_index = program.attributes[attribute_index].streamIndex;
+    uint32_t offset = 0;
+    for (size_t i = 0; i < attribute_index; i++)
+        if (program.attributes[i].streamIndex == stream_index)
+            offset += slot_bytes(program.attributes[i]);
+    return offset;
+}
+
+// The size of a repacked vertex
+inline uint32_t repacked_vertex_size(const SceGxmVertexProgram &program, uint32_t stream_index) {
+    uint32_t size = 0;
+    for (const SceGxmVertexAttribute &attribute : program.attributes)
+        if (attribute.streamIndex == stream_index)
+            size += slot_bytes(attribute);
+    return size;
+}
+
+// The repacked stride (0 stays 0: every vertex reads the same attributes)
+inline uint32_t repacked_stride(const SceGxmVertexProgram &program, uint32_t stream_index) {
+    return program.streams[stream_index].stride == 0 ? 0 : repacked_vertex_size(program, stream_index);
+}
+
+// Repacks the size bytes of a stream at data into out
+inline void repack_stream(const SceGxmVertexProgram &program, uint32_t stream_index, const uint8_t *data, size_t size, std::vector<uint8_t> &out) {
+    const uint32_t stride = program.streams[stream_index].stride;
+    const uint32_t vertex_size = repacked_vertex_size(program, stream_index);
+    const size_t count = stride ? (size + stride - 1) / stride : 1;
+
+    struct Move {
+        uint32_t from, to, bytes;
+    };
+    std::vector<Move> moves;
+    for (size_t i = 0; i < program.attributes.size(); i++)
+        if (program.attributes[i].streamIndex == stream_index)
+            moves.push_back({ program.attributes[i].offset, repacked_offset(program, i), attribute_bytes(program.attributes[i]) });
+
+    // (room past the end: a 3 component attribute read as 4 components; the slots' padding is
+    // never read, so nothing is cleared)
+    out.resize(count * vertex_size + 16);
+    for (const Move &move : moves) {
+        // the vertices whose attribute is whole in the data, then the one cut short
+        const size_t whole = move.from + move.bytes > size ? 0 : (stride ? std::min<size_t>(count, (size - move.from - move.bytes) / stride + 1) : 1);
+        const uint8_t *source = data + move.from;
+        uint8_t *destination = out.data() + move.to;
+        const auto copy_all = [&]<size_t N>() {
+            for (size_t vertex = 0; vertex < whole; vertex++, source += stride, destination += vertex_size)
+                std::memcpy(destination, source, N);
+        };
+        switch (move.bytes) {
+        case 2: copy_all.template operator()<2>(); break;
+        case 3: copy_all.template operator()<3>(); break;
+        case 4: copy_all.template operator()<4>(); break;
+        case 6: copy_all.template operator()<6>(); break;
+        case 8: copy_all.template operator()<8>(); break;
+        case 12: copy_all.template operator()<12>(); break;
+        case 16: copy_all.template operator()<16>(); break;
+        default:
+            for (size_t vertex = 0; vertex < whole; vertex++, source += stride, destination += vertex_size)
+                std::memcpy(destination, source, move.bytes);
+            break;
+        }
+        if (whole < count) {
+            const size_t at = whole * stride + move.from;
+            if (at < size)
+                std::memcpy(out.data() + whole * vertex_size + move.to, data + at, std::min<size_t>(move.bytes, size - at));
+        }
+    }
+}
+
+} // namespace renderer::vulkan::ps4
