+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Called by the emulator's libraries (declared there by hand): a guest thread starts (its name in
+// the report), a run of guest code ended, an import returned (its NID). Ticks are the TSC's.
+extern "C" void ps4_perf_guest_thread(const char *name);
+extern "C" void ps4_perf_code(uint64_t ticks);
+extern "C" void ps4_perf_import(uint32_t nid, uint64_t ticks);
+// An import starts (its NID and first argument): a thread that stays in one shows in the report
+extern "C" void ps4_perf_import_begin(uint32_t nid, uint32_t arg0);
+// A run of guest code starts (the CPU, and how to stop it from another thread), and ends: whether
+// the report stopped it to see where it spins
+extern "C" void ps4_perf_code_begin(void *cpu, void (*halt)(void *));
+// (bit 0: stopped to log a spin, bit 1: stopped for a profile sample)
+extern "C" int ps4_perf_code_end();
+// The guest thread's UID (the profile log finds its CPU by it), and a profile sample: where its
+// guest code was when the profiler stopped it (the Thumb bit in bit 0)
+extern "C" void ps4_perf_thread_id(int id);
+extern "C" void ps4_perf_sample(uint32_t pc);
+
+namespace ps4perf {
+
+// One log line per guest thread busy in the last `seconds`: its time in guest code and in its
+// biggest imports (ms a second, calls a second)
+// Returns how long the longest stuck thread has been in its call (s)
+double report(double seconds, double ticks_per_ms);
+
+// The profile since the last call, per thread with samples: where its guest code was, sampled
+// 500 times a second while it ran (ps4_main.cpp logs the hottest places with their code)
+struct ProfileThread {
+    std::string name;
+    int id = 0;
+    uint64_t total = 0;
+    std::vector<std::pair<uint32_t, uint32_t>> hottest; // pc (Thumb bit 0), samples
+};
+std::vector<ProfileThread> take_profile(size_t top);
+
+// Logs how fast random reads are through a 2 MiB aligned mapping and a misaligned one of the same
+// direct memory: whether the PS4 gives the guest memory large pages
+void benchmark_large_pages();
+
+} // namespace ps4perf
