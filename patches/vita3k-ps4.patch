+// The Vita's cameras: the PS4 has none for them, so they see a solid colour. Dark, or bright for
+// the puzzles that want light on a camera (Uncharted: Golden Abyss, chapter 13). Changes at once.
+Item camera_choice(EmuEnvState &emuenv) {
+    constexpr uint32_t DARK = 0xFF000000, BRIGHT = 0xFFFFFFFF;
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = "Camera";
+    item.values = { "Dark", "Bright" };
+    item.get = [&emuenv] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return emuenv.cfg.back_camera_type == CameraType::SolidColor && emuenv.cfg.back_camera_color == BRIGHT ? 1 : 0;
+    };
+    item.set = [&emuenv](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        const uint32_t color = index == 1 ? BRIGHT : DARK;
+        emuenv.cfg.front_camera_type = emuenv.cfg.back_camera_type = CameraType::SolidColor;
+        emuenv.cfg.front_camera_color = emuenv.cfg.back_camera_color = color;
+        config::serialize_config(emuenv.cfg, emuenv.cfg.config_path);
+        // a camera the game has open shows it from its next frame
+        emuenv.camera.front()->update_config(CameraType::SolidColor, {}, {}, color);
+        emuenv.camera.back()->update_config(CameraType::SolidColor, {}, {}, color);
+    };
+    return item;
+}
