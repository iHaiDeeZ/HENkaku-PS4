+// Backs the regions of [ptr, ptr + size) that aren't yet (backed ones keep their data) and counts
+// its pages as committed.
+bool commit(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    const size_t first = (ptr - base) / PAGE;
+    const size_t last = (ptr + size - base + PAGE - 1) / PAGE;
+    if (first >= last)
