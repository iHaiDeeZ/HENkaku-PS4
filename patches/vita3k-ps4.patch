+        items.push_back(frame_generation_choice());
+        items.push_back(touch_markers_choice());
+    }
+    items.push_back(choice<int>(scope, "Texture filtering", { "Standard", "2x", "4x", "8x", "16x" }, { 1, 2, 4, 8, 16 }, &Config::CurrentConfig::anisotropic_filtering));
+    return items;
+}
