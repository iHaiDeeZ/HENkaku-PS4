+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#include "ps4_vita_shell.h"
+
+#include <miniz.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace ps4shell {
+
+namespace {
+
+// Where each picture is: its resource file, its place among the file's GIM images, its size (the
+// firmware HENkaku installs, 3.74; another version's are checked by size and left out if they differ)
+struct Wanted {
+    Picture which;
+    const char *file;
+    int index;
+    int width, height;
+};
+const Wanted WANTED[] = {
+    { Picture::Wave, "theme_plugin.rco", 0, 360, 192 },
+    { Picture::PageDot, "topmenu_plugin.rco", 5, 16, 16 },
+    { Picture::Home, "applauncher_plugin.rco", 6, 80, 80 },
+    { Picture::Glow, "applauncher_plugin.rco", 5, 40, 40 },
+    { Picture::Wifi, "indicator_plugin.rco", 55, 23, 24 },
+    { Picture::StartButton, "livearea_plugin.rco", 10, 40, 36 },
+};
+
+std::array<ps4ui::Image, static_cast<size_t>(Picture::Count)> pictures;
+bool tried = false;
+
+std::vector<uint8_t> read_file(const std::string &path) {
+    std::vector<uint8_t> data;
+    FILE *f = std::fopen(path.c_str(), "rb");
+    if (!f)
+        return data;
+    std::fseek(f, 0, SEEK_END);
+    const long size = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    if (size > 0) {
+        data.resize(static_cast<size_t>(size));
+        if (std::fread(data.data(), 1, data.size(), f) != data.size())
+            data.clear();
+    }
+    std::fclose(f);
+    return data;
+}
+
+uint16_t u16(const std::vector<uint8_t> &d, size_t at) {
+    return at + 2 <= d.size() ? static_cast<uint16_t>(d[at] | d[at + 1] << 8) : 0;
+}
+
+uint32_t u32(const std::vector<uint8_t> &d, size_t at) {
+    return at + 4 <= d.size() ? static_cast<uint32_t>(d[at] | d[at + 1] << 8 | d[at + 2] << 16 | static_cast<uint32_t>(d[at + 3]) << 24) : 0;
+}
+
+// A zlib stream at src: its data, and how much of src it took; false if there isn't one
+bool inflate_at(const uint8_t *src, size_t len, std::vector<uint8_t> &out, size_t &used) {
+    mz_stream s{};
+    if (mz_inflateInit(&s) != MZ_OK)
+        return false;
+    s.next_in = src;
+    s.avail_in = static_cast<unsigned int>(len);
+    out.clear();
+    uint8_t buffer[16384];
+    int r;
+    do {
+        s.next_out = buffer;
+        s.avail_out = sizeof(buffer);
+        r = mz_inflate(&s, MZ_NO_FLUSH);
+        out.insert(out.end(), buffer, buffer + (sizeof(buffer) - s.avail_out));
+    } while (r == MZ_OK && out.size() < (64u << 20));
+    used = s.total_in;
+    mz_inflateEnd(&s);
+    return r == MZ_STREAM_END;
+}
+
+// The GIM images of a resource file, in order: its file table's zlib streams that hold one
+std::vector<std::vector<uint8_t>> gims_of(const std::vector<uint8_t> &rco) {
+    std::vector<std::vector<uint8_t>> gims;
+    if (rco.size() < 0x50 || std::memcmp(rco.data(), "RCOF", 4) != 0)
+        return gims;
+    // the header: magic, version, then (offset, size) of the tree, id, hash id, string, wide
+    // string, hash, int array, float array and file tables
+    const uint32_t files = u32(rco, 0x48), files_size = u32(rco, 0x4c);
+    if (files > rco.size() || files_size > rco.size() - files)
+        return gims;
+    const uint8_t *blob = rco.data() + files;
+    size_t i = 0;
+    std::vector<uint8_t> out;
+    while (i + 2 < files_size) {
+        const uint8_t b = blob[i + 1];
+        size_t used = 0;
+        if (blob[i] == 0x78 && (b == 0x01 || b == 0x5e || b == 0x9c || b == 0xda) && inflate_at(blob + i, files_size - i, out, used)) {
+            if (out.size() >= 16 && std::memcmp(out.data(), "MIG.", 4) == 0)
+                gims.push_back(out);
+            i += std::max<size_t>(used, 1);
+        } else {
+            i++;
+        }
+    }
+    return gims;
+}
+
+// A GIM image (the PSP's format): blocks of a type (2 the root, 3 a picture, 4 the image, 5 its
+// palette), the image's 8 or 4 bit indices into an RGBA palette (or RGBA itself), rows padded to 16
+// bytes. The shell's are all of those, unswizzled.
+bool decode_gim(const std::vector<uint8_t> &g, ps4ui::Image &image) {
+    size_t pixels_block = 0, palette_block = 0;
+    const auto walk = [&](auto &&self, size_t at, size_t end, int depth) -> void {
+        while (at + 16 <= end && depth < 8) {
+            const uint16_t type = u16(g, at);
+            const uint32_t size = u32(g, at + 4), data = u32(g, at + 12);
+            if (size == 0 || at + size > g.size())
+                return;
+            if (type == 2 || type == 3)
+                self(self, at + data, at + size, depth + 1);
+            else if (type == 4)
+                pixels_block = at + data;
+            else if (type == 5)
+                palette_block = at + data;
+            at += size;
+        }
+    };
+    walk(walk, 16, g.size(), 0);
+    if (!pixels_block)
+        return false;
+    const uint16_t format = u16(g, pixels_block + 4), order = u16(g, pixels_block + 6);
+    const int width = u16(g, pixels_block + 8), height = u16(g, pixels_block + 10);
+    const size_t pixels = pixels_block + u32(g, pixels_block + 0x1c);
+    const int bits = format == 3 ? 32 : format == 5 ? 8 : format == 4 ? 4 : 0;
+    if (!bits || order != 0 || width <= 0 || height <= 0)
+        return false;
+    const size_t row = (static_cast<size_t>(width) * bits / 8 + 15) / 16 * 16;
+    if (pixels + row * height > g.size())
+        return false;
+    std::vector<uint32_t> palette;
+    if (bits <= 8) {
+        if (!palette_block || u16(g, palette_block + 4) != 3)
+            return false;
+        const int count = u16(g, palette_block + 8);
+        const size_t colors = palette_block + u32(g, palette_block + 0x1c);
+        if (count <= 0 || colors + static_cast<size_t>(count) * 4 > g.size())
+            return false;
+        for (int k = 0; k < count; k++)
+            palette.push_back(u32(g, colors + static_cast<size_t>(k) * 4));
+    }
+    image.width = width;
+    image.height = height;
+    image.pixels.assign(static_cast<size_t>(width) * height, 0);
+    for (int y = 0; y < height; y++) {
+        const uint8_t *src = g.data() + pixels + row * y;
+        for (int x = 0; x < width; x++) {
+            uint32_t p;
+            if (bits == 32) {
+                p = static_cast<uint32_t>(src[x * 4] | src[x * 4 + 1] << 8 | src[x * 4 + 2] << 16) | static_cast<uint32_t>(src[x * 4 + 3]) << 24;
+            } else {
+                const int index = bits == 8 ? src[x] : (src[x / 2] >> ((x & 1) * 4)) & 0xF;
+                p = index < static_cast<int>(palette.size()) ? palette[index] : 0;
+            }
+            image.pixels[static_cast<size_t>(y) * width + x] = p;
+        }
+    }
+    ps4ui::premultiply(image);
+    return true;
+}
+
+} // namespace
+
+bool load(const std::string &vs0) {
+    if (tried)
+        return picture(Picture::Wave) != nullptr;
+    tried = true;
+    std::string current;
+    std::vector<std::vector<uint8_t>> gims;
+    int found = 0;
+    for (const Wanted &w : WANTED) {
+        if (current != w.file) {
+            current = w.file;
+            gims = gims_of(read_file(vs0 + "/vsh/shell/" + w.file));
+        }
+        ps4ui::Image image;
+        if (w.index < static_cast<int>(gims.size()) && decode_gim(gims[w.index], image) && image.width == w.width && image.height == w.height) {
+            pictures[static_cast<size_t>(w.which)] = std::move(image);
+            found++;
+        }
+    }
+    return found > 0;
+}
+
+const ps4ui::Image *picture(Picture which) {
+    const ps4ui::Image &image = pictures[static_cast<size_t>(which)];
+    return image.empty() ? nullptr : &image;
+}
+
+} // namespace ps4shell
