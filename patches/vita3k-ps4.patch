+// 2 MiB of direct memory, 2 MiB aligned: one given back, else the next piece of the newest block,
+// else a new block (64 MiB, or 2 MiB when that much isn't left in one piece).
+bool take_region(off_t &phys) {
+    if (!free_regions.empty()) {
