+    "options", "touchpad-click" };
+const uint32_t PAD_BITS[PadButtonCount] = { ORBIS_PAD_BUTTON_CROSS, ORBIS_PAD_BUTTON_CIRCLE, ORBIS_PAD_BUTTON_SQUARE, ORBIS_PAD_BUTTON_TRIANGLE,
+    ORBIS_PAD_BUTTON_UP, ORBIS_PAD_BUTTON_DOWN, ORBIS_PAD_BUTTON_LEFT, ORBIS_PAD_BUTTON_RIGHT, ORBIS_PAD_BUTTON_L1, ORBIS_PAD_BUTTON_R1,
+    ORBIS_PAD_BUTTON_L2, ORBIS_PAD_BUTTON_R2, ORBIS_PAD_BUTTON_L3, ORBIS_PAD_BUTTON_R3, ORBIS_PAD_BUTTON_OPTIONS, ORBIS_PAD_BUTTON_TOUCH_PAD };
+
+const char *const PLACE_NAMES[9] = { "centre", "left", "right", "top", "bottom", "top left", "top right", "bottom left", "bottom right" };
+const char *const PLACE_KEYS[9] = { "centre", "left", "right", "top", "bottom", "top-left", "top-right", "bottom-left", "bottom-right" };
+const float PLACES[9][2] = { { 0.5f, 0.5f }, { 0.2f, 0.5f }, { 0.8f, 0.5f }, { 0.5f, 0.2f }, { 0.5f, 0.8f }, { 0.2f, 0.2f }, { 0.8f, 0.2f },
+    { 0.2f, 0.8f }, { 0.8f, 0.8f } };
+
+const char *const TOUCHPAD_NAMES[TouchpadUseCount] = { "Front", "Rear", "Both halves", "Off" };
+const char *const TOUCHPAD_KEYS[TouchpadUseCount] = { "front", "back", "split", "off" };
+const char *const STICKS_NAMES[SticksRangeCount] = { "Square", "Round (the DS4's)" };
+const char *const STICKS_KEYS[SticksRangeCount] = { "square", "round" };
+
+// The actions' names in the menus and keys in the files
+struct ActionName {
+    std::string label, key;
+};
+const std::vector<ActionName> &action_names() {
+    static const std::vector<ActionName> names = [] {
+        std::vector<ActionName> list = { { "Nothing", "none" }, { "Cross", "cross" }, { "Circle", "circle" }, { "Square", "square" },
+            { "Triangle", "triangle" }, { "Up", "up" }, { "Down", "down" }, { "Left", "left" }, { "Right", "right" }, { "L", "l" }, { "R", "r" },
+            { "START", "start" }, { "SELECT", "select" }, { "PS TV L2", "l2" }, { "PS TV R2", "r2" }, { "PS TV L3", "l3" }, { "PS TV R3", "r3" } };
+        for (int i = 0; i < 9; i++)
+            list.push_back({ std::string("Front ") + PLACE_NAMES[i], std::string("front-") + PLACE_KEYS[i] });
+        for (int i = 0; i < 9; i++)
+            list.push_back({ std::string("Rear ") + PLACE_NAMES[i], std::string("back-") + PLACE_KEYS[i] });
+        return list;
+    }();
+    return names;
+}
+
+std::recursive_mutex mutex;
+// the sets read, by app ("" all games'): the menus ask on every frame
+std::map<std::string, Controls> cache;
+std::string running_app;
+Controls running_controls = defaults();
+
+std::string file_of(const std::string &app_path) {
+    return controls_dir() + "/" + (app_path.empty() ? std::string("all") : app_path) + ".cfg";
+}
+
+bool exists(const std::string &path) {
+    struct stat st {};
+    return ::stat(path.c_str(), &st) == 0;
+}
+
+std::string trim(std::string s) {
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' ' || s.back() == '\t'))
+        s.pop_back();
+    size_t start = 0;
+    while (start < s.size() && (s[start] == ' ' || s[start] == '\t'))
+        start++;
+    return s.substr(start);
+}
+
+// Reads a set, over the defaults; false if there is no file
+bool load(const std::string &path, Controls &controls) {
+    FILE *f = std::fopen(path.c_str(), "r");
+    if (!f)
+        return false;
+    char line[256];
+    bool layout_2 = false;
+    std::vector<std::pair<std::string, std::string>> lines;
+    while (std::fgets(line, sizeof(line), f)) {
+        const std::string text = line;
+        const size_t eq = text.find('=');
+        if (eq == std::string::npos || text[0] == '#')
+            continue;
+        lines.push_back({ trim(text.substr(0, eq)), trim(text.substr(eq + 1)) });
+        layout_2 |= lines.back().first == "layout" && lines.back().second == "2";
+    }
+    std::fclose(f);
+    for (const auto &[key, value] : lines) {
+        // (a file from before layout 2 keeps the new touches on L2/R2/L3/R3 where it had the old
+        // defaults there)
+        if (!layout_2 && (key == "l2" || key == "r2" || key == "l3" || key == "r3") && value == key)
+            continue;
+        if (key == "touchpad") {
+            for (int i = 0; i < TouchpadUseCount; i++)
+                if (value == TOUCHPAD_KEYS[i])
+                    controls.touchpad = static_cast<uint8_t>(i);
+            continue;
+        }
+        if (key == "sticks") {
+            for (int i = 0; i < SticksRangeCount; i++)
+                if (value == STICKS_KEYS[i])
+                    controls.sticks = static_cast<uint8_t>(i);
+            continue;
+        }
+        for (int b = 0; b < PadButtonCount; b++) {
+            if (key != PAD_KEYS[b])
+                continue;
+            const auto &names = action_names();
+            for (size_t a = 0; a < names.size(); a++)
+                if (value == names[a].key)
+                    controls.button[b] = static_cast<uint8_t>(a);
+        }
+    }
+    return true;
+}
+
+void save(const std::string &path, const Controls &controls) {
+    ::mkdir(controls_dir().c_str(), 0777);
+    FILE *f = std::fopen(path.c_str(), "w");
+    if (!f) {
+        LOG_WARN("PS4: couldn't write {}", path);
+        return;
+    }
+    std::fprintf(f, "# HENkaku: the DualShock 4 button = what the game gets (HENkaku > Controls)\n");
+    std::fprintf(f, "layout = 2\n");
+    std::fprintf(f, "touchpad = %s\n", TOUCHPAD_KEYS[std::min<int>(controls.touchpad, TouchpadUseCount - 1)]);
+    std::fprintf(f, "sticks = %s\n", STICKS_KEYS[std::min<int>(controls.sticks, SticksRangeCount - 1)]);
+    const auto &names = action_names();
+    for (int b = 0; b < PadButtonCount; b++)
+        std::fprintf(f, "%s = %s\n", PAD_KEYS[b], names[std::min<size_t>(controls.button[b], names.size() - 1)].key.c_str());
+    std::fclose(f);
+}
+
+Controls global_controls() {
+    Controls controls = defaults();
+    load(file_of({}), controls);
+    return controls;
+}
+
+// The set a change to app_path's controls goes to: its own when it has one, else all games'
+std::string target_of(const std::string &app_path) {
+    return !app_path.empty() && exists(file_of(app_path)) ? file_of(app_path) : file_of({});
+}
+
+void reload_running() {
+    cache.clear();
+    running_controls = effective(running_app);
+}
+
+// Changes one thing in the set app_path plays with
+void change(const std::string &app_path, const std::function<void(Controls &)> &edit) {
+    const std::lock_guard<std::recursive_mutex> lock(mutex);
+    Controls controls = effective(app_path);
+    edit(controls);
+    save(target_of(app_path), controls);
+    reload_running();
+}
+
+Item choice(std::string name, std::vector<std::string> values, std::function<int()> get, std::function<void(int)> set, std::string note = {}) {
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = std::move(name);
+    item.values = std::move(values);
+    item.get = std::move(get);
+    item.set = std::move(set);
+    item.note = std::move(note);
+    return item;
+}
+
+Item section(std::string name) {
+    Item item;
+    item.type = Item::kind::section;
+    item.name = std::move(name);
+    return item;
+}
+
+} // namespace
+
+uint32_t pad_bit(PadButton button) {
+    return PAD_BITS[button];
+}
+
+void touch_place(int place, float &x, float &y) {
+    place = std::clamp(place, 0, 8);
+    x = PLACES[place][0];
+    y = PLACES[place][1];
+}
+
+Controls defaults() {
+    Controls controls{};
+    // L2/R2 the rear touch pad's left and right, L3/R3 the front screen's (God of War's Vita port
+    // put the PS2's L2/R2 on the rear pad's halves): the PS TV's buttons only reach PS TV games
+    const uint8_t layout[PadButtonCount] = { ActCross, ActCircle, ActSquare, ActTriangle, ActUp, ActDown, ActLeft, ActRight, ActL, ActR,
+        ActBackTouch + 1, ActBackTouch + 2, ActFrontTouch + 1, ActFrontTouch + 2, ActStart, ActSelect };
+    std::copy(std::begin(layout), std::end(layout), controls.button);
+    controls.touchpad = TouchpadFront;
+    controls.sticks = SticksSquare;
+    return controls;
+}
+
+Controls effective(const std::string &app_path) {
+    const std::lock_guard<std::recursive_mutex> lock(mutex);
+    const auto known = cache.find(app_path);
+    if (known != cache.end())
+        return known->second;
+    Controls controls = global_controls();
+    if (!app_path.empty())
+        load(file_of(app_path), controls);
+    cache[app_path] = controls;
+    return controls;
+}
+
+void set_running_app(const std::string &app_path) {
+    const std::lock_guard<std::recursive_mutex> lock(mutex);
+    running_app = app_path;
+    reload_running();
+    LOG_INFO("PS4 controls: {}", !app_path.empty() && exists(file_of(app_path)) ? "the game's own (" + file_of(app_path) + ")" : "all games' (" + file_of({}) + ")");
+}
+
+Controls running() {
+    const std::lock_guard<std::recursive_mutex> lock(mutex);
+    return running_controls;
+}
+
+std::vector<Item> items(const std::string &app_path) {
+    std::vector<Item> list;
+    if (!app_path.empty()) {
+        list.push_back(choice("Controls", { "All games", "This game" },
+            [app_path] {
+                const std::lock_guard<std::recursive_mutex> lock(mutex);
+                static std::map<std::string, bool> own;
+                if (!cache.contains(app_path) || !own.contains(app_path))
+                    own[app_path] = exists(file_of(app_path));
+                effective(app_path); // (fills the cache, which a change clears)
+                return own[app_path] ? 1 : 0;
+            },
+            [app_path](int value) {
+                const std::lock_guard<std::recursive_mutex> lock(mutex);
+                if (value == 1 && !exists(file_of(app_path)))
+                    save(file_of(app_path), global_controls()); // starting from all games'
+                else if (value == 0)
+                    std::remove(file_of(app_path).c_str());
+                reload_running();
+            }));
+    }
+
+    std::vector<std::string> touchpad_names(std::begin(TOUCHPAD_NAMES), std::end(TOUCHPAD_NAMES));
+    list.push_back(section("Touch pad"));
+    list.push_back(choice("Touch pad", touchpad_names,
+        [app_path] { return static_cast<int>(effective(app_path).touchpad); },
+        [app_path](int value) { change(app_path, [value](Controls &c) { c.touchpad = static_cast<uint8_t>(value); }); }));
+
+    std::vector<std::string> sticks_names(std::begin(STICKS_NAMES), std::end(STICKS_NAMES));
+    list.push_back(section("Sticks"));
+    list.push_back(choice("Range", sticks_names,
+        [app_path] { return static_cast<int>(effective(app_path).sticks); },
+        [app_path](int value) { change(app_path, [value](Controls &c) { c.sticks = static_cast<uint8_t>(value); }); }));
+
+    std::vector<std::string> action_labels;
+    for (const ActionName &name : action_names())
+        action_labels.push_back(name.label);
+    list.push_back(section("Buttons"));
+    for (int b = 0; b < PadButtonCount; b++) {
+        list.push_back(choice(PAD_NAMES[b], action_labels,
+            [app_path, b] { return static_cast<int>(effective(app_path).button[b]); },
+            [app_path, b](int value) { change(app_path, [b, value](Controls &c) { c.button[b] = static_cast<uint8_t>(value); }); }));
+    }
+    Item reset;
+    reset.type = Item::kind::action;
+    reset.name = "Reset buttons";
+    reset.run = [app_path] {
+        change(app_path, [](Controls &c) { c = defaults(); });
+    };
+    list.push_back(reset);
+    return list;
+}
+
+} // namespace ps4controls
