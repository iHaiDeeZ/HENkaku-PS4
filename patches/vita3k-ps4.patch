+
+// PS4: the HENkaku settings, the same pages in the launcher (the HENkaku bubble: all games; a
+// game's LiveArea: that game) and in a game's quick menu (L3 + R3): sections, choices, pages
+// within pages, as overlay::pause_menu_item (the in-game menu draws them itself, the launcher
+// with its canvas).
+
+#pragma once
+
+#include <overlay/pause_overlay.h>
+
+#include <string>
+#include <vector>
+
+struct EmuEnvState;
+
+namespace ps4settings {
+
+using Item = overlay::pause_menu_item;
+
+// The PS4 frontend's own settings, which Vita3K's config.yml has no place for
+// (/data/Vita3K/ps4.cfg, "key = value" lines)
+struct Prefs {
+    // the home screen: the PS Vita's bubbles, or Vita3K's list
+    bool bubbles = true;
+    // FSR 1's sharpening, an index into the choices (1: 0.2 stops, Vita3K's)
+    int fsr_sharpness = 1;
+    // the game's threads on the first four cores (one Jaguar cluster, sharing their L2 cache), or
+    // on all six like everything else
+    bool cluster_threads = false;
+};
+Prefs &prefs();
+void load_prefs();
+void save_prefs();
+// RCAS stops for an fsr_sharpness index
+float fsr_sharpening(int index);
+
+// All games' settings (config.yml, and ps4.cfg), as the launcher's HENkaku pages
+std::vector<Item> global_pages(EmuEnvState &emuenv);
+// One game's own settings (config/config_<app>.xml over the global ones), as its pages
+std::vector<Item> game_pages(EmuEnvState &emuenv, const std::string &app_path);
+// In a game: what applies at once, then the game's own settings for its next start
+std::vector<Item> quick_menu(EmuEnvState &emuenv);
+
+// The HENkaku icon (in the package)
+std::string icon_path();
+
+} // namespace ps4settings
