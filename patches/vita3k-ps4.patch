diff --git a/vita3k/renderer/include/renderer/vulkan/ps4_vertex_layout.h b/vita3k/renderer/include/renderer/vulkan/ps4_vertex_layout.h
new file mode 100644
index 00000000..dad76a8f
--- /dev/null
+++ b/vita3k/renderer/include/renderer/vulkan/ps4_vertex_layout.h
@@ -0,0 +1,136 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
