+# the project include: PS4_RUNTIME_SOURCES, ps4_link_mesa, ps4_add_eboot).
+
+target_sources(vita3k PRIVATE
+	ps4/ps4_main.cpp
+	ps4/ps4_bgdl.cpp
+	ps4/ps4_bgdl.h
+	ps4/ps4_canvas.cpp
+	ps4/ps4_canvas.h
+	ps4/ps4_data.h
+	ps4/ps4_download.cpp
+	ps4/ps4_download.h
+	ps4/ps4_launcher.cpp
+	ps4/ps4_launcher.h
+	ps4/ps4_controls.cpp
+	ps4/ps4_controls.h
+	ps4/ps4_camera.cpp
