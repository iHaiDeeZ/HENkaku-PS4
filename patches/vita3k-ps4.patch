+#pragma once
+
+#include "../state.h"
+
+#include <condition_variable>
+#include <thread>
+#include <vector>
+
+struct PS4AudioOutPort;
+
+// PS4: one sceAudioOut port (48 kHz stereo) fed by a mixer thread. Each Vita port is resampled to
+// 48 kHz into its own ring, which the mixer drains a 256-frame grain at a time.
+class PS4AudioAdapter : public AudioAdapter {
+private:
+    int32_t handle = -1;
+    std::thread mixer;
+    std::atomic<bool> quit{ false };
+    std::atomic<bool> paused{ false };
+    std::mutex ports_mutex;
+    std::vector<std::weak_ptr<PS4AudioOutPort>> ports;
+
+    void mix_loop();
+
+public:
+    explicit PS4AudioAdapter(AudioState &audio_state);
+    ~PS4AudioAdapter() override;
+
+    bool init() override;
+    void switch_state(const bool pause) override;
+    AudioOutPortPtr open_port(int nb_channels, int freq, int nb_sample) override;
+    void audio_output(AudioOutPort &out_port, const void *buffer) override;
+    void set_volume(AudioOutPort &out_port, float volume) override;
+    int get_rest_sample(AudioOutPort &out_port) override;
+    void wake_all_ports() override;
+};
+
+struct PS4AudioOutPort : public AudioOutPort {
+    int channels = 2;
+    std::atomic<float> gain{ 1.0f };
+    std::mutex mutex;
+    std::condition_variable cond_var;
+    // 48 kHz stereo frames waiting for the mixer
+    std::vector<int16_t> ring;
+    size_t read_pos = 0;
+    size_t count = 0;
+    // resampler: position of the next output frame in input frames (-1 = the previous call's last)
+    double phase = -1.0;
+    int16_t prev[2] = {};
+    std::vector<int16_t> scratch;
+};
