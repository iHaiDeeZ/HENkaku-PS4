+    if (state.synthetic_tilt) {
+        state.motion_data.UpdateBasicOrientation();
+        state.last_accel_timestamp = state.last_updated_accel_timestamp;
+        state.last_counter++;
+        return;
+    }
+
     if (!ctrl_state.has_motion_support && !state.has_device_motion_support)
         return;
 
