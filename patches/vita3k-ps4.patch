new file mode 100644
index 00000000..70a46844
--- /dev/null
+++ b/vita3k/ps4/ps4_settings.cpp
@@ -0,0 +1,475 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the HENkaku settings (ps4_settings.h).
+//
+// Vita3K keeps two sets: the global settings (config.yml: the Config members) and the running
+// game's (Config::current_config: the global ones with the game's custom config,
+// config/config_<app>.xml, over them). Config's assignment copies the global members only, so
+// a change is made on a CurrentConfig and saved the way Vita3K's own settings dialog does
+// (v00.14's quick menu changed the global members and saved a default current_config over them:
+// its changes vanished and config.yml lost two settings). Three scopes:
+// - all games, in the launcher: the global settings (there current_config is them);
+// - a game, in its LiveArea or in it: its custom config, made at its first change;
+// - in a game, what applies at once: app::commit_settings, saved where the game's settings come
+//   from (its custom config, else the global ones).
+
+#include "ps4_settings.h"
+
+#include <app/functions.h>
+#include <config/functions.h>
+#include <config/settings.h>
+#include <config/state.h>
+#include <emuenv/state.h>
+#include <io/state.h>
+#include <renderer/state.h>
+#include <util/fs.h>
+#include <util/log.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace ps4settings {
+
+namespace {
+
+const char *const PREFS_FILE = "/data/Vita3K/ps4.cfg";
+const float SHARPENING_STOPS[] = { 0.0f, 0.2f, 0.5f, 1.0f, 2.0f };
+
+// Every read and change of the settings: the in-game menu reads them on the render thread while
+// a change replaces them on the overlay's input thread
+std::mutex settings_mutex;
+
+Prefs g_prefs;
+
+std::string trim(std::string s) {
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\r' || s.back() == '\n' || s.back() == '\t'))
+        s.pop_back();
+    size_t start = 0;
+    while (start < s.size() && (s[start] == ' ' || s[start] == '\t'))
+        start++;
+    return s.substr(start);
+}
+
+// --- scopes: which settings a page shows and changes ---
+
+class Scope {
+public:
+    virtual ~Scope() = default;
+    virtual const Config::CurrentConfig &get() = 0;
+    virtual void change(const std::function<void(Config::CurrentConfig &)> &edit) = 0;
+};
+
+// All games, from the launcher: there emuenv.cfg.current_config is the global settings
+class GlobalScope : public Scope {
+public:
+    explicit GlobalScope(EmuEnvState &emuenv)
+        : emuenv(emuenv) {
+        config::set_current_config(emuenv.cfg, emuenv.config_path, {});
+    }
+    const Config::CurrentConfig &get() override { return emuenv.cfg.current_config; }
+    void change(const std::function<void(Config::CurrentConfig &)> &edit) override {
+        edit(emuenv.cfg.current_config);
+        // copies them to the global members, then writes config.yml
+        config::save_current_config(emuenv.cfg, emuenv.config_path, {}, false);
+    }
+
+private:
+    EmuEnvState &emuenv;
+};
+
+// One game's own settings: the global ones with its custom config over them, saved in its custom
+// config (made at the first change)
+class GameScope : public Scope {
+public:
+    GameScope(EmuEnvState &emuenv, std::string app_path)
+        : emuenv(emuenv)
+        , app_path(std::move(app_path)) {
+        reload();
+    }
+    const Config::CurrentConfig &get() override { return current; }
+    void change(const std::function<void(Config::CurrentConfig &)> &edit) override {
+        edit(current);
+        config::save_custom_config(current, emuenv.config_path, app_path);
+    }
+    bool custom() const { return config::has_custom_config(emuenv.config_path, app_path); }
+    void use_global() {
+        config::delete_custom_config(emuenv.config_path, app_path);
+        reload();
+    }
+
+private:
+    void reload() {
+        Config cfg;
+        cfg = emuenv.cfg; // the global members
+        config::set_current_config(cfg, emuenv.config_path, app_path);
+        current = cfg.current_config;
+    }
+
+    EmuEnvState &emuenv;
+    std::string app_path;
+    Config::CurrentConfig current;
+};
+
+// The running game, what applies at once: Vita3K's settings commit (applied, then saved where
+// the game's settings come from)
+class LiveScope : public Scope {
+public:
+    explicit LiveScope(EmuEnvState &emuenv)
+        : emuenv(emuenv) {}
+    const Config::CurrentConfig &get() override { return emuenv.cfg.current_config; }
+    void change(const std::function<void(Config::CurrentConfig &)> &edit) override {
+        Config desired;
+        desired = emuenv.cfg; // the global members; current_config isn't copied
+        desired.current_config = emuenv.cfg.current_config;
+        edit(desired.current_config);
+        const std::string &app_path = emuenv.io.app_path;
+        const bool custom = config::has_custom_config(emuenv.config_path, app_path);
+        app::commit_settings(emuenv, desired, custom ? app_path : std::string());
+    }
+
+private:
+    EmuEnvState &emuenv;
+};
+
+// --- lines ---
+
+Item section(std::string name) {
+    Item item;
+    item.type = Item::kind::section;
+    item.name = std::move(name);
+    return item;
+}
+
+Item page(std::string name, std::vector<Item> items, std::string note = {}) {
+    Item item;
+    item.type = Item::kind::page;
+    item.name = std::move(name);
+    item.note = std::move(note);
+    item.items = std::move(items);
+    return item;
+}
+
+Item action(std::string name, std::function<void()> run) {
+    Item item;
+    item.type = Item::kind::action;
+    item.name = std::move(name);
+    item.run = std::move(run);
+    return item;
+}
+
+template <typename T>
+int index_of(const std::vector<T> &values, const T &value) {
+    const auto it = std::find(values.begin(), values.end(), value);
+    return it == values.end() ? 0 : static_cast<int>(it - values.begin());
+}
+
+int index_of(const std::vector<float> &values, float value) {
+    int best = 0;
+    for (int i = 0; i < static_cast<int>(values.size()); i++) {
+        if (std::abs(values[i] - value) < std::abs(values[best] - value))
+            best = i;
+    }
+    return best;
+}
+
+// A choice over a per-game setting (a CurrentConfig member), in a scope
+template <typename T>
+Item choice(const std::shared_ptr<Scope> &scope, std::string name, std::vector<std::string> labels, std::vector<T> values,
+    T Config::CurrentConfig::*member, std::string note = {}) {
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = std::move(name);
+    item.note = std::move(note);
+    item.values = std::move(labels);
+    item.get = [scope, values, member] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return index_of(values, scope->get().*member);
+    };
+    item.set = [scope, values, member](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        scope->change([&](Config::CurrentConfig &cc) { cc.*member = values[index]; });
+    };
+    return item;
+}
+
+// A choice over a setting only the global settings have (a Config member), written to config.yml
+template <typename T>
+Item global_choice(EmuEnvState &emuenv, std::string name, std::vector<std::string> labels, std::vector<T> values,
+    T Config::*member, std::string note = {}) {
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = std::move(name);
+    item.note = std::move(note);
+    item.values = std::move(labels);
+    item.get = [&emuenv, values, member] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return index_of(values, emuenv.cfg.*member);
+    };
+    item.set = [&emuenv, values, member](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        emuenv.cfg.*member = values[index];
+        config::serialize_config(emuenv.cfg, emuenv.cfg.config_path);
+    };
+    return item;
+}
+
+// A choice over one of the PS4 frontend's own settings (ps4.cfg)
+Item pref_choice(std::string name, std::vector<std::string> labels, std::function<int(const Prefs &)> get,
+    std::function<void(Prefs &, int)> set, std::string note = {}) {
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = std::move(name);
+    item.note = std::move(note);
+    item.values = std::move(labels);
+    item.get = [get] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return get(g_prefs);
+    };
+    item.set = [set](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        set(g_prefs, index);
+        save_prefs();
+    };
+    return item;
+}
+
+// --- the settings, page by page ---
+
+const std::vector<std::string> FILTERS = { "Bilinear", "Nearest", "Bicubic", "FXAA", "FSR" };
+const std::vector<std::string> FILTER_NAMES = { "Bilinear", "Nearest", "Bicubic", "FXAA", "FSR 1" };
+
+// Vita3K's performance overlay: off, or its detail levels
+Item show_fps(EmuEnvState &emuenv) {
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = "Show FPS";
+    item.values = { "Off", "FPS", "FPS + frame time", "FPS + min / avg / max", "FPS + graph" };
+    item.get = [&emuenv] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        return emuenv.cfg.performance_overlay ? std::clamp(emuenv.cfg.performance_overlay_detail + 1, 1, 4) : 0;
+    };
+    item.set = [&emuenv](int value) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        emuenv.cfg.performance_overlay = value > 0;
+        if (value > 0)
+            emuenv.cfg.performance_overlay_detail = value - 1;
+        config::serialize_config(emuenv.cfg, emuenv.cfg.config_path);
+        app::sync_perf_overlay_config(emuenv);
+    };
+    return item;
+}
+
+Item fsr_sharpness(EmuEnvState &emuenv) {
+    return pref_choice("FSR 1 sharpness", { "Sharpest", "Sharp (default)", "Medium", "Soft", "Softest" },
+        [](const Prefs &p) { return p.fsr_sharpness; },
+        [&emuenv](Prefs &p, int value) {
+            p.fsr_sharpness = value;
+            if (emuenv.renderer)
+                emuenv.renderer->fsr_sharpening = fsr_sharpening(value);
+        });
+}
+
+std::vector<Item> display_items(EmuEnvState &emuenv, const std::shared_ptr<Scope> &scope, bool global) {
+    std::vector<Item> items;
+    if (global) {
+        items.push_back(section("Performance overlay"));
+        items.push_back(show_fps(emuenv));
+        items.push_back(global_choice<int>(emuenv, "FPS position", { "Top left", "Top centre", "Top right", "Bottom left", "Bottom centre", "Bottom right" }, { 0, 1, 2, 3, 4, 5 }, &Config::performance_overlay_position));
+    }
+    items.push_back(section("Picture"));
+    items.push_back(choice<std::string>(scope, "Screen filter", FILTER_NAMES, FILTERS, &Config::CurrentConfig::screen_filter));
+    if (global)
+        items.push_back(fsr_sharpness(emuenv));
+    items.push_back(choice<int>(scope, "Texture filtering", { "Standard", "2x anisotropic", "4x anisotropic", "8x anisotropic", "16x anisotropic" }, { 1, 2, 4, 8, 16 }, &Config::CurrentConfig::anisotropic_filtering));
+    return items;
+}
+
+std::vector<Item> graphics_items(EmuEnvState &emuenv, const std::shared_ptr<Scope> &scope, bool global, const std::string &next_start) {
+    std::vector<Item> items;
+    items.push_back(section("Rendering"));
+    items.push_back(choice<float>(scope, "Resolution", { "960x544 (1x)", "1440x816 (1.5x)", "1920x1088 (2x)" }, { 1.0f, 1.5f, 2.0f }, &Config::CurrentConfig::resolution_multiplier, next_start));
+    items.push_back(choice<bool>(scope, "GPU accuracy", { "Standard", "High" }, { false, true }, &Config::CurrentConfig::high_accuracy, next_start));
+    // Vita3K's "disable surface sync", the other way round
+    items.push_back(choice<bool>(scope, "Frame read-back", { "Off (faster)", "On (for games that read their frames)" }, { true, false }, &Config::CurrentConfig::disable_surface_sync));
+    items.push_back(section("Shaders and textures"));
+    items.push_back(choice<bool>(scope, "Shader compiling", { "In the background", "Before drawing" }, { true, false }, &Config::CurrentConfig::async_pipeline_compilation));
+    if (global)
+        items.push_back(global_choice<bool>(emuenv, "Texture checks", { "Hash each use", "Watch writes" }, { false, true }, &Config::hashless_texture_cache, next_start));
+    items.push_back(section("Frame rate"));
+    // a game that waits for two vblanks a frame (30 fps) waits for one
+    items.push_back(choice<bool>(scope, "FPS hack (30 to 60)", { "Off", "On" }, { false, true }, &Config::CurrentConfig::fps_hack));
+    return items;
+}
+
+std::vector<Item> audio_items(const std::shared_ptr<Scope> &scope, const std::string &next_start) {
+    std::vector<std::string> labels;
+    std::vector<int> volumes;
+    for (int volume = 0; volume <= 100; volume += 10) {
+        labels.push_back(std::to_string(volume) + "%");
+        volumes.push_back(volume);
+    }
+    std::vector<Item> items;
+    items.push_back(choice<int>(scope, "Volume", labels, volumes, &Config::CurrentConfig::audio_volume));
+    items.push_back(choice<bool>(scope, "NGS (the Vita's audio engine)", { "On", "Off" }, { true, false }, &Config::CurrentConfig::ngs_enable, next_start));
+    return items;
+}
+
+std::vector<Item> cpu_items(const std::shared_ptr<Scope> &scope, bool global, const std::string &next_start) {
+    std::vector<Item> items;
+    items.push_back(choice<bool>(scope, "CPU optimisations", { "On (fast)", "Off (accurate, slow)" }, { true, false }, &Config::CurrentConfig::cpu_opt, next_start));
+    if (global) {
+        items.push_back(pref_choice("Game threads", { "On all cores", "On one cluster" },
+            [](const Prefs &p) { return p.cluster_threads ? 1 : 0; },
+            [](Prefs &p, int value) { p.cluster_threads = value == 1; }, next_start));
+    }
+    return items;
+}
+
+} // namespace
+
+Prefs &prefs() {
+    return g_prefs;
+}
+
+void load_prefs() {
+    FILE *f = std::fopen(PREFS_FILE, "r");
+    if (!f)
+        return;
+    char line[256];
+    while (std::fgets(line, sizeof(line), f)) {
+        const std::string text = line;
+        const size_t eq = text.find('=');
+        if (eq == std::string::npos)
+            continue;
+        const std::string key = trim(text.substr(0, eq));
+        const std::string value = trim(text.substr(eq + 1));
+        if (key == "home")
+            g_prefs.bubbles = value != "list";
+        else if (key == "fsr-sharpness")
+            g_prefs.fsr_sharpness = std::clamp(std::atoi(value.c_str()), 0, static_cast<int>(std::size(SHARPENING_STOPS)) - 1);
+        else if (key == "game-threads")
+            g_prefs.cluster_threads = value == "cluster";
+    }
+    std::fclose(f);
+}
+
+void save_prefs() {
+    FILE *f = std::fopen(PREFS_FILE, "w");
+    if (!f) {
+        LOG_WARN("PS4: couldn't write {}", PREFS_FILE);
+        return;
+    }
+    std::fprintf(f, "# HENkaku (Vita3K for PS4): the frontend's own settings (HENkaku > System, Display, CPU)\n");
+    std::fprintf(f, "home = %s\n", g_prefs.bubbles ? "bubbles" : "list");
+    std::fprintf(f, "fsr-sharpness = %d\n", g_prefs.fsr_sharpness);
+    std::fprintf(f, "game-threads = %s\n", g_prefs.cluster_threads ? "cluster" : "all");
+    std::fclose(f);
+}
+
+float fsr_sharpening(int index) {
+    return SHARPENING_STOPS[std::clamp(index, 0, static_cast<int>(std::size(SHARPENING_STOPS)) - 1)];
+}
+
+std::string icon_path() {
+    return "/app0/icons/henkaku.png";
+}
+
+std::vector<Item> global_pages(EmuEnvState &emuenv) {
+    const auto scope = std::make_shared<GlobalScope>(emuenv);
+    const std::string next_start = "next start";
+    std::vector<Item> pages;
+    pages.push_back(section("All games"));
+    pages.push_back(page("Display", display_items(emuenv, scope, true), "FPS, filters, FSR 1"));
+    pages.push_back(page("Graphics", graphics_items(emuenv, scope, true, next_start), "resolution, accuracy"));
+    pages.push_back(page("Audio", audio_items(scope, next_start), "volume"));
+    pages.push_back(page("CPU", cpu_items(scope, true, next_start), "dynarmic, cores"));
+
+    std::vector<Item> system;
+    system.push_back(section("Home screen"));
+    system.push_back(pref_choice("Style", { "PS Vita (bubbles)", "List" },
+        [](const Prefs &p) { return p.bubbles ? 0 : 1; },
+        [](Prefs &p, int value) { p.bubbles = value == 0; }));
+    system.push_back(section("Buttons"));
+    system.push_back(global_choice<int>(emuenv, "Enter button (games)", { "Cross", "Circle" },
+        { static_cast<int>(SCE_SYSTEM_PARAM_ENTER_BUTTON_CROSS), static_cast<int>(SCE_SYSTEM_PARAM_ENTER_BUTTON_CIRCLE) },
+        &Config::sys_button, next_start));
+    pages.push_back(section("PS4"));
+    pages.push_back(page("System", std::move(system), "home screen, buttons"));
+    return pages;
+}
+
+std::vector<Item> game_pages(EmuEnvState &emuenv, const std::string &app_path) {
+    const auto scope = std::make_shared<GameScope>(emuenv, app_path);
+    const std::string next_start = "next start";
+    std::vector<Item> pages;
+    pages.push_back(section("This game"));
+    pages.push_back(page("Display", display_items(emuenv, scope, false), "filters"));
+    pages.push_back(page("Graphics", graphics_items(emuenv, scope, false, next_start), "resolution, accuracy"));
+    pages.push_back(page("Audio", audio_items(scope, next_start), "volume"));
+    pages.push_back(page("CPU", cpu_items(scope, false, next_start), "dynarmic"));
+    pages.push_back(section("Saved in config/config_" + app_path + ".xml"));
+    pages.push_back(action("Use the settings of all games", [scope] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        scope->use_global();
+    }));
+    return pages;
+}
+
+std::vector<Item> quick_menu(EmuEnvState &emuenv) {
+    const auto live = std::make_shared<LiveScope>(emuenv);
+    const std::string next_start = "next start";
+    std::vector<Item> items;
+
+    std::vector<Item> display;
+    display.push_back(section("Performance overlay"));
+    display.push_back(show_fps(emuenv));
+    display.push_back(global_choice<int>(emuenv, "FPS position", { "Top left", "Top centre", "Top right", "Bottom left", "Bottom centre", "Bottom right" }, { 0, 1, 2, 3, 4, 5 }, &Config::performance_overlay_position));
+    display.push_back(section("Picture"));
+    display.push_back(choice<std::string>(live, "Screen filter", FILTER_NAMES, FILTERS, &Config::CurrentConfig::screen_filter));
+    display.push_back(fsr_sharpness(emuenv));
+    display.push_back(choice<int>(live, "Texture filtering", { "Standard", "2x anisotropic", "4x anisotropic", "8x anisotropic", "16x anisotropic" }, { 1, 2, 4, 8, 16 }, &Config::CurrentConfig::anisotropic_filtering));
+
+    std::vector<Item> sound;
+    std::vector<std::string> labels;
+    std::vector<int> volumes;
+    for (int volume = 0; volume <= 100; volume += 10) {
+        labels.push_back(std::to_string(volume) + "%");
+        volumes.push_back(volume);
+    }
+    sound.push_back(choice<int>(live, "Volume", labels, volumes, &Config::CurrentConfig::audio_volume));
+
+    std::vector<Item> speed;
+    speed.push_back(choice<bool>(live, "Shader compiling", { "In the background", "Before drawing" }, { true, false }, &Config::CurrentConfig::async_pipeline_compilation));
+    speed.push_back(choice<bool>(live, "FPS hack (30 to 60)", { "Off", "On" }, { false, true }, &Config::CurrentConfig::fps_hack));
+
+    items.push_back(section("Now"));
+    items.push_back(page("Display", std::move(display), "FPS, filters, FSR 1"));
+    items.push_back(page("Audio", std::move(sound), "volume"));
+    items.push_back(page("Speed", std::move(speed), "shaders, FPS hack"));
+    items.push_back(section("From the next start"));
+    if (!emuenv.io.app_path.empty())
+        items.push_back(page("This game", game_pages(emuenv, emuenv.io.app_path), "its own settings"));
+    return items;
+}
+
+} // namespace ps4settings
