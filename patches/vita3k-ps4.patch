+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#version 450
+// Frame generation, 1 of 3 (renderer/vulkan/frame_generation.cpp): the game's frame copied out of
+// its surface (which the game draws the next one into), and its brightness at 1/scale of its size
+// (one luma value per scale x scale pixels), which the motion search compares, with that luma at half
+// and quarter size (2x2 and 4x4 means), where the search starts.
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(push_constant) uniform Constants {
+    ivec2 src_offset;
+    uvec2 frame_size;
+    uint scale;
+    uint luma_w;
+    uint luma_h;
+    uint blocks_w;
+    uint pass_index;
+    float phase;
+} c;
+
+layout(set = 0, binding = 0) uniform sampler2D src;
+layout(set = 0, binding = 1, rgba8) uniform writeonly image2D frame;
+layout(set = 0, binding = 2) writeonly buffer Luma {
+    float luma[];
+};
+// the luma at half size, then at quarter size
+layout(set = 0, binding = 3) writeonly buffer Levels {
+    float levels[];
+};
+
+shared float group_luma[64];
+
+void main() {
+    const uvec2 l = gl_GlobalInvocationID.xy;
+    const bool inside = l.x < c.luma_w && l.y < c.luma_h;
+    // (threads past the luma's edge take the edge's luma for the means, and store nothing)
+    const uvec2 e = min(l, uvec2(c.luma_w - 1, c.luma_h - 1));
+    float sum = 0.0;
+    uint count = 0;
+    for (uint j = 0; j < c.scale; j++) {
+        for (uint i = 0; i < c.scale; i++) {
+            const uvec2 p = e * c.scale + uvec2(i, j);
+            if (p.x >= c.frame_size.x || p.y >= c.frame_size.y)
+                continue;
+            const vec4 v = texelFetch(src, c.src_offset + ivec2(p), 0);
+            if (inside)
+                imageStore(frame, ivec2(p), vec4(v.rgb, 1.0));
+            sum += dot(v.rgb, vec3(0.299, 0.587, 0.114));
+            count++;
+        }
+    }
+    const float value = count > 0 ? sum / float(count) : 0.0;
+    if (inside)
+        luma[l.y * c.luma_w + l.x] = value;
+
+    // the levels: a group's 8x8 luma values are 4x4 at half size, 2x2 at quarter size
+    const uint lane = gl_LocalInvocationIndex;
+    group_luma[lane] = value;
+    barrier();
+    const uvec2 g = gl_LocalInvocationID.xy;
+    const uint half_w = (c.luma_w + 1) / 2, half_h = (c.luma_h + 1) / 2;
+    if ((g.x & 1u) == 0u && (g.y & 1u) == 0u) {
+        const uvec2 h = l / 2u;
+        if (h.x < half_w && h.y < half_h)
+            levels[h.y * half_w + h.x] = 0.25 * (group_luma[lane] + group_luma[lane + 1] + group_luma[lane + 8] + group_luma[lane + 9]);
+    }
+    const uint quarter_w = (c.luma_w + 3) / 4, quarter_h = (c.luma_h + 3) / 4;
+    if ((g.x & 3u) == 0u && (g.y & 3u) == 0u) {
+        const uvec2 q = l / 4u;
+        if (q.x < quarter_w && q.y < quarter_h) {
+            float s = 0.0;
+            for (uint y = 0; y < 4; y++)
+                for (uint x = 0; x < 4; x++)
+                    s += group_luma[lane + y * 8 + x];
+            levels[half_w * half_h + q.y * quarter_w + q.x] = s / 16.0;
+        }
+    }
+}
