+uint16_t text_width(const label &l) {
+    uint16_t w = 0, h = 0;
+    l.measure_text(w, h, true);
+    return w;
+}
+
+// Sets a label's text, cut short with "..." when it's wider than max_w: the menu's names and values
+// never run into each other
+void set_fitting_text(label &l, const std::string &text, uint16_t max_w) {
+    l.set_text(text);
+    if (max_w == 0 || text_width(l) <= max_w)
+        return;
+    // the longest start, in whole UTF-8 characters, that fits with the dots
+    std::vector<size_t> starts;
+    for (size_t i = 0; i < text.size();) {
+        starts.push_back(i);
+        const unsigned char c = static_cast<unsigned char>(text[i]);
+        i += c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+    }
+    const auto cut = [&](size_t kept) {
+        std::string s = text.substr(0, starts[kept]);
+        while (!s.empty() && s.back() == ' ')
+            s.pop_back();
+        return s + "...";
+    };
+    size_t lo = 0, hi = starts.size() - 1;
+    while (lo < hi) {
+        const size_t mid = (lo + hi + 1) / 2;
+        l.set_text(cut(mid));
+        if (text_width(l) <= max_w)
+            lo = mid;
+        else
+            hi = mid - 1;
+    }
+    l.set_text(cut(lo));
+}
+
+// How wide a text is in the menu's font
+uint16_t width_of(const std::string &text, uint16_t size, bool bold) {
+    label probe;
+    probe.set_font(k_pause_overlay_font, size, bold);
+    probe.set_text(text);
+    return text_width(probe);
+}
+
+std::string choice_text(const pause_menu_item &item, int index) {
+    return item.set ? "<  " + item.values[index] + "  >" : item.values[index];
+}
