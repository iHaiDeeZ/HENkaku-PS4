+void release(uint8_t *ptr, size_t size) {
+    const std::lock_guard<std::mutex> lock(mutex);
+    for (uint32_t &phys : region_phys) {
+        if (phys) {
+            free_regions.push_back(phys - 1);
+            phys = 0;
+        }
+    }
+    committed = 0;
+    sceKernelMunmap(ptr, size);
+    base = nullptr;
+    region_phys.clear();
+    region_phys.shrink_to_fit();
+    region_used.clear();
+    region_used.shrink_to_fit();
+    page_committed.clear();
+    page_committed.shrink_to_fit();
+}
