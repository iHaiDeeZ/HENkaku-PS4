+        if (legacy_fd < 0)
+            return false;
+        const int n = read_file(param, emuenv.io, legacy_fd, SDSLOT_PARAM_SIZE, export_name);
+        close_file(emuenv.io, legacy_fd, export_name);
+        return n == static_cast<int>(SDSLOT_PARAM_SIZE);
+    }
