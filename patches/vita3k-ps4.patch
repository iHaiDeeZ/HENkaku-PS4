+std::vector<Item> game_pages(EmuEnvState &emuenv, const std::string &app_path) {
+    const auto scope = std::make_shared<GameScope>(emuenv, app_path);
+    const std::string next_start = "next start";
+    std::vector<Item> pages;
+    pages.push_back(section("This game"));
+    pages.push_back(page("Display", display_items(emuenv, scope, false)));
+    pages.push_back(page("Graphics", graphics_items(emuenv, scope, false, next_start)));
+    pages.push_back(page("Audio", audio_items(scope, next_start)));
+    pages.push_back(page("CPU", cpu_items(scope, false, next_start)));
+    pages.push_back(page("Controls", ps4controls::items(app_path)));
+    pages.push_back(section("Reset"));
+    pages.push_back(action("Use all games' settings", [scope] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        scope->use_global();
+    }));
+    return pages;
+}
