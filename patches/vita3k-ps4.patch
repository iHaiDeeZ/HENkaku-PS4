+// PS4: the PS Vita shell's background downloads (ux0:bgdl), which HENkaku does itself. PKGj queues a
+// package with the shell's download service (SceDownload, modules/SceIpmi): it comes down in a thread
+// of its own while the game goes on, carries on in the launcher (HENkaku restarts after every game),
+// and the launcher installs it with the license PKGj gave.
+
+#pragma once
+
+#include "ps4_download.h"
+
+#include <util/fs.h>
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ps4bgdl {
+
+struct Download {
+    fs::path dir; // ux0/bgdl/t/<its id, 8 hex digits>
+    int id = 0;
+    int type = 0; // the shell's: 0x16 game, 0x17 add-on, 0x0C theme
+    std::string title;
+    std::string url;
+    uint64_t size = 0; // once the server said
+
+    fs::path package() const; // where the package goes (a ".part" file until it's whole)
+    fs::path license() const; // the license PKGj gave (none for free content)
+    bool downloaded() const; // the package is there, whole
+};
+
+// Queues one: its id, or -1 if it couldn't be saved. A queued download also undoes a stop.
+int queue(const fs::path &vita_fs, int type, const std::string &url, const std::string &title, const std::vector<uint8_t> &license);
+// The queued downloads, oldest first
+std::vector<Download> list(const fs::path &vita_fs);
+// Forgets one, and what of it came down
+void remove(const Download &d);
+
+// Stopped (Circle in the launcher): the launcher doesn't carry on with them by itself
+bool stopped(const fs::path &vita_fs);
+void set_stopped(const fs::path &vita_fs, bool stop);
+
+// Downloads it, carrying on from what's there; progress(done, size) returning false stops it
+using Progress = std::function<bool(uint64_t done, uint64_t size)>;
+ps4download::Result fetch(Download &d, const Progress &progress);
+
+// In a game: downloads what's queued in a thread of its own, until it's all there
+void start(const fs::path &vita_fs);
+// What that thread is doing, for the game's overlay ("" when there's nothing to say)
+std::string notice();
+
+} // namespace ps4bgdl
