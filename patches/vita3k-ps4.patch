+// To the next line that can be picked, up (-1) or down
+void settings_move(SettingsLevel &level, int step) {
+    const auto &items = *level.items;
+    for (int i = level.selected + step; i >= 0 && i < static_cast<int>(items.size()); i += step) {
+        if (settings_selectable(items[i])) {
+            level.selected = i;
+            return;
+        }
+    }
+    if (level.selected < static_cast<int>(items.size()) && !settings_selectable(items[level.selected])) {
+        for (int i = 0; i < static_cast<int>(items.size()); i++) {
+            if (settings_selectable(items[i])) {
+                level.selected = i;
+                return;
+            }
+        }
+    }
+}
+
+void settings_open(SettingsView &view, std::string scope, std::vector<SItem> root) {
+    view.scope = std::move(scope);
+    view.root = std::move(root);
+    view.stack.clear();
+    view.stack.push_back({ &view.root, {}, 0, 0 });
+    settings_move(view.stack.back(), 1);
+}
+
+int choice_value(const SItem &item) {
+    const int count = static_cast<int>(item.values.size());
+    return (count > 0 && item.get) ? std::clamp(item.get(), 0, count - 1) : -1;
+}
+
+// Left / right on a choice: its previous / next value
+void settings_change(const SItem &item, int step) {
+    const int count = static_cast<int>(item.values.size());
+    if (item.type != SItem::kind::choice || count == 0 || !item.set)
+        return;
+    item.set((std::max(choice_value(item), 0) + step + count) % count);
+}
+
+// The wallpaper picker's pictures, loaded on a thread of their own (a big JPEG took some 60 ms
+// each time the picker moved to one): the one picked shows when it's ready, the last eight kept
+class PreviewLoader {
+public:
+    PreviewLoader()
+        : thread([this] { work(); }) {
+        thread.detach();
+    }
+
+    // the picture, or nothing while it loads (asked for then)
+    std::shared_ptr<const ps4ui::Image> get(const std::string &path) {
+        const std::lock_guard<std::mutex> lock(mutex);
+        const auto it = loaded.find(path);
+        if (it != loaded.end())
+            return it->second;
+        wanted = path;
+        wake.notify_one();
+        return nullptr;
+    }
+
+    // whether a picture came since the last time this was asked (a frame to show it)
+    bool arrived() { return arrived_flag.exchange(false); }
+
+private:
+    void work() {
+        ps4ui::set_serial(true);
+        for (;;) {
+            std::string path;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                wake.wait(lock, [this] { return !wanted.empty(); });
+                path = std::move(wanted);
+                wanted.clear();
+                if (loaded.count(path))
+                    continue;
+            }
+            auto picture = std::make_shared<ps4ui::Image>(ps4ui::load_image(path, 640, 360));
+            for (uint32_t &p : picture->pixels)
+                p |= 0xFF000000u;
+            {
+                const std::lock_guard<std::mutex> lock(mutex);
+                if (loaded.size() >= 8)
+                    loaded.clear();
+                loaded.emplace(path, std::move(picture));
+            }
+            arrived_flag.store(true);
+        }
+    }
+
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::string wanted;
+    std::map<std::string, std::shared_ptr<const ps4ui::Image>> loaded;
+    std::atomic<bool> arrived_flag{ false };
+    std::thread thread;
+};
+
+PreviewLoader &preview_loader() {
+    // (made once and kept: its thread waits for pictures for as long as the app runs)
+    static PreviewLoader *const loader = new PreviewLoader;
+    return *loader;
+}
