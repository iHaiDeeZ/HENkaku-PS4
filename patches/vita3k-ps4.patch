+extern "C" int ps4_touch_front(float *xy, const int max) {
+    const std::lock_guard<std::mutex> lock(ps4_touch_mutex);
+    int count = 0;
+    for (const Ps4TouchPoint &point : ps4_touch_points[0]) {
+        if (count >= max)
