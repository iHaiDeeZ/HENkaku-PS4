+        else if (!cards[i - 1]->empty())
+            c.blit(*cards[i - 1], static_cast<int>(cx) - cards[i - 1]->width / 2, STATUS_H / 2 - cards[i - 1]->height / 2, a);
+        if (near > 0.5f)
+            c.fill_round_rect(static_cast<int>(cx) - 12, STATUS_H - 7, 24, 4, 2, rgb(0x9fe0ff, static_cast<uint8_t>(255 * near)));
+    }
+    int right = W - 34;
