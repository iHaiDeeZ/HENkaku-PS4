+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: HTTP downloads (ps4_download.cpp), for the PS Vita firmware the launcher gets from Sony and
+// the packages PKGj queues (ps4_bgdl.cpp).
+
+#pragma once
+
+#include <util/fs.h>
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace ps4download {
+
+// Told how many bytes there are so far; returning false stops the download.
+using Progress = std::function<bool(uint64_t done)>;
+
+enum class Status {
+    Done,
+    Stopped,
+    Failed,
+};
+
+struct Result {
+    Status status = Status::Failed;
+    std::string error; // why it failed, for the user
+};
+
+// How big what url holds is (a HEAD request), or 0 with error saying why not
+uint64_t remote_size(const std::string &url, std::string &error);
+
+// Downloads url to path, which must come out `size` bytes long. Until it's complete the file is
+// path + ".part", and the next call for it carries on from where this one stopped.
+Result download(const std::string &url, const fs::path &path, uint64_t size, const Progress &progress);
+
+} // namespace ps4download
diff --git a/vita3k/ps4/ps4_keyboard.cpp b/vita3k/ps4/ps4_keyboard.cpp
new file mode 100644
index 00000000..821093be
--- /dev/null
+++ b/vita3k/ps4/ps4_keyboard.cpp
@@ -0,0 +1,249 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// PS4: the PS4's own keyboard (its IME dialog, opened as March33 opens it) for the keyboard a Vita
+// game opens, through its IME dialog (a name, a save's title) or sceIme. Vita3K draws a text field
+// over the game and takes the text from a computer's keyboard, which the PS4 doesn't give an app.
+// The text is UTF-16 on both. The keyboard confirms with Cross: the package's param.sfo has
+// ATTRIBUTE 0x2 (scripts/make-pkg.sh), without which system dialogs follow the console's region
+// (Circle on some).
+
+#include "ps4_keyboard.h"
+
+#include <dialog/state.h>
+#include <emuenv/state.h>
+#include <ime/functions.h>
+#include <ime/state.h>
+#include <util/log.h>
+
+#include <orbis/CommonDialog.h>
+#include <orbis/ImeDialog.h>
+#include <orbis/Sysmodule.h>
+#include <orbis/UserService.h>
+
+#include <algorithm>
+#include <iterator>
+#include <mutex>
+#include <string>
+
+namespace {
+
+// the longest text of both IMEs
+constexpr uint32_t MAX_TEXT = SCE_IME_DIALOG_MAX_TEXT_LENGTH;
+// the same bits on both for these two (the Vita's 0x4 is "no assistance", the PS4's a password)
+constexpr uint32_t OPTION_MULTILINE = 0x1;
+constexpr uint32_t OPTION_NO_AUTO_CAPITALIZATION = 0x2;
+constexpr uint32_t OPTION_PASSWORD = 0x4;
+// the PS4 pad's buttons, without its "the system has the input" bit
+constexpr uint32_t PAD_BUTTONS = 0x001FFFFF;
+
+std::mutex g_lock;
+bool g_open = false;
+// for an IME dialog (else sceIme)
+bool g_for_dialog = false;
+// the game closed it, its result goes nowhere
+bool g_closing = false;
+bool g_hold = false;
+char16_t g_text[MAX_TEXT + 2];
+char16_t g_initial[MAX_TEXT + 2];
+char16_t g_title[SCE_IME_DIALOG_MAX_TITLE_LENGTH + 1];
+
+void copy_text(char16_t *out, size_t size, const char16_t *in) {
+    size_t n = 0;
+    if (in) {
+        for (; n + 1 < size && in[n]; n++)
+            out[n] = in[n];
+    }
+    out[n] = 0;
+}
+
+// The Vita's IME types (ime/types.h) as the PS4's
+OrbisImeType ps4_type(uint32_t vita_type) {
+    switch (vita_type) {
+    case SCE_IME_TYPE_BASIC_LATIN: return ORBIS_TYPE_BASIC_LATIN;
+    case SCE_IME_TYPE_NUMBER:
+    case SCE_IME_TYPE_EXTENDED_NUMBER: return ORBIS_TYPE_NUMBER;
+    case SCE_IME_TYPE_URL: return ORBIS_TYPE_TYPE_URL;
+    case SCE_IME_TYPE_MAIL: return ORBIS_TYPE_MAIL;
+    default: return ORBIS_TYPE_DEFAULT;
+    }
+}
+
+// The text typed to an IME dialog: closed on a dialog the game made without a cancel button, the
+// dialog ends with the text it started with
+void give_dialog(EmuEnvState &emuenv, bool done, const std::u16string &text) {
+    DialogState &dialog = emuenv.common_dialog;
+    const std::lock_guard<std::recursive_mutex> dialog_lock(dialog.mutex);
+    if (dialog.type != IME_DIALOG || dialog.status != SCE_COMMON_DIALOG_STATUS_RUNNING || !dialog.ime.host_keyboard)
+        return;
+    if (!done && dialog.ime.cancelable) {
+        cancel_ime_dialog(emuenv);
+        return;
+    }
+    if (done) {
+        const std::lock_guard<std::mutex> ime_lock(emuenv.ime.mutex);
+        emuenv.ime.str = text.substr(0, dialog.ime.max_length);
+        emuenv.ime.caretIndex = static_cast<uint32_t>(emuenv.ime.str.size());
+    }
+    // (takes the dialog's lock again, and the IME's)
+    finish_ime_dialog(emuenv);
+}
+
+// The text typed to sceIme: an update of its text and enter, or its close button
+void give_ime(EmuEnvState &emuenv, bool done, const std::u16string &text) {
+    Ime &ime = emuenv.ime;
+    const std::lock_guard<std::mutex> lock(ime.mutex);
+    if (!ime.state)
+        return;
+    if (!done) {
+        ime.queue_event(SCE_IME_EVENT_PRESS_CLOSE);
+        return;
+    }
+    ime.str = text.substr(0, ime.param.maxTextLength);
+    const uint32_t length = static_cast<uint32_t>(ime.str.size());
+    ime.caretIndex = length;
+    ime.edit_text.caretIndex = length;
+    ime.edit_text.preeditIndex = length;
+    ime.edit_text.preeditLength = 0;
+    ime.queue_event(SCE_IME_EVENT_UPDATE_TEXT);
+    ime.queue_submit_events();
+}
+
+} // namespace
+
+// Opens the keyboard for a game's IME dialog (for_dialog) or its sceIme, with the IME's settings
+// (ime/types.h): false if the PS4 refused every way of opening it
+extern "C" bool ps4_keyboard_open(const char16_t *title, const char16_t *text, uint32_t max_length, uint32_t vita_type,
+    uint32_t vita_option, bool password, uint32_t enter_label, bool for_dialog) {
+    const std::lock_guard<std::mutex> guard(g_lock);
+    if (g_open)
+        return false;
+    static bool loaded = false;
+    if (!loaded) {
+        sceSysmoduleLoadModule(ORBIS_SYSMODULE_IME_DIALOG);
+        sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_COMMON_DIALOG);
+        sceCommonDialogInitialize();
+        loaded = true;
+    }
+    const uint32_t length = std::clamp<uint32_t>(max_length, 1, MAX_TEXT);
+    copy_text(g_initial, length + 1, text);
+    copy_text(g_title, std::size(g_title), title);
+    int32_t user = -1;
+    sceUserServiceGetInitialUser(&user);
+
+    // Each attempt plainer than the one before: the PS4 refuses a password with the default type
+    // (80bc0030, March33), so it gets basic Latin and a password's length
+    struct Attempt {
+        OrbisImeType type;
+        uint32_t option;
+        uint32_t length;
+    };
+    const uint32_t option = vita_option & (OPTION_MULTILINE | OPTION_NO_AUTO_CAPITALIZATION);
+    const Attempt text_attempts[] = {
+        { ps4_type(vita_type), option, length },
+        { ORBIS_TYPE_DEFAULT, 0, length },
+        { ORBIS_TYPE_DEFAULT, 0, std::min<uint32_t>(length, 256) },
+    };
+    const Attempt password_attempts[] = {
+        { ORBIS_TYPE_BASIC_LATIN, OPTION_PASSWORD, std::min<uint32_t>(length, 128) },
+        { ORBIS_TYPE_BASIC_LATIN, OPTION_PASSWORD, std::min<uint32_t>(length, 16) },
+        { ORBIS_TYPE_DEFAULT, OPTION_PASSWORD, std::min<uint32_t>(length, 64) },
+        { ORBIS_TYPE_BASIC_LATIN, OPTION_NO_AUTO_CAPITALIZATION, std::min<uint32_t>(length, 128) },
+    };
+    const Attempt *const attempts = password ? password_attempts : text_attempts;
+    const size_t count = password ? std::size(password_attempts) : std::size(text_attempts);
+    int32_t result = -1;
+    for (size_t i = 0; i < count && result < 0; i++) {
+        copy_text(g_text, attempts[i].length + 1, g_initial);
+        OrbisImeDialogSetting setting{};
+        setting.userId = static_cast<uint32_t>(user);
+        setting.type = attempts[i].type;
+        setting.enterLabel = static_cast<OrbisButtonLabel>(enter_label <= SCE_IME_ENTER_LABEL_GO ? enter_label : SCE_IME_ENTER_LABEL_DEFAULT);
+        setting.option = attempts[i].option;
+        setting.maxTextLength = attempts[i].length;
+        setting.inputTextBuffer = reinterpret_cast<wchar_t *>(g_text);
+        setting.posx = 1920.f / 2;
+        setting.posy = 1080.f / 2;
+        setting.horizontalAlignment = ORBIS_H_CENTER;
+        setting.verticalAlignment = ORBIS_V_CENTER;
+        setting.title = reinterpret_cast<const wchar_t *>(g_title);
+        result = sceImeDialogInit(&setting, nullptr);
+        LOG_INFO("PS4 keyboard: open {:08X} for the game's {} (type {}, option {:X}, length {})", static_cast<uint32_t>(result),
+            for_dialog ? "IME dialog" : "IME", static_cast<int>(attempts[i].type), attempts[i].option, attempts[i].length);
+    }
+    g_open = result >= 0;
+    g_for_dialog = for_dialog;
+    g_closing = false;
+    g_hold = g_hold || g_open;
+    return g_open;
+}
+
+// Closes the keyboard the game opened (for_dialog: its IME dialog, else its sceIme) without a
+// result: the game aborted the dialog or closed its IME
+extern "C" void ps4_keyboard_close(bool for_dialog) {
+    const std::lock_guard<std::mutex> guard(g_lock);
+    if (!g_open || g_for_dialog != for_dialog || g_closing)
+        return;
+    sceImeDialogAbort();
+    g_closing = true;
+}
+
+namespace ps4keyboard {
+
+void update(EmuEnvState &emuenv) {
+    bool for_dialog;
+    bool done;
+    std::u16string text;
+    {
+        const std::lock_guard<std::mutex> guard(g_lock);
+        if (!g_open)
+            return;
+        const OrbisDialogStatus status = sceImeDialogGetStatus();
+        if (status == ORBIS_DIALOG_STATUS_RUNNING)
+            return;
+        OrbisDialogResult result{};
+        if (status == ORBIS_DIALOG_STATUS_STOPPED)
+            sceImeDialogGetResult(&result);
+        sceImeDialogTerm();
+        g_open = false;
+        if (g_closing) {
+            g_closing = false;
+            LOG_INFO("PS4 keyboard: closed by the game");
+            return;
+        }
+        done = status == ORBIS_DIALOG_STATUS_STOPPED && result.endstatus == ORBIS_DIALOG_OK;
+        for_dialog = g_for_dialog;
+        if (done)
+            text = g_text;
+    }
+    LOG_INFO("PS4 keyboard: {} ({} characters)", done ? "done" : "closed", text.size());
+    if (for_dialog)
+        give_dialog(emuenv, done, text);
+    else
+        give_ime(emuenv, done, text);
+}
+
+bool holds_input(uint32_t buttons) {
+    const std::lock_guard<std::mutex> guard(g_lock);
+    if (g_open)
+        return true;
+    if (g_hold && !(buttons & PAD_BUTTONS))
+        g_hold = false;
+    return g_hold;
+}
+
+} // namespace ps4keyboard
