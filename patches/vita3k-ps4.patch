+// The built-in themes, "Custom colours", then the PS Vita themes installed (their pictures and colours)
+Item theme_choice(EmuEnvState &emuenv) {
+    const std::vector<VitaTheme> installed = vita_themes(fs_utils::path_to_utf8(emuenv.vita_fs_path / "ux0" / "theme"));
+    Item item;
+    item.type = Item::kind::choice;
+    item.name = "Theme";
+    item.values = theme_names();
+    for (const VitaTheme &t : installed)
+        item.values.push_back(t.title);
+    item.get = [installed] {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        for (size_t i = 0; i < installed.size(); i++) {
+            if (installed[i].folder == g_prefs.vita_theme)
+                return static_cast<int>(theme_names().size() + i);
+        }
+        return g_prefs.theme;
+    };
+    item.set = [installed](int index) {
+        const std::lock_guard<std::mutex> lock(settings_mutex);
+        const int built_in = static_cast<int>(theme_names().size());
+        if (index < built_in) {
+            g_prefs.theme = index;
+            g_prefs.vita_theme.clear();
+        } else if (index - built_in < static_cast<int>(installed.size())) {
+            g_prefs.vita_theme = installed[index - built_in].folder;
+        }
+        save_prefs();
+    };
+    return item;
+}
