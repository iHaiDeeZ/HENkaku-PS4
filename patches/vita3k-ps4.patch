+        }
+        // nothing shown: what the next frames need is made now, else the buttons are read again soon
+        // (a frame shown: the next one waits for it in present(), at the TV's refresh)
+        if (!shown && !make_ahead())
+            std::this_thread::sleep_for(std::chrono::milliseconds(8));
+    }
+}
+
+} // namespace ps4launcher
