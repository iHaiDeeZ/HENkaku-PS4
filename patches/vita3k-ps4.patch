+static std::string spirv_literal_string(const uint32_t *words, size_t max_words) {
+    std::string out;
+    for (size_t i = 0; i < max_words; i++) {
+        for (int b = 0; b < 4; b++) {
+            const char c = static_cast<char>((words[i] >> (8 * b)) & 0xFF);
+            if (c == '\0')
+                return out;
+            out.push_back(c);
+        }
+    }
+    return out;
