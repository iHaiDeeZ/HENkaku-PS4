+        if (!map_run(base + region * LARGE_PAGE, LARGE_PAGE, phys)) {
+            free_regions.push_back(static_cast<uint32_t>(phys / LARGE_PAGE));
+            return false;
+        }
+        region_phys[region] = static_cast<uint32_t>(phys / LARGE_PAGE + 1);
+    }
+    for (size_t page = first; page < last; page++) {
+        if (!page_committed[page]) {
+            page_committed[page] = 1;
+            region_used[page / PAGES_PER_REGION]++;
+            committed += PAGE;
+        }
+    }
+    return true;
